            role: 'moderator',
            permissions: {
                'users.manage': false,
                'users.roles': false,
                'products.manage': true,
                'orders.manage': true,
                'payments.manage': false,
                'disputes.manage': true,
                'settings.manage': false,
                'emails.manage': false,
                'analytics.view': true
