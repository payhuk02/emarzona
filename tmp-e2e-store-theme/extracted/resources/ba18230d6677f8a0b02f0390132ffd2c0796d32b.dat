import { createHotContext as __vite__createHotContext } from "/@vite/client";import.meta.hot = __vite__createHotContext("/src/styles/reviews-mobile.css");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from "/@vite/client"
const __vite__id = "/home/runner/work/emarzona/emarzona/src/styles/reviews-mobile.css"
const __vite__css = "/**\n * Mobile Optimizations pour Reviews\n * Date : 27 octobre 2025\n */\n\n/* Touch Targets - Minimum 44px */\n@media (max-width: 768px) {\n  .vote-button,\n  .review-action-button {\n    min-width: 44px;\n    min-height: 44px;\n    padding: 12px;\n  }\n\n  /* Larger tap targets for stars */\n  .review-stars button {\n    min-width: 40px;\n    min-height: 40px;\n    padding: 8px;\n  }\n\n  /* Review Cards */\n  .review-card {\n    padding: 1rem;\n  }\n\n  /* Stats on mobile */\n  .review-stats-card {\n    padding: 1rem;\n  }\n\n  /* Form inputs */\n  .review-form-input,\n  .review-form-textarea {\n    font-size: 1rem;\n    line-height: 1.625rem;\n    letter-spacing: 0; /* Prevent zoom on iOS */\n    font-size: 16px !important;\n  }\n\n  /* Media Gallery - Swipeable */\n  .review-media-gallery {\n    scroll-snap-type: x var(--tw-scroll-snap-strictness);\n    --tw-scroll-snap-strictness: mandatory;\n    overflow-x: auto;\n    scrollbar-width: none; /* Firefox */\n    -ms-overflow-style: none; /* IE/Edge */\n  }\n\n  .review-media-gallery::-webkit-scrollbar {\n    display: none; /* Chrome/Safari */\n  }\n\n  .review-media-item {\n    flex-shrink: 0;\n    scroll-snap-align: center;\n  }\n\n  /* Bottom Sheet for Form (mobile) */\n  .review-form-mobile-sheet {\n    position: fixed;\n    bottom: 0px;\n    left: 0px;\n    right: 0px;\n    z-index: 50;\n    border-top-left-radius: 0.75rem;\n    border-top-right-radius: 0.75rem;\n    border-top-width: 1px;\n    background-color: hsl(var(--background));\n    max-height: 90vh;\n    overflow-y: auto;\n    padding: 1.5rem;\n  }\n\n  /* Compact stats on mobile */\n  .review-stats-compact {\n    display: flex;\n    align-items: center;\n    gap: 0.75rem;\n  }\n\n  .review-stats-compact .average-rating {\n    font-size: 1.875rem;\n    line-height: 2.25rem;\n    letter-spacing: -0.01em;\n    font-weight: 700;\n  }\n\n  .review-stats-compact .stars {\n    --tw-scale-x: .9;\n    --tw-scale-y: .9;\n    transform: translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y));\n  }\n\n  /* Grid adjustments */\n  .reviews-layout-grid {\n    grid-template-columns: repeat(1, minmax(0, 1fr));\n    gap: 1rem;\n  }\n\n  /* Floating action button for review */\n  .review-fab {\n    position: fixed;\n    bottom: 1.5rem;\n    right: 1.5rem;\n    z-index: 40;\n    height: 3.5rem;\n    width: 3.5rem;\n    border-radius: 9999px;\n    background-color: hsl(var(--primary));\n    color: hsl(var(--primary-foreground));\n    --tw-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);\n    --tw-shadow-colored: 0 10px 15px -3px var(--tw-shadow-color), 0 4px 6px -4px var(--tw-shadow-color);\n    box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  /* Sticky filter bar on mobile */\n  .review-filter-mobile {\n    position: sticky;\n    top: 0px;\n    z-index: 30;\n    background-color: hsl(var(--background) / 0.95);\n    --tw-backdrop-blur: blur(8px);\n    backdrop-filter: var(--tw-backdrop-blur) var(--tw-backdrop-brightness) var(--tw-backdrop-contrast) var(--tw-backdrop-grayscale) var(--tw-backdrop-hue-rotate) var(--tw-backdrop-invert) var(--tw-backdrop-opacity) var(--tw-backdrop-saturate) var(--tw-backdrop-sepia);\n    border-bottom-width: 1px;\n    padding: 1rem;\n  }\n\n  /* Reduce spacing on mobile */\n  .review-list-mobile .review-card + .review-card {\n    margin-top: 1rem;\n  }\n\n  /* Image lightbox mobile */\n  .review-image-lightbox-mobile {\n    position: fixed;\n    inset: 0px;\n    z-index: 50;\n    background-color: rgb(0 0 0 / 0.95);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .review-image-lightbox-mobile img {\n    max-height: 100%;\n    max-width: 100%;\n    -o-object-fit: contain;\n       object-fit: contain;\n  }\n\n  /* Swipe indicator for media */\n  .swipe-indicator {\n    margin-top: 0.5rem;\n    display: flex;\n    justify-content: center;\n    gap: 0.25rem;\n  }\n\n  .swipe-indicator-dot {\n    height: 0.5rem;\n    width: 0.5rem;\n    border-radius: 9999px;\n    --tw-bg-opacity: 1;\n    background-color: rgb(156 163 175 / var(--tw-bg-opacity, 1));\n  }\n\n  .swipe-indicator-dot.active {\n    width: 1rem;\n    background-color: hsl(var(--primary));\n  }\n}\n\n/* Small Mobile (<375px) */\n@media (max-width: 374px) {\n  .review-card {\n    padding: 0.75rem;\n  }\n\n  .review-stats-card {\n    padding: 0.75rem;\n  }\n\n  .vote-button,\n  .review-action-button {\n    padding-left: 0.75rem;\n    padding-right: 0.75rem;\n    font-size: 0.875rem;\n    line-height: 1.375rem;\n    letter-spacing: 0;\n  }\n}\n\n/* Tablet (768px - 1024px) */\n@media (min-width: 768px) and (max-width: 1024px) {\n  .reviews-layout-grid {\n    grid-template-columns: repeat(1, minmax(0, 1fr));\n  }\n  @media (min-width: 1024px) {\n    .reviews-layout-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n  }\n\n  /* Stats can stay in sidebar on tablet */\n  .review-stats-tablet {\n    position: sticky;\n    top: 5rem;\n  }\n}\n\n/* Landscape mobile */\n@media (max-width: 768px) and (orientation: landscape) {\n  .review-form-mobile-sheet {\n    max-height: 80vh;\n  }\n\n  .review-stats-compact {\n    flex-direction: row;\n  }\n}\n"
__vite__updateStyle(__vite__id, __vite__css)
import.meta.hot.accept()
import.meta.hot.prune(() => __vite__removeStyle(__vite__id))