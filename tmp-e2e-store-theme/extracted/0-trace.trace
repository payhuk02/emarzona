 mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n\n    .dashboard-bottom-grid {\n      gap: 0.75rem;\n    }\n\n    /* Grilles adaptées */\n  }\n\n  .dashboard-bottom-grid {\n    gap: 1rem;\n  }\n}\n\n/* Tablet Optimizations */\n@media (min-width: 768px) and (max-width: 1023px) {\n  .dashboard-card {\n    min-height: 140px;\n  }\n  @media (max-width: 360px) {\n\n    /* Padding réduit pour très petits écrans */\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n\n    .dashboard-stats-grid {\n      gap: 0.75rem;\n    }\n\n    /* Grilles adaptées */\n  }\n\n  .dashboard-stats-grid {\n    gap: 1rem;\n  }\n  @media (max-width: 360px) {\n\n    /* Padding réduit pour très petits écrans */\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n\n    .dashboard-actions-grid {\n      gap: 0.75rem;\n    }\n\n    /* Grilles adaptées */\n  }\n\n  .dashboard-actions-grid {\n    gap: 1rem;\n  }\n}\n\n/* Desktop Optimizations */\n@media (min-width: 1024px) {\n  .dashboard-card {\n    min-height: 160px;\n  }\n\n  .dashboard-stats-grid {\n    gap: 1.5rem;\n  }\n\n  .dashboard-actions-grid {\n    gap: 1.5rem;\n  }\n\n  .dashboard-bottom-grid {\n    gap: 2rem;\n  }\n}\n\n/* Animation Classes */\n@keyframes fadeInUp {\n  from {\n    opacity: 0;\n    transform: translateY(20px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.animate-fade-in {\n  animation: fadeInUp 0.6s ease-out;\n}\n\n.animate-fade-in-delayed {\n  animation: fadeInUp 0.6s ease-out 0.2s both;\n}\n\n/* Focus States for Accessibility */\n.dashboard-card:focus-visible {\n  --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);\n  --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(2px + var(--tw-ring-offset-width)) var(--tw-ring-color);\n  box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000);\n  --tw-ring-color: hsl(var(--primary));\n  --tw-ring-offset-width: 2px;\n}\n\n.dashboard-button:focus-visible {\n  --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);\n  --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(2px + var(--tw-ring-offset-width)) var(--tw-ring-color);\n  box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000);\n  --tw-ring-color: hsl(var(--primary));\n  --tw-ring-offset-width: 2px;\n}\n\n/* Dark Mode Optimizations */\n@media (prefers-color-scheme: dark) {\n  .dashboard-card {\n    border-color: hsl(var(--border));\n    background-color: hsl(var(--card));\n  }\n\n  .dashboard-header {\n    background-color: hsl(var(--card) / 0.95);\n  }\n}\n\n/* ✅ ACCESSIBILITÉ: Reduced Motion - Désactiver toutes les animations */\n@media (prefers-reduced-motion: reduce) {\n  .dashboard-card,\n  .dashboard-icon-container,\n  .dashboard-notification-item,\n  .dashboard-activity-item,\n  .dashboard-button {\n    transition-property: none;\n    will-change: auto;\n  }\n\n  .dashboard-card:hover,\n  .dashboard-icon-container:hover {\n    transform: none;\n  }\n\n  .animate-fade-in,\n  .animate-fade-in-delayed,\n  .animate-in {\n    animation: none !important;\n  }\n\n  /* Désactiver les animations inline dans les composants React */\n  [style*='animationDelay'] {\n    animation: none !important;\n  }\n}\n\n/* ✅ PERFORMANCE: Désactiver will-change quand l'animation est terminée */\n@supports (animation-timeline: scroll()) {\n  .dashboard-card {\n    animation-timeline: view();\n  }\n}\n"],["STYLE",{},"/* All @import statements must come first */\n/* Google Fonts chargé via <link> dans index.html pour éviter les problèmes CSP */\n/**\n * Animations CSS personnalisées\n * À utiliser avec Tailwind ou directement\n */\n/* Animations de base */\n@keyframes fadeIn {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n@keyframes fadeOut {\n  from {\n    opacity: 1;\n  }\n  to {\n    opacity: 0;\n  }\n}\n@keyframes slideInUp {\n  from {\n    transform: translateY(20px);\n    opacity: 0;\n  }\n  to {\n    transform: translateY(0);\n    opacity: 1;\n  }\n}\n@keyframes slideInDown {\n  from {\n    transform: translateY(-20px);\n    opacity: 0;\n  }\n  to {\n    transform: translateY(0);\n    opacity: 1;\n  }\n}\n@keyframes slideInLeft {\n  from {\n    transform: translateX(-20px);\n    opacity: 0;\n  }\n  to {\n    transform: translateX(0);\n    opacity: 1;\n  }\n}\n@keyframes slideInRight {\n  from {\n    transform: translateX(20px);\n    opacity: 0;\n  }\n  to {\n    transform: translateX(0);\n    opacity: 1;\n  }\n}\n@keyframes scaleIn {\n  from {\n    transform: scale(0.9);\n    opacity: 0;\n  }\n  to {\n    transform: scale(1);\n    opacity: 1;\n  }\n}\n@keyframes pulse {\n  0%,\n  100% {\n    transform: scale(1);\n    opacity: 1;\n  }\n  50% {\n    transform: scale(1.05);\n    opacity: 0.8;\n  }\n}\n@keyframes bounce {\n  0%,\n  100% {\n    transform: translateY(0);\n  }\n  50% {\n    transform: translateY(-10px);\n  }\n}\n@keyframes shimmer {\n  0% {\n    background-position: -1000px 0;\n  }\n  100% {\n    background-position: 1000px 0;\n  }\n}\n@keyframes wave {\n  0%,\n  100% {\n    transform: translateY(0);\n  }\n  25% {\n    transform: translateY(-10px);\n  }\n  75% {\n    transform: translateY(10px);\n  }\n}\n@keyframes spin {\n  from {\n    transform: rotate(0deg);\n  }\n  to {\n    transform: rotate(360deg);\n  }\n}\n/* Classes utilitaires */\n.animate-fade-in {\n  animation: fadeIn 0.3s ease-out;\n}\n.animate-fade-out {\n  animation: fadeOut 0.3s ease-out;\n}\n.animate-slide-in-up {\n  animation: slideInUp 0.4s ease-out;\n}\n.animate-slide-in-down {\n  animation: slideInDown 0.4s ease-out;\n}\n.animate-slide-in-left {\n  animation: slideInLeft 0.4s ease-out;\n}\n.animate-slide-in-right {\n  animation: slideInRight 0.4s ease-out;\n}\n.animate-scale-in {\n  animation: scaleIn 0.3s ease-out;\n}\n.animate-pulse-slow {\n  animation: pulse 2s ease-in-out infinite;\n}\n.animate-bounce-slow {\n  animation: bounce 1s ease-in-out infinite;\n}\n.animate-shimmer {\n  background: linear-gradient(\n    90deg,\n    rgba(255, 255, 255, 0) 0%,\n    rgba(255, 255, 255, 0.2) 50%,\n    rgba(255, 255, 255, 0) 100%\n  );\n  background-size: 1000px 100%;\n  animation: shimmer 2s infinite linear;\n}\n.animate-wave {\n  animation: wave 1.5s ease-in-out infinite;\n}\n/* Animation au scroll */\n.animate-on-scroll {\n  opacity: 0;\n  transform: translateY(20px);\n  transition:\n    opacity 0.6s ease-out,\n    transform 0.6s ease-out;\n}\n.animate-on-scroll.animate-in {\n  opacity: 1;\n  transform: translateY(0);\n}\n/* Délais d'animation pour effet de cascade */\n.animate-delay-100 {\n  animation-delay: 100ms;\n}\n.animate-delay-200 {\n  animation-delay: 200ms;\n}\n.animate-delay-300 {\n  animation-delay: 300ms;\n}\n.animate-delay-400 {\n  animation-delay: 400ms;\n}\n.animate-delay-500 {\n  animation-delay: 500ms;\n}\n/* Hover effects - Optimisés avec GPU acceleration */\n.hover-lift {\n  transition:\n    transform 0.2s ease-out,\n    box-shadow 0.2s ease-out;\n  will-change: transform;\n  transform: translateZ(0); /* Force GPU acceleration */\n}\n.hover-lift:hover {\n  transform: translateY(-4px) translateZ(0);\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);\n}\n.hover-lift:not(:hover) {\n  will-change: auto; /* Réinitialiser après animation */\n}\n.hover-scale {\n  transition: transform 0.2s ease-out;\n  will-change: transform;\n  transform: translateZ(0); /* Force GPU acceleration */\n}\n.hover-scale:hover {\n  transform: scale(1.05) translateZ(0);\n}\n.hover-scale:not(:hover) {\n  will-change: auto; /* Réinitialiser après animation */\n}\n.hover-glow {\n  transition: box-shadow 0.3s ease-out;\n  will-change: box-shadow;\n}\n.hover-glow:hover {\n  box-shadow: 0 0 20px rgba(99, 102, 241, 0.5);\n}\n.hover-glow:not(:hover) {\n  will-change: auto; /* Réinitialiser après animation */\n}\n/* Skeleton loading */\n.skeleton {\n  background: linear-gradient(90deg, #f0f0f0 0%, #e0e0e0 50%, #f0f0f0 100%);\n  background-size: 200% 100%;\n  animation: shimmer 1.5s infinite linear;\n  border-radius: 4px;\n}\n.skeleton-dark {\n  background: linear-gradient(90deg, #2a2a2a 0%, #1a1a1a 50%, #2a2a2a 100%);\n  background-size: 200% 100%;\n  animation: shimmer 1.5s infinite linear;\n}\n/* Transitions fluides */\n.transition-smooth {\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n.transition-fast {\n  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);\n}\n.transition-slow {\n  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);\n}\n/* Page transitions */\n.page-enter {\n  opacity: 0;\n  transform: translateX(-20px);\n}\n.page-enter-active {\n  opacity: 1;\n  transform: translateX(0);\n  transition:\n    opacity 0.3s,\n    transform 0.3s;\n}\n.page-exit {\n  opacity: 1;\n  transform: translateX(0);\n}\n.page-exit-active {\n  opacity: 0;\n  transform: translateX(20px);\n  transition:\n    opacity 0.3s,\n    transform 0.3s;\n}\n/* Modal/Dialog animations */\n.modal-backdrop-enter {\n  opacity: 0;\n}\n.modal-backdrop-enter-active {\n  opacity: 1;\n  transition: opacity 0.2s;\n}\n.modal-backdrop-exit {\n  opacity: 1;\n}\n.modal-backdrop-exit-active {\n  opacity: 0;\n  transition: opacity 0.2s;\n}\n.modal-content-enter {\n  opacity: 0;\n  transform: scale(0.95) translateY(20px);\n}\n.modal-content-enter-active {\n  opacity: 1;\n  transform: scale(1) translateY(0);\n  transition:\n    opacity 0.3s,\n    transform 0.3s;\n}\n.modal-content-exit {\n  opacity: 1;\n  transform: scale(1) translateY(0);\n}\n.modal-content-exit-active {\n  opacity: 0;\n  transform: scale(0.95) translateY(20px);\n  transition:\n    opacity 0.3s,\n    transform 0.3s;\n}\n/* Notification/Toast animations */\n.toast-enter {\n  opacity: 0;\n  transform: translateX(100%);\n}\n.toast-enter-active {\n  opacity: 1;\n  transform: translateX(0);\n  transition:\n    opacity 0.3s,\n    transform 0.3s;\n}\n.toast-exit {\n  opacity: 1;\n  transform: translateX(0);\n}\n.toast-exit-active {\n  opacity: 0;\n  transform: translateX(100%);\n  transition:\n    opacity 0.3s,\n    transform 0.3s;\n}\n/* Loading spinner */\n@keyframes spin-slow {\n  from {\n    transform: rotate(0deg);\n  }\n  to {\n    transform: rotate(360deg);\n  }\n}\n.loading-spinner {\n  animation: spin-slow 1s linear infinite;\n}\n/* Card hover effect - Optimisé avec GPU acceleration */\n.card-hover {\n  transition:\n    transform 0.2s ease-out,\n    box-shadow 0.2s ease-out;\n  will-change: transform;\n  transform: translateZ(0); /* Force GPU acceleration */\n}\n.card-hover:hover {\n  transform: translateY(-4px) scale(1.02) translateZ(0);\n  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);\n}\n.card-hover:not(:hover) {\n  will-change: auto; /* Réinitialiser après animation */\n}\n/* Image zoom effect */\n.image-zoom {\n  overflow: hidden;\n}\n.image-zoom img {\n  transition: transform 0.4s ease-out;\n}\n.image-zoom:hover img {\n  transform: scale(1.1);\n}\n/* Button ripple effect */\n.button-ripple {\n  position: relative;\n  overflow: hidden;\n}\n.button-ripple::after {\n  content: '';\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 0;\n  height: 0;\n  border-radius: 50%;\n  background: rgba(255, 255, 255, 0.5);\n  transform: translate(-50%, -50%);\n  transition:\n    width 0.6s,\n    height 0.6s;\n}\n.button-ripple:active::after {\n  width: 300px;\n  height: 300px;\n}\n/* Smooth scroll */\nhtml {\n  scroll-behavior: smooth;\n}\n/* Reduce motion for accessibility */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n/**\n * Optimisations Mobile - Phase 2 UX\n * Améliorations spécifiques pour l'expérience mobile\n */\n/* === TOUCH TARGETS === */\n/* Taille minimale 44x44px pour les éléments interactifs (Apple HIG, Material Design) */\nbutton,\na,\ninput[type='button'],\ninput[type='submit'],\ninput[type='checkbox'],\ninput[type='radio'],\nselect {\n  min-height: 44px;\n  min-width: 44px;\n}\n/* === SCROLL SMOOTH === */\n/* Amélioration du scroll sur mobile */\n@media (max-width: 768px) {\n  * {\n    -webkit-overflow-scrolling: touch;\n  }\n\n  body {\n    overscroll-behavior-y: contain;\n  }\n}\n/* === TEXT SIZE === */\n/* Taille de texte optimale pour mobile */\n@media (max-width: 768px) {\n  body {\n    font-size: 16px; /* Évite le zoom automatique sur iOS */\n    -webkit-text-size-adjust: 100%;\n    -moz-text-size-adjust: 100%;\n         text-size-adjust: 100%;\n  }\n\n  input,\n  textarea,\n  select {\n    font-size: 16px; /* Évite le zoom automatique sur iOS */\n  }\n}\n/* === VIEWPORT FIXES === */\n/* Corrections pour les navigateurs mobiles */\n@supports (-webkit-touch-callout: none) {\n  /* iOS Safari */\n  .mobile-fix {\n    min-height: -webkit-fill-available;\n  }\n}\n/* === SAFE AREA === */\n/* Support pour les zones sûres (notch, etc.) */\n@supports (padding: max(0px)) {\n  .safe-area-top {\n    padding-top: max(1rem, env(safe-area-inset-top));\n  }\n\n  .safe-area-bottom {\n    padding-bottom: max(1rem, env(safe-area-inset-bottom));\n  }\n\n  .safe-area-left {\n    padding-left: max(1rem, env(safe-area-inset-left));\n  }\n\n  .safe-area-right {\n    padding-right: max(1rem, env(safe-area-inset-right));\n  }\n}\n/* === MODAL MOBILE === */\n/* Modales optimisées pour mobile */\n@media (max-width: 768px) {\n  [role='dialog'],\n  [role='alertdialog'] {\n    max-height: 90vh;\n    max-width: 100vw;\n    margin: 0;\n    border-radius: 1rem 1rem 0 0;\n  }\n\n  /* Animation slide-up pour mobile */\n  .modal-mobile-enter {\n    transform: translateY(100%);\n  }\n\n  .modal-mobile-enter-active {\n    transform: translateY(0);\n    transition: transform 0.3s ease-out;\n  }\n}\n/* === NAVIGATION MOBILE === */\n/* Navigation optimisée pour mobile */\n@media (max-width: 768px) {\n  nav:not(.platform-customization-nav-list):not(.context-bottom-nav) {\n    position: sticky;\n    top: 0;\n    z-index: 100;\n    background: var(--background);\n    backdrop-filter: blur(10px);\n  }\n\n  /* Exception pour la barre de navigation contextuelle en bas */\n  nav.context-bottom-nav {\n    position: fixed !important;\n    top: auto !important;\n    bottom: 0 !important;\n    z-index: 110 !important;\n  }\n\n  /* Bottom navigation pour mobile */\n  .bottom-nav {\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    background: var(--background);\n    border-top: 1px solid var(--border);\n    padding: 0.5rem 0;\n    padding-bottom: max(0.5rem, env(safe-area-inset-bottom));\n    z-index: 100;\n  }\n}\n/* === CARDS MOBILE === */\n/* Cartes optimisées pour mobile */\n@media (max-width: 768px) {\n  .card-mobile {\n    margin: 0.5rem;\n    border-radius: 0.75rem;\n  }\n\n  .card-mobile:active {\n    transform: scale(0.98);\n    transition: transform 0.1s;\n  }\n}\n/* === FORMS MOBILE === */\n/* Formulaires optimisés pour mobile */\n@media (max-width: 768px) {\n  input[type='text'],\n  input[type='email'],\n  input[type='password'],\n  input[type='number'],\n  input[type='tel'],\n  input[type='url'],\n  textarea,\n  select {\n    width: 100%;\n    padding: 0.75rem;\n    font-size: 16px; /* Évite le zoom automatique */\n    border-radius: 0.5rem;\n  }\n\n  /* Labels au-dessus des inputs sur mobile */\n  .form-group-mobile {\n    display: flex;\n    flex-direction: column;\n    gap: 0.5rem;\n  }\n}\n/* === BUTTONS MOBILE === */\n/* Boutons optimisés pour mobile */\n@media (max-width: 768px) {\n  .btn-mobile {\n    width: 100%;\n    padding: 0.875rem 1.5rem;\n    font-size: 1rem;\n    font-weight: 600;\n    border-radius: 0.75rem;\n    min-height: 48px; /* Touch target optimal */\n  }\n\n  .btn-mobile:active {\n    transform: scale(0.98);\n    opacity: 0.9;\n  }\n}\n/* === IMAGES MOBILE === */\n/* Images optimisées pour mobile */\n@media (max-width: 768px) {\n  img {\n    max-width: 100%;\n    height: auto;\n  }\n\n  /* Lazy loading pour mobile (hors landing premium) */\n  img[loading='lazy']:not([data-no-mobile-opt]) {\n    opacity: 0;\n    transition: opacity 0.3s;\n  }\n\n  img[loading='lazy'].loaded,\n  img[loading='lazy'][data-no-mobile-opt],\n  .landing-premium img[loading='lazy']:not([data-no-mobile-opt]) {\n    opacity: 1;\n  }\n}\n/* === TABLES MOBILE === */\n/* Tables optimisées pour mobile */\n@media (max-width: 768px) {\n  table {\n    display: block;\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n  }\n\n  /* Stack table sur mobile */\n  .table-mobile-stack {\n    display: block;\n  }\n\n  .table-mobile-stack thead {\n    display: none;\n  }\n\n  .table-mobile-stack tbody,\n  .table-mobile-stack tr,\n  .table-mobile-stack td {\n    display: block;\n    width: 100%;\n  }\n\n  .table-mobile-stack td {\n    text-align: right;\n    padding: 0.5rem;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .table-mobile-stack td::before {\n    content: attr(data-label);\n    float: left;\n    font-weight: 600;\n  }\n}\n/* === LOADING STATES MOBILE === */\n/* États de chargement optimisés pour mobile */\n@media (max-width: 768px) {\n  .skeleton-mobile {\n    border-radius: 0.5rem;\n    margin: 0.5rem 0;\n  }\n\n  .loading-spinner-mobile {\n    width: 2rem;\n    height: 2rem;\n  }\n}\n/* === SCROLLBAR HIDE === */\n/* Masquer la scrollbar tout en gardant le scroll */\n.scrollbar-hide {\n  -ms-overflow-style: none; /* IE et Edge */\n  scrollbar-width: none; /* Firefox */\n}\n.scrollbar-hide::-webkit-scrollbar {\n  display: none; /* Chrome, Safari et Opera */\n}\n/* === SCROLLBAR PROFESSIONNELLE POUR ONGLET COMMANDES === */\n/* Barre de défilement horizontale visible et stylisée pour l'onglet Commandes - Version Professionnelle */\n.scrollbar-orders {\n  scrollbar-width: thin; /* Firefox - barre fine */\n  scrollbar-color: rgb(168 85 247 / 0.7) rgb(0 0 0 / 0.08); /* Firefox - thumb et track améliorés */\n  /* Momentum scrolling pour iOS */\n  -webkit-overflow-scrolling: touch;\n}\n.scrollbar-orders::-webkit-scrollbar {\n  height: 10px; /* Hauteur de la barre de défilement horizontale - Augmentée pour meilleure visibilité */\n}\n.scrollbar-orders::-webkit-scrollbar-track {\n  background: linear-gradient(\n    to right,\n    rgb(0 0 0 / 0.03),\n    rgb(0 0 0 / 0.05),\n    rgb(0 0 0 / 0.03)\n  ); /* Gradient subtil pour la piste */\n  border-radius: 5px;\n  margin: 2px 0;\n}\n.scrollbar-orders::-webkit-scrollbar-thumb {\n  background: linear-gradient(\n    to right,\n    rgb(168 85 247 / 0.4),\n    rgb(168 85 247 / 0.7),\n    rgb(168 85 247 / 0.4)\n  ); /* Gradient pour le curseur */\n  border-radius: 5px;\n  border: 1px solid rgb(168 85 247 / 0.2);\n  -webkit-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  box-shadow: 0 2px 4px rgb(168 85 247 / 0.2);\n}\n.scrollbar-orders::-webkit-scrollbar-thumb:hover {\n  background: linear-gradient(\n    to right,\n    rgb(168 85 247 / 0.6),\n    rgb(168 85 247 / 0.9),\n    rgb(168 85 247 / 0.6)\n  ); /* Gradient plus intense au survol */\n  box-shadow: 0 2px 6px rgb(168 85 247 / 0.4);\n  transform: scaleY(1.1);\n}\n.scrollbar-orders::-webkit-scrollbar-thumb:active {\n  background: linear-gradient(\n    to right,\n    rgb(147 51 234 / 0.7),\n    rgb(168 85 247 / 1),\n    rgb(147 51 234 / 0.7)\n  ); /* Gradient encore plus intense au clic */\n  box-shadow: 0 1px 3px rgb(168 85 247 / 0.5);\n}\n/* Dark mode support */\n@media (prefers-color-scheme: dark) {\n  .scrollbar-orders {\n    scrollbar-color: rgb(168 85 247 / 0.8) rgb(255 255 255 / 0.05);\n  }\n\n  .scrollbar-orders::-webkit-scrollbar-track {\n    background: linear-gradient(\n      to right,\n      rgb(255 255 255 / 0.02),\n      rgb(255 255 255 / 0.05),\n      rgb(255 255 255 / 0.02)\n    );\n  }\n}\n/* === PERFORMANCE MOBILE === */\n/* Optimisations de performance pour mobile */\n@media (max-width: 768px) {\n  /*\n   * ⚠️ PERF: éviter les overrides globaux sur `*` avec `!important`\n   * Ça force des recalculs de style massifs et peut dégrader le scroll / input latency.\n   * On garde des optimisations ciblées ci-dessous et le mode \"reduce-motion-mobile\" si besoin.\n   */\n\n  /* Désactiver les animations complexes sur mobile */\n  .reduce-motion-mobile *,\n  .reduce-motion-mobile *::before,\n  .reduce-motion-mobile *::after {\n    animation-duration: 0.01ms !important;\n    transition-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n  }\n\n  /* Désactiver les animations de hover sur mobile (pas de hover sur tactile) */\n  @media (hover: none) {\n    *:hover {\n      transform: none !important;\n      transition: none !important;\n    }\n\n    .hover-lift:hover,\n    .hover-scale:hover,\n    .hover-glow:hover {\n      transform: none !important;\n      box-shadow: none !important;\n    }\n  }\n\n  /* Optimiser les animations de scroll sur mobile */\n  .animate-on-scroll {\n    animation-duration: 0.3s !important;\n  }\n\n  /* Réduire les animations de skeleton */\n  .skeleton,\n  .skeleton-dark {\n    animation-duration: 1s !important;\n  }\n\n  /* Réduire les animations de pulse */\n  .animate-pulse {\n    animation-duration: 2s !important;\n  }\n\n  /* Optimiser les transitions de modales sur mobile */\n  .modal-content-enter-active,\n  .modal-content-exit-active {\n    transition-duration: 0.2s !important;\n  }\n\n  /* Optimiser les transitions de toasts sur mobile */\n  .toast-enter-active,\n  .toast-exit-active {\n    transition-duration: 0.2s !important;\n  }\n}\n/* === ACCESSIBILITY MOBILE === */\n/* Améliorations d'accessibilité mobile */\n@media (max-width: 768px) {\n  /* Focus visible amélioré sur mobile */\n  *:focus-visible {\n    outline: 3px solid var(--primary);\n    outline-offset: 2px;\n  }\n\n  /* Skip link visible sur mobile */\n  .skip-link:focus {\n    position: fixed;\n    top: 1rem;\n    left: 1rem;\n    z-index: 1000;\n    padding: 0.75rem 1.5rem;\n    background: var(--primary);\n    color: white;\n    border-radius: 0.5rem;\n  }\n}\n/**\n * Mobile-First Design System\n * Système de design optimisé pour mobile avec scaling progressif vers desktop\n * \n * Breakpoints:\n * - Mobile: 320px - 767px (base)\n * - Tablet: 768px - 1023px\n * - Desktop: 1024px+\n */\n/* ============================================\n   MOBILE-FIRST TYPOGRAPHY SYSTEM\n   ============================================ */\n:root {\n  /* Mobile-first font sizes (base: 16px) */\n  --font-size-xs: 0.75rem; /* 12px - Mobile only */\n  --font-size-sm: 0.875rem; /* 14px - Mobile base */\n  --font-size-base: 1rem; /* 16px - Mobile body, prevents iOS zoom */\n  --font-size-lg: 1.125rem; /* 18px - Mobile subheading */\n  --font-size-xl: 1.25rem; /* 20px - Mobile heading */\n  --font-size-2xl: 1.5rem; /* 24px - Mobile large heading */\n  --font-size-3xl: 1.875rem; /* 30px - Tablet heading */\n  --font-size-4xl: 2.25rem; /* 36px - Desktop heading */\n\n  /* Line heights optimized for mobile */\n  --line-height-tight: 1.25;\n  --line-height-normal: 1.5;\n  --line-height-relaxed: 1.75;\n\n  /* Spacing system mobile-first */\n  --spacing-xs: 0.25rem; /* 4px */\n  --spacing-sm: 0.5rem; /* 8px */\n  --spacing-md: 0.75rem; /* 12px */\n  --spacing-base: 1rem; /* 16px */\n  --spacing-lg: 1.5rem; /* 24px */\n  --spacing-xl: 2rem; /* 32px */\n  --spacing-2xl: 3rem; /* 48px */\n\n  /* Safe area padding for mobile */\n  --safe-area-top: env(safe-area-inset-top, 0px);\n  --safe-area-bottom: env(safe-area-inset-bottom, 0px);\n  --safe-area-left: env(safe-area-inset-left, 0px);\n  --safe-area-right: env(safe-area-inset-right, 0px);\n\n  /* Container padding mobile-first */\n  --container-padding-mobile: 1rem; /* 16px */\n  --container-padding-tablet: 1.5rem; /* 24px */\n  --container-padding-desktop: 2rem; /* 32px */\n\n  /* Touch target sizes */\n  --touch-target-min: 44px; /* WCAG 2.5.5 minimum */\n  --touch-target-comfortable: 48px;\n\n  /* Border radius mobile */\n  --radius-sm: 0.375rem; /* 6px */\n  --radius-base: 0.5rem; /* 8px */\n  --radius-lg: 0.75rem; /* 12px */\n  --radius-xl: 1rem; /* 16px */\n}\n/* ============================================\n   MOBILE-FIRST BASE STYLES\n   ============================================ */\n@media (max-width: 767px) {\n  /* Base typography for mobile */\n  html {\n    font-size: 16px; /* Prevents iOS zoom on input focus */\n    -webkit-text-size-adjust: 100%;\n    -moz-text-size-adjust: 100%;\n         text-size-adjust: 100%;\n  }\n\n  body {\n    font-size: var(--font-size-base);\n    line-height: var(--line-height-normal);\n    padding-left: var(--safe-area-left);\n    padding-right: var(--safe-area-right);\n  }\n\n  /* Headings mobile-optimized */\n  h1 {\n    font-size: var(--font-size-2xl);\n    line-height: var(--line-height-tight);\n    font-weight: 700;\n    margin-bottom: var(--spacing-base);\n  }\n\n  h2 {\n    font-size: var(--font-size-xl);\n    line-height: var(--line-height-tight);\n    font-weight: 600;\n    margin-bottom: var(--spacing-md);\n  }\n\n  h3 {\n    font-size: var(--font-size-lg);\n    line-height: var(--line-height-normal);\n    font-weight: 600;\n    margin-bottom: var(--spacing-md);\n  }\n\n  h4,\n  h5,\n  h6 {\n    font-size: var(--font-size-base);\n    line-height: var(--line-height-normal);\n    font-weight: 600;\n    margin-bottom: var(--spacing-sm);\n  }\n\n  /* Paragraphs */\n  p {\n    font-size: var(--font-size-base);\n    line-height: var(--line-height-relaxed);\n    margin-bottom: var(--spacing-base);\n  }\n\n  /* Links */\n  a {\n    font-size: var(--font-size-base);\n    min-height: var(--touch-target-min);\n    display: inline-flex;\n    align-items: center;\n  }\n\n  /* Container mobile */\n  .container {\n    width: 100%;\n    max-width: 100%;\n    padding-left: var(--container-padding-mobile);\n    padding-right: var(--container-padding-mobile);\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n  /* Prevent horizontal scroll */\n  * {\n    max-width: 100%;\n  }\n\n  img,\n  video,\n  iframe {\n    max-width: 100%;\n    height: auto;\n  }\n\n  /* Tables mobile-friendly */\n  table {\n    display: block;\n    width: 100%;\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n  }\n}\n/* ============================================\n   TABLET OPTIMIZATIONS (768px - 1023px)\n   ============================================ */\n@media (min-width: 768px) and (max-width: 1023px) {\n  html {\n    font-size: 16px;\n  }\n\n  body {\n    font-size: var(--font-size-base);\n  }\n\n  h1 {\n    font-size: var(--font-size-3xl);\n  }\n\n  h2 {\n    font-size: var(--font-size-2xl);\n  }\n\n  h3 {\n    font-size: var(--font-size-xl);\n  }\n\n  .container {\n    padding-left: var(--container-padding-tablet);\n    padding-right: var(--container-padding-tablet);\n  }\n}\n/* ============================================\n   DESKTOP OPTIMIZATIONS (1024px+)\n   ============================================ */\n@media (min-width: 1024px) {\n  html {\n    font-size: 16px;\n  }\n\n  body {\n    font-size: var(--font-size-base);\n  }\n\n  h1 {\n    font-size: var(--font-size-4xl);\n  }\n\n  h2 {\n    font-size: var(--font-size-3xl);\n  }\n\n  h3 {\n    font-size: var(--font-size-2xl);\n  }\n\n  .container {\n    padding-left: var(--container-padding-desktop);\n    padding-right: var(--container-padding-desktop);\n    max-width: 1280px;\n  }\n}\n/* ============================================\n   TOUCH TARGETS - MOBILE-FIRST\n   ============================================ */\n@media (max-width: 767px) {\n  /* All interactive elements must be at least 44px */\n  button,\n  a[role='button'],\n  input[type='button'],\n  input[type='submit'],\n  input[type='checkbox'],\n  input[type='radio'],\n  select,\n  [role='button'],\n  [role='tab'],\n  [role='menuitem'] {\n    min-height: var(--touch-target-min);\n    min-width: var(--touch-target-min);\n    padding: var(--spacing-sm) var(--spacing-base);\n    font-size: var(--font-size-base); /* Prevents iOS zoom */\n  }\n\n  /* Icon-only buttons */\n  button[aria-label],\n  button:has(svg:only-child) {\n    min-width: var(--touch-target-min);\n    min-height: var(--touch-target-min);\n    padding: var(--spacing-sm);\n  }\n\n  /* Form inputs */\n  input[type='text'],\n  input[type='email'],\n  input[type='password'],\n  input[type='number'],\n  input[type='tel'],\n  input[type='url'],\n  input[type='search'],\n  textarea,\n  select {\n    min-height: var(--touch-target-min);\n    font-size: var(--font-size-base); /* Prevents iOS zoom */\n    padding: var(--spacing-sm) var(--spacing-base);\n  }\n}\n/* ============================================\n   MOBILE-FIRST UTILITIES\n   ============================================ */\n/* Safe area utilities */\n.safe-top {\n  padding-top: calc(var(--safe-area-top) + var(--spacing-base));\n}\n.safe-bottom {\n  padding-bottom: calc(var(--safe-area-bottom) + var(--spacing-base));\n}\n.safe-left {\n  padding-left: calc(var(--safe-area-left) + var(--spacing-base));\n}\n.safe-right {\n  padding-right: calc(var(--safe-area-right) + var(--spacing-base));\n}\n.safe-all {\n  padding-top: calc(var(--safe-area-top) + var(--spacing-base));\n  padding-bottom: calc(var(--safe-area-bottom) + var(--spacing-base));\n  padding-left: calc(var(--safe-area-left) + var(--spacing-base));\n  padding-right: calc(var(--safe-area-right) + var(--spacing-base));\n}\n/* Mobile-first spacing */\n@media (max-width: 767px) {\n  .mobile-p-0 {\n    padding: 0;\n  }\n  .mobile-p-1 {\n    padding: var(--spacing-xs);\n  }\n  .mobile-p-2 {\n    padding: var(--spacing-sm);\n  }\n  .mobile-p-3 {\n    padding: var(--spacing-md);\n  }\n  .mobile-p-4 {\n    padding: var(--spacing-base);\n  }\n  .mobile-p-6 {\n    padding: var(--spacing-lg);\n  }\n\n  .mobile-m-0 {\n    margin: 0;\n  }\n  .mobile-m-1 {\n    margin: var(--spacing-xs);\n  }\n  .mobile-m-2 {\n    margin: var(--spacing-sm);\n  }\n  .mobile-m-3 {\n    margin: var(--spacing-md);\n  }\n  .mobile-m-4 {\n    margin: var(--spacing-base);\n  }\n  .mobile-m-6 {\n    margin: var(--spacing-lg);\n  }\n\n  .mobile-gap-1 {\n    gap: var(--spacing-xs);\n  }\n  .mobile-gap-2 {\n    gap: var(--spacing-sm);\n  }\n  .mobile-gap-3 {\n    gap: var(--spacing-md);\n  }\n  .mobile-gap-4 {\n    gap: var(--spacing-base);\n  }\n}\n/* Prevent text selection on mobile (for better UX) */\n@media (max-width: 767px) {\n  button,\n  [role='button'],\n  a {\n    -webkit-user-select: none;\n    -moz-user-select: none;\n         user-select: none;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  /* Allow selection for text content */\n  p,\n  span,\n  div:not([role='button']):not(button) {\n    -webkit-user-select: text;\n    -moz-user-select: text;\n         user-select: text;\n  }\n}\n/* ============================================\n   SCROLL OPTIMIZATIONS MOBILE\n   ============================================ */\n@media (max-width: 767px) {\n  /* Smooth scrolling on mobile */\n  html {\n    -webkit-overflow-scrolling: touch;\n    scroll-behavior: smooth;\n  }\n\n  /* Prevent overscroll bounce on iOS */\n  body {\n    overscroll-behavior-y: contain;\n    overscroll-behavior-x: none;\n  }\n\n  /* Scroll containers */\n  [data-scroll-container] {\n    -webkit-overflow-scrolling: touch;\n    overscroll-behavior: contain;\n  }\n\n  /* Hide scrollbar but keep functionality */\n  .scrollbar-hide {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n\n  .scrollbar-hide::-webkit-scrollbar {\n    display: none;\n  }\n}\n/* ============================================\n   MOBILE-FIRST GRID SYSTEM\n   ============================================ */\n.mobile-grid {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: var(--spacing-base);\n}\n@media (min-width: 768px) {\n  .mobile-grid {\n    grid-template-columns: repeat(2, 1fr);\n    gap: var(--spacing-lg);\n  }\n}\n@media (min-width: 1024px) {\n  .mobile-grid {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n/* ============================================\n   MOBILE-FIRST FLEX UTILITIES\n   ============================================ */\n@media (max-width: 767px) {\n  .mobile-flex-col {\n    flex-direction: column;\n  }\n\n  .mobile-flex-wrap {\n    flex-wrap: wrap;\n  }\n\n  .mobile-justify-center {\n    justify-content: center;\n  }\n\n  .mobile-items-center {\n    align-items: center;\n  }\n\n  .mobile-w-full {\n    width: 100%;\n  }\n\n  .mobile-text-center {\n    text-align: center;\n  }\n}\n/* ============================================\n   PERFORMANCE OPTIMIZATIONS\n   ============================================ */\n/* GPU acceleration for animations */\n@media (max-width: 767px) {\n  .mobile-gpu-accelerate {\n    transform: translateZ(0);\n    will-change: transform;\n    backface-visibility: hidden;\n  }\n\n  /* Reduce animations on mobile for performance (sauf marquees landing) */\n  *:not(.lp-marquee-track):not(.lp-countries-marquee-track):not(.lp-currencies-marquee-track) {\n    animation-duration: 0.2s !important;\n    transition-duration: 0.2s !important;\n  }\n}\n/* Respect reduced motion */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n/**\n * Styles sidebar — thème clair (fond blanc)\n */\n.app-sidebar {\n  --sidebar-background: 0 0% 100%;\n}\n[data-sidebar='sidebar'] {\n  --sidebar-background: 0 0% 100%;\n  --sidebar-foreground: 220 40% 10%;\n  --sidebar-primary: 217 91% 60%;\n  --sidebar-primary-foreground: 0 0% 100%;\n  --sidebar-accent: 0 0% 96%;\n  --sidebar-accent-foreground: 0 0% 12%;\n  --sidebar-border: 0 0% 90%;\n  --sidebar-ring: 217 91% 60%;\n\n  --sidebar-text-color: hsl(220 40% 10%);\n  --sidebar-text-color-muted: hsl(220 10% 46%);\n  --sidebar-text-color-active: hsl(220 40% 10%);\n  --sidebar-bg: #ffffff;\n  --sidebar-bg-gradient: #ffffff;\n\n  background: #ffffff !important;\n  color: var(--sidebar-text-color) !important;\n  border-color: hsl(var(--sidebar-border)) !important;\n}\n[data-sidebar='sidebar'] [data-sidebar='group-label'],\n[data-sidebar='sidebar'] [data-sidebar='menu-button'],\n[data-sidebar='sidebar'] [data-sidebar='menu-button'] span {\n  color: var(--sidebar-text-color);\n}\n[data-sidebar='sidebar'] svg:not([class*='text-orange']):not([class*='text-red']) {\n  color: var(--sidebar-text-color);\n  stroke: currentColor;\n  flex-shrink: 0;\n  width: 1rem;\n  height: 1rem;\n  display: inline-block;\n}\n/* Mobile drawer — keep menu icons visible (avoid collapsed-rail bleed) */\n[data-sidebar='sidebar'][data-mobile='true'] [data-sidebar='menu-button'] svg {\n  display: inline-block !important;\n  visibility: visible !important;\n  opacity: 1 !important;\n  width: 1rem !important;\n  height: 1rem !important;\n  min-width: 1rem;\n  min-height: 1rem;\n  flex-shrink: 0;\n}\n/* Horizontal context mega-nav (Systeme.io style) */\n[data-testid='horizontal-context-nav'] [data-radix-collection-item] {\n  scroll-margin-top: 3rem;\n}\n[data-testid='horizontal-context-nav'] .scrollbar-hide {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n[data-testid='horizontal-context-nav'] .scrollbar-hide::-webkit-scrollbar {\n  display: none;\n}\n[data-sidebar='sidebar'] [data-sidebar='group-label'] {\n  color: var(--sidebar-text-color-muted) !important;\n}\n[data-sidebar='sidebar'] input {\n  color: hsl(var(--foreground)) !important;\n  background: hsl(var(--background)) !important;\n  border-color: hsl(var(--border)) !important;\n}\n[data-sidebar='sidebar'] input::-moz-placeholder {\n  color: hsl(var(--muted-foreground)) !important;\n}\n[data-sidebar='sidebar'] input::placeholder {\n  color: hsl(var(--muted-foreground)) !important;\n}\n[data-sidebar='sidebar'] [data-active='true'],\n[data-sidebar='sidebar'] [data-active='true'] *,\n[data-sidebar='sidebar'] [aria-current='page'],\n[data-sidebar='sidebar'] [aria-current='page'] * {\n  color: var(--sidebar-text-color-active) !important;\n}\n[data-sidebar='sidebar'] [data-sidebar='menu-button'][data-active='true'] {\n  background: hsl(var(--sidebar-accent)) !important;\n  font-weight: 600;\n  border-left: 2px solid hsl(var(--sidebar-primary));\n}\n[data-sidebar='sidebar'] [data-sidebar='menu-button']:hover {\n  background: hsl(var(--sidebar-accent)) !important;\n  color: hsl(var(--sidebar-accent-foreground)) !important;\n}\n[data-sidebar='sidebar'] a:hover,\n[data-sidebar='sidebar'] button:hover {\n  color: hsl(var(--sidebar-foreground)) !important;\n}\n[data-sidebar='sidebar'] img {\n  color: unset !important;\n  stroke: unset !important;\n  fill: unset !important;\n}\n.landing-premium.app-premium [data-sidebar='sidebar'] {\n  background: #ffffff !important;\n}\n.scrollbar-thin {\n  scrollbar-width: thin;\n  scrollbar-color: rgba(0, 0, 0, 0.15) transparent;\n}\n.scrollbar-thin::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n.scrollbar-thin::-webkit-scrollbar-track {\n  background: transparent;\n}\n.scrollbar-thin::-webkit-scrollbar-thumb {\n  background-color: rgba(0, 0, 0, 0.15);\n  border-radius: 3px;\n  -webkit-transition: background-color 0.2s ease;\n  transition: background-color 0.2s ease;\n}\n.scrollbar-thin::-webkit-scrollbar-thumb:hover {\n  background-color: rgba(0, 0, 0, 0.25);\n}\n[data-sidebar='sidebar'] *:focus-visible {\n  outline: 2px solid hsl(var(--sidebar-ring));\n  outline-offset: 2px;\n}\n[data-sidebar='sidebar'] {\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n}\n[data-sidebar='sidebar'] .app-sidebar-scroll {\n  flex: 1 1 auto;\n  min-height: 0;\n  overflow-x: hidden;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  scrollbar-gutter: stable;\n  -webkit-mask-image: linear-gradient(\n    to bottom,\n    transparent 0,\n    #000 10px,\n    #000 calc(100% - 12px),\n    transparent 100%\n  );\n          mask-image: linear-gradient(\n    to bottom,\n    transparent 0,\n    #000 10px,\n    #000 calc(100% - 12px),\n    transparent 100%\n  );\n}\n[data-sidebar='sidebar'] .app-sidebar-footer {\n  flex-shrink: 0;\n  margin-top: auto;\n  z-index: 2;\n}\n[data-sidebar='sidebar'] .app-sidebar-footer .lp-lang-switcher {\n  width: 100%;\n  justify-content: center;\n  border-radius: 0.5rem;\n}\n[data-sidebar='sidebar'] .app-sidebar-section-header {\n  border-left: 2px solid transparent;\n}\n[data-sidebar='sidebar'] .app-sidebar-section-header:hover,\n[data-sidebar='sidebar'] .app-sidebar-section-header[aria-expanded='true'] {\n  border-left-color: hsl(var(--sidebar-primary));\n  background: hsl(var(--sidebar-accent));\n}\n[data-sidebar='sidebar'] .app-sidebar-section-header[aria-expanded='true'] span {\n  color: hsl(var(--sidebar-foreground));\n}\n[data-sidebar='sidebar'] .app-sidebar-command-trigger:focus-visible {\n  outline: 2px solid hsl(var(--sidebar-ring));\n  outline-offset: 2px;\n}\n[data-sidebar='sidebar'] .app-sidebar-rail-separator {\n  flex-shrink: 0;\n}\n[data-sidebar='sidebar'] .app-sidebar-pinned-rail button:hover {\n  color: hsl(var(--sidebar-foreground));\n}\n:root {\n  --emarzona-brand-emar: #f97316;\n  --emarzona-brand-zona: #2563eb;\n}\n.emarzona-brand-name {\n  font-weight: inherit;\n  letter-spacing: inherit;\n  white-space: nowrap;\n}\n.emarzona-brand-emar {\n  color: var(--emarzona-brand-emar);\n  font-weight: inherit;\n}\n.emarzona-brand-zona {\n  color: var(--emarzona-brand-zona);\n  font-weight: inherit;\n}\n/* Pied de page landing : titres en gras, sous-éléments grisés */\n.landing-premium footer .lp-footer-col-title {\n  font-weight: 700;\n  color: 