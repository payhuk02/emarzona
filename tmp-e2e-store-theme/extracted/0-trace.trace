remium.app-premium main.flex-1.overflow-auto label {\n  font-weight: 400;\n  color: hsl(var(--foreground));\n}\n\n.landing-premium.app-premium #main-content .text-muted-foreground,\n.landing-premium.app-premium main.flex-1 .text-muted-foreground,\n.landing-premium.app-premium main.flex-1.overflow-auto .text-muted-foreground {\n  color: hsl(var(--muted-foreground)) !important;\n  font-weight: 400 !important;\n}\n\n/* Minimum lisible : remplace text-[8px]–text-[11px] */\n.landing-premium.app-premium #main-content [class*='text-[8px]'],\n.landing-premium.app-premium #main-content [class*='text-[9px]'],\n.landing-premium.app-premium #main-content [class*='text-[10px]'],\n.landing-premium.app-premium #main-content [class*='text-[11px]'],\n.landing-premium.app-premium main.flex-1 [class*='text-[8px]'],\n.landing-premium.app-premium main.flex-1 [class*='text-[9px]'],\n.landing-premium.app-premium main.flex-1 [class*='text-[10px]'],\n.landing-premium.app-premium main.flex-1 [class*='text-[11px]'],\n.landing-premium.app-premium main.flex-1.overflow-auto [class*='text-[8px]'],\n.landing-premium.app-premium main.flex-1.overflow-auto [class*='text-[9px]'],\n.landing-premium.app-premium main.flex-1.overflow-auto [class*='text-[10px]'],\n.landing-premium.app-premium main.flex-1.overflow-auto [class*='text-[11px]'] {\n  font-size: var(--app-font-caption) !important;\n  line-height: var(--app-line-normal) !important;\n}\n\n/* Classes sémantiques réutilisables */\n.landing-premium.app-premium .app-text-display {\n  font-family: var(--lp-serif);\n  font-size: var(--app-font-display);\n  font-weight: 700;\n  line-height: var(--app-line-tight);\n  letter-spacing: -0.02em;\n  color: #000;\n}\n\n.landing-premium.app-premium .app-text-title {\n  font-family: var(--lp-serif);\n  font-size: var(--app-font-h1);\n  font-weight: 700;\n  line-height: var(--app-line-tight);\n  color: #000;\n}\n\n.landing-premium.app-premium .app-text-section {\n  font-size: var(--app-font-h2);\n  font-weight: 600;\n  line-height: var(--app-line-tight);\n}\n\n.landing-premium.app-premium .app-text-body {\n  font-size: var(--app-font-body);\n  font-weight: 400;\n  line-height: var(--app-line-normal);\n}\n\n@media (min-width: 768px) {\n  .landing-premium.app-premium .app-text-body {\n    font-size: var(--app-font-body-lg);\n  }\n}\n\n.landing-premium.app-premium .app-text-caption {\n  font-size: var(--app-font-caption);\n  font-weight: 400;\n  line-height: var(--app-line-normal);\n  color: hsl(var(--muted-foreground));\n}\n\n.landing-premium.app-premium .app-text-stat {\n  font-size: clamp(1.25rem, 0.5vw + 1.1rem, 1.75rem);\n  font-weight: 700;\n  line-height: var(--app-line-tight);\n  font-variant-numeric: tabular-nums;\n}\n\n.landing-premium.app-premium .app-text-card-title {\n  font-size: var(--app-font-h3);\n  font-weight: 600;\n  line-height: var(--app-line-tight);\n}\n\n/* Boutons outline / ghost — poids medium */\n.landing-premium.app-premium\n  #main-content\n  button:not([class*='bg-primary']):not([class*='destructive']):not([class*='app-btn-premium']):not(\n    [class*='from-purple']\n  ):not([class*='to-pink']),\n.landing-premium.app-premium #main-content a:not([class*='bg-primary']) {\n  font-weight: 500;\n}\n"],["STYLE",{},"/* ✅ UTILITAIRES: Classes communes pour réduire la duplication */\n.dashboard-card-base {\n  border-color: hsl(var(--border) / 0.5);\n  background-color: hsl(var(--card) / 0.5);\n  --tw-backdrop-blur: blur(4px);\n  backdrop-filter: var(--tw-backdrop-blur) var(--tw-backdrop-brightness) var(--tw-backdrop-contrast) var(--tw-backdrop-grayscale) var(--tw-backdrop-hue-rotate) var(--tw-backdrop-invert) var(--tw-backdrop-opacity) var(--tw-backdrop-saturate) var(--tw-backdrop-sepia);\n}\n\n.dashboard-card-hover {\n  transition-property: all;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 300ms;\n  animation-duration: 300ms;\n}\n\n.dashboard-card-hover:hover {\n  --tw-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);\n  --tw-shadow-colored: 0 10px 15px -3px var(--tw-shadow-color), 0 4px 6px -4px var(--tw-shadow-color);\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\n}\n\n.dashboard-text-responsive {\n  font-size: 1rem;\n  line-height: 1.625rem;\n  letter-spacing: 0;\n  font-weight: 600;\n}\n\n@media (min-width: 768px) {\n  .dashboard-text-responsive {\n    font-size: 1.125rem;\n    line-height: 1.75rem;\n    letter-spacing: 0;\n  }\n}\n\n.dashboard-text-responsive-small {\n  font-size: 0.875rem;\n  line-height: 1.375rem;\n  letter-spacing: 0;\n  font-weight: 400;\n}\n\n@media (min-width: 768px) {\n  .dashboard-text-responsive-small {\n    font-size: 1rem;\n    line-height: 1.625rem;\n    letter-spacing: 0;\n  }\n}\n\n/* ——— Sections tableau de bord (séparation claire) ——— */\n.dashboard-section {\n  border-radius: 1rem;\n  border-width: 1px;\n  border-color: hsl(var(--border) / 0.6);\n  background-color: hsl(var(--card) / 0.8);\n  --tw-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);\n  --tw-shadow-colored: 0 1px 2px 0 var(--tw-shadow-color);\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\n  padding: 1rem;\n}\n@media (min-width: 640px) {\n  .dashboard-section {\n    padding: 1.25rem;\n  }\n}\n@media (min-width: 768px) {\n  .dashboard-section {\n    padding: 1.5rem;\n  }\n}\n@media (min-width: 1024px) {\n  .dashboard-section {\n    padding: 2rem;\n  }\n}\n\n.dashboard-section + .dashboard-section {\n  margin-top: 1.5rem;\n}\n\n@media (min-width: 640px) {\n  .dashboard-section + .dashboard-section {\n    margin-top: 2rem;\n  }\n}\n\n@media (min-width: 768px) {\n  .dashboard-section + .dashboard-section {\n    margin-top: 2.5rem;\n  }\n}\n\n.dashboard-section-header {\n  margin-bottom: 1rem;\n  border-bottom-width: 1px;\n  border-color: hsl(var(--border) / 0.5);\n  padding-bottom: 1rem;\n}\n\n@media (min-width: 640px) {\n  .dashboard-section-header {\n    margin-bottom: 1.25rem;\n  }\n}\n\n@media (min-width: 768px) {\n  .dashboard-section-header {\n    margin-bottom: 1.5rem;\n  }\n}\n\n.dashboard-section-title {\n  font-family: var(--lp-serif, Georgia, serif);\n  font-size: 1.125rem;\n  line-height: 1.75rem;\n  letter-spacing: 0;\n  font-weight: 700;\n  letter-spacing: -0.025em;\n  color: hsl(var(--foreground));\n}\n\n@media (min-width: 640px) {\n  .dashboard-section-title {\n    font-size: 1.25rem;\n    line-height: 1.75rem;\n    letter-spacing: 0;\n  }\n}\n\n@media (min-width: 768px) {\n  .dashboard-section-title {\n    font-size: 1.5rem;\n    line-height: 2rem;\n    letter-spacing: -0.01em;\n  }\n}\n\n.dashboard-section-title {\n  letter-spacing: -0.02em;\n}\n\n.dashboard-section-description {\n  margin-top: 0.375rem;\n  max-width: 48rem;\n  font-size: 0.875rem;\n  line-height: 1.375rem;\n  letter-spacing: 0;\n  font-weight: 400;\n  line-height: 1.625;\n  color: hsl(var(--muted-foreground));\n}\n\n@media (min-width: 640px) {\n  .dashboard-section-description {\n    margin-top: 0.5rem;\n  }\n}\n\n@media (min-width: 768px) {\n  .dashboard-section-description {\n    font-size: 1rem;\n    line-height: 1.625rem;\n    letter-spacing: 0;\n  }\n}\n\n@media (max-width: 360px) {\n\n    /* Padding réduit pour très petits écrans */\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n\n    .dashboard-section-body > * + * {\n      margin-top: 0.75rem;\n    }\n\n    /* Grilles adaptées */\n  }\n\n.dashboard-section-body > :not([hidden]) ~ :not([hidden]) {\n  --tw-space-y-reverse: 0;\n  margin-top: calc(1rem * calc(1 - var(--tw-space-y-reverse)));\n  margin-bottom: calc(1rem * var(--tw-space-y-reverse));\n}\n\n@media (min-width: 640px) {\n  .dashboard-section-body > :not([hidden]) ~ :not([hidden]) {\n    --tw-space-y-reverse: 0;\n    margin-top: calc(1.25rem * calc(1 - var(--t