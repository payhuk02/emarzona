a);\n  box-shadow: var(--shadow-soft);\n}\n\n.dashboard-main {\n  flex: 1 1 0%;\n  padding: 0.75rem;\n}\n\n@media (min-width: 640px) {\n  .dashboard-main {\n    padding: 1rem;\n  }\n}\n\n@media (min-width: 768px) {\n  .dashboard-main {\n    padding: 1.5rem;\n  }\n}\n\n@media (min-width: 1024px) {\n  .dashboard-main {\n    padding: 2rem;\n  }\n}\n\n.dashboard-main {\n  overflow-x: hidden;\n  background-color: hsl(var(--background));\n}\n\n/* Responsive Typography — échelle premium (min 12px) */\n.dashboard-title {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 1.5rem;\n  line-height: 2rem;\n  letter-spacing: -0.01em;\n  font-weight: 700;\n}\n@media (min-width: 768px) {\n  .dashboard-title {\n    font-size: 1.875rem;\n    line-height: 2.25rem;\n    letter-spacing: -0.01em;\n  }\n}\n@media (min-width: 1024px) {\n  .dashboard-title {\n    font-size: 2.25rem;\n    line-height: 2.5rem;\n    letter-spacing: -0.02em;\n  }\n}\n\n.dashboard-card-title {\n  font-size: 1rem;\n  line-height: 1.625rem;\n  letter-spacing: 0;\n  font-weight: 600;\n  color: hsl(var(--foreground));\n}\n\n@media (min-width: 768px) {\n  .dashboard-card-title {\n    font-size: 1.125rem;\n    line-height: 1.75rem;\n    letter-spacing: 0;\n  }\n}\n\n.dashboard-stat-value {\n  margin-bottom: 0.25rem;\n  font-size: 1.5rem;\n  line-height: 2rem;\n  letter-spacing: -0.01em;\n  font-weight: 700;\n  --tw-numeric-spacing: tabular-nums;\n  font-variant-numeric: var(--tw-ordinal) var(--tw-slashed-zero) var(--tw-numeric-figure) var(--tw-numeric-spacing) var(--tw-numeric-fraction);\n}\n\n@media (min-width: 768px) {\n  .dashboard-stat-value {\n    font-size: 1.875rem;\n    line-height: 2.25rem;\n    letter-spacing: -0.01em;\n  }\n}\n\n@media (min-width: 1024px) {\n  .dashboard-stat-value {\n    font-size: 2.25rem;\n    line-height: 2.5rem;\n    letter-spacing: -0.02em;\n  }\n}\n\n.dashboard-stat-description {\n  margin-bottom: 0.5rem;\n  font-size: 0.875rem;\n  line-height: 1.3