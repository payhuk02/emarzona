{"type":"frame-snapshot","snapshot":{"callId":"call@12","snapshotName":"after@call@12","pageId":"page@75e00394c7a29c8b14e752b3b0024d01","frameId":"frame@3ab07472595bf59bcbded2fcbd1fd723","frameUrl":"http://localhost:8080/login","doctype":"html","html":["HTML",{"lang":"fr"},["HEAD",{},["BASE",{"href":"http://localhost:8080/login"}],["STYLE",{},"\n/* Variables CSS critiques - Minimales pour FCP */\n:root {\n  --background: 0 0% 100%;\n  --foreground: 220 40% 10%;\n  --primary: 217 91% 60%;\n  --primary-foreground: 0 0% 100%;\n  --border: 0 0% 90%;\n  --radius: 0.5rem;\n}\n\n/* Reset minimal */\n*,::before,::after {\n  box-sizing: border-box;\n}\n\nhtml {\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\nbody {\n  font-family: system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;\n  font-size: 1rem;\n  line-height: 1.625;\n  margin: 0;\n  background-color: hsl(var(--background));\n  color: hsl(var(--foreground));\n  overflow-x: hidden;\n}\n\n#root {\n  min-height: 100vh;\n}\n\n/* Container minimal */\n.container {\n  width: 100%;\n  margin: 0 auto;\n  padding: 0 1rem;\n}\n\n/* Typographie critique */\nh1,h2,h3 {\n  font-weight: 600;\n  line-height: 1.2;\n  margin: 0;\n}\n\n/* Images critiques */\nimg {\n  max-width: 100%;\n  height: auto;\n  display: block;\n}\n\n/* Boutons critiques */\nbutton {\n  min-height: 44px;\n  min-width: 44px;\n  touch-action: manipulation;\n}\n\n/* Focus visible */\n*:focus-visible {\n  outline: 3px solid hsl(var(--primary));\n  outline-offset: 2px;\n}\n"],"\n    ","\n\n    ","\n\n    ",["META",{"charset":"utf-8"}],"\n    ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes, viewport-fit=cover"}],"\n    ",["META",{"name":"theme-color","content":"#08080a"}],"\n    ",["META",{"name":"mobile-web-app-capable","content":"yes"}],"\n    ",["META",{"name":"apple-mobile-web-app-capable","content":"yes"}],"\n    ",["META",{"name":"apple-mobile-web-app-status-bar-style","content":"black-translucent"}],"\n    \n    ","\n    ",["META",{"http-equiv":"x-dns-prefetch-control","content":"on"}],"\n    ",["META",{"name":"format-detection","content":"telephone=no"}],"\n    \n    ",["LINK",{"rel":"manifest","href":"/manifest.json"}],"\n\n    ","\n    ",["LINK",{"rel":"icon","type":"image/png","sizes":"32x32","href":"/icon-32x32.png","id":"favicon-default"}],"\n    ",["LINK",{"rel":"icon","type":"image/png","sizes":"192x192","href":"/icon-192x192.png"}],"\n    ",["LINK",{"rel":"apple-touch-icon","sizes":"180x180","href":"/apple-touch-icon.png"}],"\n    ",["META",{"name":"msapplication-TileColor","content":"#3b82f6"}],"\n    ",["META",{"name":"msapplication-TileImage","content":"/icons/icon-144x144.png"}],"\n\n    ",["TITLE",{},"Emarzona - Plateforme de ecommerce et marketing"],"\n    ",["META",{"name":"description","content":"Créez et gérez votre boutique en ligne avec Emarzona"}],"\n    ",["META",{"name":"author","content":"Emarzona"}],"\n    ",["LINK",{"rel":"canonical","href":"http://localhost:8080/login"}],"\n    ",["LINK",{"rel":"alternate","hreflang":"fr-FR","href":"https://www.emarzona.com/"}],"\n    ",["LINK",{"rel":"alternate","hreflang":"fr","href":"https://www.emarzona.com/"}],"\n    ",["LINK",{"rel":"alternate","hreflang":"x-default","href":"https://www.emarzona.com/"}],"\n    ",["LINK",{"rel":"alternate","hreflang":"en","href":"https://www.emarzona.com/?lang=en"}],"\n    ","\n\n    ","\n    ",["LINK",{"rel":"dns-prefetch","href":"https://fonts.googleapis.com"}],"\n    ",["LINK",{"rel":"dns-prefetch","href":"https://fonts.gstatic.com"}],"\n    ",["LINK",{"rel":"dns-prefetch","href":"https://www.googletagmanager.com"}],"\n    ",["LINK",{"rel":"dns-prefetch","href":"https://www.google-analytics.com"}],"\n    \n    ",["LINK",{"rel":"dns-prefetch","href":"https://images.unsplash.com"}],"\n    ",["LINK",{"rel":"preconnect","href":"https://fonts.googleapis.com"}],"\n    ",["LINK",{"rel":"preconnect","href":"https://fonts.gstatic.com","crossorigin":""}],"\n\n    ","\n    ",["LINK",{"rel":"preconnect","href":"https://hbdnzajbyjakdhuavrvb.supabase.co"}],"\n    ",["LINK",{"rel":"preconnect","href":"https://storage.googleapis.com"}],"\n    ",["LINK",{"rel":"preconnect","href":"https://api.moneroo.com"}],"\n\n    ","\n    ","\n    ","\n\n    ","\n",["META",{"property":"og:type","content":"website"}],"\n",["META",{"property":"og:site_name","content":"Emarzona"}],"\n",["META",{"property":"og:locale","content":"fr_FR"}],"\n\n\n",["META",{"property":"og:image","content":"https://www.emarzona.com/og-image.png"}],"\n",["META",{"property":"og:image:width","content":"1200"}],"\n",["META",{"property":"og:image:height","content":"630"}],"\n",["META",{"property":"og:image:alt","content":"Emarzona — Plateforme e-commerce premium pour l'Afrique et le monde"}],"\n",["META",{"property":"og:url","content":"https://www.emarzona.com/"}],"\n\n    ","\n    ",["META",{"name":"twitter:card","content":"summary_large_image"}],"\n    ",["META",{"name":"twitter:image","content":"https://www.emarzona.com/og-image.png"}],"\n    \n    \n    \n    \n    \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  \n  ",["META",{"property":"og:title","content":"Emarzona - Plateforme de ecommerce et marketing"}],"\n  ",["META",{"name":"twitter:title","content":"Emarzona - Plateforme de ecommerce et marketing"}],"\n  ",["META",{"property":"og:description","content":"Créez et gérez votre boutique en ligne avec Emarzona"}],"\n  ",["META",{"name":"twitter:description","content":"Créez et gérez votre boutique en ligne avec Emarzona"}],"\n\n",["STYLE",{},"/* Emarzona Premium Landing — design system haute gamme */\n/* Polices chargées à la demande depuis Landing.tsx (évite @import bloquant) */\n.landing-premium {\n  --lp-ink: #08080a;\n  --lp-ink-soft: #121218;\n  --lp-ink-muted: #1a1a22;\n  --lp-surface: #fafaf9;\n  --lp-surface-muted: #f4f3f0;\n  --lp-surface-elevated: #ffffff;\n  --lp-gold: #c9a227;\n  --lp-gold-bright: #e4c76a;\n  --lp-gold-deep: #9a7b1a;\n  --lp-cream: #f5f0e6;\n  --lp-text: #0f0f12;\n  --lp-text-muted: #5c5c66;\n  --lp-text-on-dark: #e8e6e1;\n  --lp-text-dim: #9a9890;\n  --lp-purple: #7c5cff;\n  --lp-blue: #2563eb;\n  --lp-blue-bright: #3b82f6;\n  --lp-blue-deep: #1d4ed8;\n  --lp-orange: #f97316;\n  --lp-orange-deep: #ea580c;\n  --lp-blue-glow: rgba(37, 99, 235, 0.35);\n  --lp-violet-glow: rgba(124, 92, 255, 0.35);\n  --lp-gold-glow: rgba(201, 162, 39, 0.25);\n  --lp-border: rgba(255, 255, 255, 0.08);\n  --lp-border-light: rgba(15, 15, 18, 0.08);\n  --lp-ease: cubic-bezier(0.22, 1, 0.36, 1);\n  --lp-serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;\n  --lp-sans: 'DM Sans', system-ui, sans-serif;\n  --lp-section-py: clamp(4rem, 8vw, 7rem);\n\n  font-family: var(--lp-sans);\n  color: var(--lp-text);\n  background: var(--lp-surface);\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  overflow-x: hidden;\n}\n/* Texture grain subtile — sections sombres */\n.landing-premium .lp-hero-grain {\n  opacity: 0.04;\n  background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\");\n}\n/* Hero — animations CSS (sans framer-motion sur le chemin critique) */\n@keyframes lp-hero-fade-up {\n  from {\n    opacity: 0;\n    transform: translateY(20px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n@keyframes lp-hero-scale-in {\n  from {\n    opacity: 0;\n    transform: scale(0.96);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n.landing-premium .lp-hero-animate {\n  animation: lp-hero-fade-up 0.75s var(--lp-ease) both;\n}\n.landing-premium .lp-hero-animate--delay-1 {\n  animation-delay: 0.08s;\n}\n.landing-premium .lp-hero-animate--delay-2 {\n  animation-delay: 0.16s;\n}\n.landing-premium .lp-hero-animate--delay-3 {\n  animation-delay: 0.24s;\n}\n.landing-premium .lp-hero-animate--delay-4 {\n  animation-delay: 0.4s;\n}\n.landing-premium .lp-hero-animate-scale {\n  animation: lp-hero-scale-in 1s var(--lp-ease) 0.2s both;\n}\n/* Hero — pas de mouvement à l'affichage */\n.landing-premium .lp-hero .lp-hero-animate,\n.landing-premium .lp-hero .lp-hero-animate-scale {\n  animation: none;\n  opacity: 1;\n  transform: none;\n}\n.landing-premium .lp-section-light {\n  background: var(--lp-surface-elevated);\n}\n.landing-premium .lp-section-muted {\n  background: var(--lp-surface-muted);\n}\n.landing-premium .lp-section-pad {\n  padding-top: var(--lp-section-py);\n  padding-bottom: var(--lp-section-py);\n}\n/* Eyebrow — libellés de section (landing uniquement) */\n.landing-premium:not(.marketplace-premium) .lp-eyebrow,\n.landing-premium:not(.marketplace-premium) .lp-eyebrow-light {\n  display: inline-flex;\n  align-items: center;\n  border-radius: 9999px;\n  border: 1px solid var(--lp-orange-deep);\n  background: var(--lp-orange);\n  padding: 0.375rem 0.875rem;\n  font-size: 0.625rem;\n  font-weight: 700;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: #fff;\n}\n@media (min-width: 640px) {\n  .landing-premium:not(.marketplace-premium) .lp-eyebrow,\n  .landing-premium:not(.marketplace-premium) .lp-eyebrow-light {\n    font-size: 0.75rem;\n  }\n}\n/* Légende hero — hors zone de clip */\n.landing-premium .lp-hero-caption {\n  width: 100%;\n  max-width: 20rem;\n  font-size: 0.6875rem;\n  font-weight: 500;\n  letter-spacing: 0.26em;\n  text-transform: uppercase;\n  color: rgba(255, 255, 255, 0.42);\n  line-height: 1.5;\n}\n@media (min-width: 640px) {\n  .landing-premium .lp-hero-caption {\n    font-size: 0.75rem;\n    letter-spacing: 0.28em;\n    max-width: none;\n  }\n}\n.landing-premium .lp-serif {\n  font-family: var(--lp-serif);\n  font-weight: 500;\n  letter-spacing: -0.02em;\n}\n.landing-premium .lp-gold-text {\n  color: var(--lp-blue);\n  font-weight: 700;\n}\n.landing-premium .lp-btn-primary,\n.landing-premium .lp-btn-gold {\n  background: linear-gradient(\n    135deg,\n    var(--lp-blue-bright) 0%,\n    var(--lp-blue) 55%,\n    var(--lp-blue-deep) 100%\n  );\n  color: #fff;\n  font-weight: 600;\n  border: none;\n  box-shadow:\n    0 4px 24px var(--lp-blue-glow),\n    inset 0 1px 0 rgba(255, 255, 255, 0.25);\n  transition:\n    transform 0.45s var(--lp-ease),\n    box-shadow 0.45s var(--lp-ease);\n}\n.landing-premium .lp-btn-primary:hover,\n.landing-premium .lp-btn-gold:hover {\n  transform: translateY(-2px);\n  box-shadow:\n    0 8px 32px var(--lp-blue-glow),\n    inset 0 1px 0 rgba(255, 255, 255, 0.3);\n}\n.landing-premium .lp-btn-outline {\n  background: transparent;\n  color: #fff;\n  border: 1px solid rgba(59, 130, 246, 0.55);\n  transition:\n    border-color 0.4s var(--lp-ease),\n    background 0.4s var(--lp-ease),\n    color 0.4s var(--lp-ease);\n}\n.landing-premium .lp-btn-outline:hover {\n  border-color: var(--lp-blue-bright);\n  background: rgba(37, 99, 235, 0.12);\n  color: #fff;\n}\n.landing-premium .lp-btn-outline-light {\n  background: transparent;\n  color: var(--lp-blue);\n  border: 1px solid rgba(37, 99, 235, 0.35);\n  font-weight: 500;\n  transition:\n    border-color 0.4s var(--lp-ease),\n    background 0.4s var(--lp-ease);\n}\n.landing-premium .lp-btn-outline-light:hover {\n  border-color: var(--lp-blue);\n  background: rgba(37, 99, 235, 0.06);\n}\n.landing-premium .lp-reveal {\n  opacity: 0;\n  transform: translateY(28px);\n  transition:\n    opacity 0.9s var(--lp-ease),\n    transform 0.9s var(--lp-ease);\n}\n.landing-premium .lp-reveal.is-visible {\n  opacity: 1;\n  transform: translateY(0);\n}\n/* Cartes premium */\n.landing-premium .lp-card {\n  border-radius: 1rem;\n  border: 1px solid var(--lp-border-light);\n  background: var(--lp-surface-elevated);\n  box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04);\n  transition:\n    transform 0.5s var(--lp-ease),\n    box-shadow 0.5s var(--lp-ease),\n    border-color 0.5s var(--lp-ease);\n}\n.landing-premium .lp-card:hover {\n  transform: translateY(-3px);\n  border-color: rgba(201, 162, 39, 0.15);\n  box-shadow:\n    0 24px 48px -24px rgba(0, 0, 0, 0.1),\n    0 0 0 1px rgba(201, 162, 39, 0.06);\n}\n/* Section « Cinq façons de vendre » — icônes premium (desktop) */\n@media (min-width: 1024px) {\n  .landing-premium .lp-sell-way-card {\n    align-items: center;\n    text-align: center;\n  }\n}\n.landing-premium .lp-sell-way-icon {\n  background: transparent;\n  border: none;\n  box-shadow: none;\n  color: var(--lp-text);\n  transition: transform 0.5s var(--lp-ease);\n}\n.landing-premium .lp-sell-way-card:hover .lp-sell-way-icon {\n  transform: translateY(-2px);\n}\n.landing-premium .lp-sell-way-icon__svg {\n  color: var(--lp-text);\n}\n@media (min-width: 1024px) {\n  .landing-premium .lp-sell-way-icon {\n    height: 3.5rem;\n    width: 3.5rem;\n    border-radius: 1rem;\n  }\n\n  .landing-premium .lp-sell-way-icon__svg {\n    height: 1.5rem;\n    width: 1.5rem;\n    stroke-width: 1.5;\n  }\n}\n.landing-premium .lp-feature-cell {\n  padding: 1.25rem;\n  border-radius: 0.875rem;\n  transition: background 0.4s var(--lp-ease);\n}\n.landing-premium .lp-feature-cell:hover {\n  background: rgba(245, 240, 230, 0.5);\n}\n.landing-premium .lp-feature-icon {\n  display: flex;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  background: transparent;\n  border: none;\n  box-shadow: none;\n  color: var(--lp-text);\n}\n.landing-premium .lp-pricing-dark {\n  border: 1px solid var(--lp-border-light);\n  background: linear-gradient(135deg, #0f0f12 0%, #15151c 50%, #1a1a24 100%);\n  color: #fff;\n  box-shadow: 0 28px 56px -32px rgba(15, 15, 18, 0.45);\n  transition:\n    transform 0.45s var(--lp-ease),\n    box-shadow 0.45s var(--lp-ease);\n}\n.landing-premium .lp-pricing-dark:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 32px 64px -28px rgba(15, 15, 18, 0.55);\n}\n.landing-premium .lp-pricing-dark--highlight {\n  border-color: rgba(201, 162, 39, 0.45);\n  box-shadow:\n    0 28px 56px -32px rgba(15, 15, 18, 0.45),\n    0 0 0 1px rgba(201, 162, 39, 0.2);\n}\n.landing-premium .lp-btn-outline-dark {\n  border: 1px solid rgba(255, 255, 255, 0.2);\n  background: transparent;\n  color: #fff;\n}\n.landing-premium .lp-btn-outline-dark:hover {\n  background: rgba(255, 255, 255, 0.08);\n}\n.landing-premium .lp-pricing-card {\n  border-radius: 1.25rem;\n  border: 1px solid var(--lp-border-light);\n  background: var(--lp-surface);\n  transition:\n    transform 0.45s var(--lp-ease),\n    box-shadow 0.45s var(--lp-ease);\n}\n.landing-premium .lp-pricing-card:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 20px 40px -28px rgba(0, 0, 0, 0.12);\n}\n.landing-premium .lp-pricing-card--highlight {\n  border-color: rgba(201, 162, 39, 0.35);\n  background: linear-gradient(180deg, var(--lp-cream) 0%, #fff 100%);\n  box-shadow: 0 24px 48px -24px rgba(201, 162, 39, 0.22);\n}\n.landing-premium .lp-pricing-section {\n  content-visibility: auto;\n  contain-intrinsic-size: auto 1200px;\n}\n.landing-premium .lp-pricing-commission {\n  box-shadow: 0 28px 56px -32px rgba(15, 15, 18, 0.45);\n}\n.landing-premium .lp-deferred-section {\n  content-visibility: auto;\n  contain-intrinsic-size: auto 480px;\n}\n/* Marquee boutiques */\n.landing-premium .lp-marquee-mask {\n  mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);\n  -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);\n}\n.landing-premium .lp-marquee-track {\n  --lp-marquee-duration: 60s;\n  animation: lp-marquee-scroll var(--lp-marquee-duration) linear infinite;\n  animation-duration: var(--lp-marquee-duration) !important;\n  animation-iteration-count: infinite !important;\n  will-change: transform;\n}\n.landing-premium .lp-marquee-item {\n  transition:\n    transform 0.5s var(--lp-ease),\n    box-shadow 0.5s var(--lp-ease);\n}\n.landing-premium .lp-marquee-item:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.12);\n}\n@keyframes lp-marquee-scroll {\n  0% {\n    transform: translateX(0);\n  }\n  100% {\n    transform: translateX(-50%);\n  }\n}\n/* Marquee pays & drapeaux */\n.landing-premium .lp-countries-section {\n  isolation: isolate;\n}\n.landing-premium .lp-countries-marquee-mask {\n  mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);\n  -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);\n}\n.landing-premium .lp-countries-marquee-track {\n  --lp-countries-duration: 280s;\n  animation: lp-countries-scroll var(--lp-countries-duration) linear infinite;\n  animation-duration: var(--lp-countries-duration) !important;\n  animation-iteration-count: infinite !important;\n  will-change: transform;\n}\n.landing-premium .lp-country-flag-wrap {\n  display: inline-flex;\n  flex-shrink: 0;\n  width: 2.5rem;\n  height: 1.75rem;\n  line-height: 0;\n  background: rgba(255, 255, 255, 0.06);\n}\n.landing-premium .lp-country-flag-img {\n  display: block;\n  flex-shrink: 0;\n  background-size: cover;\n  background-position: center;\n  background-repeat: no-repeat;\n  transform: translateZ(0);\n}\n@media (max-width: 768px) {\n  .landing-premium .lp-marquee-item img {\n    opacity: 1 !important;\n    max-width: none !important;\n    width: 2.5rem !important;\n    height: 2.5rem !important;\n    border-radius: 0.75rem;\n    -o-object-fit: cover;\n       object-fit: cover;\n  }\n\n  .landing-premium .lp-country-chip {\n    backdrop-filter: none;\n    -webkit-backdrop-filter: none;\n  }\n}\n.landing-premium .lp-countries-marquee-track--reverse {\n  animation-name: lp-countries-scroll-reverse;\n  --lp-countries-duration: 220s;\n  animation-duration: var(--lp-countries-duration) !important;\n  animation-iteration-count: infinite !important;\n}\n.landing-premium .lp-country-chip {\n  transition:\n    transform 0.45s var(--lp-ease),\n    border-color 0.45s var(--lp-ease),\n    background 0.45s var(--lp-ease),\n    box-shadow 0.45s var(--lp-ease);\n}\n.landing-premium .lp-country-chip:hover {\n  transform: translateY(-2px);\n  border-color: rgba(59, 130, 246, 0.35);\n  background: rgba(255, 255, 255, 0.08);\n  box-shadow: 0 8px 28px -8px rgba(37, 99, 235, 0.25);\n}\n@keyframes lp-countries-scroll {\n  0% {\n    transform: translateX(0);\n  }\n  100% {\n    transform: translateX(-50%);\n  }\n}\n@keyframes lp-countries-scroll-reverse {\n  0% {\n    transform: translateX(-50%);\n  }\n  100% {\n    transform: translateX(0);\n  }\n}\n@media (max-width: 768px) {\n  .landing-premium .lp-countries-marquee-track {\n    --lp-countries-duration: 12s;\n  }\n\n  .landing-premium .lp-countries-marquee-track--reverse {\n    --lp-countries-duration: 14s;\n  }\n}\n/* Marquee devises */\n.landing-premium .lp-currencies-section {\n  isolation: isolate;\n}\n.landing-premium .lp-currencies-marquee-mask {\n  mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);\n  -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);\n}\n.landing-premium .lp-currencies-marquee-track {\n  --lp-currencies-duration: 200s;\n  animation: lp-countries-scroll var(--lp-currencies-duration) linear infinite;\n  animation-duration: var(--lp-currencies-duration) !important;\n  animation-iteration-count: infinite !important;\n  will-change: transform;\n}\n.landing-premium .lp-currencies-marquee-track--reverse {\n  animation-name: lp-countries-scroll-reverse;\n  --lp-currencies-duration: 220s;\n  animation-duration: var(--lp-currencies-duration) !important;\n  animation-iteration-count: infinite !important;\n}\n.landing-premium .lp-currency-logo-wrap {\n  display: inline-flex;\n  flex-shrink: 0;\n  width: 2.25rem;\n  height: 2.25rem;\n  line-height: 0;\n}\n.landing-premium .lp-currency-logo-img {\n  display: block;\n  flex-shrink: 0;\n  background-size: cover;\n  background-position: center;\n  background-repeat: no-repeat;\n  transform: translateZ(0);\n}\n.landing-premium .lp-currency-chip {\n  transition:\n    transform 0.45s var(--lp-ease),\n    border-color 0.45s var(--lp-ease),\n    box-shadow 0.45s var(--lp-ease);\n}\n.landing-premium .lp-currency-chip:hover {\n  transform: translateY(-2px);\n  border-color: rgba(201, 162, 39, 0.35);\n  box-shadow: 0 8px 24px -8px rgba(201, 162, 39, 0.18);\n}\n@media (max-width: 768px) {\n  .landing-premium .lp-currencies-marquee-track {\n    --lp-currencies-duration: 11s;\n  }\n\n  .landing-premium .lp-currencies-marquee-track--reverse {\n    --lp-currencies-duration: 13s;\n  }\n\n  .landing-premium .lp-currencies-marquee-track {\n    animation: lp-countries-scroll var(--lp-currencies-duration) linear infinite !important;\n  }\n\n  .landing-premium .lp-currencies-marquee-track--reverse {\n    animation: lp-countries-scroll-reverse var(--lp-currencies-duration) linear infinite !important;\n  }\n\n  .landing-premium .lp-currency-logo-wrap {\n    width: 2.25rem;\n    height: 2.25rem;\n  }\n}\n.landing-premium .lp-adapt-visual {\n  order: -1;\n  width: 100%;\n  min-width: 0;\n}\n@media (min-width: 1024px) {\n  .landing-premium .lp-adapt-visual {\n    order: 0;\n  }\n}\n.landing-premium .lp-adapt-photo {\n  position: relative;\n  width: 100%;\n}\n.landing-premium .lp-adapt-photo__img,\n.landing-premium .lp-adapt-photo img {\n  display: block;\n  width: 100%;\n  height: auto;\n  -o-object-fit: contain;\n     object-fit: contain;\n  -o-object-position: center;\n     object-position: center;\n}\n/* Navbar premium */\n.landing-premium .lp-premium-nav {\n  isolation: isolate;\n  background: linear-gradient(180deg, rgba(14, 14, 18, 0.94) 0%, rgba(8, 8, 10, 0.9) 100%);\n  border-bottom: 1px solid rgba(255, 255, 255, 0.07);\n  box-shadow:\n    0 1px 0 rgba(255, 255, 255, 0.04) inset,\n    0 12px 40px -16px rgba(0, 0, 0, 0.65);\n  backdrop-filter: blur(20px) saturate(1.25);\n  -webkit-backdrop-filter: blur(20px) saturate(1.25);\n}\n.landing-premium .lp-premium-nav::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background:\n    radial-gradient(ellipse 55% 120% at 8% -20%, rgba(201, 162, 39, 0.12) 0%, transparent 55%),\n    radial-gradient(ellipse 45% 100% at 92% -30%, rgba(37, 99, 235, 0.14) 0%, transparent 50%);\n}\n.landing-premium .lp-premium-nav::after {\n  content: '';\n  position: absolute;\n  left: 0;\n  right: 0;\n  top: 0;\n  height: 1px;\n  pointer-events: none;\n  background: linear-gradient(\n    90deg,\n    transparent 0%,\n    rgba(201, 162, 39, 0.35) 22%,\n    rgba(96, 165, 250, 0.4) 50%,\n    rgba(201, 162, 39, 0.35) 78%,\n    transparent 100%\n  );\n  opacity: 0.85;\n}\n.landing-premium .lp-premium-nav__inner {\n  position: relative;\n  z-index: 1;\n}\n.landing-premium .lp-nav-menu {\n  padding-inline: 0.5rem;\n}\n.landing-premium .lp-nav-menu__pill {\n  flex-shrink: 1;\n}\n.landing-premium .lp-premium-nav__drawer {\n  background: linear-gradient(180deg, rgba(12, 12, 16, 0.98) 0%, rgba(8, 8, 10, 0.99) 100%);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n}\n.landing-premium .lp-nav-logo {\n  min-width: 0;\n}\n.landing-premium .lp-nav-logo img {\n  display: block;\n  height: 100%;\n  max-height: 2.5rem;\n  width: auto;\n  max-width: min(100%, 200px);\n  -o-object-fit: contain;\n     object-fit: contain;\n  -o-object-position: left center;\n     object-position: left center;\n}\n@media (min-width: 1024px) {\n  .landing-premium .lp-nav-logo img {\n    max-height: 2.75rem;\n    max-width: 220px;\n  }\n}\n.landing-premium .lp-nav-ghost {\n  font-size: 0.875rem;\n  font-weight: 500;\n  color: rgba(255, 255, 255, 0.72);\n  transition: color 0.3s var(--lp-ease);\n}\n.landing-premium .lp-nav-ghost:hover {\n  color: #fff;\n}\n.landing-premium .lp-nav-cta {\n  min-height: 2.5rem;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  line-height: 1;\n}\n.landing-premium .lp-nav-control .lp-lang-switcher {\n  height: 2.5rem;\n  min-height: 2.5rem;\n  border-radius: 9999px;\n  padding-left: 0.75rem;\n  padding-right: 0.75rem;\n}\n.landing-premium .lp-nav-icon-btn {\n  backdrop-filter: blur(8px);\n}\n.landing-premium .lp-footer-logo {\n  position: relative;\n  z-index: 30;\n  display: inline-flex;\n  max-width: 100%;\n}\n.landing-premium .lp-footer-logo-img {\n  display: block;\n  filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.55));\n}\n.landing-premium .lp-footer-newsletter input {\n  font-size: 16px;\n}\n@media (min-width: 640px) {\n  .landing-premium .lp-footer-newsletter input {\n    font-size: 0.875rem;\n  }\n}\n.landing-premium .lp-cta-globe {\n  isolation: isolate;\n  min-height: 280px;\n}\n.landing-premium .lp-cta-globe-halo {\n  background: radial-gradient(\n    circle,\n    rgba(59, 130, 246, 0.35) 0%,\n    rgba(37, 99, 235, 0.15) 45%,\n    transparent 70%\n  );\n}\n.landing-premium .lp-cta-globe-sphere {\n  border-radius: 50%;\n  overflow: hidden;\n  background: radial-gradient(circle at 32% 28%, #2563eb 0%, #1e3a5f 42%, #0a0a12 100%);\n  box-shadow:\n    0 0 0 2px rgba(96, 165, 250, 0.35),\n    0 0 48px rgba(59, 130, 246, 0.45),\n    0 16px 40px rgba(0, 0, 0, 0.5);\n}\n.landing-premium .lp-cta-globe__img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  mix-blend-mode: normal;\n  filter: contrast(1.12) saturate(1.2) brightness(1.08);\n  -o-object-fit: cover;\n     object-fit: cover;\n  -o-object-position: center;\n     object-position: center;\n}\n@media (max-width: 639px) {\n  .landing-premium .lp-cta-globe {\n    min-height: 300px;\n    padding: 0.5rem 0 1rem;\n  }\n\n  .landing-premium .lp-cta-globe-sphere {\n    height: 72%;\n    width: 72%;\n    min-height: 210px;\n    min-width: 210px;\n  }\n\n  .landing-premium .lp-cta-globe__img {\n    filter: contrast(1.18) saturate(1.28) brightness(1.12);\n  }\n\n  .landing-premium .lp-cta-globe-halo {\n    inset: 0;\n  }\n}\n.landing-premium .lp-cta-logo-panel {\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.04) 100%);\n  border: 1px solid rgba(255, 255, 255, 0.14);\n  border-radius: 1.25rem;\n  padding: clamp(1.25rem, 4vw, 2rem);\n  box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.55);\n}\n.landing-premium .lp-cta-logo-glow {\n  background: radial-gradient(\n    circle,\n    rgba(59, 130, 246, 0.28) 0%,\n    rgba(37, 99, 235, 0.14) 40%,\n    transparent 70%\n  );\n  animation: lp-cta-glow-pulse 5s ease-in-out infinite;\n}\n@keyframes lp-cta-glow-pulse {\n  0%,\n  100% {\n    opacity: 0.7;\n    transform: scale(0.95);\n  }\n  50% {\n    opacity: 1;\n    transform: scale(1.05);\n  }\n}\n.landing-premium .lp-lang-switcher:focus-visible {\n  outline: 2px solid rgba(201, 162, 39, 0.5);\n  outline-offset: 2px;\n}\n/* Badge machine à écrire — hero droit */\n.landing-premium .lp-hero-typewriter-badge {\n  position: relative;\n  z-index: 2;\n  display: block;\n  align-self: center;\n  width: 100%;\n  max-width: min(100%, 480px);\n  border-radius: 1rem;\n  border: 1px solid rgba(201, 162, 39, 0.45);\n  background: linear-gradient(\n    135deg,\n    rgba(201, 162, 39, 0.18) 0%,\n    rgba(124, 92, 255, 0.1) 55%,\n    rgba(8, 8, 10, 0.65) 100%\n  );\n  box-shadow:\n    0 0 0 1px rgba(255, 255, 255, 0.06) inset,\n    0 8px 24px -12px rgba(0, 0, 0, 0.55);\n  backdrop-filter: blur(10px);\n  font-size: 0.625rem;\n  font-weight: 600;\n  letter-spacing: 0.03em;\n  line-height: 1.45;\n  color: rgba(255, 255, 255, 0.92);\n}\n@media (min-width: 640px) {\n  .landing-premium .lp-hero-typewriter-badge {\n    max-width: min(100%, 540px);\n    font-size: 0.6875rem;\n  }\n}\n@media (min-width: 1024px) {\n  .landing-premium .lp-hero-typewriter-badge {\n    align-self: flex-start;\n    max-width: 100%;\n  }\n}\n.landing-premium .lp-hero-typewriter-badge__ghost {\n  display: block;\n  visibility: hidden;\n  padding: 0.5rem 1rem;\n  white-space: normal;\n  word-wrap: break-word;\n}\n.landing-premium .lp-hero-typewriter-badge__live {\n  position: absolute;\n  inset: 0;\n  padding: 0.5rem 1rem;\n  white-space: normal;\n  word-wrap: break-word;\n  overflow: hidden;\n}\n.landing-premium .lp-hero-typewriter-badge__cursor {\n  display: inline-block;\n  width: 1px;\n  height: 0.85em;\n  margin-left: 1px;\n  background: var(--lp-gold-bright);\n  animation: lp-typewriter-cursor 1s step-end infinite;\n  vertical-align: -0.05em;\n}\n@keyframes lp-typewriter-cursor {\n  0%,\n  100% {\n    opacity: 1;\n  }\n  50% {\n    opacity: 0;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .landing-premium .lp-hero-typewriter-badge__cursor {\n    display: none;\n  }\n}\n/* Hero carrousel premium */\n.landing-premium .lp-hero-carousel {\n  isolation: isolate;\n  width: 100%;\n  max-width: 100%;\n}\n.landing-premium .lp-hero-carousel__ambient {\n  background:\n    radial-gradient(ellipse 60% 50% at 55% 42%, rgba(124, 92, 255, 0.24) 0%, transparent 72%),\n    radial-gradient(ellipse 45% 38% at 52% 62%, rgba(201, 162, 39, 0.14) 0%, transparent 74%);\n  filter: blur(40px);\n}\n.landing-premium .lp-hero-carousel__stage {\n  position: relative;\n  overflow: hidden;\n  border-radius: 1.25rem;\n  aspect-ratio: 1024 / 561;\n  width: 100%;\n}\n@media (min-width: 1024px) {\n  .landing-premium .lp-hero-carousel__stage {\n    border-radius: 1.5rem;\n  }\n}\n.landing-premium .lp-hero-carousel__slide {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.landing-premium .lp-hero-carousel__slide--card {\n  background: linear-gradient(180deg, #fafaf9 0%, #f3f2ef 100%);\n}\n.landing-premium .lp-hero-carousel__picture {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  height: 100%;\n}\n.landing-premium .lp-hero-carousel__img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  -o-object-fit: contain;\n     object-fit: contain;\n  -o-object-position: center;\n     object-position: center;\n  filter: contrast(1.04) saturate(1.05);\n  backface-visibility: hidden;\n}\n.landing-premium .lp-hero-carousel__slide--transparent .lp-hero-carousel__img {\n  -o-object-position: center bottom;\n     object-position: center bottom;\n  filter: contrast(1.05) saturate(1.06);\n}\n.landing-premium .lp-hero-carousel__caption {\n  min-height: 2.75rem;\n}\n.landing-premium .lp-hero-carousel__progress {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  height: 2px;\n  transform-origin: left center;\n  background: linear-gradient(90deg, var(--lp-gold) 0%, var(--lp-purple) 100%);\n  opacity: 0.85;\n}\n@media (prefers-reduced-motion: reduce) {\n  .landing-premium .lp-hero-carousel__progress {\n    display: none;\n  }\n}\n@media (max-width: 379px) {\n  .landing-premium .lp-btn-primary,\n  .landing-premium .lp-btn-gold,\n  .landing-premium .lp-btn-outline,\n  .landing-premium .lp-btn-outline-light {\n    width: 100%;\n    justify-content: center;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .landing-premium .lp-hero-animate,\n  .landing-premium .lp-hero-animate-scale {\n    animation: none;\n    opacity: 1;\n    transform: none;\n  }\n\n  .landing-premium .lp-reveal {\n    opacity: 1;\n    transform: none;\n    transition: none;\n  }\n\n  .landing-premium .lp-marquee-track,\n  .landing-premium .lp-countries-marquee-track,\n  .landing-premium .lp-currencies-marquee-track {\n    animation: none;\n  }\n\n  .landing-premium .lp-compass-glow {\n    animation: none;\n  }\n\n  .landing-premium .lp-cta-logo-glow {\n    animation: none;\n  }\n\n  .landing-premium .lp-card:hover,\n  .landing-premium .lp-pricing-card:hover {\n    transform: none;\n  }\n}\n"],["STYLE",{},"/**\n * Thème application — aligné sur landing-premium\n * Ancêtre requis : .landing-premium.app-premium\n */\n\n.landing-premium.app-premium {\n  /* Tokens shadcn alignés sur le landing */\n  --background: 40 9% 98%;\n  --foreground: 240 6% 7%;\n  --card: 0 0% 100%;\n  --card-foreground: 240 6% 7%;\n  --popover: 0 0% 100%;\n  --popover-foreground: 240 6% 7%;\n  --primary: 217 91% 53%;\n  --primary-foreground: 0 0% 100%;\n  --secondary: 40 6% 94%;\n  --secondary-foreground: 240 6% 12%;\n  --muted: 40 6% 96%;\n  --muted-foreground: 240 4% 40%;\n  --accent: 217 91% 53%;\n  --accent-foreground: 0 0% 100%;\n  --border: 240 6% 90%;\n  --input: 240 6% 90%;\n  --ring: 217 91% 53%;\n  --radius: 0.75rem;\n\n  --sidebar-background: 0 0% 100%;\n  --sidebar-foreground: 240 6% 7%;\n  --sidebar-primary: 217 91% 58%;\n  --sidebar-primary-foreground: 0 0% 100%;\n  --sidebar-accent: 40 6% 96%;\n  --sidebar-accent-foreground: 240 6% 12%;\n  --sidebar-border: 240 6% 90%;\n  --sidebar-ring: 217 91% 58%;\n}\n\n/* Sidebar — fond blanc aligné sur sidebar-optimized */\n.landing-premium.app-premium [data-sidebar='sidebar'] {\n  background: #ffffff !important;\n  border-color: hsl(var(--sidebar-border)) !important;\n  color: hsl(var(--sidebar-foreground)) !important;\n}\n\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='header'],\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='footer'],\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='content'],\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='group'],\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='group-content'] {\n  color: hsl(var(--sidebar-foreground)) !important;\n  border-color: hsl(var(--sidebar-border));\n}\n\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='group-label'] {\n  color: hsl(var(--muted-foreground)) !important;\n  font-size: 0.625rem;\n  font-weight: 700;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n}\n\n.landing-premium.app-premium\n  [data-sidebar='sidebar']\n  [data-sidebar='menu-button'][data-active='true'],\n.landing-premium.app-premium\n  [data-sidebar='sidebar']\n  [data-sidebar='menu-button'][data-active='true']\n  span,\n.landing-premium.app-premium\n  [data-sidebar='sidebar']\n  [data-sidebar='menu-button'][data-active='true']\n  svg {\n  background: hsl(var(--sidebar-accent)) !important;\n  color: hsl(var(--sidebar-foreground)) !important;\n  font-weight: 600;\n}\n\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='menu-button']:hover,\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='menu-button']:hover span,\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='menu-button']:hover svg {\n  background: hsl(var(--sidebar-accent)) !important;\n  color: hsl(var(--sidebar-foreground)) !important;\n}\n\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='input'] {\n  background: hsl(var(--background));\n  border-color: hsl(var(--border));\n  color: hsl(var(--foreground)) !important;\n}\n\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='input']::-moz-placeholder {\n  color: hsl(var(--muted-foreground)) !important;\n}\n\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='input']::placeholder {\n  color: hsl(var(--muted-foreground)) !important;\n}\n\n/* Barre supérieure dashboard */\n.landing-premium.app-premium .app-premium-topnav {\n  background: linear-gradient(\n    180deg,\n    rgba(14, 14, 18, 0.97) 0%,\n    rgba(8, 8, 10, 0.95) 100%\n  ) !important;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;\n  box-shadow: 0 12px 40px -16px rgba(0, 0, 0, 0.5);\n  backdrop-filter: blur(16px);\n}\n\n.landing-premium.app-premium .app-premium-topnav a,\n.landing-premium.app-premium .app-premium-topnav button:not(.lp-btn-primary) {\n  color: rgba(255, 255, 255, 0.82);\n}\n\n.landing-premium.app-premium .app-premium-topnav a:hover {\n  color: #fff;\n}\n\n.landing-premium.app-premium .app-premium-topnav .topnav-brand,\n.landing-premium.app-premium .app-premium-topnav .topnav-brand span {\n  color: #fff !important;\n}\n\n.landing-premium.app-premium .app-premium-topnav .text-primary,\n.landing-premium.app-premium .app-premium-topnav [class*='text-primary'] {\n  color: var(--lp-gold-bright) !important;\n}\n\n/* Boutons icône topnav (notifications, thème) — pas de fond blanc du Select */\n.landing-premium.app-premium .app-premium-topnav .topnav-icon-btn {\n  background: transparent !important;\n  border: none !important;\n  box-shadow: none !important;\n  color: rgba(255, 255, 255, 0.75) !important;\n}\n\n.landing-premium.app-premium .app-premium-topnav .topnav-icon-btn:hover,\n.landing-premium.app-premium .app-premium-topnav .topnav-icon-btn[data-state='open'] {\n  background: rgba(255, 255, 255, 0.1) !important;\n  color: #fff !important;\n}\n\n/* Fallback : tout Select/combobox résiduel dans la topnav */\n.landing-premium.app-premium .app-premium-topnav button[role='combobox'] {\n  background: transparent !important;\n  border-color: transparent !important;\n  box-shadow: none !important;\n  color: rgba(255, 255, 255, 0.75) !important;\n  min-height: 2.25rem;\n  height: 2.25rem;\n  width: auto;\n}\n\n.landing-premium.app-premium .app-premium-topnav .topnav-loyalty-badge {\n  border-color: rgba(251, 191, 36, 0.35) !important;\n  color: #fde68a !important;\n  background: rgba(251, 191, 36, 0.12) !important;\n}\n\n.landing-premium.app-premium .app-premium-topnav .topnav-main-link {\n  max-height: 2.25rem;\n}\n\n.landing-premium.app-premium .app-premium-topnav .topnav-main-link.bg-primary {\n  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);\n}\n\n/* Sidebar contextuelle — fond blanc (aligné AppSidebar) */\n.landing-premium.app-premium .app-context-sidebar {\n  background: #ffffff !important;\n  border-color: hsl(var(--border)) !important;\n  color: hsl(var(--foreground)) !important;\n}\n\n.landing-premium.app-premium .app-context-sidebar input {\n  background: hsl(var(--background)) !important;\n  border-color: hsl(var(--border)) !important;\n  color: hsl(var(--foreground)) !important;\n}\n\n.landing-premium.app-premium .app-context-sidebar input::-moz-placeholder {\n  color: hsl(var(--muted-foreground)) !important;\n}\n\n.landing-premium.app-premium .app-context-sidebar input::placeholder {\n  color: hsl(var(--muted-foreground)) !important;\n}\n\n.landing-premium.app-premium .app-context-sidebar .overflow-x-auto,\n.landing-premium.app-premium .app-context-sidebar nav[aria-label='Breadcrumb'] {\n  scrollbar-width: none;\n}\n\n.landing-premium.app-premium .app-context-sidebar .overflow-x-auto::-webkit-scrollbar,\n.landing-premium.app-premium .app-context-sidebar nav[aria-label='Breadcrumb']::-webkit-scrollbar {\n  display: none;\n}\n\n/* Zone principale */\n.landing-premium.app-premium #main-content,\n.landing-premium.app-premium main.flex-1.overflow-auto,\n.landing-premium.app-premium main.flex-1.flex-col,\n.landing-premium.app-premium main.flex-1 {\n  background: var(--lp-surface) !important;\n}\n\n/* Cartes dashboard / admin */\n.landing-premium.app-premium .bg-card.rounded-lg,\n.landing-premium.app-premium .rounded-lg.border.bg-card,\n.landing-premium.app-premium [class*='Card']:not([class*='card-']) {\n  /* évite sur-sélecteur — cible Card shadcn */\n}\n\n.landing-premium.app-premium .rounded-lg.border.bg-card,\n.landing-premium.app-premium div.bg-card {\n  border-radius: 1rem;\n  border-color: var(--lp-border-light) !important;\n  background: var(--lp-surface-elevated) !important;\n  box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04);\n  transition:\n    transform 0.45s var(--lp-ease),\n    box-shadow 0.45s var(--lp-ease);\n}\n\n.landing-premium.app-premium .rounded-lg.border.bg-card:hover {\n  box-shadow: 0 16px 40px -20px rgba(0, 0, 0, 0.1);\n}\n\n/* Titres de page — noir gras (plus de dégradé violet/rose / magenta) */\n.landing-premium.app-premium #main-content h1,\n.landing-premium.app-premium #main-content h2,\n.landing-premium.app-premium #main-content h3,\n.landing-premium.app-premium #main-content h4,\n.landing-premium.app-premium #main-content .app-premium-page-title,\n.landing-premium.app-premium main.flex-1 h1,\n.landing-premium.app-premium main.flex-1 h2,\n.landing-premium.app-premium main.flex-1 h3,\n.landing-premium.app-premium main.flex-1.overflow-auto h1,\n.landing-premium.app-premium main.flex-1.overflow-auto h2,\n.landing-premium.app-premium main.flex-1.overflow-auto h3 {\n  font-family: var(--lp-serif);\n  font-weight: 700 !important;\n  letter-spacing: -0.02em;\n  color: #000 !important;\n  -webkit-text-fill-color: #000 !important;\n  background: none !important;\n  background-image: none !important;\n}\n\n.landing-premium.app-premium #main-content [class*='bg-clip-text'],\n.landing-premium.app-premium main.flex-1 [class*='bg-clip-text'],\n.landing-premium.app-premium main.flex-1.overflow-auto [class*='bg-clip-text'] {\n  background: none !important;\n  background-image: none !important;\n  -webkit-background-clip: unset !important;\n  background-clip: unset !important;\n  -webkit-text-fill-color: #000 !important;\n  color: #000 !important;\n  font-weight: 700 !important;\n}\n\n/* Hiérarchie texte : voir app-typography.css (poids/tailles par rôle) */\n\n/* Icônes : voir app-ui-overrides.css (scope #main-content + main.flex-1) */\n\n/* Badges / boutons primaires — conserver le contraste */\n.landing-premium.app-premium #main-content .bg-primary,\n.landing-premium.app-premium #main-content .bg-destructive,\n.landing-premium.app-premium #main-content [class*='text-primary-foreground'] {\n  color: inherit;\n  font-weight: inherit;\n}\n\n/* Filtres type produit — style neutre */\n.landing-premium.app-premium #main-content button[class*='bg-'][class*='500/10'],\n.landing-premium.app-premium #main-content button[class*='border-'][class*='500'] {\n  background: transparent !important;\n  border-color: rgba(0, 0, 0, 0.2) !important;\n  color: #000 !important;\n  font-weight: 700 !important;\n}\n\n/* Sélecteur de langue sidebar — style landing navbar */\n.landing-premium.app-premium [data-sidebar='sidebar'] .app-sidebar-lang-switcher {\n  width: 100%;\n}\n\n.landing-premium.app-premium [data-sidebar='sidebar'] .app-sidebar-lang-switcher .lp-lang-switcher {\n  width: 100%;\n  justify-content: center;\n  border-radius: 0.5rem;\n}\n\n/* État actif premium — barre dorée */\n.landing-premium.app-premium [data-sidebar='sidebar'] [aria-current='page'] {\n  border-left-width: 3px !important;\n  border-left-color: hsl(var(--sidebar-primary)) !important;\n  background: hsl(var(--sidebar-accent)) !important;\n}\n\n/* Boutons primaires globaux */\n.landing-premium.app-premium\n  .bg-primary.text-primary-foreground:not(.lp-btn-outline):not([data-sidebar]):not(\n    .app-premium-auth-submit\n  ) {\n  background: linear-gradient(\n    135deg,\n    var(--lp-blue-bright) 0%,\n    var(--lp-blue) 55%,\n    var(--lp-blue-deep) 100%\n  ) !important;\n  border: none;\n  box-shadow: 0 4px 20px var(--lp-blue-glow);\n}\n\n.landing-premium.app-premium\n  .bg-primary.text-primary-foreground:hover:not(.app-premium-auth-submit) {\n  filter: brightness(1.05);\n}\n\n/* Admin sidebar */\n.landing-premium.app-premium .app-premium-admin-aside {\n  background: linear-gradient(180deg, var(--lp-ink-soft) 0%, var(--lp-ink) 100%) !important;\n  border-color: rgba(255, 255, 255, 0.08) !important;\n  color: #fff !important;\n}\n\n.landing-premium.app-premium .app-premium-admin-aside h2,\n.landing-premium.app-premium .app-premium-admin-aside h3,\n.landing-premium.app-premium .app-premium-admin-aside button,\n.landing-premium.app-premium .app-premium-admin-aside span,\n.landing-premium.app-premium .app-premium-admin-aside a,\n.landing-premium.app-premium .app-premium-admin-aside svg {\n  color: #fff !important;\n}\n\n.landing-premium.app-premium .app-premium-admin-aside h2 {\n  font-family: var(--lp-serif);\n}\n\n.landing-premium.app-premium .app-premium-admin-aside .bg-primary {\n  background: rgba(37, 99, 235, 0.28) !important;\n  color: #fff !important;\n}\n\n.landing-premium.app-premium .app-premium-admin-aside .text-muted-foreground {\n  color: rgba(255, 255, 255, 0.7) !important;\n}\n\n/* Sidebars contextuelles legacy (fixed) — fond blanc */\n.landing-premium.app-premium aside.fixed.app-context-sidebar:not(.bottom-0),\n.landing-premium.app-premium aside.app-context-sidebar:not(.bottom-0) {\n  background: #ffffff !important;\n  border-color: hsl(var(--border)) !important;\n  color: hsl(var(--foreground)) !important;\n}\n\n/* Auth */\n.landing-premium.app-premium .app-premium-auth {\n  min-height: 100vh;\n  background: var(--lp-ink);\n  position: relative;\n}\n\n.landing-premium.app-premium .app-premium-auth-layout {\n  position: relative;\n  z-index: 1;\n}\n\n.landing-premium.app-premium .app-premium-auth-form {\n  position: relative;\n  min-height: 100vh;\n  background: linear-gradient(165deg, #0c1a2e 0%, var(--lp-ink) 42%, #050506 100%);\n  isolation: isolate;\n}\n\n.landing-premium.app-premium .app-premium-auth-form::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background:\n    radial-gradient(ellipse 70% 55% at 85% 15%, rgba(124, 92, 255, 0.14) 0%, transparent 55%),\n    radial-gradient(ellipse 50% 45% at 10% 85%, rgba(201, 162, 39, 0.1) 0%, transparent 50%),\n    radial-gradient(ellipse 40% 35% at 50% 50%, rgba(37, 99, 235, 0.06) 0%, transparent 60%);\n}\n\n.landing-premium.app-premium .app-premium-auth-form::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  opacity: 0.035;\n  background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\");\n}\n\n.landing-premium.app-premium .app-premium-auth-inner {\n  position: relative;\n  z-index: 1;\n  animation: app-premium-auth-card-in 0.85s var(--lp-ease) both;\n  animation-delay: 0.08s;\n}\n\n@keyframes app-premium-auth-card-in {\n  from {\n    opacity: 0;\n    transform: translateY(18px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.landing-premium.app-premium .app-premium-auth-brand {\n  animation: app-premium-auth-card-in 0.75s var(--lp-ease) both;\n}\n\n.landing-premium.app-premium .app-premium-auth-brand .emarzona-brand-name {\n  font-family: var(--lp-serif);\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.25));\n}\n\n.landing-premium.app-premium .app-premium-auth-lang button {\n  border-color: rgba(255, 255, 255, 0.14) !important;\n  background: rgba(255, 255, 255, 0.06) !important;\n  color: var(--lp-text-on-dark) !important;\n  backdrop-filter: blur(12px);\n  box-shadow: 0 4px 16px -8px rgba(0, 0, 0, 0.4);\n  transition:\n    background 0.35s var(--lp-ease),\n    border-color 0.35s var(--lp-ease);\n}\n\n.landing-premium.app-premium .app-premium-auth-lang button:hover {\n  background: rgba(255, 255, 255, 0.1) !important;\n  border-color: rgba(201, 162, 39, 0.35) !important;\n}\n\n.landing-premium.app-premium .app-premium-auth-card {\n  position: relative;\n  z-index: 1;\n  overflow: hidden;\n  border-radius: 1.5rem;\n  border: 1px solid rgba(255, 255, 255, 0.14);\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.99) 0%, rgba(252, 251, 249, 0.98) 100%);\n  box-shadow:\n    0 0 0 1px rgba(201, 162, 39, 0.07),\n    0 32px 64px -28px rgba(0, 0, 0, 0.6),\n    0 0 100px -30px rgba(201, 162, 39, 0.15);\n  animation: app-premium-auth-card-in 0.8s var(--lp-ease) both;\n  animation-delay: 0.12s;\n}\n\n.landing-premium.app-premium .app-premium-auth-card::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 10%;\n  right: 10%;\n  height: 2px;\n  border-radius: 2px;\n  background: linear-gradient(\n    90deg,\n    transparent 0%,\n    var(--lp-gold-bright) 25%,\n    var(--lp-gold) 50%,\n    var(--lp-gold-bright) 75%,\n    transparent 100%\n  );\n  opacity: 0.85;\n}\n\n.landing-premium.app-premium .app-premium-auth-title {\n  font-size: clamp(1.75rem, 4vw, 2.125rem) !important;\n  letter-spacing: -0.03em !important;\n  line-height: 1.15 !important;\n}\n\n.landing-premium.app-premium .app-premium-auth-subtitle {\n  color: var(--lp-text-muted) !important;\n  font-size: 0.9375rem;\n  line-height: 1.55;\n  max-width: 28ch;\n}\n\n.landing-premium.app-premium .app-premium-auth-tabs-list {\n  width: 100%;\n  height: auto;\n  min-height: 3rem;\n  padding: 0.3rem;\n  border-radius: 0.875rem;\n  background: rgba(15, 15, 18, 0.04);\n  border: 1px solid rgba(15, 15, 18, 0.07);\n  gap: 0.3rem;\n}\n\n.landing-premium.app-premium .app-premium-auth-tab {\n  flex: 1;\n  border-radius: 0.625rem;\n  font-weight: 600;\n  font-size: 0.875rem;\n  letter-spacing: 0.015em;\n  color: var(--lp-text-muted);\n  transition:\n    color 0.35s var(--lp-ease),\n    background 0.35s var(--lp-ease),\n    box-shadow 0.35s var(--lp-ease);\n}\n\n.landing-premium.app-premium .app-premium-auth-tab[data-state='active'] {\n  background: #fff;\n  color: var(--lp-text);\n  box-shadow:\n    0 2px 14px -4px rgba(0, 0, 0, 0.14),\n    0 0 0 1px rgba(201, 162, 39, 0.18);\n}\n\n.landing-premium.app-premium\n  .app-premium-auth-card\n  input:not([type='checkbox']):not([type='radio']),\n.landing-premium.app-premium .app-premium-auth-card textarea {\n  background: rgba(250, 249, 247, 0.9);\n  border-color: rgba(15, 15, 18, 0.1);\n  font-size: 0.9375rem;\n  transition:\n    border-color 0.3s var(--lp-ease),\n    box-shadow 0.3s var(--lp-ease),\n    background 0.3s var(--lp-ease);\n}\n\n.landing-premium.app-premium .app-premium-auth-card input:focus,\n.landing-premium.app-premium .app-premium-auth-card textarea:focus {\n  border-color: rgba(201, 162, 39, 0.5);\n  background: #fff;\n  box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.14);\n}\n\n.landing-premium.app-premium .app-premium-auth-card label {\n  font-weight: 500;\n  letter-spacing: 0.01em;\n  color: var(--lp-text);\n}\n\n.landing-premium.app-premium #main-content .app-premium-auth-submit,\n.landing-premium.app-premium #main-content .app-premium-auth-submit.bg-primary {\n  border: none;\n  border-radius: 0.875rem;\n  font-weight: 600;\n  letter-spacing: 0.02em;\n  color: #fff !important;\n  background: linear-gradient(\n    135deg,\n    #fb923c 0%,\n    var(--lp-orange) 48%,\n    var(--lp-orange-deep) 100%\n  ) !important;\n  box-shadow:\n    0 4px 22px rgba(249, 115, 22, 0.38),\n    inset 0 1px 0 rgba(255, 255, 255, 0.2) !important;\n  transition:\n    transform 0.35s var(--lp-ease),\n    box-shadow 0.35s var(--lp-ease);\n}\n\n.landing-premium.app-premium #main-content .app-premium-auth-submit:hover:not(:disabled),\n.landing-premium.app-premium\n  #main-content\n  .app-premium-auth-submit.bg-primary:hover:not(:disabled) {\n  transform: translateY(-1px);\n  filter: none;\n  background: linear-gradient(\n    135deg,\n    #fdba74 0%,\n    var(--lp-orange) 48%,\n    var(--lp-orange-deep) 100%\n  ) !important;\n  box-shadow:\n    0 8px 32px rgba(249, 115, 22, 0.45),\n    0 0 0 1px rgba(201, 162, 39, 0.2),\n    inset 0 1px 0 rgba(255, 255, 255, 0.24) !important;\n}\n\n.landing-premium.app-premium .app-premium-auth-submit:active:not(:disabled) {\n  transform: translateY(0);\n}\n\n.landing-premium.app-premium .app-premium-auth-trust {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 0.65rem 1rem;\n  margin-top: 1.25rem;\n  padding: 1rem 1.125rem;\n  border-radius: 1rem;\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  background: rgba(255, 255, 255, 0.04);\n  backdrop-filter: blur(10px);\n  animation: app-premium-auth-card-in 0.8s var(--lp-ease) both;\n  animation-delay: 0.2s;\n}\n\n.landing-premium.app-premium .app-premium-auth-trust-item {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  font-size: 0.75rem;\n  font-weight: 500;\n  letter-spacing: 0.01em;\n  color: rgba(232, 230, 225, 0.72);\n}\n\n.landing-premium.app-premium .app-premium-auth-trust-item svg {\n  color: var(--lp-gold-bright);\n  flex-shrink: 0;\n  opacity: 0.95;\n}\n\n.landing-premium.app-premium .app-premium-auth-terms {\n  color: rgba(232, 230, 225, 0.5) !important;\n  line-height: 1.5;\n}\n\n.landing-premium.app-premium .app-premium-auth-terms-link {\n  color: rgba(232, 230, 225, 0.78);\n  text-decoration: underline;\n  text-underline-offset: 2px;\n  transition: color 0.25s var(--lp-ease);\n}\n\n.landing-premium.app-premium .app-premium-auth-terms-link:hover {\n  color: var(--lp-gold-bright);\n}\n\n.landing-premium.app-premium .app-premium-auth-password-wrap {\n  position: relative;\n}\n\n.landing-premium.app-premium .app-premium-auth-password-toggle {\n  position: absolute;\n  top: 0;\n  right: 0;\n  bottom: 0;\n  width: 2.75rem;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin: 0;\n  padding: 0;\n  border: none;\n  background: transparent;\n  color: hsl(var(--muted-foreground));\n  cursor: pointer;\n  -webkit-tap-highlight-color: transparent;\n  touch-action: manipulation;\n  transform: none;\n  flex-shrink: 0;\n}\n\n.landing-premium.app-premium .app-premium-auth-password-toggle:hover {\n  color: hsl(var(--foreground));\n}\n\n.landing-premium.app-premium .app-premium-auth-password-toggle:active {\n  transform: none;\n}\n\n.landing-premium.app-premium .app-premium-auth-password-toggle-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 1.25rem;\n  height: 1.25rem;\n  flex-shrink: 0;\n  pointer-events: none;\n}\n\n.landing-premium.app-premium .app-premium-auth-password-toggle-icon svg {\n  width: 1.25rem;\n  height: 1.25rem;\n  flex-shrink: 0;\n}\n\n.landing-premium.app-premium .app-premium-auth-card button[type='button'].text-primary {\n  font-weight: 500;\n  transition: color 0.25s var(--lp-ease);\n}\n\n.landing-premium.app-premium .app-premium-auth-card button[type='button'].text-primary:hover {\n  color: var(--lp-gold-deep);\n}\n\n.landing-premium.app-premium .app-premium-auth-hero {\n  position: relative;\n  min-height: 100vh;\n  overflow: hidden;\n  background: #0a1628;\n}\n\n.landing-premium.app-premium .app-premium-auth-hero-picture {\n  display: block;\n  width: 100%;\n  height: 100%;\n  min-height: 100vh;\n  overflow: hidden;\n}\n\n.landing-premium.app-premium .app-premium-auth-hero-img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  min-height: 100vh;\n  -o-object-fit: cover;\n     object-fit: cover;\n  /* Centré : texte marketing à gauche + dame à droite visibles */\n  -o-object-position: 50% 44%;\n     object-position: 50% 44%;\n  transform: translateZ(0);\n  filter: contrast(1.03) saturate(1.04);\n  backface-visibility: hidden;\n  -webkit-font-smoothing: antialiased;\n  image-rendering: -webkit-optimize-contrast;\n  animation: app-premium-auth-hero-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;\n}\n\n@keyframes app-premium-auth-hero-in {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n\n.landing-premium.app-premium .app-premium-auth-hero-overlay {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background:\n    linear-gradient(90deg, rgba(10, 22, 40, 0.08) 0%, transparent 35%),\n    linear-gradient(180deg, transparent 55%, rgba(10, 22, 40, 0.35) 100%),\n    radial-gradient(ellipse 80% 60% at 15% 40%, rgba(201, 162, 39, 0.06) 0%, transparent 55%);\n}\n\n.landing-premium.app-premium .app-premium-auth-hero-edge {\n  position: absolute;\n  top: 0;\n  right: 0;\n  bottom: 0;\n  width: 1px;\n  background: linear-gradient(\n    180deg,\n    transparent 0%,\n    rgba(201, 162, 39, 0.35) 35%,\n    rgba(201, 162, 39, 0.5) 50%,\n    rgba(201, 162, 39, 0.35) 65%,\n    transparent 100%\n  );\n  box-shadow: 0 0 24px rgba(201, 162, 39, 0.15);\n}\n\n/* Inputs */\n.landing-premium.app-premium input:not([type='checkbox']):not([type='radio']),\n.landing-premium.app-premium textarea,\n.landing-premium.app-premium select {\n  border-radius: 0.75rem;\n  border-color: var(--lp-border-light);\n  font-family: var(--lp-sans);\n}\n\n.landing-premium.app-premium input:focus,\n.landing-premium.app-premium textarea:focus,\n.landing-premium.app-premium select:focus {\n  border-color: var(--lp-blue);\n  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);\n}\n\n/* Tables */\n.landing-premium.app-premium thead tr {\n  background: var(--lp-surface-muted);\n}\n\n/* Bottom nav mobile */\n.landing-premium.app-premium nav.fixed.bottom-0 {\n  background: var(--lp-ink-soft) !important;\n  border-color: rgba(255, 255, 255, 0.1) !important;\n}\n\n/* Personnalisation plateforme — layout 2 colonnes + nav cliquable */\n.platform-customization-shell {\n  grid-template-columns: minmax(0, 1fr);\n}\n\n@media (min-width: 1024px) {\n  .platform-customization-shell {\n    grid-template-columns: 16rem minmax(0, 1fr);\n  }\n}\n\n#platform-customization-nav {\n  pointer-events: auto;\n  isolation: isolate;\n  position: relative;\n  z-index: 50;\n  grid-column: 1;\n  grid-row: 1;\n}\n\n#platform-customization-nav .platform-customization-nav-list,\n#platform-customization-nav .platform-customization-nav-btn {\n  pointer-events: auto;\n  cursor: pointer;\n  position: relative;\n  text-decoration: none;\n}\n\n#platform-customization-nav .platform-customization-nav-btn[aria-current='page'],\n#platform-customization-nav .platform-customization-nav-btn[aria-current='page'] span,\n#platform-customization-nav .platform-customization-nav-btn[aria-current='page'] svg {\n  color: hsl(var(--primary-foreground)) !important;\n}\n\n@media (max-width: 1023px) {\n  #platform-customization-nav .platform-customization-nav-list {\n    position: static;\n    top: auto;\n    z-index: auto;\n  }\n}\n\n#platform-customization-panel {\n  pointer-events: auto;\n  min-width: 0;\n  grid-column: 1;\n  grid-row: 2;\n}\n\n@media (min-width: 1024px) {\n  #platform-customization-panel {\n    grid-column: 2;\n    grid-row: 1;\n  }\n}\n\n#platform-customization-scroll {\n  overscroll-behavior: contain;\n  -webkit-overflow-scrolling: touch;\n  scroll-padding-bottom: 2rem;\n}\n\n@media (max-width: 1023px) {\n  #platform-customization-nav {\n    max-height: min(48vh, 28rem);\n  }\n\n  #platform-customization-panel {\n    min-height: min(55vh, 36rem);\n    scroll-margin-top: 4.5rem;\n  }\n\n  .platform-customization-shell {\n    min-height: 0;\n  }\n}\n\n/* Onglets horizontaux : défilement natif (évite ScrollArea qui masque le contenu) */\n.platform-customization-section-tabs {\n  -webkit-overflow-scrolling: touch;\n  overscroll-behavior-x: contain;\n  scrollbar-width: thin;\n}\n"],["STYLE",{},"/**\n * Overrides UI plateforme (zone app premium)\n * - Icônes sans arrière-plan, en noir\n * - Boutons dégradé violet/rose → bleu landing\n * - Titres dégradé violet/rose → noir\n *\n * Scope : #main-content ET tout <main class=\"flex-1\"> (ex. portail client)\n */\n\n.landing-premium.app-premium {\n  --app-btn-blue: linear-gradient(\n    135deg,\n    var(--lp-blue-bright) 0%,\n    var(--lp-blue) 55%,\n    var(--lp-blue-deep) 100%\n  );\n}\n\n/* Zone de contenu principale (hors sidebar) */\n.landing-premium.app-premium #main-content,\n.landing-premium.app-premium main.flex-1 {\n  /* anchor pour has() si besoin */\n}\n\n/* ——— Titres dégradé (ex. « Mon Espace Client » violet→rose) → noir ——— */\n.landing-premium.app-premium #main-content [class*='bg-clip-text'],\n.landing-premium.app-premium\n  #main-content\n  [class*='from-purple-600'][class*='to-pink-600']:not(button):not([role='tab']),\n.landing-premium.app-premium #main-content h1 span[class*='bg-gradient'],\n.landing-premium.app-premium #main-content h2 span[class*='bg-gradient'],\n.landing-premium.app-premium main.flex-1 [class*='bg-clip-text'],\n.landing-premium.app-premium\n  main.flex-1\n  [class*='from-purple-600'][class*='to-pink-600']:not(button):not([role='tab']),\n.landing-premium.app-premium main.flex-1 h1 span[class*='bg-gradient'],\n.landing-premium.app-premium main.flex-1 h2 span[class*='bg-gradient'] {\n  background: none !important;\n  background-image: none !important;\n  -webkit-background-clip: unset !important;\n  background-clip: unset !important;\n  -webkit-text-fill-color: #000 !important;\n  color: #000 !important;\n}\n\n/* ——— Bouton primaire bleu (remplace violet→rose) ——— */\n.landing-premium.app-premium #main-content .app-btn-premium-gradient,\n.landing-premium.app-premium #main-content .bg-gradient-to-r.from-purple-600.to-pink-600,\n.landing-premium.app-premium #main-content [class*='from-purple-600'][class*='to-pink-600'],\n.landing-premium.app-premium #main-content [class*='from-purple-500'][class*='to-pink-500'],\n.landing-premium.app-premium #main-content [class*='from-\\[#7851A9\\]'][class*='to-\\[#FF69B4\\]'],\n.landing-premium.app-premium #main-content [class*='from-\\[#7851A9\\]'],\n.landing-premium.app-premium main.flex-1 .app-btn-premium-gradient,\n.landing-premium.app-premium main.flex-1 [class*='from-purple-600'][class*='to-pink-600'] {\n  background-image: var(--app-btn-blue) !important;\n  background-color: transparent !important;\n  color: #fff !important;\n  border: none !important;\n  -webkit-text-fill-color: #fff !important;\n}\n\n.landing-premium.app-premium #main-content .app-btn-premium-gradient:hover,\n.landing-premium.app-premium #main-content [class*='from-purple-600'][class*='to-pink-600']:hover,\n.landing-premium.app-premium main.flex-1 [class*='from-purple-600'][class*='to-pink-600']:hover {\n  filter: brightness(1.06);\n}\n\n.landing-premium.app-premium #main-content .app-btn-premium-gradient svg,\n.landing-premium.app-premium #main-content .app-btn-premium-gradient span,\n.landing-premium.app-premium #main-content [class*='from-purple-600'][class*='to-pink-600'] svg,\n.landing-premium.app-premium #main-content [class*='from-purple-600'][class*='to-pink-600'] span,\n.landing-premium.app-premium main.flex-1 [class*='from-purple-600'][class*='to-pink-600'] svg {\n  color: #fff !important;\n  stroke: #fff !important;\n}\n\n/* ——— Conteneurs d'icônes : fond transparent, pas de bordure colorée ——— */\