n.landing-premium.app-premium\n  main.flex-1\n  [class*='rounded-lg'][class*='border-green-']:not(button):not([class*='bg-card']),\n.landing-premium.app-premium\n  main.flex-1\n  [class*='rounded-lg'][class*='border-purple-']:not(button):not([class*='bg-card']),\n.landing-premium.app-premium\n  main.flex-1\n  [class*='rounded-lg'][class*='border-orange-']:not(button):not([class*='bg-card']),\n.landing-premium.app-premium\n  main.flex-1\n  [class*='rounded-lg'][class*='border-pink-']:not(button):not([class*='bg-card']),\n.landing-premium.app-premium\n  main.flex-1\n  [class*='rounded-lg'][class*='border-red-']:not(button):not([class*='bg-card']),\n.landing-premium.app-premium\n  #main-content\n  div[class*='justify-center'][class*='rounded-lg']:has(svg):not(button):not(a),\n.landing-premium.app-premium\n  main.flex-1\n  div[class*='justify-center'][class*='rounded-lg']:has(svg):not(button):not(a) {\n  background: transparent !important;\n  background-image: none !important;\n  border: none !important;\n  box-shadow: none !important;\n  backdrop-filter: none !important;\n  padding: 0 !important;\n  min-width: unset;\n  min-height: unset;\n}\n\n/* ——— Icônes Lucide / SVG décoratives → noir ——— */\n.landing-premium.app-premium #main-content svg.lucide,\n.landing-premium.app-premium #main-content svg[class*='lucide'],\n.landing-premium.app-premium main.flex-1 svg.lucide,\n.landing-premium.app-premium main.flex-1 svg {\n  color: #000 !important;\n  stroke: currentColor !important;\n}\n\n/* Icônes dans boutons / liens colorés : héritent la couleur du bouton */\n.landing-premium.app-premium #main-content button svg,\n.landing-premium.app-premium #main-content a[class*='bg-gradient'] svg,\n.landing-premium.app-premium main.flex-1 button svg,\n.landing-premium.app-premium main.flex-1 a[class*='bg-gradient'] svg {\n  color: inherit !important;\n  stroke: currentColor !important;\n}\n\n.landing-premium.app-premium #main-content .app-btn-premium-gradient svg,\n.landing-premium.app-premium #main-content [class*='from-purple-600'][class*='to-pink-600'] svg,\n.landing-premium.app-premium #main-content .bg-primary svg,\n.landing-premium.app-premium #main-content [class*='text-primary-foreground'] svg,\n.landing-premium.app-premium main.flex-1 [class*='from-purple-600'][class*='to-pink-600'] svg,\n.landing-premium.app-premium main.flex-1 .bg-primary svg,\n.landing-premium.app-premium main.flex-1 [class*='text-white'] svg {\n  color: #fff !important;\n  stroke: #fff !important;\n}\n\n/* Classes texte colorées sur icônes → noir */\n.landing-premium.app-premium #main-content [class*='text-blue-500'],\n.landing-premium.app-premium #main-content [class*='text-blue-600'],\n.landing-premium.app-premium #main-content [class*='text-orange-500'],\n.landing-premium.app-premium #main-content [class*='text-orange-600'],\n.landing-premium.app-premium #main-content [class*='text-green-500'],\n.landing-premium.app-premium #main-content [class*='text-green-600'],\n.landing-premium.app-premium #main-content [class*='text-purple-500'],\n.landing-premium.app-premium #main-content [class*='text-purple-600'],\n.landing-premium.app-premium #main-content [class*='text-pink-500'],\n.landing-premium.app-premium #main-content [class*='text-pink-600'],\n.landing-premium.app-premium #main-content [class*='text-red-500'],\n.landing-premium.app-premium #main-content [class*='text-red-600'],\n.landing-premium.app-premium #main-content [class*='text-cyan-'],\n.landing-premium.app-premium #main-content [class*='text-emerald-'],\n.landing-premium.app-premium main.flex-1 [class*='text-blue-500'],\n.landing-premium.app-premium main.flex-1 [class*='text-blue-600'],\n.landing-premium.app-premium main.flex-1 [class*='text-orange-500'],\n.landing-premium.app-premium main.flex-1 [class*='text-orange-600'],\n.landing-premium.app-premium main.flex-1 [class*='text-green-500'],\n.landing-premium.app-premium main.flex-1 [class*='text-green-600'],\n.landing-premium.app-premium main.flex-1 [class*='text-purple-500'],\n.landing-premium.app-premium main.flex-1 [class*='text-purple-600'],\n.landing-premium.app-premium main.flex-1 [class*='text-pink-500'],\n.landing-premium.app-premium main.flex-1 [class*='text-pink-600'],\n.landing-premium.app-premium main.flex-1 [class*='text-red-500'],\n.landing-premium.app-premium main.flex-1 [class*='text-red-600'],\n.landing-premium.app-premium main.flex-1 [class*='text-cyan-'],\n.landing-premium.app-premium main.flex-1 [class*='text-emerald-'] {\n  color: #000 !important;\n}\n\n/* fill sur icônes (ex. cœur wishlist) */\n.landing-premium.app-premium #main-content [class*='fill-purple'],\n.landing-premium.app-premium #main-content [class*='fill-pink'],\n.landing-premium.app-premium #main-content [class*='fill-blue'],\n.landing-premium.app-premium main.flex-1 [class*='fill-purple'],\n.landing-premium.app-premium main.flex-1 [class*='fill-pink'],\n.landing-premium.app-premium main.flex-1 [class*='fill-blue'] {\n  fill: #000 !important;\n}\n"],["STYLE",{},"/**\n * Typographie premium — zone application (.landing-premium.app-premium)\n * Échelle lisible, minimum 12px, hiérarchie par taille + graisse (pas tout en gras).\n */\n\n.landing-premium.app-premium {\n  --app-font-display: clamp(1.75rem, 1.2vw + 1.35rem, 2.5rem);\n  --app-font-h1: clamp(1.5rem, 0.8vw + 1.2rem, 2rem);\n  --app-font-h2: clamp(1.125rem, 0.4vw + 1rem, 1.375rem);\n  --app-font-h3: 1rem;\n  --app-font-body: 0.9375rem;\n  --app-font-body-lg: 1rem;\n  --app-font-small: 0.8125rem;\n  --app-font-caption: 0.75rem;\n  --app-line-tight: 1.25;\n  --app-line-normal: 1.5;\n  --app-line-relaxed: 1.625;\n}\n\n/* Base zone principale */\n.landing-premium.app-premium #main-content,\n.landing-premium.app-premium main.flex-1,\n.landing-premium.app-premium main.flex-1.overflow-auto {\n  font-family: var(--lp-sans), system-ui, sans-serif;\n  font-size: var(--app-font-body);\n  line-height: var(--app-line-normal);\n  font-weight: 400;\n  color: hsl(var(--foreground));\n  -webkit-font-smoothing: antialiased;\n}\n\n@media (min-width: 768px) {\n  .landing-premium.app-premium #main-content,\n  .landing-premium.app-premium main.flex-1,\n  .landing-premium.app-premium main.flex-1.overflow-auto {\n    font-size: var(--app-font-body-lg);\n  }\n}\n\n/* Titres */\n.landing-premium.app-premium #main-content h1,\n.landing-premium.app-premium #main-content .app-premium-page-title,\n.landing-premium.app-premium main.flex-1 h1,\n.landing-premium.app-premium main.flex-1.overflow-auto h1 {\n  font-size: var(--app-font-display) !important;\n  line-height: var(--app-line-tight);\n  font-weight: 700 !important;\n}\n\n.landing-premium.app-premium #main-content h2,\n.landing-premium.app-premium main.flex-1 h2,\n.landing-premium.app-premium main.flex-1.overflow-auto h2 {\n  font-size: var(--app-font-h1) !important;\n  line-height: var(--app-line-tight);\n  font-weight: 600 !important;\n}\n\n.landing-premium.app-premium #main-content h3,\n.landing-premium.app-premium main.flex-1 h3,\n.landing-premium.app-premium main.flex-1.overflow-auto h3 {\n  font-size: var(--app-font-h2) !important;\n  line-height: var(--app-line-tight);\n  font-weight: 600 !important;\n}\n\n.landing-premium.app-premium #main-content h4,\n.landing-premium.app-premium main.flex-1 h4,\n.landing-premium.app-premium main.flex-1.overflow-auto h4 {\n  font-size: var(--app-font-h3) !important;\n  font-weight: 600 !important;\n}\n\n/* Corps & labels — poids normal */\n.landing-premium.app-premium #main-content p,\n.landing-premium.app-premium #main-content span:not([class*='font-']),\n.landing-premium.app-premium #main-content label,\n.landing-premium.app-premium #main-content li,\n.landing-premium.app-premium #main-content td,\n.landing-premium.app-premium #main-content th,\n.landing-premium.app-premium main.flex-1 p,\n.landing-premium.app-premium main.flex-1 span:not([class*='font-']),\n.landing-premium.app-premium main.flex-1 label,\n.landing-premium.app-premium main.flex-1.overflow-auto p,\n.landing-premium.app-premium main.flex-1.overflow-auto span:not([class*='font-']),\n.landing-premium.app-premium main.flex-1.overflow-auto label {\n  font-weight: 400;\n  color: hsl(var(--foreground));\n}\n\n.landing-premium.app-premium #main-content .text-muted-foreground,\n.landing-premium.app-premium main.flex-1 .text-muted-foreground,\n.landing-premium.app-premium main.flex-1.overflow-auto .text-muted-foreground {\n  color: hsl(var(--muted-foreground)) !important;\n  font-weight: 400 !important;\n}\n\n/* Minimum lisible : remplace text-[8px]–text-[11px] */\n.landing-premium.app-premium #main-content [class*='text-[8px]'],\n.landing-premium.app-premium #main-content [class*='text-[9px]'],\n.landing-premium.app-premium #main-content [class*='text-[10px]'],\n.landing-premium.app-premium #main-content [class*='text-[11px]'],\n.landing-premium.app-premium main.flex-1 [class*='text-[8px]'],\n.landing-premium.app-premium main.flex-1 [class*='text-[9px]'],\n.landing-premium.app-premium main.flex-1 [class*='text-[10px]'],\n.landing-premium.app-premium main.flex-1 [class*='text-[11px]'],\n.landing-premium.app-premium main.flex-1.overflow-auto [class*='text-[8px]'],\n.landing-premium.app-premium main.flex-1.overflow-auto [class*='text-[9px]'],\n.landing-premium.app-premium main.flex-1.overflow-auto [class*='text-[10px]'],\n.landing-premium.app-premium main.flex-1.overflow-auto [class*='text-[11px]'] {\n  font-size: var(--app-font-caption) !important;\n  line-height: var(--app-line-normal) !important;\n}\n\n/* Classes sémantiques réutilisables */\n.landing-premium.app-premium .app-text-display {\n  font-family: var(--lp-serif);\n  font-size: var(--app-font-display);\n  font-weight: 700;\n  line-height: var(--app-line-tight);\n  letter-spacing: -0.02em;\n  color: #000;\n}\n\n.landing-premium.app-premium .app-text-title {\n  font-family: var(--lp-serif);\n  font-size: var(--app-font-h1);\n  font-weight: 700;\n  line-height: var(--app-line-tight);\n  color: #000;\n}\n\n.landin