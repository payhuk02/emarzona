pp-premium\n  main.flex-1\n  [class*='rounded-lg'][class*='border-blue-']:not(button):not([class*='bg-card']),\n.landing-premium.app-premium\n  main.flex-1\n  [class*='rounded-lg'][class*='border-green-']:not(button):not([class*='bg-card']),\n.landing-premium.app-premium\n  main.flex-1\n  [class*='rounded-lg'][class*='border-purple-']:not(button):not([class*='bg-card']),\n.landing-premium.app-premium\n  main.flex-1\n  [class*='rounded-lg'][class*='border-orange-']:not(button):not([class*='bg-card']),\n.landing-premium.app-premium\n  main.flex-1\n  [class*='rounded-lg'][class*='border-pink-']:not(button):not([class*='bg-card']),\n.landing-premium.app-premium\n  main.flex-1\n  [class*='rounded-lg'][class*='border-red-']:not(button):not([class*='bg-card']),\n.landing-premium.app-premium\n  #main-content\n  div[class*='justify-center'][class*='rounded-lg']:has(svg):not(button):not(a),\n.landing-premium.app-premium\n  main.flex-1\n  div[class*='justify-center'][class*='rounded-lg']:has(svg):not(button):not(a) {\n  background: transparent !important;\n  background-image: none !important;\n  border: none !important;\n  box-shadow: none !important;\n  backdrop-filter: none !important;\n  padding: 0 !important;\n  min-width: unset;\n  min-height: unset;\n}\n\n/* ——— Icônes Lucide / SVG décoratives → noir ——— */\n.landing-premium.app-premium #main-content svg.lucide,\n.landing-premium.app-premium #main-content svg[class*='lucide'],\n.landing-premium.app-premium main.flex-1 svg.lucide,\n.landing-premium.app-premium main.flex-1 svg {\n  color: #000 !important;\n  stroke: currentColor !important;\n}\n\n/* Icônes dans boutons / liens colorés : héritent la couleur du bouton */\n.landing-premium.app-premium #main-content button svg,\n.landing-premium.app-premium #main-content a[class*='bg-gradient'] svg,\n.landing-premium.app-premium main.flex-1 button svg,\n.landing-premium.app-premium main.flex-1 a[class*='bg-gradient'] svg {\n  color: inherit !important;\n  stroke: currentColor !important;\n}\n\n.landing-premium.app-premium #main-content .app-btn-premium-gradient svg,\n.landing-premium.app-premium #main-content [class*='from-purple-600'][class*='to-pink-600'] svg,\n.landing-premium.app-premium #main-content .bg-primary svg,\n.landing-premium.app-premium #main-content [class*='text-primary-foreground'] svg,\n.landing-premium.app-premium main.flex-1 [class*='from-purple-600'][class*='to-pink-600'] svg,\n.landing-premium.app-premium main.flex-1 .bg-primary svg,\n.landing-premium.app-premium main.flex-1 [class*='text-white'] svg {\n  color: #fff !important;\n  stroke: #fff !important;\n}\n\n/* Classes texte colorées sur icônes → noir */\n.landing-premium.app-premium #main-content [class*='text-blue-500'],\n.landing-premium.app-premium #main-content [class*='text-blue-600'],\n.landing-premium.app-premium #main-content [class*='text-orange-500'],\n.landing-premium.app-premium #main-content [class*='text-orange-600'],\n.landing-premium.app-premium #main-content [class*='text-green-500'],\n.landing-premium.app-premium #main-content [class*='text-green-600'],\n.landing-premium.app-premium #main-content [class*='text-purple-500'],\n.landing-premium.app-premium #main-content [class*='text-purple-600'],\n.landing-premium.app-premium #main-content [class*='text-pink-500'],\n.landing-premium.app-premium #main-content [class*='text-pink-600'],\n.landing-premium.app-premium #main-content [class*='text-red-500'],\n.landing-premium.app-premium #main-content [class*='text-red-600'],\n.landing-premium.app-premium #main-content [class*='text-cyan-'],\n.landing-premium.app-premium #main-content [class*='text-emerald-'],\n.landing-premium.app-premium main.flex-1 [class*='text-blue-500'],\n.landing-premium.app-premium main.flex-1 [class*='text-blue-600'],\n.landing-premium.app-premium main.flex-1 [class*='text-orange-500'],\n.landing-premium.app-premium main.flex-1 [class*='text-orange-600'],\n.landing-premium.app-premium main.flex-1 [class*='text-green-500'],\n.