herit;\n}\n/*\nReset links to optimize for opt-in styling instead of opt-out.\n*/\na {\n  color: inherit;\n  text-decoration: inherit;\n}\n/*\nAdd the correct font weight in Edge and Safari.\n*/\nb,\nstrong {\n  font-weight: bolder;\n}\n/*\n1. Use the user's configured `mono` font-family by default.\n2. Use the user's configured `mono` font-feature-settings by default.\n3. Use the user's configured `mono` font-variation-settings by default.\n4. Correct the odd `em` font sizing in all browsers.\n*/\ncode,\nkbd,\nsamp,\npre {\n  font-family: JetBrains Mono, Fira Code, Consolas, monospace; /* 1 */\n  font-feature-settings: normal; /* 2 */\n  font-variation-settings: normal; /* 3 */\n  font-size: 1em; /* 4 */\n}\n/*\nAdd the correct font size in all browsers.\n*/\nsmall {\n  font-size: 80%;\n}\n/*\nPrevent `sub` and `sup` elements from affecting the line height in all browsers.\n*/\nsub,\nsup {\n  font-size: 75%;\n  line-height: 0;\n  position: relative;\n  vertical-align: baseline;\n}\nsub {\n  bottom: -0.25em;\n}\nsup {\n  top: -0.5em;\n}\n/*\n1. Remove text indentation from table contents in Chrome and Safari. (https://bugs.chromium.org/p/chromium/issues/detail?id=999088, https://bugs.webkit.org/show_bug.cgi?id=201297)\n2. Correct table border color inheritance in all Chrome and Safari. (https://bugs.chromium.org/p/chromium/issues/detail?id=935729, https://bugs.webkit.org/show_bug.cgi?id=195016)\n3. Remove gaps between table borders by default.\n*/\ntable {\n  text-indent: 0; /* 1 */\n  border-color: inherit; /* 2 */\n  border-collapse: collapse; /* 3 */\n}\n/*\n1. Change the font styles in all browsers.\n2. Remove the margin in Firefox and Safari.\n3. Remove default padding in all browsers.\n*/\nbutton,\ninput,\noptgroup,\nselect,\ntextarea {\n  font-family: inherit; /* 1 */\n  font-feature-settings: inherit; /* 1 */\n  font-variation-settings: inherit; /* 1 */\n  font-size: 100%; /* 1 */\n  font-weight: inherit; /* 1 */\n  line-height: inherit; /* 1 */\n  letter-spacing: inherit; /* 1 */\n  color: inherit; /* 1 */\n  margin: 0; /* 2 */\n  padding: 0; /* 3 */\n}\n/*\nRemove the inheritance of text transform in Edge and Firefox.\n*/\nbutton,\nselect {\n  text-transform: none;\n}\n/*\n1. Correct the inability to style clickable types in iOS and Safari.\n2. Remove default button styles.\n*/\nbutton,\ninput:where([type='button']),\ninput:where([type='reset']),\ninput:where([type='submit']) {\n  -webkit-appearance: button; /* 1 */\n  background-color: transparent; /* 2 */\n  background-image: none; /* 2 */\n}\n/*\nUse the modern Firefox focus style for all focusable elements.\n*/\n:-moz-focusring {\n  outline: auto;\n}\n/*\nRemove the additional `:invalid` styles in Firefox. (https://github.com/mozilla/gecko-dev/blob/2f9eacd9d3d995c937b4251a5557d95d494c9be1/layout/style/res/forms.css#L728-L737)\n*/\n:-moz-ui-invalid {\n  box-shadow: none;\n}\n/*\nAdd the correct vertical alignment in Chrome and Firefox.\n*/\nprogress {\n  vertical-align: baseline;\n}\n/*\nCorrect the cursor style of increment and decrement buttons in Safari.\n*/\n::-webkit-inner-spin-button,\n::-webkit-outer-spin-button {\n  height: auto;\n}\n/*\n1. Correct the odd appearance in Chrome and Safari.\n2. Correct the outline style in Safari.\n*/\n[type='search'] {\n  -webkit-appearance: textfield; /* 1 */\n  outline-offset: -2px; /* 2 */\n}\n/*\nRemove the inner padding in Chrome and Safari on macOS.\n*/\n::-webkit-search-decoration {\n  -webkit-appearance: none;\n}\n/*\n1. Correct the inability to style clickable types in iOS and Safari.\n2. Change font properties to `inherit` in Safari.\n*/\n::-webkit-file-upload-button {\n  -webkit-appearance: button; /* 1 */\n  font: inherit; /* 2 */\n}\n/*\nAdd the correct display in Chrome and Safari.\n*/\nsummary {\n  display: list-item;\n}\n/*\nRemoves the default spacing and border for appropriate elements.\n*/\nblockquote,\ndl,\ndd,\nh1,\nh2,\nh3,\nh4,\nh5,\nh6,\nhr,\nfigure,\np,\npre {\n  margin: 0;\n}\nfieldset {\n  margin: 0;\n  padding: 0;\n}\nlegend {\n  padding: 0;\n}\nol,\nul,\nmenu {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n/*\nReset default styling for dialogs.\n*/\ndialog {\n  padding: 0;\n}\n/*\nPrevent resizing textareas horizontally by default.\n*/\ntextarea {\n  resize: vertical;\n}\n/*\n1. Reset the default placeholder opacity in Firefox. (https://github.com/tailwindlabs/tailwindcss/issues/3300)\n2. Set the default placeholder color to the user's configured gray 400 color.\n*/\ninput::-moz-placeholder, textarea::-moz-placeholder {\n  opacity: 1; /* 1 */\n  color: #9ca3af; /* 2 */\n}\ninput::placeholder,\ntextarea::placeholder {\n  opacity: 1; /* 1 */\n  color: #9ca3af; /* 2 */\n}\n/*\nSet the default cursor for buttons.\n*/\nbutton,\n[role=\"button\"] {\n  cursor: pointer;\n}\n/*\nMake sure disabled buttons don't get the pointer cursor.\n*/\n:disabled {\n  cursor: default;\n}\n/*\n1. Make replaced elements `display: block` by default. (https://github.com/mozdevs/cssremedy/issues/14)\n2. Add `vertical-align: middle` to align replaced elements more sensibly by default. (https://github.com/jensimmons/cssremedy/issues/14#issuecomment-634934210)\n   This can trigger a poorly considered lint error in some tools but is included by design.\n*/\nimg,\nsvg,\nvideo,\ncanvas,\naudio,\niframe,\nembed,\nobject {\n  display: block; /* 1 */\n  vertical-align: middle; /* 2 */\n}\n/*\nConstrain images and videos to the parent width and preserve their intrinsic aspect ratio. (https://github.com/mozdevs/cssremedy/issues/14)\n*/\nimg,\nvideo {\n  max-width: 100%;\n  height: auto;\n}\n/* Make elements with the HTML hidden attribute stay hidden by default */\n[hidden]:where(:not([hidden=\"until-found\"])) {\n  display: none;\n}\n:root {\n    /* Thème clair par défaut (Professionnel) */\n    --background: 0 0% 100%;\n    --foreground: 220 40% 10%; /* Plus foncé pour meilleur contraste sur fond blanc (WCAG AA) */\n\n    --card: 0 0% 100%;\n    --card-foreground: 220 40% 10%; /* Plus foncé pour meilleur contraste */\n\n    --popover: 0 0% 100%;\n    --popover-foreground: 220 40% 10%; /* Plus foncé pour meilleur contraste */\n\n    --primary: 24.6 95% 53.1%; /* Orange Premium #f97316 — conversion optimisée */\n    --primary-foreground: 0 0% 100%;\n\n    --secondary: 0 0% 96%; /* Gris très clair moderne */\n    --secondary-foreground: 0 0% 12%; /* Noir doux */\n\n    --muted: 0 0% 98%; /* Gris ultra clair */\n    --muted-foreground: 0 0% 35%; /* Gris foncé pour meilleur contraste sur fond blanc (WCAG AA) */\n\n    --accent: 38 92% 50%; /* Orange/Jaune moderne pour contraste avec primary */\n    --accent-foreground: 0 0% 100%;\n\n    --destructive: 0 84.2% 60.2%;\n    --destructive-foreground: 0 0% 100%;\n\n    --border: 0 0% 90%; /* Gris clair moderne */\n    --input: 0 0% 90%; /* Gris clair moderne */\n    --ring: 24.6 95% 53.1%; /* Orange moderne */\n\n    --radius: 0.5rem; /* 8px - Border radius moderne et cohérent */\n\n    --gradient-primary: linear-gradient(135deg, hsl(24.6, 95%, 60%) 0%, hsl(24.6, 95%, 50%) 100%);\n    --gradient-accent: linear-gradient(135deg, hsl(38, 92%, 50%) 0%, hsl(38, 92%, 45%) 100%);\n    --gradient-hero: linear-gradient(135deg, hsl(220, 50%, 12%) 0%, hsl(220, 45%, 18%) 100%);\n    --gradient-dark: linear-gradient(180deg, hsl(220, 30%, 12%) 0%, hsl(220, 35%, 18%) 100%);\n\n    --shadow-soft: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);\n    --shadow-medium: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\n    --shadow-large: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\n    --shadow-glow: 0 0 20px rgba(59, 130, 246, 0.3);\n    --shadow-glass: 0 8px 32px 0 rgba(0, 0, 0, 0.08);\n    --shadow-float: 0 12px 36px -4px rgba(0, 0, 0, 0.12), 0 4px 12px -2px rgba(0, 0, 0, 0.08);\n\n    --transition-smooth: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n\n    /* Sidebar claire par défaut */\n    --sidebar-background: 0 0% 100%;\n    --sidebar-foreground: 220 40% 10%; /* Plus foncé pour meilleur contraste sur fond blanc */\n    --sidebar-primary: 217 91% 60%; /* Bleu moderne */\n    --sidebar-primary-foreground: 0 0% 100%;\n    --sidebar-accent: 0 0% 96%; /* Gris très clair */\n    --sidebar-accent-foreground: 0 0% 12%; /* Noir doux */\n    --sidebar-border: 0 0% 90%; /* Gris clair */\n    --sidebar-ring: 217 91% 60%; /* Bleu moderne */\n  }\n.dark {\n    --background: 220 35% 8%;\n    --foreground: 0 0% 98%;\n\n    --card: 220 30% 12%;\n    --card-foreground: 0 0% 98%;\n\n    --popover: 220 30% 12%;\n    --popover-foreground: 0 0% 98%;\n\n    --primary: 24.6 95% 58%; /* Orange moderne plus clair pour dark mode */\n    --primary-foreground: 0 0% 100%;\n\n    --secondary: 0 0% 18%; /* Gris foncé moderne */\n    --secondary-foreground: 0 0% 98%;\n\n    --muted: 0 0% 16%; /* Gris très foncé */\n    --muted-foreground: 0 0% 65%; /* Gris moyen */\n\n    --accent: 38 92% 55%; /* Orange/Jaune moderne pour contraste avec primary */\n    --accent-foreground: 0 0% 100%;\n\n    --destructive: 0 72% 51%;\n    --destructive-foreground: 0 0% 100%;\n\n    --border: 0 0% 20%; /* Gris foncé */\n    --input: 0 0% 20%; /* Gris foncé */\n    --ring: 24.6 95% 58%; /* Orange moderne */\n\n    --gradient-primary: linear-gradient(135deg, hsl(24.6, 95%, 65%) 0%, hsl(24.6, 95%, 55%) 100%);\n    --gradient-accent: linear-gradient(135deg, hsl(38, 92%, 55%) 0%, hsl(38, 92%, 50%) 100%);\n    --gradient-hero: linear-gradient(135deg, hsl(220, 50%, 12%) 0%, hsl(220, 45%, 18%) 100%);\n    --gradient-dark: linear-gradient(180deg, hsl(220, 35%, 8%) 0%, hsl(220, 40%, 14%) 100%);\n\n    --shadow-soft: 0 1px 3px 0 rgba(0, 0, 0, 0.3), 0 1px 2px 0 rgba(0, 0, 0, 0.2);\n    --shadow-medium: 0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -1px rgba(0, 0, 0, 0.3);\n    --shadow-large: 0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -2px rgba(0, 0, 0, 0.4);\n    --shadow-glow: 0 0 30px rgba(59, 130, 246, 0.4);\n    --shadow-glass: 0 8px 32px 0 rgba(0, 0, 0, 0.4);\n    --shadow-float: 0 12px 36px -4px rgba(0, 0, 0, 0.5), 0 4px 12px -2px rgba(0, 0, 0, 0.4);\n\n    /* Sidebar toujours en thème clair même en mode sombre */\n    --sidebar-background: 0 0% 100%;\n    --sidebar-foreground: 0 0% 0%;\n    --sidebar-primary: 25 95% 53%;\n    --sidebar-primary-foreground: 0 0% 100%;\n    --sidebar-accent: 33 100% 96.5%;\n    --sidebar-accent-foreground: 0 0% 0%;\n    --sidebar-border: 20 5.9% 90%;\n    --sidebar-ring: 25 95% 53%;\n  }\n* {\n  border-color: hsl(var(--border));\n}\n/* Times New Roman pour les titres */\nh1,\n  h2,\n  h3,\n  h4,\n  h5,\n  h6 {\n    font-family: 'Times New Roman', Times, serif;\n  }\n/* OPTIMISATION: CSS du sidebar déplacé dans sidebar-optimized.css\n     pour permettre le chargement asynchrone et réduire le CSS critique */\n/* Les styles du sidebar sont maintenant dans ./styles/sidebar-optimized.css */\nhtml {\n    scroll-behavior: smooth;\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n  }\nbody {\n  background-color: hsl(var(--background));\n  font-family: Inter, system-ui, -apple-system, sans-serif;\n  color: hsl(var(--foreground));\n    font-family:\n      'Inter',\n      system-ui,\n      -apple-system,\n      sans-serif;\n    font-size: 1rem; /* 16px - Taille professionnelle */\n    line-height: 1.625; /* Amélioré pour meilleure lisibilité */\n    letter-spacing: 0;\n    overscroll-behavior: none;\n    -webkit-tap-highlight-color: transparent;\n    touch-action: manipulation;\n    overflow-x: hidden;\n    max-width: 100vw;\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n}\n/* Hiérarchie typographique moderne */\nh1 {\n    font-size: 2.5rem; /* 40px */\n    line-height: 1.2;\n    font-weight: 700;\n    letter-spacing: -0.02em;\n  }\nh2 {\n    font-size: 2rem; /* 32px */\n    line-height: 1.25;\n    font-weight: 600;\n    letter-spacing: -0.01em;\n  }\nh3 {\n    font-size: 1.5rem; /* 24px */\n    line-height: 1.3;\n    font-weight: 600;\n    letter-spacing: 0;\n  }\nh4 {\n    font-size: 1.25rem; /* 20px */\n    line-height: 1.4;\n    font-weight: 600;\n    letter-spacing: 0;\n  }\nh5 {\n    font-size: 1.125rem; /* 18px */\n    line-height: 1.4;\n    font-weight: 600;\n    letter-spacing: 0;\n  }\nh6 {\n    font-size: 1rem; /* 16px */\n    line-height: 1.4;\n    font-weight: 600;\n    letter-spacing: 0.01em;\n  }\n/* Responsive typography */\n@media (max-width: 768px) {\n    h1 {\n      font-size: 2rem; /* 32px */\n    }\n    h2 {\n      font-size: 1.75rem; /* 28px */\n    }\n    h3 {\n      font-size: 1.5rem; /* 24px */\n    }\n  }\n/* Optimisations pour très petits écrans (< 360px) */\n@media (max-width: 360px) {\n    h1 {\n      font-size: 1.75rem; /* 28px */\n      line-height: 1.2;\n    }\n    h2 {\n      font-size: 1.5rem; /* 24px */\n      line-height: 1.25;\n    }\n    h3 {\n      font-size: 1.25rem; /* 20px */\n      line-height: 1.3;\n    }\n\n    /* Padding réduit pour très petits écrans */\n    .container {\n      padding-left: 0.5rem;\n      padding-right: 0.5rem;\n    }\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n    body {\n      font-size: 0.875rem; /* 14px - Minimum recommandé WCAG */\n      line-height: 1.5;\n    }\n\n    /* Boutons compacts mais touch-friendly */\n    button {\n      padding: 0.5rem 0.75rem;\n      font-size: 0.875rem;\n      min-height: 40px; /* Légèrement réduit mais toujours touch-friendly */\n      min-width: 40px;\n    }\n\n    /* Cards plus compactes */\n    [class*='card'],\n    [class*='Card'] {\n      padding: 0.75rem;\n    }\n\n    /* Espacement réduit */\n    .space-y-3 > * + * {\n      margin-top: 0.5rem;\n    }\n\n    .space-y-4 > * + * {\n      margin-top: 0.75rem;\n    }\n\n    .gap-3 {\n      gap: 0.5rem;\n    }\n\n    .gap-4 {\n      gap: 0.75rem;\n    }\n\n    /* Grilles adaptées */\n    .grid {\n      gap: 0.5rem;\n    }\n\n    /* Padding réduit pour très petits écrans */\n    .\\!container {\n      padding-left: 0.5rem !important;\n      padding-right: 0.5rem !important;\n    }\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n\n    /* Grilles adaptées */\n  }\n#root {\n    min-height: 100vh;\n    overflow-x: hidden;\n    max-width: 100vw;\n  }\n* {\n    box-sizing: border-box;\n  }\n/*\n   * ⚠️ PERF: éviter les transitions globales sur `*`\n   * Cela augmente le coût des recalculs de style (surtout sur mobile) et peut dégrader le scroll.\n   * On applique des transitions uniquement aux éléments interactifs et composants UI.\n   */\nbutton,\n  a,\n  input,\n  textarea,\n  select,\n  [role='button'] {\n    transition:\n      background-color 0.2s ease,\n      color 0.2s ease,\n      border-color 0.2s ease,\n      box-shadow 0.2s ease,\n      opacity 0.2s ease,\n      transform 0.2s ease;\n  }\nimg,\n  video {\n    max-width: 100%;\n    height: auto;\n    display: block;\n  }\n.animate-fade-in,\n  .animate-fade-in-up,\n  .hover-scale {\n    will-change: transform, opacity;\n    transform: translateZ(0);\n    backface-visibility: hidden;\n  }\n/* Optimisations mobile et interactions tactiles */\n/* Réduction des animations pour l'accessibilité */\n@media (prefers-reduced-motion: reduce) {\n    *,\n    *::before,\n    *::after {\n      animation-duration: 0.01ms !important;\n      animation-iteration-count: 1 !important;\n      transition-duration: 0.01ms !important;\n      scroll-behavior: auto !important;\n    }\n\n    /* Désactiver les animations spécifiques */\n    .animate-fade-in-up,\n    .animate-float,\n    .animate-pulse {\n      animation: none !important;\n    }\n\n    /* Désactiver les transformations au hover */\n    *:hover {\n      transform: none !important;\n    }\n  }\n/* OPTIMISATION PERFORMANCE: Réduire les animations sur mobile pour économiser la batterie */\n@media (max-width: 768px) {\n    /* Réduire la durée des animations (sauf marquees landing) */\n    *:not(.lp-marquee-track):not(.lp-countries-marquee-track):not(.lp-currencies-marquee-track),\n    *:not(.lp-marquee-track):not(.lp-countries-marquee-track):not(\n        .lp-currencies-marquee-track\n      )::before,\n    *:not(.lp-marquee-track):not(.lp-countries-marquee-track):not(\n        .lp-currencies-marquee-track\n      )::after {\n      animation-duration: 0.2s !important;\n      transition-duration: 0.15s !important;\n    }\n\n    /* Désactiver les animations non-essentielles */\n    .animate-float,\n    .animate-pulse:not([aria-busy='true']) {\n      animation: none !important;\n    }\n\n    /* Désactiver les transformations au hover (peu utiles sur mobile) */\n    .hover-smooth-lift:hover,\n    .hover-smooth-scale:hover,\n    .product-card-zoom:hover {\n      transform: none !important;\n    }\n\n    /* Réduire les effets de glow et shadow sur mobile */\n    .shadow-glow {\n      box-shadow: var(--shadow-soft) !important;\n    }\n  }\n/* Optimisations pour très petits écrans */\n@media (max-width: 475px) {\n    .\\!container {\n      padding-left: 0.75rem !important;\n      padding-right: 0.75rem !important;\n    }\n    .container {\n      padding-left: 0.75rem;\n      padding-right: 0.75rem;\n    }\n\n    .text-responsive-xs {\n      font-size: 0.75rem;\n      line-height: 1rem;\n    }\n\n    .p-responsive-xs {\n      padding: 0.5rem;\n    }\n\n    .gap-responsive-xs {\n      gap: 0.5rem;\n    }\n  }\n/* Optimisations supplémentaires pour très petits écrans (< 360px) */\n@media (max-width: 360px) {\n    .container {\n      padding-left: 0.5rem;\n      padding-right: 0.5rem;\n    }\n\n    /* Textes adaptés - Minimum 14px pour accessibilité WCAG */\n    .text-responsive-xs {\n      font-size: 0.875rem; /* 14px minimum pour accessibilité */\n      line-height: 1.25rem;\n    }\n\n    /* Padding minimal */\n    .p-responsive-xs {\n      padding: 0.375rem;\n    }\n\n    /* Gap minimal */\n    .gap-responsive-xs {\n      gap: 0.375rem;\n    }\n\n    /* Cards plus compactes */\n    .card {\n      padding: 0.75rem;\n    }\n\n    /* Boutons compacts mais touch-friendly */\n    button {\n      min-height: 40px; /* Légèrement réduit mais toujours touch-friendly */\n      padding: 0.5rem 0.75rem;\n      font-size: 0.875rem;\n    }\n    .\\!container {\n      padding-left: 0.5rem !important;\n      padding-right: 0.5rem !important;\n    }\n\n    /* Textes adaptés - Minimum 14px pour accessibilité WCAG */\n\n    /* Padding minimal */\n\n    /* Gap minimal */\n\n    /* Cards plus compactes */\n\n    /* Boutons compacts mais touch-friendly */\n  }\n/* ===================================== */\n/* ACCESSIBILITÉ WCAG AA LEVEL */\n/* ===================================== */\n/* 1. Focus visible amélioré - Respecte WCAG 2.4.7 */\n*:focus-visible {\n    outline: 3px solid hsl(var(--ring));\n    outline-offset: 2px;\n    transition: outline-offset 0.2s ease;\n  }\n/* Focus étendu pour les interactions tactiles */\n@media (hover: none) {\n    *:focus-visible {\n      outline-width: 4px;\n      outline-offset: 3px;\n    }\n  }\n/* Skip links - Respecte WCAG 2.4.1 */\n.sr-only {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n    border-width: 0;\n  }\n.sr-only:focus,\n  .focus\\:not-sr-only:focus {\n    position: static;\n    width: auto;\n    height: auto;\n    padding: inherit;\n    margin: inherit;\n    overflow: visible;\n    clip: auto;\n    white-space: normal;\n  }\n/* 2. Contraste amélioré pour les liens - Respecte WCAG 1.4.3 */\na {\n    color: hsl(var(--primary));\n    -webkit-text-decoration-skip: ink;\n            text-decoration-skip-ink: auto;\n  }\na:hover {\n    text-decoration: underline;\n  }\na:focus {\n    outline: 3px solid hsl(var(--ring));\n    outline-offset: 2px;\n  }\n/* 3. Boutons accessibles - Respecte WCAG 2.1.1 */\nbutton:disabled,\n  [aria-disabled='true'] {\n    cursor: not-allowed;\n    opacity: 0.6;\n  }\nbutton:focus-visible,\n  [role='button']:focus-visible,\n  a:focus-visible,\n  input:focus-visible,\n  select:focus-visible,\n  textarea:focus-visible {\n    outline: 3px solid hsl(var(--ring));\n    outline-offset: 3px;\n    outline-style: solid;\n    border-radius: 0.25rem;\n  }\n/* Focus visible amélioré pour navigation clavier - WCAG 2.4.7 */\n*:focus-visible {\n    outline: 3px solid hsl(var(--ring));\n    outline-offset: 3px;\n    outline-style: solid;\n  }\n/* Exception pour les éléments avec focus interne (inputs, etc.) */\ninput:focus-visible,\n  textarea:focus-visible,\n  select:focus-visible {\n    outline: 2px solid hsl(var(--ring));\n    outline-offset: 2px;\n  }\n/* 4. Messages d'erreur et status - Respecte WCAG 3.3.1 & 3.3.2 */\n[role='alert'],\n  [aria-live='assertive'],\n  [aria-live='polite'] {\n    position: relative;\n  }\n/* 5. Cibles tactiles minimum 44x44px - Respecte WCAG 2.5.5 */\nbutton,\n  a,\n  input[type='checkbox'],\n  input[type='radio'],\n  select {\n    min-height: 44px;\n    min-width: 44px;\n    touch-action: manipulation;\n  }\n/* Exception pour les icônes dans les boutons */\nbutton > svg,\n  a > svg {\n    pointer-events: none;\n  }\n/* 6. Texte sélectionnable avec contraste - Respecte WCAG 1.4.3 */\n::-moz-selection {\n    background-color: hsl(var(--primary) / 0.3);\n    color: hsl(var(--foreground));\n  }\n::selection {\n    background-color: hsl(var(--primary) / 0.3);\n    color: hsl(var(--foreground));\n  }\n/* 7. Mode sombre avec contraste respecté */\n.dark {\n    /* Garantir un contraste minimum de 4.5:1 */\n    --text-high-contrast: 0 0% 100%;\n    --text-medium-contrast: 0 0% 85%;\n    --text-low-contrast: 0 0% 70%;\n  }\n/* 8. États hover et active clairs - Respecte WCAG 1.4.1 */\nbutton:hover:not(:disabled),\n  [role='button']:hover:not([aria-disabled='true']) {\n    filter: brightness(1.1);\n  }\nbutton:active:not(:disabled),\n  [role='button']:active:not([aria-disabled='true']) {\n    filter: brightness(0.9);\n  }\n/* 9. Navigation au clavier visible */\n[tabindex]:focus-visible,\n  [role='tab']:focus-visible,\n  [role='menuitem']:focus-visible,\n  [role='option']:focus-visible {\n    outline: 3px solid hsl(var(--ring));\n    outline-offset: 2px;\n    z-index: 10;\n  }\n/* 10. Indicateurs de chargement accessibles */\n@keyframes spin-accessible {\n    from {\n      transform: rotate(0deg);\n    }\n    to {\n      transform: rotate(360deg);\n    }\n  }\n[aria-busy='true']::before {\n    content: '';\n    display: inline-block;\n    width: 1em;\n    height: 1em;\n    margin-right: 0.5em;\n    border: 2px solid hsl(var(--primary));\n    border-top-color: transparent;\n    border-radius: 50%;\n    animation: spin-accessible 0.8s linear infinite;\n  }\n/* 11. Amélioration du contraste pour les placeholders */\n::-moz-placeholder {\n    color: hsl(var(--muted-foreground));\n    opacity: 0.7;\n  }\n::placeholder {\n    color: hsl(var(--muted-foreground));\n    opacity: 0.7;\n  }\ninput:focus::-moz-placeholder, textarea:focus::-moz-placeholder {\n    opacity: 0.5;\n  }\ninput:focus::placeholder,\n  textarea:focus::placeholder {\n    opacity: 0.5;\n  }\n/* 12. Focus pour les éléments de formulaire */\ninput:focus,\n  textarea:focus,\n  select:focus {\n    outline: 3px solid hsl(var(--ring));\n    outline-offset: 2px;\n    border-color: hsl(var(--ring));\n  }\n/* 13. Tooltips accessibles */\n[role='tooltip'] {\n    background-color: hsl(var(--popover));\n    color: hsl(var(--popover-foreground));\n    border: 1px solid hsl(var(--border));\n    padding: 0.5rem 0.75rem;\n    border-radius: 0.375rem;\n    font-size: 0.875rem;\n    box-shadow: var(--shadow-medium);\n  }\n/* 14. Indicateur de page actuelle */\n[aria-current='page'] {\n    font-weight: 600;\n    position: relative;\n  }\n[aria-current='page']::after {\n    content: '';\n    position: absolute;\n    bottom: -2px;\n    left: 0;\n    right: 0;\n    height: 2