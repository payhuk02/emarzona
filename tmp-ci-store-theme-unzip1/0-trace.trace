les adaptées */\n    .lg\\:grid {\n      gap: 0.5rem;\n    }\n  }\n}\n@media (min-width: 1280px) {\n  @media (max-width: 360px) {\n\n    /* Padding réduit pour très petits écrans */\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n\n    .xl\\:gap-3 {\n      gap: 0.5rem;\n    }\n\n    /* Grilles adaptées */\n  }\n}\n.file\\:mr-4::file-selector-button {\n  margin-right: 1rem;\n}\n.file\\:rounded-md::file-selector-button {\n  border-radius: calc(var(--radius) - 2px);\n}\n.file\\:border-0::file-selector-button {\n  border-width: 0px;\n}\n.file\\:bg-primary\\/10::file-selector-button {\n  background-color: hsl(var(--primary) / 0.1);\n}\n.file\\:bg-transparent::file-selector-button {\n  background-color: transparent;\n}\n.file\\:px-3::file-selector-button {\n  padding-left: 0.75rem;\n  padding-right: 0.75rem;\n}\n.file\\:py-1\\.5::file-selector-button {\n  padding-top: 0.375rem;\n  padding-bottom: 0.375rem;\n}\n.file\\:text-sm::file-selector-button {\n  font-size: 0.875rem;\n  line-height: 1.375rem;\n  letter-spacing: 0;\n}\n.file\\:text-xs::file-selector-button {\n  font-size: 0.75rem;\n  line-height: 1.25rem;\n  letter-spacing: 0;\n}\n.file\\:font-medium::file-selector-button {\n  font-weight: 500;\n}\n.file\\:text-foreground::file-selector-button {\n  color: hsl(var(--foreground));\n}\n.file\\:text-primary::file-selector-button {\n  color: hsl(var(--primary));\n}\n.placeholder\\:text-gray-400::-moz-placeholder {\n  --tw-text-opacity: 1;\n  color: rgb(156 163 175 / var(--tw-text-opacity, 1));\n}\n.placeholder\\:text-gray-400::placeholder {\n  --tw-text-opacity: 1;\n  color: rgb(156 163 175 / var(--tw-text-opacity, 1));\n}\n.placeholder\\:text-muted-foreground::-moz-placeholder {\n  color: hsl(var(--muted-foreground));\n}\n.placeholder\\:text-muted-foreground::placeholder {\n  color: hsl(var(--muted-foreground));\n}\n.placehol