s */\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n\n    .dashboard-stats-grid {\n      gap: 0.5rem;\n    }\n\n    /* Grilles adaptées */\n  }\n\n  .dashboard-stats-grid {\n    gap: 0.75rem;\n  }\n  @media (max-width: 360px) {\n\n    /* Padding réduit pour très petits écrans */\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n\n    .dashboard-actions-grid {\n      gap: 0.5rem;\n    }\n\n    /* Grilles adaptées */\n  }\n\n  .dashboard-actions-grid {\n    gap: 0.75rem;\n  }\n  @media (max-width: 360px) {\n\n    /* Padding réduit pour très petits écrans */\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n\n    .dashboard-bottom-grid {\n      gap: 0.75rem;\n    }\n\n    /* Grilles adaptées */\n  }\n\n  .dashboard-bottom-grid {\n    gap: 1rem;\n  }\n}\n\n/* Tablet Optimizations */\n@media (min-width: 768px) and (max-width: 1023px) {\n  .dashboard-card {\n    min-height: 140px;\n  }\n  @media (max-width: 360px) {\n\n    /* Padding réduit pour très petits écrans */\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n\n    .dashboard-stats-grid {\n      gap: 0.75rem;\n    }\n\n    /* Grilles adaptées */\n  }\n\n  .dashboard-stats-grid {\n    gap: 1rem;\n  }\n  @media (max-width: 360px) {\n\n    /* Padding réduit pour très petits écrans */\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n\n    .dashboard-actions-grid {\n      gap: 0.75rem;\n    }\n\n    /* Grilles adaptées */\n  }\n\n  .dashboard-actions-grid {\n    gap: 1rem;\n  }\n}\n\n/* Desktop Optimizations */\n@media (min-width: 1024px) {\n  .dashboard-card {\n    min-height: 160px;\n  }\n\n  .dashboard-stats-grid {\n    gap: 1.5rem;\n  }\n\n  .dashboard-actions-grid {\n    gap: 1.5rem;\n  }\n\n  .dashboard-bottom-grid {\n    gap: 2rem;\n  }\n}\n\n/* Animation Classes */\n@keyframes fadeInUp {\n  from {\n    opacity: 0;\n    transform: translateY(20px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.animate-fade-in {\n  animation: fadeInUp 0.6s ease-out;\n}\n\n.animate-fade-in-delayed {\n  animation: fadeInUp 0.6s ease-out 0.2s both;\n}\n\n/* Focus States for Accessibility */\n.dashboard-card:focus-visible {\n  --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);\n  --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(2px + var(--tw-ring-offset-width)) var(--tw-ring-color);\n  box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000);\n  --tw-ring-color: hsl(var(--primary));\n  --tw-ring-offset-width: 2px;\n}\n\n.dashboard-button:focus-visible {\n  --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);\n  --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(2px + var(--tw-ring-offset-width)) var(--tw-ring-color);\n  box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000);\n  --tw-ring-color: hsl(var(--primary));\n  --tw-ring-offset-width: 2px;\n}\n\n/* Dark Mode Optimizations */\n@media (prefers-color-scheme: dark) {\n  .dashboard-card {\n    border-color: hsl(var(--border));\n    background-color: hsl(var(--card));\n  }\n\n  .dashboard-header {\n    background-color: hsl(var(--card) / 0.95);\n  }\n}\n\n/* ✅ ACCESSIBILITÉ: Reduced Motion - Désactiver toutes les animations */\n@media (prefers-reduced-motion: reduce) {\n  .dashboard-card,\n  .dashboard-icon-container,\n  .dashboard-notification-item,\n  .dashboard-activity-item,\n  .dashboard-button {\n    transition-property: none;\n    will-change: auto;\n  }\n\n  .dashboard-card:hover,\n  .dashboard-icon-container:hover {\n    transform: none;\n  }\n\n  .animate-fade-in,\n  .animate-fade-in-delayed,\n  .animate-in {\n    animation: none !important;\n  }\n\n  /* Désactiver les animations inline dans les composants React */\n  [style*='animationDelay'] {\n    animation: none !important;\n  }\n}\n\n/* ✅ PERFORMANCE: Désactiver will-change quand l'animation est terminée */\n@supports (animation-timeline: scroll()) {\n  .dashboard-card {\n    animation-timeline: view();\n  }\n}\n"
