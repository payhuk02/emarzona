const __vite__css = "/* ✅ UTILITAIRES: Classes communes pour réduire la duplication */\n.dashboard-card-base {\n  border-color: hsl(var(--border) / 0.5);\n  background-color: hsl(var(--card) / 0.5);\n  --tw-backdrop-blur: blur(4px);\n  backdrop-filter: var(--tw-backdrop-blur) var(--tw-backdrop-brightness) var(--tw-backdrop-contrast) var(--tw-backdrop-grayscale) var(--tw-backdrop-hue-rotate) var(--tw-backdrop-invert) var(--tw-backdrop-opacity) var(--tw-backdrop-saturate) var(--tw-backdrop-sepia);\n}\n\n.dashboard-card-hover {\n  transition-property: all;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 300ms;\n  animation-duration: 300ms;\n}\n\n.dashboard-card-hover:hover {\n  --tw-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);\n  --tw-shadow-colored: 0 10px 15px -3px var(--tw-shadow-color), 0 4px 6px -4px var(--tw-shadow-color);\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\n}\n\n.dashboard-text-responsive {\n  font-size: 1rem;\n  line-height: 1.625rem;\n  letter-spacing: 0;\n  font-weight: 600;\n}\n\n@media (min-width: 768px) {\n  .dashboard-text-responsive {\n    font-size: 1.125rem;\n    line-height: 1.75rem;\n    letter-spacing: 0;\n  }\n}\n\n.dashboard-text-responsive-small {\n  font-size: 0.875rem;\n  line-height: 1.375rem;\n  letter-spacing: 0;\n  font-weight: 400;\n}\n\n@media (min-width: 768px) {\n  .dashboard-text-responsive-small {\n    font-size: 1rem;\n    line-height: 1.625rem;\n    letter-spacing: 0;\n  }\n}\n\n/* ——— Sections tableau de bord (séparation claire) ——— */\n.dashboard-section {\n  border-radius: 1rem;\n  border-width: 1px;\n  border-color: hsl(var(--border) / 0.6);\n  background-color: hsl(var(--card) / 0.8);\n  --tw-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);\n  --tw-shadow-colored: 0 1px 2px 0 var(--tw-shadow-color);\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\n  padding: 1rem;\n}\n@media (min-width: 640px) {\n  .dashboard-section {\n    padding: 1.25rem;\n  }\n}\n@media (min-width: 768px) {\n  .dashboard-section {\n    padding: 1.5rem;\n  }\n}\n@media (min-width: 1024px) {\n  .dashboard-section {\n    padding: 2rem;\n  }\n}\n\n.dashboard-section + .dashboard-section {\n  margin-top: 1.5rem;\n}\n\n@media (min-width: 640px) {\n  .dashboard-section + .dashboard-section {\n    margin-top: 2rem;\n  }\n}\n\n@media (min-width: 768px) {\n  .dashboard-section + .dashboard-section {\n    margin-top: 2.5rem;\n  }\n}\n\n.dashboard-section-header {\n  margin-bottom: 1rem;\n  border-bottom-width: 1px;\n  border-color: hsl(var(--border) / 0.5);\n  padding-bottom: 1rem;\n}\n\n@media (min-width: 640px) {\n  .dashboard-section-header {\n    margin-bottom: 1.25rem;\n  }\n}\n\n@media (min-width: 768px) {\n  .dashboard-section-header {\n    margin-bottom: 1.5rem;\n  }\n}\n\n.dashboard-section-title {\n  font-family: var(--lp-serif, Georgia, serif);\n  font-size: 1.125rem;\n  line-height: 1.75rem;\n  letter-spacing: 0;\n  font-weight: 700;\n  letter-spacing: -0.025em;\n  color: hsl(var(--foreground));\n}\n\n@media (min-width: 640px) {\n  .dashboard-section-title {\n    font-size: 1.25rem;\n    line-height: 1.75rem;\n    letter-spacing: 0;\n  }\n}\n\n@media (min-width: 768px) {\n  .dashboard-section-title {\n    font-size: 1.5rem;\n    line-height: 2rem;\n    letter-spacing: -0.01em;\n  }\n}\n\n.dashboard-section-title {\n  letter-spacing: -0.02em;\n}\n\n.dashboard-section-description {\n  margin-top: 0.375rem;\n  max-width: 48rem;\n  font-size: 0.875rem;\n  line-height: 1.375rem;\n  letter-spacing: 0;\n  font-weight: 400;\n  line-height: 1.625;\n  color: hsl(var(--muted-foreground));\n}\n\n@media (min-width: 640px) {\n  .dashboard-section-description {\n    margin-top: 0.5rem;\n  }\n}\n\n@media (min-width: 768px) {\n  .dashboard-section-description {\n    font-size: 1rem;\n    line-height: 1.625rem;\n    letter-spacing: 0;\n  }\n}\n\n@