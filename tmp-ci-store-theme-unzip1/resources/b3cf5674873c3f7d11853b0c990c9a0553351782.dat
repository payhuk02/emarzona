ange pour animations fluides */\n  will-change: transform;\n}\n\n.dashboard-icon-container:hover {\n  transform: scale(1.1);\n}\n\n/* ✅ PERFORMANCE: Limiter les animations sur mobile */\n@media (max-width: 767px) {\n  .dashboard-icon-container {\n    will-change: auto;\n  }\n\n  .dashboard-icon-container:hover {\n    transform: none;\n  }\n}\n\n@media (max-width: 360px) {\n\n    /* Padding réduit pour très petits écrans */\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n\n    .dashboard-notification-item {\n      gap: 0.5rem;\n    }\n\n    /* Grilles adaptées */\n  }\n\n.dashboard-notification-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.75rem;\n  border-radius: var(--radius);\n  padding: 0.75rem;\n  transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n\n.dashboard-notification-item:hover {\n  background-color: hsl(var(--muted) / 0.5);\n}\n\n.dashboard-notification-item {\n  min-height: 60px;\n  touch-action: manipulation;\n}\n\n@media (max-width: 360px) {\n\n    /* Padding réduit pour très petits écrans */\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n\n    .dashboard-activity-item {\n      gap: 0.5rem;\n    }\n\n    /* Grilles adaptées */\n  }\n\n.dashboard-activity-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.75rem;\n  border-radius: var(--radius);\n  padding: 0.75rem;\n  transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n\n.dashboard-activity-item:hover {\n 