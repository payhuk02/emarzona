import { createHotContext as __vite__createHotContext } from "/@vite/client";import.meta.hot = __vite__createHotContext("/src/styles/landing-premium.css");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from "/@vite/client"
const __vite__id = "/home/runner/work/emarzona/emarzona/src/styles/landing-premium.css"
const __vite__css = "/* Emarzona Premium Landing — design system haute gamme */\n/* Polices chargées à la demande depuis Landing.tsx (évite @import bloquant) */\n.landing-premium {\n  --lp-ink: #08080a;\n  --lp-ink-soft: #121218;\n  --lp-ink-muted: #1a1a22;\n  --lp-surface: #fafaf9;\n  --lp-surface-muted: #f4f3f0;\n  --lp-surface-elevated: #ffffff;\n  --lp-gold: #c9a227;\n  --lp-gold-bright: #e4c76a;\n  --lp-gold-deep: #9a7b1a;\n  --lp-cream: #f5f0e6;\n  --lp-text: #0f0f12;\n  --lp-text-muted: #5c5c66;\n  --lp-text-on-dark: #e8e6e1;\n  --lp-text-dim: #9a9890;\n  --lp-purple: #7c5cff;\n  --lp-blue: #2563eb;\n  --lp-blue-bright: #3b82f6;\n  --lp-blue-deep: #1d4ed8;\n  --lp-orange: #f97316;\n  --lp-orange-deep: #ea580c;\n  --lp-blue-glow: rgba(37, 99, 235, 0.35);\n  --lp-violet-glow: rgba(124, 92, 255, 0.35);\n  --lp-gold-glow: rgba(201, 162, 39, 0.25);\n  --lp-border: rgba(255, 255, 255, 0.08);\n  --lp-border-light: rgba(15, 15, 18, 0.08);\n  --lp-ease: cubic-bezier(0.22, 1, 0.36, 1);\n  --lp-serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;\n  --lp-sans: 'DM Sans', system-ui, sans-serif;\n  --lp-section-py: clamp(4rem, 8vw, 7rem);\n\n  font-family: var(--lp-sans);\n  color: var(--lp-text);\n  background: var(--lp-surface);\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  overflow-x: hidden;\n}\n/* Texture grain subtile — sections sombres */\n.landing-premium .lp-hero-grain {\n  opacity: 0.04;\n  background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\");\n}\n/* Hero — animations CSS (sans framer-motion sur le chemin critique) */\n@keyframes lp-hero-fade-up {\n  from {\n    opacity: 0;\n    transform: translateY(20px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n@keyframes lp-hero-scale-in {\n  from {\n    opacity: 0;\n    transform: scale(0.96);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n.landing-premium .lp-hero-animate {\n  animation: lp-hero-fade-up 0.75s var(--lp-ease) both;\n}\n.landing-premium .lp-hero-animate--delay-1 {\n  animation-delay: 0.08s;\n}\n.landing-premium .lp-hero-animate--delay-2 {\n  animation-delay: 0.16s;\n}\n.landing-premium .lp-hero-animate--delay-3 {\n  animation-delay: 0.24s;\n}\n.landing-premium .lp-hero-animate--delay-4 {\n  animation-delay: 0.4s;\n}\n.landing-premium .lp-hero-animate-scale {\n  animation: lp-hero-scale-in 1s var(--lp-ease) 0.2s both;\n}\n/* Hero — pas de mouvement à l'affichage */\n.landing-premium .lp-hero .lp-hero-animate,\n.landing-premium .lp-hero .lp-hero-animate-scale {\n  animation: none;\n  opacity: 1;\n  transform: none;\n}\n.landing-premium .lp-section-light {\n  background: var(--lp-surface-elevated);\n}\n.landing-premium .lp-section-muted {\n  background: var(--lp-surface-muted);\n}\n.landing-premium .lp-section-pad {\n  padding-top: var(--lp-section-py);\n  padding-bottom: var(--lp-section-py);\n}\n/* Eyebrow — libellés de section (landing uniquement) */\n.landing-premium:not(.marketplace-premium) .lp-eyebrow,\n.landing-premium:not(.marketplace-premium) .lp-eyebrow-light {\n  display: inline-flex;\n  align-items: center;\n  border-radius: 9999px;\n  border: 1px solid var(--lp-orange-deep);\n  background: var(--lp-orange);\n  padding: 0.375rem 0.875rem;\n  font-size: 0.625rem;\n  font-weight: 700;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: #fff;\n}\n@media (min-width: 640px) {\n  .landing-premium:not(.marketplace-premium) .lp-eyebrow,\n  .landing-premium:not(.marketplace-premium) .lp-eyebrow-light {\n    font-size: 0.75rem;\n  }\n}\n/* Légende hero — hors zone de clip */\n.landing-premium .lp-hero-caption {\n  width: 100%;\n  max-width: 20rem;\n  font-size: 0.6875rem;\n  font-weight: 500;\n  letter-spacing: 0.26em;\n  text-transform: uppercase;\n  color: rgba(255, 255, 255, 0.42);\n  line-height: 1.5;\n}\n@media (min-width: 640px) {\n  .landing-premium .lp-hero-caption {\n    font-size: 0.75rem;\n    letter-spacing: 0.28em;\n    max-width: none;\n  }\n}\n.landing-premium .lp-serif {\n  font-family: var(--lp-serif);\n  font-weight: 500;\n  letter-spacing: -0.02em;\n}\n.landing-premium .lp-gold-text {\n  color: var(--lp-blue);\n  font-weight: 700;\n}\n.landing-premium .lp-btn-primary,\n.landing-premium .lp-btn-gold {\n  background: linear-gradient(\n    135deg,\n    var(--lp-blue-bright) 0%,\n    var(--lp-blue) 55%,\n    var(--lp-blue-deep) 100%\n  );\n  color: #fff;\n  font-weight: 600;\n  border: none;\n  box-shadow:\n    0 4px 24px var(--lp-blue-glow),\n    inset 0 1px 0 rgba(255, 255, 255, 0.25);\n  transition:\n    transform 0.45s var(--lp-ease),\n    box-shadow 0.45s var(--lp-ease);\n}\n.landing-premium .lp-btn-primary:hover,\n.landing-premium .lp-btn-gold:hover {\n  transform: translateY(-2px);\n  box-shadow:\n    0 8px 32px var(--lp-blue-glow),\n    inset 0 1px 0 rgba(255, 255, 255, 0.3);\n}\n.landing-premium .lp-btn-outline {\n  background: transparent;\n  color: #fff;\n  border: 1px solid rgba(59, 130, 246, 0.55);\n  transition:\n    border-color 0.4s var(--lp-ease),\n    background 0.4s var(--lp-ease),\n    color 0.4s var(--lp-ease);\n}\n.landing-premium .lp-btn-outline:hover {\n  border-color: var(--lp-blue-bright);\n  background: rgba(37, 99, 235, 0.12);\n  color: #fff;\n}\n.landing-premium .lp-btn-outline-light {\n  background: transparent;\n  color: var(--lp-blue);\n  border: 1px solid rgba(37, 99, 235, 0.35);\n  font-weight: 500;\n  transition:\n    border-color 0.4s var(--lp-ease),\n    background 0.4s var(--lp-ease);\n}\n.landing-premium .lp-btn-outline-light:hover {\n  border-color: var(--lp-blue);\n  background: rgba(37, 99, 235, 0.06);\n}\n.landing-premium .lp-reveal {\n  opacity: 0;\n  transform: translateY(28px);\n  transition:\n    opacity 0.9s var(--lp-ease),\n    transform 0.9s var(--lp-ease);\n}\n.landing-premium .lp-reveal.is-visible {\n  opacity: 1;\n  transform: translateY(0);\n}\n/* Cartes premium */\n.landing-premium .lp-card {\n  border-radius: 1rem;\n  border: 1px solid var(--lp-border-light);\n  background: var(--lp-surface-elevated);\n  box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04);\n  transition:\n    transform 0.5s var(--lp-ease),\n    box-shadow 0.5s var(--lp-ease),\n    border-color 0.5s var(--lp-ease);\n}\n.landing-premium .lp-card:hover {\n  transform: translateY(-3px);\n  border-color: rgba(201, 162, 39, 0.15);\n  box-shadow:\n    0 24px 48px -24px rgba(0, 0, 0, 0.1),\n    0 0 0 1px rgba(201, 162, 39, 0.06);\n}\n/* Section « Cinq façons de vendre » — icônes premium (desktop) */\n@media (min-width: 1024px) {\n  .landing-premium .lp-sell-way-card {\n    align-items: center;\n    text-align: center;\n  }\n}\n.landing-premium .lp-sell-way-icon {\n  background: transparent;\n  border: none;\n  box-shadow: none;\n  color: var(--lp-text);\n  transition: transform 0.5s var(--lp-ease);\n}\n.landing-premium .lp-sell-way-card:hover .lp-sell-way-icon {\n  transform: translateY(-2px);\n}\n.landing-premium .lp-sell-way-icon__svg {\n  color: var(--lp-text);\n}\n@media (min-width: 1024px) {\n  .landing-premium .lp-sell-way-icon {\n    height: 3.5rem;\n    width: 3.5rem;\n    border-radius: 1rem;\n  }\n\n  .landing-premium .lp-sell-way-icon__svg {\n    height: 1.5rem;\n    width: 1.5rem;\n    stroke-width: 1.5;\n  }\n}\n.landing-premium .lp-feature-cell {\n  padding: 1.25rem;\n  border-radius: 0.875rem;\n  transition: background 0.4s var(--lp-ease);\n}\n.landing-premium .lp-feature-cell:hover {\n  background: rgba(245, 240, 230, 0.5);\n}\n.landing-premium .lp-feature-icon {\n  display: flex;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  background: transparent;\n  border: none;\n  box-shadow: none;\n  color: var(--lp-text);\n}\n.landing-premium .lp-pricing-dark {\n  border: 1px solid var(--lp-border-light);\n  background: linear-gradient(135deg, #0f0f12 0%, #15151c 50%, #1a1a24 100%);\n  color: #fff;\n  box-shadow: 0 28px 56px -32px rgba(15, 15, 18, 0.45);\n  transition:\n    transform 0.45s var(--lp-ease),\n    box-shadow 0.45s var(--lp-ease);\n}\n.landing-premium .lp-pricing-dark:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 32px 64px -28px rgba(15, 15, 18, 0.55);\n}\n.landing-premium .lp-pricing-dark--highlight {\n  border-color: rgba(201, 162, 39, 0.45);\n  box-shadow:\n    0 28px 56px -32px rgba(15, 15, 18, 0.45),\n    0 0 0 1px rgba(201, 162, 39, 0.2);\n}\n.landing-premium .lp-btn-outline-dark {\n  border: 1px solid rgba(255, 255, 255, 0.2);\n  background: transparent;\n  color: #fff;\n}\n.landing-premium .lp-btn-outline-dark:hover {\n  background: rgba(255, 255, 255, 0.08);\n}\n.landing-premium .lp-pricing-card {\n  border-radius: 1.25rem;\n  border: 1px solid var(--lp-border-light);\n  background: var(--lp-surface);\n  transition:\n    transform 0.45s var(--lp-ease),\n    box-shadow 0.45s var(--lp-ease);\n}\n.landing-premium .lp-pricing-card:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 20px 40px -28px rgba(0, 0, 0, 0.12);\n}\n.landing-premium .lp-pricing-card--highlight {\n  border-color: rgba(201, 162, 39, 0.35);\n  background: linear-gradient(180deg, var(--lp-cream) 0%, #fff 100%);\n  box-shadow: 0 24px 48px -24px rgba(201, 162, 39, 0.22);\n}\n.landing-premium .lp-pricing-section {\n  content-visibility: auto;\n  contain-intrinsic-size: auto 1200px;\n}\n.landing-premium .lp-pricing-commission {\n  box-shadow: 0 28px 56px -32px rgba(15, 15, 18, 0.45);\n}\n.landing-premium .lp-deferred-section {\n  content-visibility: auto;\n  contain-intrinsic-size: auto 480px;\n}\n/* Marquee boutiques */\n.landing-premium .lp-marquee-mask {\n  mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);\n  -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);\n}\n.landing-premium .lp-marquee-track {\n  --lp-marquee-duration: 60s;\n  animation: lp-marquee-scroll var(--lp-marquee-duration) linear infinite;\n  animation-duration: var(--lp-marquee-duration) !important;\n  animation-iteration-count: infinite !important;\n  will-change: transform;\n}\n.landing-premium .lp-marquee-item {\n  transition:\n    transform 0.5s var(--lp-ease),\n    box-shadow 0.5s var(--lp-ease);\n}\n.landing-premium .lp-marquee-item:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.12);\n}\n@keyframes lp-marquee-scroll {\n  0% {\n    transform: translateX(0);\n  }\n  100% {\n    transform: translateX(-50%);\n  }\n}\n/* Marquee pays & drapeaux */\n.landing-premium .lp-countries-section {\n  isolation: isolate;\n}\n.landing-premium .lp-countries-marquee-mask {\n  mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);\n  -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);\n}\n.landing-premium .lp-countries-marquee-track {\n  --lp-countries-duration: 280s;\n  animation: lp-countries-scroll var(--lp-countries-duration) linear infinite;\n  animation-duration: var(--lp-countries-duration) !important;\n  animation-iteration-count: infinite !important;\n  will-change: transform;\n}\n.landing-premium .lp-country-flag-wrap {\n  display: inline-flex;\n  flex-shrink: 0;\n  width: 2.5rem;\n  height: 1.75rem;\n  line-height: 0;\n  background: rgba(255, 255, 255, 0.06);\n}\n.landing-premium .lp-country-flag-img {\n  display: block;\n  flex-shrink: 0;\n  background-size: cover;\n  background-position: center;\n  background-repeat: no-repeat;\n  transform: translateZ(0);\n}\n@media (max-width: 768px) {\n  .landing-premium .lp-marquee-item img {\n    opacity: 1 !important;\n    max-width: none !important;\n    width: 2.5rem !important;\n    height: 2.5rem !important;\n    border-radius: 0.75rem;\n    -o-object-fit: cover;\n       object-fit: cover;\n  }\n\n  .landing-premium .lp-country-chip {\n    backdrop-filter: none;\n    -webkit-backdrop-filter: none;\n  }\n}\n.landing-premium .lp-countries-marquee-track--reverse {\n  animation-name: lp-countries-scroll-reverse;\n  --lp-countries-duration: 220s;\n  animation-duration: var(--lp-countries-duration) !important;\n  animation-iteration-count: infinite !important;\n}\n.landing-premium .lp-country-chip {\n  transition:\n    transform 0.45s var(--lp-ease),\n    border-color 0.45s var(--lp-ease),\n    background 0.45s var(--lp-ease),\n    box-shadow 0.45s var(--lp-ease);\n}\n.landing-premium .lp-country-chip:hover {\n  transform: translateY(-2px);\n  border-color: rgba(59, 130, 246, 0.35);\n  background: rgba(255, 255, 255, 0.08);\n  box-shadow: 0 8px 28px -8px rgba(37, 99, 235, 0.25);\n}\n@keyframes lp-countries-scroll {\n  0% {\n    transform: translateX(0);\n  }\n  100% {\n    transform: translateX(-50%);\n  }\n}\n@keyframes lp-countries-scroll-reverse {\n  0% {\n    transform: translateX(-50%);\n  }\n  100% {\n    transform: translateX(0);\n  }\n}\n@media (max-width: 768px) {\n  .landing-premium .lp-countries-marquee-track {\n    --lp-countries-duration: 12s;\n  }\n\n  .landing-premium .lp-countries-marquee-track--reverse {\n    --lp-countries-duration: 14s;\n  }\n}\n/* Marquee devises */\n.landing-premium .lp-currencies-section {\n  isolation: isolate;\n}\n.landing-premium .lp-currencies-marquee-mask {\n  mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);\n  -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);\n}\n.landing-premium .lp-currencies-marquee-track {\n  --lp-currencies-duration: 200s;\n  animation: lp-countries-scroll var(--lp-currencies-duration) linear infinite;\n  animation-duration: var(--lp-currencies-duration) !important;\n  animation-iteration-count: infinite !important;\n  will-change: transform;\n}\n.landing-premium .lp-currencies-marquee-track--reverse {\n  animation-name: lp-countries-scroll-reverse;\n  --lp-currencies-duration: 220s;\n  animation-duration: var(--lp-currencies-duration) !important;\n  animation-iteration-count: infinite !important;\n}\n.landing-premium .lp-currency-logo-wrap {\n  display: inline-flex;\n  flex-shrink: 0;\n  width: 2.25rem;\n  height: 2.25rem;\n  line-height: 0;\n}\n.landing-premium .lp-currency-logo-img {\n  display: block;\n  flex-shrink: 0;\n  background-size: cover;\n  background-position: center;\n  background-repeat: no-repeat;\n  transform: translateZ(0);\n}\n.landing-premium .lp-currency-chip {\n  transition:\n    transform 0.45s var(--lp-ease),\n    border-color 0.45s var(--lp-ease),\n    box-shadow 0.45s var(--lp-ease);\n}\n.landing-premium .lp-currency-chip:hover {\n  transform: translateY(-2px);\n  border-color: rgba(201, 162, 39, 0.35);\n  box-shadow: 0 8px 24px -8px rgba(201, 162, 39, 0.18);\n}\n@media (max-width: 768px) {\n  .landing-premium .lp-currencies-marquee-track {\n    --lp-currencies-duration: 11s;\n  }\n\n  .landing-premium .lp-currencies-marquee-track--reverse {\n    --lp-currencies-duration: 13s;\n  }\n\n  .landing-premium .lp-currencies-marquee-track {\n    animation: lp-countries-scroll var(--lp-currencies-duration) linear infinite !important;\n  }\n\n  .landing-premium .lp-currencies-marquee-track--reverse {\n    animation: lp-countries-scroll-reverse var(--lp-currencies-duration) linear infinite !important;\n  }\n\n  .landing-premium .lp-currency-logo-wrap {\n    width: 2.25rem;\n    height: 2.25rem;\n  }\n}\n.landing-premium .lp-adapt-visual {\n  order: -1;\n  width: 100%;\n  min-width: 0;\n}\n@media (min-width: 1024px) {\n  .landing-premium .lp-adapt-visual {\n    order: 0;\n  }\n}\n.landing-premium .lp-adapt-photo {\n  position: relative;\n  width: 100%;\n}\n.landing-premium .lp-adapt-photo__img,\n.landing-premium .lp-adapt-photo img {\n  display: block;\n  width: 100%;\n  height: auto;\n  -o-object-fit: contain;\n     object-fit: contain;\n  -o-object-position: center;\n     object-position: center;\n}\n/* Navbar premium */\n.landing-premium .lp-premium-nav {\n  isolation: isolate;\n  background: linear-gradient(180deg, rgba(14, 14, 18, 0.94) 0%, rgba(8, 8, 10, 0.9) 100%);\n  border-bottom: 1px solid rgba(255, 255, 255, 0.07);\n  box-shadow:\n    0 1px 0 rgba(255, 255, 255, 0.04) inset,\n    0 12px 40px -16px rgba(0, 0, 0, 0.65);\n  backdrop-filter: blur(20px) saturate(1.25);\n  -webkit-backdrop-filter: blur(20px) saturate(1.25);\n}\n.landing-premium .lp-premium-nav::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background:\n    radial-gradient(ellipse 55% 120% at 8% -20%, rgba(201, 162, 39, 0.12) 0%, transparent 55%),\n    radial-gradient(ellipse 45% 100% at 92% -30%, rgba(37, 99, 235, 0.14) 0%, transparent 50%);\n}\n.landing-premium .lp-premium-nav::after {\n  content: '';\n  position: absolute;\n  left: 0;\n  right: 0;\n  top: 0;\n  height: 1px;\n  pointer-events: none;\n  background: linear-gradient(\n    90deg,\n    transparent 0%,\n    rgba(201, 162, 39, 0.35) 22%,\n    rgba(96, 165, 250, 0.4) 50%,\n    rgba(201, 162, 39, 0.35) 78%,\n    transparent 100%\n  );\n  opacity: 0.85;\n}\n.landing-premium .lp-premium-nav__inner {\n  position: relative;\n  z-index: 1;\n}\n.landing-premium .lp-nav-menu {\n  padding-inline: 0.5rem;\n}\n.landing-premium .lp-nav-menu__pill {\n  flex-shrink: 1;\n}\n.landing-premium .lp-premium-nav__drawer {\n  background: linear-gradient(180deg, rgba(12, 12, 16, 0.98) 0%, rgba(8, 8, 10, 0.99) 100%);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n}\n.landing-premium .lp-nav-logo {\n  min-width: 0;\n}\n.landing-premium .lp-nav-logo img {\n  display: block;\n  height: 100%;\n  max-height: 2.5rem;\n  width: auto;\n  max-width: min(100%, 200px);\n  -o-object-fit: contain;\n     object-fit: contain;\n  -o-object-position: left center;\n     object-position: left center;\n}\n@media (min-width: 1024px) {\n  .landing-premium .lp-nav-logo img {\n    max-height: 2.75rem;\n    max-width: 220px;\n  }\n}\n.landing-premium .lp-nav-ghost {\n  font-size: 0.875rem;\n  font-weight: 500;\n  color: rgba(255, 255, 255, 0.72);\n  transition: color 0.3s var(--lp-ease);\n}\n.landing-premium .lp-nav-ghost:hover {\n  color: #fff;\n}\n.landing-premium .lp-nav-cta {\n  min-height: 2.5rem;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  line-height: 1;\n}\n.landing-premium .lp-nav-control .lp-lang-switcher {\n  height: 2.5rem;\n  min-height: 2.5rem;\n  border-radius: 9999px;\n  padding-left: 0.75rem;\n  padding-right: 0.75rem;\n}\n.landing-premium .lp-nav-icon-btn {\n  backdrop-filter: blur(8px);\n}\n.landing-premium .lp-footer-logo {\n  position: relative;\n  z-index: 30;\n  display: inline-flex;\n  max-width: 100%;\n}\n.landing-premium .lp-footer-logo-img {\n  display: block;\n  filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.55));\n}\n.landing-premium .lp-footer-newsletter input {\n  font-size: 16px;\n}\n@media (min-width: 640px) {\n  .landing-premium .lp-footer-newsletter input {\n    font-size: 0.875rem;\n  }\n}\n.landing-premium .lp-cta-globe {\n  isolation: isolate;\n  min-height: 280px;\n}\n.landing-premium .lp-cta-globe-halo {\n  background: radial-gradient(\n    circle,\n    rgba(59, 130, 246, 0.35) 0%,\n    rgba(37, 99, 235, 0.15) 45%,\n    transparent 70%\n  );\n}\n.landing-premium .lp-cta-globe-sphere {\n  border-radius: 50%;\n  overflow: hidden;\n  background: radial-gradient(circle at 32% 28%, #2563eb 0%, #1e3a5f 42%, #0a0a12 100%);\n  box-shadow:\n    0 0 0 2px rgba(96, 165, 250, 0.35),\n    0 0 48px rgba(59, 130, 246, 0.45),\n    0 16px 40px rgba(0, 0, 0, 0.5);\n}\n.landing-premium .lp-cta-globe__img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  mix-blend-mode: normal;\n  filter: contrast(1.12) saturate(1.2) brightness(1.08);\n  -o-object-fit: cover;\n     object-fit: cover;\n  -o-object-position: center;\n     object-position: center;\n}\n@media (max-width: 639px) {\n  .landing-premium .lp-cta-globe {\n    min-height: 300px;\n    padding: 0.5rem 0 1rem;\n  }\n\n  .landing-premium .lp-cta-globe-sphere {\n    height: 72%;\n    width: 72%;\n    min-height: 210px;\n    min-width: 210px;\n  }\n\n  .landing-premium .lp-cta-globe__img {\n    filter: contrast(1.18) saturate(1.28) brightness(1.12);\n  }\n\n  .landing-premium .lp-cta-globe-halo {\n    inset: 0;\n  }\n}\n.landing-premium .lp-cta-logo-panel {\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.04) 100%);\n  border: 1px solid rgba(255, 255, 255, 0.14);\n  border-radius: 1.25rem;\n  padding: clamp(1.25rem, 4vw, 2rem);\n  box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.55);\n}\n.landing-premium .lp-cta-logo-glow {\n  background: radial-gradient(\n    circle,\n    rgba(59, 130, 246, 0.28) 0%,\n    rgba(37, 99, 235, 0.14) 40%,\n    transparent 70%\n  );\n  animation: lp-cta-glow-pulse 5s ease-in-out infinite;\n}\n@keyframes lp-cta-glow-pulse {\n  0%,\n  100% {\n    opacity: 0.7;\n    transform: scale(0.95);\n  }\n  50% {\n    opacity: 1;\n    transform: scale(1.05);\n  }\n}\n.landing-premium .lp-lang-switcher:focus-visible {\n  outline: 2px solid rgba(201, 162, 39, 0.5);\n  outline-offset: 2px;\n}\n/* Badge machine à écrire — hero droit */\n.landing-premium .lp-hero-typewriter-badge {\n  position: relative;\n  z-index: 2;\n  display: block;\n  align-self: center;\n  width: 100%;\n  max-width: min(100%, 480px);\n  border-radius: 1rem;\n  border: 1px solid rgba(201, 162, 39, 0.45);\n  background: linear-gradient(\n    135deg,\n    rgba(201, 162, 39, 0.18) 0%,\n    rgba(124, 92, 255, 0.1) 55%,\n    rgba(8, 8, 10, 0.65) 100%\n  );\n  box-shadow:\n    0 0 0 1px rgba(255, 255, 255, 0.06) inset,\n    0 8px 24px -12px rgba(0, 0, 0, 0.55);\n  backdrop-filter: blur(10px);\n  font-size: 0.625rem;\n  font-weight: 600;\n  letter-spacing: 0.03em;\n  line-height: 1.45;\n  color: rgba(255, 255, 255, 0.92);\n}\n@media (min-width: 640px) {\n  .landing-premium .lp-hero-typewriter-badge {\n    max-width: min(100%, 540px);\n    font-size: 0.6875rem;\n  }\n}\n@media (min-width: 1024px) {\n  .landing-premium .lp-hero-typewriter-badge {\n    align-self: flex-start;\n    max-width: 100%;\n  }\n}\n.landing-premium .lp-hero-typewriter-badge__ghost {\n  display: block;\n  visibility: hidden;\n  padding: 0.5rem 1rem;\n  white-space: normal;\n  word-wrap: break-word;\n}\n.landing-premium .lp-hero-typewriter-badge__live {\n  position: absolute;\n  inset: 0;\n  padding: 0.5rem 1rem;\n  white-space: normal;\n  word-wrap: break-word;\n  overflow: hidden;\n}\n.landing-premium .lp-hero-typewriter-badge__cursor {\n  display: inline-block;\n  width: 1px;\n  height: 0.85em;\n  margin-left: 1px;\n  background: var(--lp-gold-bright);\n  animation: lp-typewriter-cursor 1s step-end infinite;\n  vertical-align: -0.05em;\n}\n@keyframes lp-typewriter-cursor {\n  0%,\n  100% {\n    opacity: 1;\n  }\n  50% {\n    opacity: 0;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .landing-premium .lp-hero-typewriter-badge__cursor {\n    display: none;\n  }\n}\n/* Hero carrousel premium */\n.landing-premium .lp-hero-carousel {\n  isolation: isolate;\n  width: 100%;\n  max-width: 100%;\n}\n.landing-premium .lp-hero-carousel__ambient {\n  background:\n    radial-gradient(ellipse 60% 50% at 55% 42%, rgba(124, 92, 255, 0.24) 0%, transparent 72%),\n    radial-gradient(ellipse 45% 38% at 52% 62%, rgba(201, 162, 39, 0.14) 0%, transparent 74%);\n  filter: blur(40px);\n}\n.landing-premium .lp-hero-carousel__stage {\n  position: relative;\n  overflow: hidden;\n  border-radius: 1.25rem;\n  aspect-ratio: 1024 / 561;\n  width: 100%;\n}\n@media (min-width: 1024px) {\n  .landing-premium .lp-hero-carousel__stage {\n    border-radius: 1.5rem;\n  }\n}\n.landing-premium .lp-hero-carousel__slide {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.landing-premium .lp-hero-carousel__slide--card {\n  background: linear-gradient(180deg, #fafaf9 0%, #f3f2ef 100%);\n}\n.landing-premium .lp-hero-carousel__picture {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  height: 100%;\n}\n.landing-premium .lp-hero-carousel__img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  -o-object-fit: contain;\n     object-fit: contain;\n  -o-object-position: center;\n     object-position: center;\n  filter: contrast(1.04) saturate(1.05);\n  backface-visibility: hidden;\n}\n.landing-premium .lp-hero-carousel__slide--transparent .lp-hero-carousel__img {\n  -o-object-position: center bottom;\n     object-position: center bottom;\n  filter: contrast(1.05) saturate(1.06);\n}\n.landing-premium .lp-hero-carousel__caption {\n  min-height: 2.75rem;\n}\n.landing-premium .lp-hero-carousel__progress {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  height: 2px;\n  transform-origin: left center;\n  background: linear-gradient(90deg, var(--lp-gold) 0%, var(--lp-purple) 100%);\n  opacity: 0.85;\n}\n@media (prefers-reduced-motion: reduce) {\n  .landing-premium .lp-hero-carousel__progress {\n    display: none;\n  }\n}\n@media (max-width: 379px) {\n  .landing-premium .lp-btn-primary,\n  .landing-premium .lp-btn-gold,\n  .landing-premium .lp-btn-outline,\n  .landing-premium .lp-btn-outline-light {\n    width: 100%;\n    justify-content: center;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .landing-premium .lp-hero-animate,\n  .landing-premium .lp-hero-animate-scale {\n    animation: none;\n    opacity: 1;\n    transform: none;\n  }\n\n  .landing-premium .lp-reveal {\n    opacity: 1;\n    transform: none;\n    transition: none;\n  }\n\n  .landing-premium .lp-marquee-track,\n  .landing-premium .lp-countries-marquee-track,\n  .landing-premium .lp-currencies-marquee-track {\n    animation: none;\n  }\n\n  .landing-premium .lp-compass-glow {\n    animation: none;\n  }\n\n  .landing-premium .lp-cta-logo-glow {\n    animation: none;\n  }\n\n  .landing-premium .lp-card:hover,\n  .landing-premium .lp-pricing-card:hover {\n    transform: none;\n  }\n}\n"
__vite__updateStyle(__vite__id, __vite__css)
import.meta.hot.accept()
import.meta.hot.prune(() => __vite__removeStyle(__vite__id))