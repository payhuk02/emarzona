import { createHotContext as __vite__createHotContext } from "/@vite/client";import.meta.hot = __vite__createHotContext("/src/styles/product-banners.css");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from "/@vite/client"
const __vite__id = "/home/runner/work/emarzona/emarzona/src/styles/product-banners.css"
const __vite__css = "/* ============================================================\n   OPTIMISATION DES BANNIÈRES PRODUITS - EMARZONA\n   Version Professionnelle - Inspirée des grandes plateformes\n   ============================================================ */\n\n/* Variables CSS pour la cohérence et la performance - Style ComeUp/Fiverr */\n:root {\n  /* Ratio par défaut des bannières aligné sur le format produit 1536×1024 (3:2) */\n  --product-banner-aspect-ratio: 3/2;\n  --mobile-margin: 0.125rem;\n  --tablet-margin: 1rem;\n  --desktop-margin: 1.5rem;\n  --border-radius-mobile: 0.75rem;\n  --border-radius-tablet: 1rem;\n  --border-radius-desktop: 1.25rem;\n  --transition-duration: 300ms;\n  /* Ombres supprimées pour affichage statique et professionnel */\n}\n\n/* Container principal pour les cartes produits - Optimisé pour toutes les plateformes */\n.product-card-container {\n  width: 100%;\n  /* Prévention du CLS et optimisation GPU */\n  contain: layout style;\n  transform: translateZ(0);\n  will-change: transform;\n}\n\n/* Container de bannière avec optimisations avancées */\n.product-banner-container {\n  position: relative;\n  width: 100%;\n  /* Optimisation GPU */\n  transform: translateZ(0);\n  will-change: transform;\n}\n\n/* Bannière produit avec ratio 3:2 professionnel */\n.product-banner {\n  position: relative;\n  width: 100%;\n  overflow: hidden;\n  aspect-ratio: var(--product-banner-aspect-ratio);\n  /* Qualité d'affichage optimisée */\n  image-rendering: high-quality;\n  -webkit-image-rendering: high-quality;\n  /* Optimisation GPU */\n  transform: translateZ(0);\n  will-change: transform;\n}\n\n/* Image optimisée avec rendu professionnel statique - Pas d'ombres, pas d'animations - Stable et optimisée */\n.product-banner img {\n  height: 100%;\n  width: 100%;\n  -o-object-fit: cover;\n     object-fit: cover;\n  /* Qualité d'affichage optimisée - Images nettes */\n  image-rendering: high-quality;\n  -webkit-image-rendering: high-quality;\n  /* Centrage parfait de l'image */\n  -o-object-position: center;\n     object-position: center;\n  /* Prévention du CLS */\n  contain: layout;\n  /* Coins arrondis pour l'image */\n  border-radius: inherit;\n  /* Pas d'ombres, affichage statique */\n  box-shadow: none !important;\n  filter: none;\n  /* S'assurer que l'image reste visible lors du scroll sur mobile */\n  position: relative !important;\n  z-index: 1 !important;\n  visibility: visible !important;\n  opacity: 1 !important;\n  display: block !important;\n  /* Stabilité garantie - pas de transformations */\n  transform: none !important;\n  /* Optimisation performance */\n  will-change: auto;\n  backface-visibility: visible;\n  -webkit-backface-visibility: visible;\n}\n\n/* Overlay gradient pour les effets visuels */\n.product-banner-overlay {\n  position: absolute;\n  inset: 0px;\n  background-image: linear-gradient(to top, var(--tw-gradient-stops));\n  --tw-gradient-from: rgb(0 0 0 / 0.6) var(--tw-gradient-from-position);\n  --tw-gradient-to: rgb(0 0 0 / 0) var(--tw-gradient-to-position);\n  --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to);\n  --tw-gradient-to: rgb(0 0 0 / 0)  var(--tw-gradient-to-position);\n  --tw-gradient-stops: var(--tw-gradient-from), transparent var(--tw-gradient-via-position), var(--tw-gradient-to);\n  --tw-gradient-to: transparent var(--tw-gradient-to-position);\n  opacity: 0;\n  transition-property: opacity;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 300ms;\n  animation-duration: 300ms;\n}\n\n.product-card:hover .product-banner-overlay {\n  opacity: 1;\n}\n\n/* Badges de promotion */\n.product-badge {\n  position: absolute;\n  top: 0.75rem;\n  right: 0.75rem;\n  z-index: 10;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  /* Optimisation GPU */\n  transform: translateZ(0);\n  will-change: transform;\n}\n\n/* Actions hover */\n.product-actions {\n  position: absolute;\n  top: 0.75rem;\n  right: 0.75rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  --tw-translate-x: 0.5rem;\n  transform: translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y));\n  opacity: 0;\n  transition-property: all;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 300ms;\n  animation-duration: 300ms;\n  /* Optimisation GPU */\n  transform: translateZ(0) translateX(8px);\n  will-change: transform, opacity;\n}\n\n.product-card:hover .product-actions {\n  opacity: 1;\n  transform: translateZ(0) translateX(0);\n}\n\n/* ============================================================\n   RESPONSIVE DESIGN - MOBILE FIRST\n   ============================================================ */\n\n/* Mobile (< 640px) - 1 produit par ligne - Affichage exact */\n@media (max-width: 639px) {\n  .product-card-container {\n    width: 96%;\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n  .product-banner {\n    border-radius: var(--border-radius-mobile);\n    /* Largeur 96% pour une meilleure utilisation de l'espace mobile */\n    width: 96%;\n    margin: 0 auto;\n  }\n\n  /* Grille mobile - EXACTEMENT 1 produit par ligne */\n  .products-grid-mobile {\n    display: grid;\n    grid-template-columns: repeat(1, minmax(0, 1fr));\n    gap: 1.5rem;\n    padding-left: 2%;\n    padding-right: 2%;\n    /* Optimisation GPU */\n    transform: translateZ(0);\n    will-change: transform;\n  }\n\n  /* Cartes produits mobile - Design professionnel */\n  .product-card-mobile {\n    margin-left: 0px;\n    margin-right: 0px;\n    width: 96%;\n    margin-left: auto;\n    margin-right: auto;\n    box-shadow: none;\n    border-radius: var(--border-radius-mobile);\n    background: transparent;\n    /* Effet de profondeur */\n    transform: translateZ(0);\n    will-change: transform;\n    /* Hauteur uniforme exacte */\n    height: 480px;\n    min-height: 480px;\n    max-height: 480px;\n  }\n\n  /* Contenu des cartes mobile */\n  .product-card-content-mobile {\n    padding: 1rem;\n  }\n\n  /* Boutons mobile - Style moderne */\n  .product-button-mobile {\n    width: 100%;\n    padding-top: 0.75rem;\n    padding-bottom: 0.75rem;\n    padding-left: 1rem;\n    padding-right: 1rem;\n    font-size: 0.875rem;\n    line-height: 1.375rem;\n    letter-spacing: 0;\n    border-radius: var(--border-radius-mobile);\n    font-weight: 600;\n    /* Optimisation GPU */\n    transform: translateZ(0);\n    will-change: transform;\n  }\n}\n\n/* Tablet (640px - 1024px) - EXACTEMENT 2 produits par ligne */\n@media (min-width: 640px) and (max-width: 1023px) {\n  .product-card-container {\n    margin-left: var(--tablet-margin);\n    margin-right: var(--tablet-margin);\n  }\n\n  .product-banner {\n    border-radius: var(--border-radius-tablet);\n  }\n\n  /* Grille tablette - EXACTEMENT 2 produits par ligne */\n  .products-grid-tablet {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 2rem;\n    padding-left: var(--tablet-margin);\n    padding-right: var(--tablet-margin);\n    /* Optimisation GPU */\n    transform: translateZ(0);\n    will-change: transform;\n  }\n\n  /* Cartes produits tablette */\n  .product-card-tablet {\n    box-shadow: none;\n    border-radius: var(--border-radius-tablet);\n    background: transparent;\n    /* Hauteur uniforme exacte */\n    height: 520px;\n    min-height: 520px;\n    max-height: 520px;\n    transition: all var(--transition-duration) cubic-bezier(0.4, 0, 0.2, 1);\n    /* Optimisation GPU */\n    transform: translateZ(0);\n    will-change: transform;\n  }\n\n  /* Pas d'effet hover - Affichage statique */\n  .product-card-tablet:hover {\n    transform: none;\n    box-shadow: none;\n  }\n}\n\n/* Desktop (> 1024px) - EXACTEMENT 3 produits par ligne */\n@media (min-width: 1024px) {\n  .product-card-container {\n    margin-left: var(--desktop-margin);\n    margin-right: var(--desktop-margin);\n  }\n\n  .product-banner {\n    border-radius: var(--border-radius-desktop);\n    /* Optimisation pour le ratio 1920x1080 */\n    max-width: 100%;\n    height: auto;\n  }\n\n  /* Grille desktop - EXACTEMENT 3 produits par ligne */\n  .products-grid-desktop {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 2rem;\n    padding-left: var(--desktop-margin);\n    padding-right: var(--desktop-margin);\n    /* Optimisation GPU */\n    transform: translateZ(0);\n    will-change: transform;\n  }\n\n  /* Affichage statique et professionnel pour desktop - Pas d'ombres */\n  .product-card-desktop {\n    box-shadow: none;\n    border-radius: var(--border-radius-desktop);\n    background: transparent;\n    /* Hauteur uniforme exacte */\n    height: 560px;\n    min-height: 560px;\n    max-height: 560px;\n  }\n\n  /* Pas d'effet hover - Affichage statique */\n  .product-card-desktop:hover {\n    transform: none;\n    box-shadow: none;\n  }\n\n  /* Optimisation pour les écrans ultra-larges - Maintenir EXACTEMENT 3 colonnes */\n  @media (min-width: 1920px) {\n    .products-grid-desktop {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n      gap: 2rem;\n      max-width: 1400px;\n      margin: 0 auto;\n    }\n  }\n}\n\n/* ============================================================\n   STYLES UNIFORMES POUR LES CARTES PRODUITS\n   ============================================================ */\n\n/* Hauteur uniforme pour toutes les cartes - Garantie exacte */\n.product-card {\n  display: flex;\n  flex-direction: column;\n  background: transparent;\n  /* Hauteur minimale pour éviter les décalages */\n  min-height: 480px;\n  /* Optimisation GPU */\n  transform: translateZ(0);\n  will-change: transform;\n  /* Transition fluide pour tous les effets */\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n/* Contenu des cartes - Espacement uniforme */\n.product-card-content {\n  display: flex;\n  flex: 1 1 0%;\n  flex-direction: column;\n  justify-content: space-between;\n  padding: 1rem;\n}\n\n/* Titres de produits - Style professionnel */\n.product-title {\n  font-size: 1rem;\n  line-height: 1.625rem;\n  letter-spacing: 0;\n  font-weight: 600;\n  line-height: 1.25;\n  min-height: 2.5rem;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n/* Prix - Style moderne */\n.product-price {\n  font-size: 1.125rem;\n  line-height: 1.75rem;\n  letter-spacing: 0;\n  font-weight: 700;\n  color: hsl(var(--primary));\n}\n\n/* Boutons d'action - Centrés et uniformes */\n.product-actions {\n  margin-top: 1rem;\n  display: flex;\n  gap: 0.5rem;\n}\n\n.product-button {\n  flex: 1 1 0%;\n  border-radius: var(--radius);\n  padding-top: 0.5rem;\n  padding-bottom: 0.5rem;\n  padding-left: 1rem;\n  padding-right: 1rem;\n  text-align: center;\n  font-weight: 500;\n  transition-property: all;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 200ms;\n  animation-duration: 200ms;\n  /* Optimisation GPU */\n  transform: translateZ(0);\n  will-change: transform;\n}\n\n.product-button-primary {\n  background-color: hsl(var(--primary));\n  color: hsl(var(--primary-foreground));\n}\n\n.product-button-primary:hover {\n  background-color: hsl(var(--primary) / 0.9);\n}\n\n.product-button-secondary {\n  background-color: hsl(var(--secondary));\n  color: hsl(var(--secondary-foreground));\n}\n\n.product-button-secondary:hover {\n  background-color: hsl(var(--secondary) / 0.9);\n}\n\n/* Étoiles de notation */\n.product-rating {\n  display: flex;\n  align-items: center;\n  gap: 0.25rem;\n  font-size: 0.875rem;\n  line-height: 1.375rem;\n  letter-spacing: 0;\n  color: hsl(var(--muted-foreground));\n}\n\n/* Badges de promotion */\n.product-badge {\n  position: absolute;\n  top: 0.75rem;\n  right: 0.75rem;\n  z-index: 10;\n}\n\n/* Pas d'effet hover - Affichage statique et professionnel */\n.product-card:hover {\n  transform: none;\n  box-shadow: none;\n}\n\n.product-card:hover .product-title {\n  color: hsl(var(--primary));\n}\n\n/* Prévention du CLS (Cumulative Layout Shift) */\n.product-banner {\n  contain: layout style;\n}\n\n/* Lazy loading optimisé */\n.product-banner img[loading='lazy'] {\n  opacity: 0;\n  transition: opacity 0.3s ease-in-out;\n}\n\n.product-banner img[loading='lazy'].loaded {\n  opacity: 1;\n}\n\n/* Placeholder de chargement */\n.product-banner-loading {\n  position: absolute;\n  inset: 0px;\n  background-image: linear-gradient(to bottom right, var(--tw-gradient-stops));\n  --tw-gradient-from: #334155 var(--tw-gradient-from-position);\n  --tw-gradient-to: rgb(51 65 85 / 0) var(--tw-gradient-to-position);\n  --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to);\n  --tw-gradient-to: #1e293b var(--tw-gradient-to-position);\n  display: flex;\n}\n@keyframes pulse {\n  50% {\n    opacity: .5;\n  }\n}\n.product-banner-loading {\n  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n  align-items: center;\n  justify-content: center;\n}\n\n/* ============================================================\n   COMPATIBILITÉ NAVIGATEURS\n   ============================================================ */\n\n/* Fallback pour les navigateurs sans support aspect-ratio */\n@supports not (aspect-ratio: 16/9) {\n  .product-banner {\n    position: relative;\n    padding-bottom: 56.25%; /* 16:9 ratio */\n  }\n\n  .product-banner img {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n  }\n}\n\n/* ============================================================\n   ACCESSIBILITÉ\n   ============================================================ */\n\n/* Focus visible pour l'accessibilité */\n.product-card:focus-visible {\n  outline-width: 2px;\n  outline-offset: 2px;\n  outline-color: #3b82f6;\n}\n\n/* Contraste amélioré pour les badges */\n.product-badge .badge {\n  font-weight: 600;\n  --tw-text-opacity: 1;\n  color: rgb(255 255 255 / var(--tw-text-opacity, 1));\n  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);\n}\n\n/* ============================================================\n   ANIMATIONS FLUIDES\n   ============================================================ */\n\n/* Animation d'entrée pour les cartes */\n@keyframes fadeInUp {\n  from {\n    opacity: 0;\n    transform: translateY(20px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.product-card {\n  animation: fadeInUp 0.5s ease-out;\n}\n\n/* Animation de chargement */\n@keyframes shimmer {\n  0% {\n    background-position: -200px 0;\n  }\n  100% {\n    background-position: calc(200px + 100%) 0;\n  }\n}\n\n.product-banner-loading::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);\n  background-size: 200px 100%;\n  animation: shimmer 1.5s infinite;\n}\n\n/* ============================================================\n   MODE SOMBRE OPTIMISÉ\n   ============================================================ */\n\n@media (prefers-color-scheme: dark) {\n  .product-card {\n    --tw-border-opacity: 1;\n    border-color: rgb(71 85 105 / var(--tw-border-opacity, 1));\n    background-color: transparent;\n  }\n\n  .product-card:hover {\n    --tw-border-opacity: 1;\n    border-color: rgb(100 116 139 / var(--tw-border-opacity, 1));\n  }\n\n  .product-banner-loading {\n    background-image: linear-gradient(to bottom right, var(--tw-gradient-stops));\n    --tw-gradient-from: #334155 var(--tw-gradient-from-position);\n    --tw-gradient-to: rgb(51 65 85 / 0) var(--tw-gradient-to-position);\n    --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to);\n    --tw-gradient-to: #1e293b var(--tw-gradient-to-position);\n  }\n}\n\n/* ============================================================\n   PRINT STYLES\n   ============================================================ */\n\n@media print {\n  .product-card {\n    -moz-column-break-inside: avoid;\n         break-inside: avoid;\n  }\n\n  .product-banner {\n    aspect-ratio: 1 / 1; /* Ratio carré pour l'impression */\n  }\n\n  .product-actions {\n    display: none; /* Masquer les actions pour l'impression */\n  }\n}\n\n/* ============================================================\n   OPTIMISATIONS PERFORMANCE AVANCÉES\n   ============================================================ */\n\n/* Utilisation de contain pour l'isolation des layouts */\n.product-card {\n  contain: layout style;\n}\n\n/* Optimisation des animations avec will-change */\n.product-card:hover {\n  will-change: transform;\n}\n\n.product-card:not(:hover) {\n  will-change: auto;\n}\n\n/* Préchargement des images critiques */\n.product-banner img[data-priority='true'] {\n  opacity: 1;\n}\n\n/* Optimisation des transitions */\n.product-card * {\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n/* Réduction des animations sur les appareils lents */\n@media (prefers-reduced-motion: reduce) {\n  .product-card {\n    animation: none;\n  }\n\n  .product-card:hover {\n    transform: none;\n  }\n\n  .product-banner img {\n    transition: none;\n  }\n}\n"
__vite__updateStyle(__vite__id, __vite__css)
import.meta.hot.accept()
import.meta.hot.prune(() => __vite__removeStyle(__vite__id))