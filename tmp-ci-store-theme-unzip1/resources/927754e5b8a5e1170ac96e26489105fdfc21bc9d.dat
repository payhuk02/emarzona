import { createHotContext as __vite__createHotContext } from "/@vite/client";import.meta.hot = __vite__createHotContext("/src/styles/app-premium.css");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from "/@vite/client"
const __vite__id = "/home/runner/work/emarzona/emarzona/src/styles/app-premium.css"
const __vite__css = "/**\n * Thème application — aligné sur landing-premium\n * Ancêtre requis : .landing-premium.app-premium\n */\n\n.landing-premium.app-premium {\n  /* Tokens shadcn alignés sur le landing */\n  --background: 40 9% 98%;\n  --foreground: 240 6% 7%;\n  --card: 0 0% 100%;\n  --card-foreground: 240 6% 7%;\n  --popover: 0 0% 100%;\n  --popover-foreground: 240 6% 7%;\n  --primary: 217 91% 53%;\n  --primary-foreground: 0 0% 100%;\n  --secondary: 40 6% 94%;\n  --secondary-foreground: 240 6% 12%;\n  --muted: 40 6% 96%;\n  --muted-foreground: 240 4% 40%;\n  --accent: 217 91% 53%;\n  --accent-foreground: 0 0% 100%;\n  --border: 240 6% 90%;\n  --input: 240 6% 90%;\n  --ring: 217 91% 53%;\n  --radius: 0.75rem;\n\n  --sidebar-background: 0 0% 100%;\n  --sidebar-foreground: 240 6% 7%;\n  --sidebar-primary: 217 91% 58%;\n  --sidebar-primary-foreground: 0 0% 100%;\n  --sidebar-accent: 40 6% 96%;\n  --sidebar-accent-foreground: 240 6% 12%;\n  --sidebar-border: 240 6% 90%;\n  --sidebar-ring: 217 91% 58%;\n}\n\n/* Sidebar — fond blanc aligné sur sidebar-optimized */\n.landing-premium.app-premium [data-sidebar='sidebar'] {\n  background: #ffffff !important;\n  border-color: hsl(var(--sidebar-border)) !important;\n  color: hsl(var(--sidebar-foreground)) !important;\n}\n\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='header'],\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='footer'],\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='content'],\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='group'],\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='group-content'] {\n  color: hsl(var(--sidebar-foreground)) !important;\n  border-color: hsl(var(--sidebar-border));\n}\n\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='group-label'] {\n  color: hsl(var(--muted-foreground)) !important;\n  font-size: 0.625rem;\n  font-weight: 700;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n}\n\n.landing-premium.app-premium\n  [data-sidebar='sidebar']\n  [data-sidebar='menu-button'][data-active='true'],\n.landing-premium.app-premium\n  [data-sidebar='sidebar']\n  [data-sidebar='menu-button'][data-active='true']\n  span,\n.landing-premium.app-premium\n  [data-sidebar='sidebar']\n  [data-sidebar='menu-button'][data-active='true']\n  svg {\n  background: hsl(var(--sidebar-accent)) !important;\n  color: hsl(var(--sidebar-foreground)) !important;\n  font-weight: 600;\n}\n\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='menu-button']:hover,\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='menu-button']:hover span,\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='menu-button']:hover svg {\n  background: hsl(var(--sidebar-accent)) !important;\n  color: hsl(var(--sidebar-foreground)) !important;\n}\n\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='input'] {\n  background: hsl(var(--background));\n  border-color: hsl(var(--border));\n  color: hsl(var(--foreground)) !important;\n}\n\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='input']::-moz-placeholder {\n  color: hsl(var(--muted-foreground)) !important;\n}\n\n.landing-premium.app-premium [data-sidebar='sidebar'] [data-sidebar='input']::placeholder {\n  color: hsl(var(--muted-foreground)) !important;\n}\n\n/* Barre supérieure dashboard */\n.landing-premium.app-premium .app-premium-topnav {\n  background: linear-gradient(\n    180deg,\n    rgba(14, 14, 18, 0.97) 0%,\n    rgba(8, 8, 10, 0.95) 100%\n  ) !important;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;\n  box-shadow: 0 12px 40px -16px rgba(0, 0, 0, 0.5);\n  backdrop-filter: blur(16px);\n}\n\n.landing-premium.app-premium .app-premium-topnav a,\n.landing-premium.app-premium .app-premium-topnav button:not(.lp-btn-primary) {\n  color: rgba(255, 255, 255, 0.82);\n}\n\n.landing-premium.app-premium .app-premium-topnav a:hover {\n  color: #fff;\n}\n\n.landing-premium.app-premium .app-premium-topnav .topnav-brand,\n.landing-premium.app-premium .app-premium-topnav .topnav-brand span {\n  color: #fff !important;\n}\n\n.landing-premium.app-premium .app-premium-topnav .text-primary,\n.landing-premium.app-premium .app-premium-topnav [class*='text-primary'] {\n  color: var(--lp-gold-bright) !important;\n}\n\n/* Boutons icône topnav (notifications, thème) — pas de fond blanc du Select */\n.landing-premium.app-premium .app-premium-topnav .topnav-icon-btn {\n  background: transparent !important;\n  border: none !important;\n  box-shadow: none !important;\n  color: rgba(255, 255, 255, 0.75) !important;\n}\n\n.landing-premium.app-premium .app-premium-topnav .topnav-icon-btn:hover,\n.landing-premium.app-premium .app-premium-topnav .topnav-icon-btn[data-state='open'] {\n  background: rgba(255, 255, 255, 0.1) !important;\n  color: #fff !important;\n}\n\n/* Fallback : tout Select/combobox résiduel dans la topnav */\n.landing-premium.app-premium .app-premium-topnav button[role='combobox'] {\n  background: transparent !important;\n  border-color: transparent !important;\n  box-shadow: none !important;\n  color: rgba(255, 255, 255, 0.75) !important;\n  min-height: 2.25rem;\n  height: 2.25rem;\n  width: auto;\n}\n\n.landing-premium.app-premium .app-premium-topnav .topnav-loyalty-badge {\n  border-color: rgba(251, 191, 36, 0.35) !important;\n  color: #fde68a !important;\n  background: rgba(251, 191, 36, 0.12) !important;\n}\n\n.landing-premium.app-premium .app-premium-topnav .topnav-main-link {\n  max-height: 2.25rem;\n}\n\n.landing-premium.app-premium .app-premium-topnav .topnav-main-link.bg-primary {\n  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);\n}\n\n/* Sidebar contextuelle — fond blanc (aligné AppSidebar) */\n.landing-premium.app-premium .app-context-sidebar {\n  background: #ffffff !important;\n  border-color: hsl(var(--border)) !important;\n  color: hsl(var(--foreground)) !important;\n}\n\n.landing-premium.app-premium .app-context-sidebar input {\n  background: hsl(var(--background)) !important;\n  border-color: hsl(var(--border)) !important;\n  color: hsl(var(--foreground)) !important;\n}\n\n.landing-premium.app-premium .app-context-sidebar input::-moz-placeholder {\n  color: hsl(var(--muted-foreground)) !important;\n}\n\n.landing-premium.app-premium .app-context-sidebar input::placeholder {\n  color: hsl(var(--muted-foreground)) !important;\n}\n\n.landing-premium.app-premium .app-context-sidebar .overflow-x-auto,\n.landing-premium.app-premium .app-context-sidebar nav[aria-label='Breadcrumb'] {\n  scrollbar-width: none;\n}\n\n.landing-premium.app-premium .app-context-sidebar .overflow-x-auto::-webkit-scrollbar,\n.landing-premium.app-premium .app-context-sidebar nav[aria-label='Breadcrumb']::-webkit-scrollbar {\n  display: none;\n}\n\n/* Zone principale */\n.landing-premium.app-premium #main-content,\n.landing-premium.app-premium main.flex-1.overflow-auto,\n.landing-premium.app-premium main.flex-1.flex-col,\n.landing-premium.app-premium main.flex-1 {\n  background: var(--lp-surface) !important;\n}\n\n/* Cartes dashboard / admin */\n.landing-premium.app-premium .bg-card.rounded-lg,\n.landing-premium.app-premium .rounded-lg.border.bg-card,\n.landing-premium.app-premium [class*='Card']:not([class*='card-']) {\n  /* évite sur-sélecteur — cible Card shadcn */\n}\n\n.landing-premium.app-premium .rounded-lg.border.bg-card,\n.landing-premium.app-premium div.bg-card {\n  border-radius: 1rem;\n  border-color: var(--lp-border-light) !important;\n  background: var(--lp-surface-elevated) !important;\n  box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04);\n  transition:\n    transform 0.45s var(--lp-ease),\n    box-shadow 0.45s var(--lp-ease);\n}\n\n.landing-premium.app-premium .rounded-lg.border.bg-card:hover {\n  box-shadow: 0 16px 40px -20px rgba(0, 0, 0, 0.1);\n}\n\n/* Titres de page — noir gras (plus de dégradé violet/rose / magenta) */\n.landing-premium.app-premium #main-content h1,\n.landing-premium.app-premium #main-content h2,\n.landing-premium.app-premium #main-content h3,\n.landing-premium.app-premium #main-content h4,\n.landing-premium.app-premium #main-content .app-premium-page-title,\n.landing-premium.app-premium main.flex-1 h1,\n.landing-premium.app-premium main.flex-1 h2,\n.landing-premium.app-premium main.flex-1 h3,\n.landing-premium.app-premium main.flex-1.overflow-auto h1,\n.landing-premium.app-premium main.flex-1.overflow-auto h2,\n.landing-premium.app-premium main.flex-1.overflow-auto h3 {\n  font-family: var(--lp-serif);\n  font-weight: 700 !important;\n  letter-spacing: -0.02em;\n  color: #000 !important;\n  -webkit-text-fill-color: #000 !important;\n  background: none !important;\n  background-image: none !important;\n}\n\n.landing-premium.app-premium #main-content [class*='bg-clip-text'],\n.landing-premium.app-premium main.flex-1 [class*='bg-clip-text'],\n.landing-premium.app-premium main.flex-1.overflow-auto [class*='bg-clip-text'] {\n  background: none !important;\n  background-image: none !important;\n  -webkit-background-clip: unset !important;\n  background-clip: unset !important;\n  -webkit-text-fill-color: #000 !important;\n  color: #000 !important;\n  font-weight: 700 !important;\n}\n\n/* Hiérarchie texte : voir app-typography.css (poids/tailles par rôle) */\n\n/* Icônes : voir app-ui-overrides.css (scope #main-content + main.flex-1) */\n\n/* Badges / boutons primaires — conserver le contraste */\n.landing-premium.app-premium #main-content .bg-primary,\n.landing-premium.app-premium #main-content .bg-destructive,\n.landing-premium.app-premium #main-content [class*='text-primary-foreground'] {\n  color: inherit;\n  font-weight: inherit;\n}\n\n/* Filtres type produit — style neutre */\n.landing-premium.app-premium #main-content button[class*='bg-'][class*='500/10'],\n.landing-premium.app-premium #main-content button[class*='border-'][class*='500'] {\n  background: transparent !important;\n  border-color: rgba(0, 0, 0, 0.2) !important;\n  color: #000 !important;\n  font-weight: 700 !important;\n}\n\n/* Sélecteur de langue sidebar — style landing navbar */\n.landing-premium.app-premium [data-sidebar='sidebar'] .app-sidebar-lang-switcher {\n  width: 100%;\n}\n\n.landing-premium.app-premium [data-sidebar='sidebar'] .app-sidebar-lang-switcher .lp-lang-switcher {\n  width: 100%;\n  justify-content: center;\n  border-radius: 0.5rem;\n}\n\n/* État actif premium — barre dorée */\n.landing-premium.app-premium [data-sidebar='sidebar'] [aria-current='page'] {\n  border-left-width: 3px !important;\n  border-left-color: hsl(var(--sidebar-primary)) !important;\n  background: hsl(var(--sidebar-accent)) !important;\n}\n\n/* Boutons primaires globaux */\n.landing-premium.app-premium\n  .bg-primary.text-primary-foreground:not(.lp-btn-outline):not([data-sidebar]):not(\n    .app-premium-auth-submit\n  ) {\n  background: linear-gradient(\n    135deg,\n    var(--lp-blue-bright) 0%,\n    var(--lp-blue) 55%,\n    var(--lp-blue-deep) 100%\n  ) !important;\n  border: none;\n  box-shadow: 0 4px 20px var(--lp-blue-glow);\n}\n\n.landing-premium.app-premium\n  .bg-primary.text-primary-foreground:hover:not(.app-premium-auth-submit) {\n  filter: brightness(1.05);\n}\n\n/* Admin sidebar */\n.landing-premium.app-premium .app-premium-admin-aside {\n  background: linear-gradient(180deg, var(--lp-ink-soft) 0%, var(--lp-ink) 100%) !important;\n  border-color: rgba(255, 255, 255, 0.08) !important;\n  color: #fff !important;\n}\n\n.landing-premium.app-premium .app-premium-admin-aside h2,\n.landing-premium.app-premium .app-premium-admin-aside h3,\n.landing-premium.app-premium .app-premium-admin-aside button,\n.landing-premium.app-premium .app-premium-admin-aside span,\n.landing-premium.app-premium .app-premium-admin-aside a,\n.landing-premium.app-premium .app-premium-admin-aside svg {\n  color: #fff !important;\n}\n\n.landing-premium.app-premium .app-premium-admin-aside h2 {\n  font-family: var(--lp-serif);\n}\n\n.landing-premium.app-premium .app-premium-admin-aside .bg-primary {\n  background: rgba(37, 99, 235, 0.28) !important;\n  color: #fff !important;\n}\n\n.landing-premium.app-premium .app-premium-admin-aside .text-muted-foreground {\n  color: rgba(255, 255, 255, 0.7) !important;\n}\n\n/* Sidebars contextuelles legacy (fixed) — fond blanc */\n.landing-premium.app-premium aside.fixed.app-context-sidebar:not(.bottom-0),\n.landing-premium.app-premium aside.app-context-sidebar:not(.bottom-0) {\n  background: #ffffff !important;\n  border-color: hsl(var(--border)) !important;\n  color: hsl(var(--foreground)) !important;\n}\n\n/* Auth */\n.landing-premium.app-premium .app-premium-auth {\n  min-height: 100vh;\n  background: var(--lp-ink);\n  position: relative;\n}\n\n.landing-premium.app-premium .app-premium-auth-layout {\n  position: relative;\n  z-index: 1;\n}\n\n.landing-premium.app-premium .app-premium-auth-form {\n  position: relative;\n  min-height: 100vh;\n  background: linear-gradient(165deg, #0c1a2e 0%, var(--lp-ink) 42%, #050506 100%);\n  isolation: isolate;\n}\n\n.landing-premium.app-premium .app-premium-auth-form::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background:\n    radial-gradient(ellipse 70% 55% at 85% 15%, rgba(124, 92, 255, 0.14) 0%, transparent 55%),\n    radial-gradient(ellipse 50% 45% at 10% 85%, rgba(201, 162, 39, 0.1) 0%, transparent 50%),\n    radial-gradient(ellipse 40% 35% at 50% 50%, rgba(37, 99, 235, 0.06) 0%, transparent 60%);\n}\n\n.landing-premium.app-premium .app-premium-auth-form::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  opacity: 0.035;\n  background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\");\n}\n\n.landing-premium.app-premium .app-premium-auth-inner {\n  position: relative;\n  z-index: 1;\n  animation: app-premium-auth-card-in 0.85s var(--lp-ease) both;\n  animation-delay: 0.08s;\n}\n\n@keyframes app-premium-auth-card-in {\n  from {\n    opacity: 0;\n    transform: translateY(18px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.landing-premium.app-premium .app-premium-auth-brand {\n  animation: app-premium-auth-card-in 0.75s var(--lp-ease) both;\n}\n\n.landing-premium.app-premium .app-premium-auth-brand .emarzona-brand-name {\n  font-family: var(--lp-serif);\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.25));\n}\n\n.landing-premium.app-premium .app-premium-auth-lang button {\n  border-color: rgba(255, 255, 255, 0.14) !important;\n  background: rgba(255, 255, 255, 0.06) !important;\n  color: var(--lp-text-on-dark) !important;\n  backdrop-filter: blur(12px);\n  box-shadow: 0 4px 16px -8px rgba(0, 0, 0, 0.4);\n  transition:\n    background 0.35s var(--lp-ease),\n    border-color 0.35s var(--lp-ease);\n}\n\n.landing-premium.app-premium .app-premium-auth-lang button:hover {\n  background: rgba(255, 255, 255, 0.1) !important;\n  border-color: rgba(201, 162, 39, 0.35) !important;\n}\n\n.landing-premium.app-premium .app-premium-auth-card {\n  position: relative;\n  z-index: 1;\n  overflow: hidden;\n  border-radius: 1.5rem;\n  border: 1px solid rgba(255, 255, 255, 0.14);\n  background: linear-gradient(180deg, rgba(255, 255, 255, 0.99) 0%, rgba(252, 251, 249, 0.98) 100%);\n  box-shadow:\n    0 0 0 1px rgba(201, 162, 39, 0.07),\n    0 32px 64px -28px rgba(0, 0, 0, 0.6),\n    0 0 100px -30px rgba(201, 162, 39, 0.15);\n  animation: app-premium-auth-card-in 0.8s var(--lp-ease) both;\n  animation-delay: 0.12s;\n}\n\n.landing-premium.app-premium .app-premium-auth-card::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 10%;\n  right: 10%;\n  height: 2px;\n  border-radius: 2px;\n  background: linear-gradient(\n    90deg,\n    transparent 0%,\n    var(--lp-gold-bright) 25%,\n    var(--lp-gold) 50%,\n    var(--lp-gold-bright) 75%,\n    transparent 100%\n  );\n  opacity: 0.85;\n}\n\n.landing-premium.app-premium .app-premium-auth-title {\n  font-size: clamp(1.75rem, 4vw, 2.125rem) !important;\n  letter-spacing: -0.03em !important;\n  line-height: 1.15 !important;\n}\n\n.landing-premium.app-premium .app-premium-auth-subtitle {\n  color: var(--lp-text-muted) !important;\n  font-size: 0.9375rem;\n  line-height: 1.55;\n  max-width: 28ch;\n}\n\n.landing-premium.app-premium .app-premium-auth-tabs-list {\n  width: 100%;\n  height: auto;\n  min-height: 3rem;\n  padding: 0.3rem;\n  border-radius: 0.875rem;\n  background: rgba(15, 15, 18, 0.04);\n  border: 1px solid rgba(15, 15, 18, 0.07);\n  gap: 0.3rem;\n}\n\n.landing-premium.app-premium .app-premium-auth-tab {\n  flex: 1;\n  border-radius: 0.625rem;\n  font-weight: 600;\n  font-size: 0.875rem;\n  letter-spacing: 0.015em;\n  color: var(--lp-text-muted);\n  transition:\n    color 0.35s var(--lp-ease),\n    background 0.35s var(--lp-ease),\n    box-shadow 0.35s var(--lp-ease);\n}\n\n.landing-premium.app-premium .app-premium-auth-tab[data-state='active'] {\n  background: #fff;\n  color: var(--lp-text);\n  box-shadow:\n    0 2px 14px -4px rgba(0, 0, 0, 0.14),\n    0 0 0 1px rgba(201, 162, 39, 0.18);\n}\n\n.landing-premium.app-premium\n  .app-premium-auth-card\n  input:not([type='checkbox']):not([type='radio']),\n.landing-premium.app-premium .app-premium-auth-card textarea {\n  background: rgba(250, 249, 247, 0.9);\n  border-color: rgba(15, 15, 18, 0.1);\n  font-size: 0.9375rem;\n  transition:\n    border-color 0.3s var(--lp-ease),\n    box-shadow 0.3s var(--lp-ease),\n    background 0.3s var(--lp-ease);\n}\n\n.landing-premium.app-premium .app-premium-auth-card input:focus,\n.landing-premium.app-premium .app-premium-auth-card textarea:focus {\n  border-color: rgba(201, 162, 39, 0.5);\n  background: #fff;\n  box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.14);\n}\n\n.landing-premium.app-premium .app-premium-auth-card label {\n  font-weight: 500;\n  letter-spacing: 0.01em;\n  color: var(--lp-text);\n}\n\n.landing-premium.app-premium #main-content .app-premium-auth-submit,\n.landing-premium.app-premium #main-content .app-premium-auth-submit.bg-primary {\n  border: none;\n  border-radius: 0.875rem;\n  font-weight: 600;\n  letter-spacing: 0.02em;\n  color: #fff !important;\n  background: linear-gradient(\n    135deg,\n    #fb923c 0%,\n    var(--lp-orange) 48%,\n    var(--lp-orange-deep) 100%\n  ) !important;\n  box-shadow:\n    0 4px 22px rgba(249, 115, 22, 0.38),\n    inset 0 1px 0 rgba(255, 255, 255, 0.2) !important;\n  transition:\n    transform 0.35s var(--lp-ease),\n    box-shadow 0.35s var(--lp-ease);\n}\n\n.landing-premium.app-premium #main-content .app-premium-auth-submit:hover:not(:disabled),\n.landing-premium.app-premium\n  #main-content\n  .app-premium-auth-submit.bg-primary:hover:not(:disabled) {\n  transform: translateY(-1px);\n  filter: none;\n  background: linear-gradient(\n    135deg,\n    #fdba74 0%,\n    var(--lp-orange) 48%,\n    var(--lp-orange-deep) 100%\n  ) !important;\n  box-shadow:\n    0 8px 32px rgba(249, 115, 22, 0.45),\n    0 0 0 1px rgba(201, 162, 39, 0.2),\n    inset 0 1px 0 rgba(255, 255, 255, 0.24) !important;\n}\n\n.landing-premium.app-premium .app-premium-auth-submit:active:not(:disabled) {\n  transform: translateY(0);\n}\n\n.landing-premium.app-premium .app-premium-auth-trust {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 0.65rem 1rem;\n  margin-top: 1.25rem;\n  padding: 1rem 1.125rem;\n  border-radius: 1rem;\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  background: rgba(255, 255, 255, 0.04);\n  backdrop-filter: blur(10px);\n  animation: app-premium-auth-card-in 0.8s var(--lp-ease) both;\n  animation-delay: 0.2s;\n}\n\n.landing-premium.app-premium .app-premium-auth-trust-item {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  font-size: 0.75rem;\n  font-weight: 500;\n  letter-spacing: 0.01em;\n  color: rgba(232, 230, 225, 0.72);\n}\n\n.landing-premium.app-premium .app-premium-auth-trust-item svg {\n  color: var(--lp-gold-bright);\n  flex-shrink: 0;\n  opacity: 0.95;\n}\n\n.landing-premium.app-premium .app-premium-auth-terms {\n  color: rgba(232, 230, 225, 0.5) !important;\n  line-height: 1.5;\n}\n\n.landing-premium.app-premium .app-premium-auth-terms-link {\n  color: rgba(232, 230, 225, 0.78);\n  text-decoration: underline;\n  text-underline-offset: 2px;\n  transition: color 0.25s var(--lp-ease);\n}\n\n.landing-premium.app-premium .app-premium-auth-terms-link:hover {\n  color: var(--lp-gold-bright);\n}\n\n.landing-premium.app-premium .app-premium-auth-password-wrap {\n  position: relative;\n}\n\n.landing-premium.app-premium .app-premium-auth-password-toggle {\n  position: absolute;\n  top: 0;\n  right: 0;\n  bottom: 0;\n  width: 2.75rem;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin: 0;\n  padding: 0;\n  border: none;\n  background: transparent;\n  color: hsl(var(--muted-foreground));\n  cursor: pointer;\n  -webkit-tap-highlight-color: transparent;\n  touch-action: manipulation;\n  transform: none;\n  flex-shrink: 0;\n}\n\n.landing-premium.app-premium .app-premium-auth-password-toggle:hover {\n  color: hsl(var(--foreground));\n}\n\n.landing-premium.app-premium .app-premium-auth-password-toggle:active {\n  transform: none;\n}\n\n.landing-premium.app-premium .app-premium-auth-password-toggle-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 1.25rem;\n  height: 1.25rem;\n  flex-shrink: 0;\n  pointer-events: none;\n}\n\n.landing-premium.app-premium .app-premium-auth-password-toggle-icon svg {\n  width: 1.25rem;\n  height: 1.25rem;\n  flex-shrink: 0;\n}\n\n.landing-premium.app-premium .app-premium-auth-card button[type='button'].text-primary {\n  font-weight: 500;\n  transition: color 0.25s var(--lp-ease);\n}\n\n.landing-premium.app-premium .app-premium-auth-card button[type='button'].text-primary:hover {\n  color: var(--lp-gold-deep);\n}\n\n.landing-premium.app-premium .app-premium-auth-hero {\n  position: relative;\n  min-height: 100vh;\n  overflow: hidden;\n  background: #0a1628;\n}\n\n.landing-premium.app-premium .app-premium-auth-hero-picture {\n  display: block;\n  width: 100%;\n  height: 100%;\n  min-height: 100vh;\n  overflow: hidden;\n}\n\n.landing-premium.app-premium .app-premium-auth-hero-img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  min-height: 100vh;\n  -o-object-fit: cover;\n     object-fit: cover;\n  /* Centré : texte marketing à gauche + dame à droite visibles */\n  -o-object-position: 50% 44%;\n     object-position: 50% 44%;\n  transform: translateZ(0);\n  filter: contrast(1.03) saturate(1.04);\n  backface-visibility: hidden;\n  -webkit-font-smoothing: antialiased;\n  image-rendering: -webkit-optimize-contrast;\n  animation: app-premium-auth-hero-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;\n}\n\n@keyframes app-premium-auth-hero-in {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n\n.landing-premium.app-premium .app-premium-auth-hero-overlay {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background:\n    linear-gradient(90deg, rgba(10, 22, 40, 0.08) 0%, transparent 35%),\n    linear-gradient(180deg, transparent 55%, rgba(10, 22, 40, 0.35) 100%),\n    radial-gradient(ellipse 80% 60% at 15% 40%, rgba(201, 162, 39, 0.06) 0%, transparent 55%);\n}\n\n.landing-premium.app-premium .app-premium-auth-hero-edge {\n  position: absolute;\n  top: 0;\n  right: 0;\n  bottom: 0;\n  width: 1px;\n  background: linear-gradient(\n    180deg,\n    transparent 0%,\n    rgba(201, 162, 39, 0.35) 35%,\n    rgba(201, 162, 39, 0.5) 50%,\n    rgba(201, 162, 39, 0.35) 65%,\n    transparent 100%\n  );\n  box-shadow: 0 0 24px rgba(201, 162, 39, 0.15);\n}\n\n/* Inputs */\n.landing-premium.app-premium input:not([type='checkbox']):not([type='radio']),\n.landing-premium.app-premium textarea,\n.landing-premium.app-premium select {\n  border-radius: 0.75rem;\n  border-color: var(--lp-border-light);\n  font-family: var(--lp-sans);\n}\n\n.landing-premium.app-premium input:focus,\n.landing-premium.app-premium textarea:focus,\n.landing-premium.app-premium select:focus {\n  border-color: var(--lp-blue);\n  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);\n}\n\n/* Tables */\n.landing-premium.app-premium thead tr {\n  background: var(--lp-surface-muted);\n}\n\n/* Bottom nav mobile */\n.landing-premium.app-premium nav.fixed.bottom-0 {\n  background: var(--lp-ink-soft) !important;\n  border-color: rgba(255, 255, 255, 0.1) !important;\n}\n\n/* Personnalisation plateforme — layout 2 colonnes + nav cliquable */\n.platform-customization-shell {\n  grid-template-columns: minmax(0, 1fr);\n}\n\n@media (min-width: 1024px) {\n  .platform-customization-shell {\n    grid-template-columns: 16rem minmax(0, 1fr);\n  }\n}\n\n#platform-customization-nav {\n  pointer-events: auto;\n  isolation: isolate;\n  position: relative;\n  z-index: 50;\n  grid-column: 1;\n  grid-row: 1;\n}\n\n#platform-customization-nav .platform-customization-nav-list,\n#platform-customization-nav .platform-customization-nav-btn {\n  pointer-events: auto;\n  cursor: pointer;\n  position: relative;\n  text-decoration: none;\n}\n\n#platform-customization-nav .platform-customization-nav-btn[aria-current='page'],\n#platform-customization-nav .platform-customization-nav-btn[aria-current='page'] span,\n#platform-customization-nav .platform-customization-nav-btn[aria-current='page'] svg {\n  color: hsl(var(--primary-foreground)) !important;\n}\n\n@media (max-width: 1023px) {\n  #platform-customization-nav .platform-customization-nav-list {\n    position: static;\n    top: auto;\n    z-index: auto;\n  }\n}\n\n#platform-customization-panel {\n  pointer-events: auto;\n  min-width: 0;\n  grid-column: 1;\n  grid-row: 2;\n}\n\n@media (min-width: 1024px) {\n  #platform-customization-panel {\n    grid-column: 2;\n    grid-row: 1;\n  }\n}\n\n#platform-customization-scroll {\n  overscroll-behavior: contain;\n  -webkit-overflow-scrolling: touch;\n  scroll-padding-bottom: 2rem;\n}\n\n@media (max-width: 1023px) {\n  #platform-customization-nav {\n    max-height: min(48vh, 28rem);\n  }\n\n  #platform-customization-panel {\n    min-height: min(55vh, 36rem);\n    scroll-margin-top: 4.5rem;\n  }\n\n  .platform-customization-shell {\n    min-height: 0;\n  }\n}\n\n/* Onglets horizontaux : défilement natif (évite ScrollArea qui masque le contenu) */\n.platform-customization-section-tabs {\n  -webkit-overflow-scrolling: touch;\n  overscroll-behavior-x: contain;\n  scrollbar-width: thin;\n}\n"
