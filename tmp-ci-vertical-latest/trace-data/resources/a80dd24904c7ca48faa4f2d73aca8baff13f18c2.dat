import { createHotContext as __vite__createHotContext } from "/@vite/client";import.meta.hot = __vite__createHotContext("/src/styles/app-typography.css");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from "/@vite/client"
const __vite__id = "/home/runner/work/emarzona/emarzona/src/styles/app-typography.css"
const __vite__css = "/**\n * Typographie premium — zone application (.landing-premium.app-premium)\n * Échelle lisible, minimum 12px, hiérarchie par taille + graisse (pas tout en gras).\n */\n\n.landing-premium.app-premium {\n  --app-font-display: clamp(1.75rem, 1.2vw + 1.35rem, 2.5rem);\n  --app-font-h1: clamp(1.5rem, 0.8vw + 1.2rem, 2rem);\n  --app-font-h2: clamp(1.125rem, 0.4vw + 1rem, 1.375rem);\n  --app-font-h3: 1rem;\n  --app-font-body: 0.9375rem;\n  --app-font-body-lg: 1rem;\n  --app-font-small: 0.8125rem;\n  --app-font-caption: 0.75rem;\n  --app-line-tight: 1.25;\n  --app-line-normal: 1.5;\n  --app-line-relaxed: 1.625;\n}\n\n/* Base zone principale */\n.landing-premium.app-premium #main-content,\n.landing-premium.app-premium main.flex-1,\n.landing-premium.app-premium main.flex-1.overflow-auto {\n  font-family: var(--lp-sans), system-ui, sans-serif;\n  font-size: var(--app-font-body);\n  line-height: var(--app-line-normal);\n  font-weight: 400;\n  color: hsl(var(--foreground));\n  -webkit-font-smoothing: antialiased;\n}\n\n@media (min-width: 768px) {\n  .landing-premium.app-premium #main-content,\n  .landing-premium.app-premium main.flex-1,\n  .landing-premium.app-premium main.flex-1.overflow-auto {\n    font-size: var(--app-font-body-lg);\n  }\n}\n\n/* Titres */\n.landing-premium.app-premium #main-content h1,\n.landing-premium.app-premium #main-content .app-premium-page-title,\n.landing-premium.app-premium main.flex-1 h1,\n.landing-premium.app-premium main.flex-1.overflow-auto h1 {\n  font-size: var(--app-font-display) !important;\n  line-height: var(--app-line-tight);\n  font-weight: 700 !important;\n}\n\n.landing-premium.app-premium #main-content h2,\n.landing-premium.app-premium main.flex-1 h2,\n.landing-premium.app-premium main.flex-1.overflow-auto h2 {\n  font-size: var(--app-font-h1) !important;\n  line-height: var(--app-line-tight);\n  font-weight: 600 !important;\n}\n\n.landing-premium.app-premium #main-content h3,\n.landing-premium.app-premium main.flex-1 h3,\n.landing-premium.app-premium main.flex-1.overflow-auto h3 {\n  font-size: var(--app-font-h2) !important;\n  line-height: var(--app-line-tight);\n  font-weight: 600 !important;\n}\n\n.landing-premium.app-premium #main-content h4,\n.landing-premium.app-premium main.flex-1 h4,\n.landing-premium.app-premium main.flex-1.overflow-auto h4 {\n  font-size: var(--app-font-h3) !important;\n  font-weight: 600 !important;\n}\n\n/* Corps & labels — poids normal */\n.landing-premium.app-premium #main-content p,\n.landing-premium.app-premium #main-content span:not([class*='font-']),\n.landing-premium.app-premium #main-content label,\n.landing-premium.app-premium #main-content li,\n.landing-premium.app-premium #main-content td,\n.landing-premium.app-premium #main-content th,\n.landing-premium.app-premium main.flex-1 p,\n.landing-premium.app-premium main.flex-1 span:not([class*='font-']),\n.landing-premium.app-premium main.flex-1 label,\n.landing-premium.app-premium main.flex-1.overflow-auto p,\n.landing-premium.app-premium main.flex-1.overflow-auto span:not([class*='font-']),\n.landing-premium.app-premium main.flex-1.overflow-auto label {\n  font-weight: 400;\n  color: hsl(var(--foreground));\n}\n\n.landing-premium.app-premium #main-content .text-muted-foreground,\n.landing-premium.app-premium main.flex-1 .text-muted-foreground,\n.landing-premium.app-premium main.flex-1.overflow-auto .text-muted-foreground {\n  color: hsl(var(--muted-foreground)) !important;\n  font-weight: 400 !important;\n}\n\n/* Minimum lisible : remplace text-[8px]–text-[11px] */\n.landing-premium.app-premium #main-content [class*='text-[8px]'],\n.landing-premium.app-premium #main-content [class*='text-[9px]'],\n.landing-premium.app-premium #main-content [class*='text-[10px]'],\n.landing-premium.app-premium #main-content [class*='text-[11px]'],\n.landing-premium.app-premium main.flex-1 [class*='text-[8px]'],\n.landing-premium.app-premium main.flex-1 [class*='text-[9px]'],\n.landing-premium.app-premium main.flex-1 [class*='text-[10px]'],\n.landing-premium.app-premium main.flex-1 [class*='text-[11px]'],\n.landing-premium.app-premium main.flex-1.overflow-auto [class*='text-[8px]'],\n.landing-premium.app-premium main.flex-1.overflow-auto [class*='text-[9px]'],\n.landing-premium.app-premium main.flex-1.overflow-auto [class*='text-[10px]'],\n.landing-premium.app-premium main.flex-1.overflow-auto [class*='text-[11px]'] {\n  font-size: var(--app-font-caption) !important;\n  line-height: var(--app-line-normal) !important;\n}\n\n/* Classes sémantiques réutilisables */\n.landing-premium.app-premium .app-text-display {\n  font-family: var(--lp-serif);\n  font-size: var(--app-font-display);\n  font-weight: 700;\n  line-height: var(--app-line-tight);\n  letter-spacing: -0.02em;\n  color: #000;\n}\n\n.landing-premium.app-premium .app-text-title {\n  font-family: var(--lp-serif);\n  font-size: var(--app-font-h1);\n  font-weight: 700;\n  line-height: var(--app-line-tight);\n  color: #000;\n}\n\n.landing-premium.app-premium .app-text-section {\n  font-size: var(--app-font-h2);\n  font-weight: 600;\n  line-height: var(--app-line-tight);\n}\n\n.landing-premium.app-premium .app-text-body {\n  font-size: var(--app-font-body);\n  font-weight: 400;\n  line-height: var(--app-line-normal);\n}\n\n@media (min-width: 768px) {\n  .landing-premium.app-premium .app-text-body {\n    font-size: var(--app-font-body-lg);\n  }\n}\n\n.landing-premium.app-premium .app-text-caption {\n  font-size: var(--app-font-caption);\n  font-weight: 400;\n  line-height: var(--app-line-normal);\n  color: hsl(var(--muted-foreground));\n}\n\n.landing-premium.app-premium .app-text-stat {\n  font-size: clamp(1.25rem, 0.5vw + 1.1rem, 1.75rem);\n  font-weight: 700;\n  line-height: var(--app-line-tight);\n  font-variant-numeric: tabular-nums;\n}\n\n.landing-premium.app-premium .app-text-card-title {\n  font-size: var(--app-font-h3);\n  font-weight: 600;\n  line-height: var(--app-line-tight);\n}\n\n/* Boutons outline / ghost — poids medium */\n.landing-premium.app-premium\n  #main-content\n  button:not([class*='bg-primary']):not([class*='destructive']):not([class*='app-btn-premium']):not(\n    [class*='from-purple']\n  ):not([class*='to-pink']),\n.landing-premium.app-premium #main-content a:not([class*='bg-primary']) {\n  font-weight: 500;\n}\n"
__vite__updateStyle(__vite__id, __vite__css)
import.meta.hot.accept()
import.meta.hot.prune(() => __vite__removeStyle(__vite__id))