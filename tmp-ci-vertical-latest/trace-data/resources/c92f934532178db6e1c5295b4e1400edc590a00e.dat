d-color, border-color, text-decoration-color, fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n.transition-\\[grid-template-rows\\] {\n  transition-property: grid-template-rows;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n.transition-\\[left\\2c right\\2c width\\] {\n  transition-property: left,right,width;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n.transition-\\[margin\\2c opa\\] {\n  transition-property: margin,opa;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n.transition-\\[width\\2c height\\2c padding\\] {\n  transition-property: width,height,padding;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n.transition-\\[width\\] {\n  transition-property: width;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n.transition-all {\n  transition-property: all;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n.transition-colors {\n  transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n.transition-opacity {\n  transition-property: opacity;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n.transition-shadow {\n  transition-property: box-shadow;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n.transition-transform {\n  transition-property: transform;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n.delay-100 {\n  transition-delay: 100ms;\n}\n.delay-150 {\n  transition-delay: 150ms;\n}\n.delay-200 {\n  transition-delay: 200ms;\n}\n.delay-300 {\n  transition-delay: 300ms;\n}\n.delay-500 {\n  transition-delay: 500ms;\n}\n.duration-1000 {\n  transition-duration: 1000ms;\n}\n.duration-150 {\n  transition-duration: 150ms;\n}\n.duration-200 {\n  transition-duration: 200ms;\n}\n.duration-300 {\n  transition-duration: 300ms;\n}\n.duration-500 {\n  transition-duration: 500ms;\n}\n.duration-700 {\n  transition-duration: 700ms;\n}\n.duration-75 {\n  transition-duration: 75ms;\n}\n.ease-in {\n  transition-timing-function: cubic-bezier(0.4, 0, 1, 1);\n}\n.ease-in-out {\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n}\n.ease-linear {\n  transition-timing-function: linear;\n}\n.ease-out {\n  transition-timing-function: cubic-bezier(0, 0, 0.2, 1);\n}\n.will-change-scroll {\n  will-change: scroll-position;\n}\n.will-change-transform {\n  will-change: transform;\n}\n@keyframes enter {\n  from {\n    opacity: var(--tw-enter-opacity, 1);\n    transform: translate3d(var(--tw-enter-translate-x, 0), var(--tw-enter-translate-y, 0), 0) scale3d(var(--tw-enter-scale, 1), var(--tw-enter-scale, 1), var(--tw-enter-scale, 1)) rotate(var(--tw-enter-rotate, 0));\n  }\n}\n@keyframes exit {\n  to {\n    opacity: var(--tw-exit-opacity, 1);\n    transform: translate3d(var(--tw-exit-translate-x, 0), var(--tw-exit-translate-y, 0), 0) scale3d(var(--tw-exit-scale, 1), var(--tw-exit-scale, 1), var(--tw-exit-scale, 1)) rotate(var(--tw-exit-rotate, 0));\n  }\n}\n.animate-in {\n  animation-name: enter;\n  animation-duration: 150ms;\n  --tw-enter-opacity: initial;\n  --tw-enter-scale: initial;\n  --tw-enter-rotate: initial;\n  --tw-enter-translate-x: initial;\n  --tw-enter-translate-y: initial;\n}\n.animate-out {\n  animation-name: exit;\n  animation-duration: 150ms;\n  --tw-exit-opacity: initial;\n  --tw-exit-scale: initial;\n  --tw-exit-rotate: initial;\n  --tw-exit-translate-x: initial;\n  --tw-exit-translate-y: initial;\n}\n.fade-in {\n  --tw-enter-opacity: 0;\n}\n.fade-in-0 {\n  --tw-enter-opacity: 0;\n}\n.fade-in-80 {\n  --tw-enter-opacity: 0.8;\n}\n.fade-out {\n  --tw-exit-opacity: 0;\n}\n.zoom-in {\n  --tw-enter-scale: 0;\n}\n.zoom-in-95 {\n  --tw-enter-scale: .95;\n}\n.zoom-out-95 {\n  --tw-exit-scale: .95;\n}\n.slide-in-from-bottom-2 {\n  --tw-enter-translate-y: 0.5rem;\n}\n.slide-in-from-bottom-4 {\n  --tw-enter-translate-y: 1rem;\n}\n.slide-in-from-left-2 {\n  --tw-enter-translate-x: -0.5rem;\n}\n.slide-in-from-left-4 {\n  --tw-enter-translate-x: -1rem;\n}\n.slide-in-from-right {\n  --tw-enter-translate-x: 100%;\n}\n.slide-in-from-right-4 {\n  --tw-enter-translate-x: 1rem;\n}\n.slide-in-from-top-1 {\n  --tw-enter-translate-y: -0.25rem;\n}\n.slide-in-from-top-2 {\n  --tw-enter-translate-y: -0.5rem;\n}\n.slide-in-from-top-4 {\n  --tw-enter-translate-y: -1rem;\n}\n.slide-out-to-left {\n  --tw-exit-translate-x: -100%;\n}\n.duration-1000 {\n  animation-duration: 1000ms;\n}\n.duration-150 {\n  animation-duration: 150ms;\n}\n.duration-200 {\n  animation-duration: 200ms;\n}\n.duration-300 {\n  animation-duration: 300ms;\n}\n.duration-500 {\n  animation-duration: 500ms;\n}\n.duration-700 {\n  animation-duration: 700ms;\n}\n.duration-75 {\n  animation-duration: 75ms;\n}\n.delay-100 {\n  animation-delay: 100ms;\n}\n.delay-150 {\n  animation-delay: 150ms;\n}\n.delay-200 {\n  animation-delay: 200ms;\n}\n.delay-300 {\n  animation-delay: 300ms;\n}\n.delay-500 {\n  animation-delay: 500ms;\n}\n.ease-in {\n  animation-timing-function: cubic-bezier(0.4, 0, 1, 1);\n}\n.ease-in-out {\n  animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n}\n.ease-linear {\n  animation-timing-function: linear;\n}\n.ease-out {\n  animation-timing-function: cubic-bezier(0, 0, 0.2, 1);\n}\n.running {\n  animation-play-state: running;\n}\n.\\!paused {\n  animation-play-state: paused !important;\n}\n.paused {\n  animation-play-state: paused;\n}\n/* Screen reader only */\n.sr-only {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n    border-width: 0;\n  }\n/* Focus visible amélioré pour tous les éléments interactifs */\n*:focus-visible {\n    outline: 2px solid hsl(var(--ring));\n    outline-offset: 2px;\n    border-radius: calc(var(--radius) - 2px);\n  }\n/* Focus visible pour les boutons */\nbutton:focus-visible,\n  a:focus-visible,\n  input:focus-visible,\n  textarea:focus-visible,\n  select:focus-visible {\n    outline: 2px solid hsl(var(--ring));\n    outline-offset: 2px;\n    box-shadow:\n      0 0 0 2px hsl(var(--background)),\n      0 0 0 4px hsl(var(--ring));\n  }\n/* Focus visible pour les éléments avec tabindex */\n[tabindex]:focus-visible {\n    outline: 2px solid hsl(var(--ring));\n    outline-offset: 2px;\n  }\n/* Amélioration du contraste du focus */\n.dark *:focus-visible {\n    outline-color: hsl(var(--primary));\n    box-shadow:\n      0 0 0 2px hsl(var(--background)),\n      0 0 0 4px hsl(var(--primary));\n  }\n/* Sidebar styles optimisés - Utilisation de variables CSS au lieu de !important */\n/* Les styles détaillés sont dans sidebar-optimized.css */\n.gradient-primary {\n    background: var(--gradient-primary);\n  }\n.gradient-accent {\n    background: var(--gradient-accent);\n  }\n.shadow-soft {\n    box-shadow: var(--shadow-soft);\n  }\n.shadow-medium {\n    box-shadow: var(--shadow-medium);\n  }\n.shadow-large {\n    box-shadow: var(--shadow-large);\n  }\n.shadow-glass {\n    box-shadow: var(--shadow-glass);\n  }\n.glass-header {\n    background: rgba(var(--background), 0.65);\n    backdrop-filter: blur(20px);\n    -webkit-backdrop-filter: blur(20px);\n    border-bottom: 1px solid rgba(var(--border), 0.3);\n  }\n.shadow-glow {\n    box-shadow: var(--shadow-glow);\n  }\n.transition-smooth {\n    transition: var(--transition-smooth);\n  }\n/* Micro-interactions améliorées */\n/* Smooth hover effects avec GPU acceleration */\n/* Respect des préférences utilisateur (reduced motion) */\n/* Page transitions */\n.page-transition {\n    animation-duration: 0.3s;\n    animation-fill-mode: both;\n  }\n.page-transition.fadeOut {\n    animation-name: fadeOutPage;\n  }\n.page-transition.fadeIn {\n    animation-name: fadeInPage;\n  }\n/* Link hover effects */\n\n  .nav-link.\\!active::after {\n    width: 100% !important;\n  }\n.nav-link:hover::after,\n  .nav-link.active::after {\n    width: 100%;\n  }\n/* Button ripple effect */\n/* Product card zoom effect */\n@keyframes float {\n    0%,\n    100% {\n      transform: translateY(0px);\n    }\n    50% {\n      transform: translateY(-20px);\n    }\n  }\n@keyframes fadeInUp {\n    from {\n      opacity: 0;\n      transform: translateY(30px);\n    }\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n@keyframes fadeOutPage {\n    from {\n      opacity: 1;\n      transform: translateY(0);\n    }\n    to {\n      opacity: 0;\n      transform: translateY(-10px);\n    }\n  }\n@keyframes fadeInPage {\n    from {\n      opacity: 0;\n      transform: translateY(10px);\n    }\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n@keyframes slideInRight {\n    from {\n      opacity: 0;\n      transform: translateX(30px);\n    }\n    to {\n      opacity: 1;\n      transform: translateX(0);\n    }\n  }\n@keyframes slideOutRight {\n    from {\n      opacity: 1;\n      transform: translateX(0);\n    }\n    to {\n      opacity: 0;\n      transform: translateX(30px);\n    }\n  }\n/* Animation shimmer pour LazyImage et effets de brillance */\n@keyframes shimmer {\n    0% {\n      transform: translateX(-100%) translateY(-100%) rotate(45deg);\n    }\n    100% {\n      transform: translateX(200%) translateY(200%) rotate(45deg);\n    }\n  }\n.animate-shimmer {\n    animation: shimmer 3s infinite;\n  }\n.\\[-webkit-overflow-scrolling\\:touch\\] {\n  -webkit-overflow-scrolling: touch;\n}\n.\\[animation-delay\\:-0\\.15s\\] {\n  animation-delay: -0.15s;\n}\n.\\[animation-delay\\:-0\\.3s\\] {\n  animation-delay: -0.3s;\n}\n/* Definition of the design system. All colors, gradients, fonts, etc should be defined here. \nAll colors MUST be HSL.\n*/\n/* ============================================\n   ACCESSIBILITY - Focus Visible & Keyboard Navigation\n   ============================================ */\n/* Amélioration du focus visible pour la navigation clavier */\n/* TipTap Editor Styles */\n.ProseMirror:focus {\n  outline: 2px solid transparent;\n  outline-offset: 2px;\n}\n.ProseMirror p.is-editor-empty:first-child::before {\n  color: hsl(var(--muted-foreground));\n  content: attr(data-placeholder);\n  float: left;\n  height: 0;\n  pointer-events: none;\n}\n.ProseMirror h1 {\n  margin-bottom: 1rem;\n  font-size: 1.875rem;\n  line-height: 2.25rem;\n  letter-spacing: -0.01em;\n  font-weight: 700;\n}\n.ProseMirror h2 {\n  margin-bottom: 0.75rem;\n  font-size: 1.5rem;\n  line-height: 2rem;\n  letter-spacing: -0.01em;\n  font-weight: 700;\n}\n.ProseMirror h3 {\n  margin-bottom: 0.5rem;\n  font-size: 1.25rem;\n  line-height: 1.75rem;\n  letter-spacing: 0;\n  font-weight: 700;\n}\n.ProseMirror ul {\n  margin-bottom: 1rem;\n  list-style-type: disc;\n  padding-left: 1.5rem;\n}\n.ProseMirror ol {\n  margin-bottom: 1rem;\n  list-style-type: decimal;\n  padding-left: 1.5rem;\n}\n.ProseMirror blockquote {\n  margin-top: 1rem;\n  margin-bottom: 1rem;\n  border-left-width: 4px;\n  border-color: hsl(var(--primary));\n  padding-left: 1rem;\n  font-style: italic;\n}\n.ProseMirror a {\n  cursor: pointer;\n  color: hsl(var(--primary));\n  text-decoration-line: underline;\n}\n.ProseMirror code {\n  border-radius: 0.25rem;\n  background-color: hsl(var(--muted));\n  padding-left: 0.25rem;\n  padding-right: 0.25rem;\n  padding-top: 0.125rem;\n  padding-bottom: 0.125rem;\n  font-size: 0.875rem;\n  line-height: 1.375rem;\n  letter-spacing: 0;\n}\n.ProseMirror pre {\n  margin-top: 1rem;\n  margin-bottom: 1rem;\n  overflow-x: auto;\n  border-radius: 0.25rem;\n  background-color: hsl(var(--muted));\n  padding: 1rem;\n}\n.ProseMirror strong {\n  font-weight: 700;\n}\n.ProseMirror em {\n  font-style: italic;\n}\n.ProseMirror u {\n  text-decoration-line: underline;\n}\n/* ============================================================\n   STYLES PROFESSIONNELS POUR DESCRIPTION PRODUIT\n   Respecte tous les formats définis dans RichTextEditorPro\n   ============================================================ */\n.product-description-content {\n  color: hsl(var(--foreground));\n  font-size: 0.9375rem; /* 15px base */\n  line-height: 1.75;\n  word-wrap: break-word;\n  overflow-wrap: break-word;\n}\n/* Responsive typography */\n@media (min-width: 640px) {\n  .product-description-content {\n    font-size: 1rem; /* 16px sur tablette */\n  }\n}\n@media (min-width: 1024px) {\n  .product-description-content {\n    font-size: 1.0625rem; /* 17px sur desktop */\n    line-height: 1.8;\n  }\n}\n/* Paragraphes */\n.product-description-content p {\n  margin-bottom: 1rem;\n  color: hsl(var(--foreground));\n}\n@media (min-width: 640px) {\n  .product-description-content p {\n    margin-bottom: 1.25rem;\n  }\n}\n.product-description-content p {\n  font-size: inherit;\n  line-height: inherit;\n}\n.product-description-content p:last-child {\n  margin-bottom: 0px;\n}\n/* Titres */\n.product-description-content h1 {\n  margin-bottom: 1rem;\n  margin-top: 1.5rem;\n  font-weight: 700;\n  color: hsl(var(--foreground));\n}\n@media (min-width: 640px) {\n  .product-description-content h1 {\n    margin-bottom: 1.25rem;\n    margin-top: 2rem;\n  }\n}\n.product-description-content h1 {\n  font-size: 1.75rem; /* 28px */\n  line-height: 1.3;\n}\n.product-description-content h2 {\n  margin-bottom: 0.75rem;\n  margin-top: 1.25rem;\n  font-weight: 700;\n  color: hsl(var(--foreground));\n}\n@media (min-width: 640px) {\n  .product-description-content h2 {\n    margin-bottom: 1rem;\n    margin-top: 1.5rem;\n  }\n}\n.product-description-content h2 {\n  font-size: 1.5rem; /* 24px */\n  line-height: 1.35;\n}\n.product-description-content h3 {\n  margin-bottom: 0.75rem;\n  margin-top: 1rem;\n  font-weight: 600;\n  color: hsl(var(--foreground));\n}\n@media (min-width: 640px) {\n  .product-description-content h3 {\n    margin-bottom: 1rem;\n    margin-top: 1.25rem;\n  }\n}\n.product-description-content h3 {\n  font-size: 1.25rem; /* 20px */\n  line-height: 1.4;\n}\n.product-description-content h4 {\n  margin-bottom: 0.5rem;\n  margin-top: 0.75rem;\n  font-weight: 600;\n  color: hsl(var(--foreground));\n}\n@media (min-width: 640px) {\n  .product-description-content h4 {\n    margin-bottom: 0.75rem;\n    margin-top: 1rem;\n  }\n}\n.product-description-content h4 {\n  font-size: 1.125rem; /* 18px */\n  line-height: 1.45;\n}\n.product-description-content h5 {\n  margin-bottom: 0.5rem;\n  margin-top: 0.75rem;\n  font-weight: 600;\n  color: hsl(var(--foreground));\n}\n@media (min-width: 640px) {\n  .product-description-content h5 {\n    margin-bottom: 0.75rem;\n    margin-top: 1rem;\n  }\n}\n.product-description-content h5 {\n  font-size: 1rem; /* 16px */\n  line-height: 1.5;\n}\n.product-description-content h6 {\n  margin-bottom: 0.5rem;\n  margin-top: 0.75rem;\n  font-weight: 600;\n  color: hsl(var(--foreground));\n}\n@media (min-width: 640px) {\n  .product-description-content h6 {\n    margin-bottom: 0.75rem;\n    margin-top: 1rem;\n  }\n}\n.product-description-content h6 {\n  font-size: 0.9375rem; /* 15px */\n  line-height: 1.5;\n}\n/* Responsive headings */\n@media (min-width: 640px) {\n  .product-description-content h1 {\n    font-size: 2rem; /* 32px */\n  }\n  .product-description-content h2 {\n    font-size: 1.75rem; /* 28px */\n  }\n  .product-description-content h3 {\n    font-size: 1.375rem; /* 22px */\n  }\n}\n/* Formatage de texte */\n.product-description-content strong,\n.product-description-content b {\n  font-weight: 700;\n  color: hsl(var(--foreground));\n}\n.product-description-content em,\n.product-description-content i {\n  font-style: italic;\n  color: hsl(var(--foreground));\n}\n.product-description-content u {\n  text-decoration-line: underline;\n  text-decoration-thickness: 2px;\n  text-underline-offset: 2px;\n  text-decoration-color: currentColor;\n}\n.product-description-content s,\n.product-description-content strike {\n  color: hsl(var(--muted-foreground));\n  text-decoration-line: line-through;\n}\n/* Listes */\n.product-description-content ul,\n.product-description-content ol {\n  margin-bottom: 1rem;\n  margin-left: 1rem;\n}\n@media (min-width: 640px) {\n  .product-description-content ul,\n.product-description-content ol {\n    margin-bottom: 1.25rem;\n    margin-left: 1.5rem;\n  }\n}\n.product-description-content ul,\n.product-description-content ol {\n  list-style-position: outside;\n}\n.product-description-content ul {\n  list-style-type: disc;\n}\n.product-description-content ol {\n  list-style-type: decimal;\n}\n.product-description-content li {\n  margin-bottom: 0.5rem;\n  color: hsl(var(--foreground));\n  font-size: inherit;\n  line-height: inherit;\n}\n.product-description-content li::marker {\n  color: hsl(var(--foreground));\n}\n/* Liens */\n.product-description-content a {\n  color: hsl(var(--primary));\n  text-decoration-line: underline;\n  text-decoration-thickness: 2px;\n  text-underline-offset: 2px;\n  transition: color 0.2s ease;\n}\n.product-description-content a:hover {\n  color: hsl(var(--primary) / 0.8);\n}\n.product-description-content a:focus {\n  outline-width: 2px;\n  outline-offset: 2px;\n  outline-color: hsl(var(--primary));\n}\n/* Citations */\n.product-description-content blockquote {\n  margin-top: 1rem;\n  margin-bottom: 1rem;\n  border-left-width: 4px;\n  border-color: hsl(var(--primary));\n  padding-top: 0.5rem;\n  padding-bottom: 0.5rem;\n  padding-left: 1rem;\n}\n@media (min-width: 640px) {\n  .product-description-content blockquote {\n    margin-top: 1.5rem;\n    margin-bottom: 1.5rem;\n    padding-top: 0.75rem;\n    padding-bottom: 0.75rem;\n    padding-left: 1.5rem;\n  }\n}\n.product-description-content blockquote {\n  background-color: hsl(var(--muted) / 0.5);\n  font-style: italic;\n  color: hsl(var(--foreground));\n  border-radius: 0 0.5rem 0.5rem 0;\n}\n/* Code */\n.product-description-content code {\n  border-radius: 0.25rem;\n  background-color: hsl(var(--muted));\n  padding-left: 0.375rem;\n  padding-right: 0.375rem;\n  padding-top: 0.125rem;\n  padding-bottom: 0.125rem;\n  font-size: 0.875rem;\n  line-height: 1.375rem;\n  letter-spacing: 0;\n  font-family: JetBrains Mono, Fira Code, Consolas, monospace;\n  color: hsl(var(--foreground));\n  font-size: 0.875em;\n}\n.product-description-content pre {\n  margin-top: 1rem;\n  margin-bottom: 1rem;\n  border-radius: var(--radius);\n  background-color: hsl(var(--muted));\n  padding: 0.75rem;\n}\n@media (min-width: 640px) {\n  .product-description-content pre {\n    margin-top: 1.5rem;\n    margin-bottom: 1.5rem;\n    padding: 1rem;\n  }\n}\n.product-description-content pre {\n  overflow-x: auto;\n  font-size: 0.875rem;\n  line-height: 1.6;\n}\n.product-description-content pre code {\n  background-color: transparent;\n  padding: 0px;\n  font-size: inherit;\n}\n/* Divs et spans avec styles inline (couleurs, etc.) */\n.product-description-content div,\n.product-description-content span {\n  color: hsl(var(--foreground));\n}\n/* Respect des styles inline définis dans le wizard */\n.product-description-content [style*='color'] {\n  /* Les couleurs définies dans le wizard sont préservées */\n}\n.product-description-content [style*='background-color'] {\n  /* Les couleurs de fond sont préservées */\n}\n.product-description-content [style*='text-decoration'] {\n  /* Les décorations de texte sont préservées */\n}\n.product-description-content [style*='font-weight'] {\n  /* Les poids de police sont préservés */\n}\n.product-description-content [style*='font-style'] {\n  /* Les styles de police sont préservés */\n}\n/* Images dans la description (si ajoutées) */\n.product-description-content img {\n  margin-top: 1rem;\n  margin-bottom: 1rem;\n  height: auto;\n  max-width: 100%;\n  border-radius: var(--radius);\n}\n@media (min-width: 640px) {\n  .product-description-content img {\n    margin-top: 1.5rem;\n    margin-bottom: 1.5rem;\n  }\n}\n.product-description-content img {\n  border-width: 1px;\n  border-color: hsl(var(--border));\n}\n/* Tables (si ajoutées) */\n.product-description-content table {\n  margin-top: 1rem;\n  margin-bottom: 1rem;\n  width: 100%;\n  border-collapse: collapse;\n}\n@media (min-width: 640px) {\n  .product-description-content table {\n    margin-top: 1.5rem;\n    margin-bottom: 1.5rem;\n  }\n}\n.product-description-content table {\n  display: block;\n  overflow-x: auto;\n}\n@media (min-width: 640px) {\n  .product-description-content table {\n    display: table;\n  }\n}\n.product-description-content th,\n.product-description-content td {\n  border-width: 1px;\n  border-color: hsl(var(--border));\n  padding-left: 0.75rem;\n  padding-right: 0.75rem;\n  padding-top: 0.5rem;\n  padding-bottom: 0.5rem;\n}\n@media (min-width: 640px) {\n  .product-description-content th,\n.product-description-content td {\n    padding-left: 1rem;\n    padding-right: 1rem;\n    padding-top: 0.75rem;\n    padding-bottom: 0.75rem;\n  }\n}\n.product-description-content th,\n.product-description-content td {\n  text-align: left;\n  color: hsl(var(--foreground));\n}\n.product-description-content th {\n  background-color: hsl(var(--muted));\n  font-weight: 600;\n}\n/* Saut de ligne */\n.product-description-content br {\n  display: block;\n  content: '';\n  margin-top: 0.5rem;\n}\n/* ============================================================\n   SCROLLBARS PERSONNALISÉES POUR SIDEBARS\n   Design professionnel et moderne\n   ============================================================ */\n/* Scrollbar personnalisée pour les sidebars */\n.scrollbar-thin {\n  scrollbar-width: thin;\n  scrollbar-color: hsl(var(--border)) transparent;\n}\n.scrollbar-thin::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n.scrollbar-thin::-webkit-scrollbar-track {\n  background: transparent;\n}\n.scrollbar-thin::-webkit-scrollbar-thumb {\n  background-color: hsl(var(--border));\n  border-radius: 3px;\n  -webkit-transition: background-color 0.2s ease;\n  transition: background-color 0.2s ease;\n}\n.scrollbar-thin::-webkit-scrollbar-thumb:hover {\n  background-color: hsl(var(--muted-foreground) / 0.3);\n}\n/* Scrollbar pour Firefox */\n.scrollbar-thin {\n  scrollbar-width: thin;\n  scrollbar-color: hsl(var(--border)) transparent;\n}\n/* OPTIMISATION: CSS du sidebar déplacé dans sidebar-optimized.css\n   pour permettre le chargement asynchrone et réduire le CSS critique */\n@media (max-width: 768px) {\n    /* Réduire la durée des animations (sauf marquees landing) */\n\n    /* Désactiver les animations non-essentielles */\n\n    /* Désactiver les transformations au hover (peu utiles sur mobile) */\n\n    /* Réduire les effets de glow et shadow sur mobile */\n    .hover\\:shadow-glow:hover {\n      box-shadow: var(--shadow-soft) !important;\n    }\n  }\n@media (min-width: 640px) {\n  @media (max-width: 360px) {\n\n    /* Padding réduit pour très petits écrans */\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n    .sm\\:space-y-3 > * + * {\n      margin-top: 0.5rem;\n    }\n\n    /* Grilles adaptées */\n\n    /* Padding réduit pour très petits écrans */\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n\n    .sm\\:space-y-4 > * + * {\n      margin-top: 0.75rem;\n    }\n\n    /* Grilles adaptées */\n\n    /* Padding réduit pour très petits écrans */\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* 