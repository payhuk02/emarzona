import { createHotContext as __vite__createHotContext } from "/@vite/client";import.meta.hot = __vite__createHotContext("/src/index.css");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from "/@vite/client"
const __vite__id = "/home/runner/work/emarzona/emarzona/src/index.css"
const __vite__css = "/* All @import statements must come first */\n/* Google Fonts chargé via <link> dans index.html pour éviter les problèmes CSP */\n/**\n * Animations CSS personnalisées\n * À utiliser avec Tailwind ou directement\n */\n/* Animations de base */\n@keyframes fadeIn {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n@keyframes fadeOut {\n  from {\n    opacity: 1;\n  }\n  to {\n    opacity: 0;\n  }\n}\n@keyframes slideInUp {\n  from {\n    transform: translateY(20px);\n    opacity: 0;\n  }\n  to {\n    transform: translateY(0);\n    opacity: 1;\n  }\n}\n@keyframes slideInDown {\n  from {\n    transform: translateY(-20px);\n    opacity: 0;\n  }\n  to {\n    transform: translateY(0);\n    opacity: 1;\n  }\n}\n@keyframes slideInLeft {\n  from {\n    transform: translateX(-20px);\n    opacity: 0;\n  }\n  to {\n    transform: translateX(0);\n    opacity: 1;\n  }\n}\n@keyframes slideInRight {\n  from {\n    transform: translateX(20px);\n    opacity: 0;\n  }\n  to {\n    transform: translateX(0);\n    opacity: 1;\n  }\n}\n@keyframes scaleIn {\n  from {\n    transform: scale(0.9);\n    opacity: 0;\n  }\n  to {\n    transform: scale(1);\n    opacity: 1;\n  }\n}\n@keyframes pulse {\n  0%,\n  100% {\n    transform: scale(1);\n    opacity: 1;\n  }\n  50% {\n    transform: scale(1.05);\n    opacity: 0.8;\n  }\n}\n@keyframes bounce {\n  0%,\n  100% {\n    transform: translateY(0);\n  }\n  50% {\n    transform: translateY(-10px);\n  }\n}\n@keyframes shimmer {\n  0% {\n    background-position: -1000px 0;\n  }\n  100% {\n    background-position: 1000px 0;\n  }\n}\n@keyframes wave {\n  0%,\n  100% {\n    transform: translateY(0);\n  }\n  25% {\n    transform: translateY(-10px);\n  }\n  75% {\n    transform: translateY(10px);\n  }\n}\n@keyframes spin {\n  from {\n    transform: rotate(0deg);\n  }\n  to {\n    transform: rotate(360deg);\n  }\n}\n/* Classes utilitaires */\n.animate-fade-in {\n  animation: fadeIn 0.3s ease-out;\n}\n.animate-fade-out {\n  animation: fadeOut 0.3s ease-out;\n}\n.animate-slide-in-up {\n  animation: slideInUp 0.4s ease-out;\n}\n.animate-slide-in-down {\n  animation: slideInDown 0.4s ease-out;\n}\n.animate-slide-in-left {\n  animation: slideInLeft 0.4s ease-out;\n}\n.animate-slide-in-right {\n  animation: slideInRight 0.4s ease-out;\n}\n.animate-scale-in {\n  animation: scaleIn 0.3s ease-out;\n}\n.animate-pulse-slow {\n  animation: pulse 2s ease-in-out infinite;\n}\n.animate-bounce-slow {\n  animation: bounce 1s ease-in-out infinite;\n}\n.animate-shimmer {\n  background: linear-gradient(\n    90deg,\n    rgba(255, 255, 255, 0) 0%,\n    rgba(255, 255, 255, 0.2) 50%,\n    rgba(255, 255, 255, 0) 100%\n  );\n  background-size: 1000px 100%;\n  animation: shimmer 2s infinite linear;\n}\n.animate-wave {\n  animation: wave 1.5s ease-in-out infinite;\n}\n/* Animation au scroll */\n.animate-on-scroll {\n  opacity: 0;\n  transform: translateY(20px);\n  transition:\n    opacity 0.6s ease-out,\n    transform 0.6s ease-out;\n}\n.animate-on-scroll.animate-in {\n  opacity: 1;\n  transform: translateY(0);\n}\n/* Délais d'animation pour effet de cascade */\n.animate-delay-100 {\n  animation-delay: 100ms;\n}\n.animate-delay-200 {\n  animation-delay: 200ms;\n}\n.animate-delay-300 {\n  animation-delay: 300ms;\n}\n.animate-delay-400 {\n  animation-delay: 400ms;\n}\n.animate-delay-500 {\n  animation-delay: 500ms;\n}\n/* Hover effects - Optimisés avec GPU acceleration */\n.hover-lift {\n  transition:\n    transform 0.2s ease-out,\n    box-shadow 0.2s ease-out;\n  will-change: transform;\n  transform: translateZ(0); /* Force GPU acceleration */\n}\n.hover-lift:hover {\n  transform: translateY(-4px) translateZ(0);\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);\n}\n.hover-lift:not(:hover) {\n  will-change: auto; /* Réinitialiser après animation */\n}\n.hover-scale {\n  transition: transform 0.2s ease-out;\n  will-change: transform;\n  transform: translateZ(0); /* Force GPU acceleration */\n}\n.hover-scale:hover {\n  transform: scale(1.05) translateZ(0);\n}\n.hover-scale:not(:hover) {\n  will-change: auto; /* Réinitialiser après animation */\n}\n.hover-glow {\n  transition: box-shadow 0.3s ease-out;\n  will-change: box-shadow;\n}\n.hover-glow:hover {\n  box-shadow: 0 0 20px rgba(99, 102, 241, 0.5);\n}\n.hover-glow:not(:hover) {\n  will-change: auto; /* Réinitialiser après animation */\n}\n/* Skeleton loading */\n.skeleton {\n  background: linear-gradient(90deg, #f0f0f0 0%, #e0e0e0 50%, #f0f0f0 100%);\n  background-size: 200% 100%;\n  animation: shimmer 1.5s infinite linear;\n  border-radius: 4px;\n}\n.skeleton-dark {\n  background: linear-gradient(90deg, #2a2a2a 0%, #1a1a1a 50%, #2a2a2a 100%);\n  background-size: 200% 100%;\n  animation: shimmer 1.5s infinite linear;\n}\n/* Transitions fluides */\n.transition-smooth {\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n.transition-fast {\n  transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);\n}\n.transition-slow {\n  transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);\n}\n/* Page transitions */\n.page-enter {\n  opacity: 0;\n  transform: translateX(-20px);\n}\n.page-enter-active {\n  opacity: 1;\n  transform: translateX(0);\n  transition:\n    opacity 0.3s,\n    transform 0.3s;\n}\n.page-exit {\n  opacity: 1;\n  transform: translateX(0);\n}\n.page-exit-active {\n  opacity: 0;\n  transform: translateX(20px);\n  transition:\n    opacity 0.3s,\n    transform 0.3s;\n}\n/* Modal/Dialog animations */\n.modal-backdrop-enter {\n  opacity: 0;\n}\n.modal-backdrop-enter-active {\n  opacity: 1;\n  transition: opacity 0.2s;\n}\n.modal-backdrop-exit {\n  opacity: 1;\n}\n.modal-backdrop-exit-active {\n  opacity: 0;\n  transition: opacity 0.2s;\n}\n.modal-content-enter {\n  opacity: 0;\n  transform: scale(0.95) translateY(20px);\n}\n.modal-content-enter-active {\n  opacity: 1;\n  transform: scale(1) translateY(0);\n  transition:\n    opacity 0.3s,\n    transform 0.3s;\n}\n.modal-content-exit {\n  opacity: 1;\n  transform: scale(1) translateY(0);\n}\n.modal-content-exit-active {\n  opacity: 0;\n  transform: scale(0.95) translateY(20px);\n  transition:\n    opacity 0.3s,\n    transform 0.3s;\n}\n/* Notification/Toast animations */\n.toast-enter {\n  opacity: 0;\n  transform: translateX(100%);\n}\n.toast-enter-active {\n  opacity: 1;\n  transform: translateX(0);\n  transition:\n    opacity 0.3s,\n    transform 0.3s;\n}\n.toast-exit {\n  opacity: 1;\n  transform: translateX(0);\n}\n.toast-exit-active {\n  opacity: 0;\n  transform: translateX(100%);\n  transition:\n    opacity 0.3s,\n    transform 0.3s;\n}\n/* Loading spinner */\n@keyframes spin-slow {\n  from {\n    transform: rotate(0deg);\n  }\n  to {\n    transform: rotate(360deg);\n  }\n}\n.loading-spinner {\n  animation: spin-slow 1s linear infinite;\n}\n/* Card hover effect - Optimisé avec GPU acceleration */\n.card-hover {\n  transition:\n    transform 0.2s ease-out,\n    box-shadow 0.2s ease-out;\n  will-change: transform;\n  transform: translateZ(0); /* Force GPU acceleration */\n}\n.card-hover:hover {\n  transform: translateY(-4px) scale(1.02) translateZ(0);\n  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);\n}\n.card-hover:not(:hover) {\n  will-change: auto; /* Réinitialiser après animation */\n}\n/* Image zoom effect */\n.image-zoom {\n  overflow: hidden;\n}\n.image-zoom img {\n  transition: transform 0.4s ease-out;\n}\n.image-zoom:hover img {\n  transform: scale(1.1);\n}\n/* Button ripple effect */\n.button-ripple {\n  position: relative;\n  overflow: hidden;\n}\n.button-ripple::after {\n  content: '';\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 0;\n  height: 0;\n  border-radius: 50%;\n  background: rgba(255, 255, 255, 0.5);\n  transform: translate(-50%, -50%);\n  transition:\n    width 0.6s,\n    height 0.6s;\n}\n.button-ripple:active::after {\n  width: 300px;\n  height: 300px;\n}\n/* Smooth scroll */\nhtml {\n  scroll-behavior: smooth;\n}\n/* Reduce motion for accessibility */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n/**\n * Optimisations Mobile - Phase 2 UX\n * Améliorations spécifiques pour l'expérience mobile\n */\n/* === TOUCH TARGETS === */\n/* Taille minimale 44x44px pour les éléments interactifs (Apple HIG, Material Design) */\nbutton,\na,\ninput[type='button'],\ninput[type='submit'],\ninput[type='checkbox'],\ninput[type='radio'],\nselect {\n  min-height: 44px;\n  min-width: 44px;\n}\n/* === SCROLL SMOOTH === */\n/* Amélioration du scroll sur mobile */\n@media (max-width: 768px) {\n  * {\n    -webkit-overflow-scrolling: touch;\n  }\n\n  body {\n    overscroll-behavior-y: contain;\n  }\n}\n/* === TEXT SIZE === */\n/* Taille de texte optimale pour mobile */\n@media (max-width: 768px) {\n  body {\n    font-size: 16px; /* Évite le zoom automatique sur iOS */\n    -webkit-text-size-adjust: 100%;\n    -moz-text-size-adjust: 100%;\n         text-size-adjust: 100%;\n  }\n\n  input,\n  textarea,\n  select {\n    font-size: 16px; /* Évite le zoom automatique sur iOS */\n  }\n}\n/* === VIEWPORT FIXES === */\n/* Corrections pour les navigateurs mobiles */\n@supports (-webkit-touch-callout: none) {\n  /* iOS Safari */\n  .mobile-fix {\n    min-height: -webkit-fill-available;\n  }\n}\n/* === SAFE AREA === */\n/* Support pour les zones sûres (notch, etc.) */\n@supports (padding: max(0px)) {\n  .safe-area-top {\n    padding-top: max(1rem, env(safe-area-inset-top));\n  }\n\n  .safe-area-bottom {\n    padding-bottom: max(1rem, env(safe-area-inset-bottom));\n  }\n\n  .safe-area-left {\n    padding-left: max(1rem, env(safe-area-inset-left));\n  }\n\n  .safe-area-right {\n    padding-right: max(1rem, env(safe-area-inset-right));\n  }\n}\n/* === MODAL MOBILE === */\n/* Modales optimisées pour mobile */\n@media (max-width: 768px) {\n  [role='dialog'],\n  [role='alertdialog'] {\n    max-height: 90vh;\n    max-width: 100vw;\n    margin: 0;\n    border-radius: 1rem 1rem 0 0;\n  }\n\n  /* Animation slide-up pour mobile */\n  .modal-mobile-enter {\n    transform: translateY(100%);\n  }\n\n  .modal-mobile-enter-active {\n    transform: translateY(0);\n    transition: transform 0.3s ease-out;\n  }\n}\n/* === NAVIGATION MOBILE === */\n/* Navigation optimisée pour mobile */\n@media (max-width: 768px) {\n  nav:not(.platform-customization-nav-list):not(.context-bottom-nav) {\n    position: sticky;\n    top: 0;\n    z-index: 100;\n    background: var(--background);\n    backdrop-filter: blur(10px);\n  }\n\n  /* Exception pour la barre de navigation contextuelle en bas */\n  nav.context-bottom-nav {\n    position: fixed !important;\n    top: auto !important;\n    bottom: 0 !important;\n    z-index: 110 !important;\n  }\n\n  /* Bottom navigation pour mobile */\n  .bottom-nav {\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    background: var(--background);\n    border-top: 1px solid var(--border);\n    padding: 0.5rem 0;\n    padding-bottom: max(0.5rem, env(safe-area-inset-bottom));\n    z-index: 100;\n  }\n}\n/* === CARDS MOBILE === */\n/* Cartes optimisées pour mobile */\n@media (max-width: 768px) {\n  .card-mobile {\n    margin: 0.5rem;\n    border-radius: 0.75rem;\n  }\n\n  .card-mobile:active {\n    transform: scale(0.98);\n    transition: transform 0.1s;\n  }\n}\n/* === FORMS MOBILE === */\n/* Formulaires optimisés pour mobile */\n@media (max-width: 768px) {\n  input[type='text'],\n  input[type='email'],\n  input[type='password'],\n  input[type='number'],\n  input[type='tel'],\n  input[type='url'],\n  textarea,\n  select {\n    width: 100%;\n    padding: 0.75rem;\n    font-size: 16px; /* Évite le zoom automatique */\n    border-radius: 0.5rem;\n  }\n\n  /* Labels au-dessus des inputs sur mobile */\n  .form-group-mobile {\n    display: flex;\n    flex-direction: column;\n    gap: 0.5rem;\n  }\n}\n/* === BUTTONS MOBILE === */\n/* Boutons optimisés pour mobile */\n@media (max-width: 768px) {\n  .btn-mobile {\n    width: 100%;\n    padding: 0.875rem 1.5rem;\n    font-size: 1rem;\n    font-weight: 600;\n    border-radius: 0.75rem;\n    min-height: 48px; /* Touch target optimal */\n  }\n\n  .btn-mobile:active {\n    transform: scale(0.98);\n    opacity: 0.9;\n  }\n}\n/* === IMAGES MOBILE === */\n/* Images optimisées pour mobile */\n@media (max-width: 768px) {\n  img {\n    max-width: 100%;\n    height: auto;\n  }\n\n  /* Lazy loading pour mobile (hors landing premium) */\n  img[loading='lazy']:not([data-no-mobile-opt]) {\n    opacity: 0;\n    transition: opacity 0.3s;\n  }\n\n  img[loading='lazy'].loaded,\n  img[loading='lazy'][data-no-mobile-opt],\n  .landing-premium img[loading='lazy']:not([data-no-mobile-opt]) {\n    opacity: 1;\n  }\n}\n/* === TABLES MOBILE === */\n/* Tables optimisées pour mobile */\n@media (max-width: 768px) {\n  table {\n    display: block;\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n  }\n\n  /* Stack table sur mobile */\n  .table-mobile-stack {\n    display: block;\n  }\n\n  .table-mobile-stack thead {\n    display: none;\n  }\n\n  .table-mobile-stack tbody,\n  .table-mobile-stack tr,\n  .table-mobile-stack td {\n    display: block;\n    width: 100%;\n  }\n\n  .table-mobile-stack td {\n    text-align: right;\n    padding: 0.5rem;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .table-mobile-stack td::before {\n    content: attr(data-label);\n    float: left;\n    font-weight: 600;\n  }\n}\n/* === LOADING STATES MOBILE === */\n/* États de chargement optimisés pour mobile */\n@media (max-width: 768px) {\n  .skeleton-mobile {\n    border-radius: 0.5rem;\n    margin: 0.5rem 0;\n  }\n\n  .loading-spinner-mobile {\n    width: 2rem;\n    height: 2rem;\n  }\n}\n/* === SCROLLBAR HIDE === */\n/* Masquer la scrollbar tout en gardant le scroll */\n.scrollbar-hide {\n  -ms-overflow-style: none; /* IE et Edge */\n  scrollbar-width: none; /* Firefox */\n}\n.scrollbar-hide::-webkit-scrollbar {\n  display: none; /* Chrome, Safari et Opera */\n}\n/* === SCROLLBAR PROFESSIONNELLE POUR ONGLET COMMANDES === */\n/* Barre de défilement horizontale visible et stylisée pour l'onglet Commandes - Version Professionnelle */\n.scrollbar-orders {\n  scrollbar-width: thin; /* Firefox - barre fine */\n  scrollbar-color: rgb(168 85 247 / 0.7) rgb(0 0 0 / 0.08); /* Firefox - thumb et track améliorés */\n  /* Momentum scrolling pour iOS */\n  -webkit-overflow-scrolling: touch;\n}\n.scrollbar-orders::-webkit-scrollbar {\n  height: 10px; /* Hauteur de la barre de défilement horizontale - Augmentée pour meilleure visibilité */\n}\n.scrollbar-orders::-webkit-scrollbar-track {\n  background: linear-gradient(\n    to right,\n    rgb(0 0 0 / 0.03),\n    rgb(0 0 0 / 0.05),\n    rgb(0 0 0 / 0.03)\n  ); /* Gradient subtil pour la piste */\n  border-radius: 5px;\n  margin: 2px 0;\n}\n.scrollbar-orders::-webkit-scrollbar-thumb {\n  background: linear-gradient(\n    to right,\n    rgb(168 85 247 / 0.4),\n    rgb(168 85 247 / 0.7),\n    rgb(168 85 247 / 0.4)\n  ); /* Gradient pour le curseur */\n  border-radius: 5px;\n  border: 1px solid rgb(168 85 247 / 0.2);\n  -webkit-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  box-shadow: 0 2px 4px rgb(168 85 247 / 0.2);\n}\n.scrollbar-orders::-webkit-scrollbar-thumb:hover {\n  background: linear-gradient(\n    to right,\n    rgb(168 85 247 / 0.6),\n    rgb(168 85 247 / 0.9),\n    rgb(168 85 247 / 0.6)\n  ); /* Gradient plus intense au survol */\n  box-shadow: 0 2px 6px rgb(168 85 247 / 0.4);\n  transform: scaleY(1.1);\n}\n.scrollbar-orders::-webkit-scrollbar-thumb:active {\n  background: linear-gradient(\n    to right,\n    rgb(147 51 234 / 0.7),\n    rgb(168 85 247 / 1),\n    rgb(147 51 234 / 0.7)\n  ); /* Gradient encore plus intense au clic */\n  box-shadow: 0 1px 3px rgb(168 85 247 / 0.5);\n}\n/* Dark mode support */\n@media (prefers-color-scheme: dark) {\n  .scrollbar-orders {\n    scrollbar-color: rgb(168 85 247 / 0.8) rgb(255 255 255 / 0.05);\n  }\n\n  .scrollbar-orders::-webkit-scrollbar-track {\n    background: linear-gradient(\n      to right,\n      rgb(255 255 255 / 0.02),\n      rgb(255 255 255 / 0.05),\n      rgb(255 255 255 / 0.02)\n    );\n  }\n}\n/* === PERFORMANCE MOBILE === */\n/* Optimisations de performance pour mobile */\n@media (max-width: 768px) {\n  /*\n   * ⚠️ PERF: éviter les overrides globaux sur `*` avec `!important`\n   * Ça force des recalculs de style massifs et peut dégrader le scroll / input latency.\n   * On garde des optimisations ciblées ci-dessous et le mode \"reduce-motion-mobile\" si besoin.\n   */\n\n  /* Désactiver les animations complexes sur mobile */\n  .reduce-motion-mobile *,\n  .reduce-motion-mobile *::before,\n  .reduce-motion-mobile *::after {\n    animation-duration: 0.01ms !important;\n    transition-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n  }\n\n  /* Désactiver les animations de hover sur mobile (pas de hover sur tactile) */\n  @media (hover: none) {\n    *:hover {\n      transform: none !important;\n      transition: none !important;\n    }\n\n    .hover-lift:hover,\n    .hover-scale:hover,\n    .hover-glow:hover {\n      transform: none !important;\n      box-shadow: none !important;\n    }\n  }\n\n  /* Optimiser les animations de scroll sur mobile */\n  .animate-on-scroll {\n    animation-duration: 0.3s !important;\n  }\n\n  /* Réduire les animations de skeleton */\n  .skeleton,\n  .skeleton-dark {\n    animation-duration: 1s !important;\n  }\n\n  /* Réduire les animations de pulse */\n  .animate-pulse {\n    animation-duration: 2s !important;\n  }\n\n  /* Optimiser les transitions de modales sur mobile */\n  .modal-content-enter-active,\n  .modal-content-exit-active {\n    transition-duration: 0.2s !important;\n  }\n\n  /* Optimiser les transitions de toasts sur mobile */\n  .toast-enter-active,\n  .toast-exit-active {\n    transition-duration: 0.2s !important;\n  }\n}\n/* === ACCESSIBILITY MOBILE === */\n/* Améliorations d'accessibilité mobile */\n@media (max-width: 768px) {\n  /* Focus visible amélioré sur mobile */\n  *:focus-visible {\n    outline: 3px solid var(--primary);\n    outline-offset: 2px;\n  }\n\n  /* Skip link visible sur mobile */\n  .skip-link:focus {\n    position: fixed;\n    top: 1rem;\n    left: 1rem;\n    z-index: 1000;\n    padding: 0.75rem 1.5rem;\n    background: var(--primary);\n    color: white;\n    border-radius: 0.5rem;\n  }\n}\n/**\n * Mobile-First Design System\n * Système de design optimisé pour mobile avec scaling progressif vers desktop\n * \n * Breakpoints:\n * - Mobile: 320px - 767px (base)\n * - Tablet: 768px - 1023px\n * - Desktop: 1024px+\n */\n/* ============================================\n   MOBILE-FIRST TYPOGRAPHY SYSTEM\n   ============================================ */\n:root {\n  /* Mobile-first font sizes (base: 16px) */\n  --font-size-xs: 0.75rem; /* 12px - Mobile only */\n  --font-size-sm: 0.875rem; /* 14px - Mobile base */\n  --font-size-base: 1rem; /* 16px - Mobile body, prevents iOS zoom */\n  --font-size-lg: 1.125rem; /* 18px - Mobile subheading */\n  --font-size-xl: 1.25rem; /* 20px - Mobile heading */\n  --font-size-2xl: 1.5rem; /* 24px - Mobile large heading */\n  --font-size-3xl: 1.875rem; /* 30px - Tablet heading */\n  --font-size-4xl: 2.25rem; /* 36px - Desktop heading */\n\n  /* Line heights optimized for mobile */\n  --line-height-tight: 1.25;\n  --line-height-normal: 1.5;\n  --line-height-relaxed: 1.75;\n\n  /* Spacing system mobile-first */\n  --spacing-xs: 0.25rem; /* 4px */\n  --spacing-sm: 0.5rem; /* 8px */\n  --spacing-md: 0.75rem; /* 12px */\n  --spacing-base: 1rem; /* 16px */\n  --spacing-lg: 1.5rem; /* 24px */\n  --spacing-xl: 2rem; /* 32px */\n  --spacing-2xl: 3rem; /* 48px */\n\n  /* Safe area padding for mobile */\n  --safe-area-top: env(safe-area-inset-top, 0px);\n  --safe-area-bottom: env(safe-area-inset-bottom, 0px);\n  --safe-area-left: env(safe-area-inset-left, 0px);\n  --safe-area-right: env(safe-area-inset-right, 0px);\n\n  /* Container padding mobile-first */\n  --container-padding-mobile: 1rem; /* 16px */\n  --container-padding-tablet: 1.5rem; /* 24px */\n  --container-padding-desktop: 2rem; /* 32px */\n\n  /* Touch target sizes */\n  --touch-target-min: 44px; /* WCAG 2.5.5 minimum */\n  --touch-target-comfortable: 48px;\n\n  /* Border radius mobile */\n  --radius-sm: 0.375rem; /* 6px */\n  --radius-base: 0.5rem; /* 8px */\n  --radius-lg: 0.75rem; /* 12px */\n  --radius-xl: 1rem; /* 16px */\n}\n/* ============================================\n   MOBILE-FIRST BASE STYLES\n   ============================================ */\n@media (max-width: 767px) {\n  /* Base typography for mobile */\n  html {\n    font-size: 16px; /* Prevents iOS zoom on input focus */\n    -webkit-text-size-adjust: 100%;\n    -moz-text-size-adjust: 100%;\n         text-size-adjust: 100%;\n  }\n\n  body {\n    font-size: var(--font-size-base);\n    line-height: var(--line-height-normal);\n    padding-left: var(--safe-area-left);\n    padding-right: var(--safe-area-right);\n  }\n\n  /* Headings mobile-optimized */\n  h1 {\n    font-size: var(--font-size-2xl);\n    line-height: var(--line-height-tight);\n    font-weight: 700;\n    margin-bottom: var(--spacing-base);\n  }\n\n  h2 {\n    font-size: var(--font-size-xl);\n    line-height: var(--line-height-tight);\n    font-weight: 600;\n    margin-bottom: var(--spacing-md);\n  }\n\n  h3 {\n    font-size: var(--font-size-lg);\n    line-height: var(--line-height-normal);\n    font-weight: 600;\n    margin-bottom: var(--spacing-md);\n  }\n\n  h4,\n  h5,\n  h6 {\n    font-size: var(--font-size-base);\n    line-height: var(--line-height-normal);\n    font-weight: 600;\n    margin-bottom: var(--spacing-sm);\n  }\n\n  /* Paragraphs */\n  p {\n    font-size: var(--font-size-base);\n    line-height: var(--line-height-relaxed);\n    margin-bottom: var(--spacing-base);\n  }\n\n  /* Links */\n  a {\n    font-size: var(--font-size-base);\n    min-height: var(--touch-target-min);\n    display: inline-flex;\n    align-items: center;\n  }\n\n  /* Container mobile */\n  .container {\n    width: 100%;\n    max-width: 100%;\n    padding-left: var(--container-padding-mobile);\n    padding-right: var(--container-padding-mobile);\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n  /* Prevent horizontal scroll */\n  * {\n    max-width: 100%;\n  }\n\n  img,\n  video,\n  iframe {\n    max-width: 100%;\n    height: auto;\n  }\n\n  /* Tables mobile-friendly */\n  table {\n    display: block;\n    width: 100%;\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n  }\n}\n/* ============================================\n   TABLET OPTIMIZATIONS (768px - 1023px)\n   ============================================ */\n@media (min-width: 768px) and (max-width: 1023px) {\n  html {\n    font-size: 16px;\n  }\n\n  body {\n    font-size: var(--font-size-base);\n  }\n\n  h1 {\n    font-size: var(--font-size-3xl);\n  }\n\n  h2 {\n    font-size: var(--font-size-2xl);\n  }\n\n  h3 {\n    font-size: var(--font-size-xl);\n  }\n\n  .container {\n    padding-left: var(--container-padding-tablet);\n    padding-right: var(--container-padding-tablet);\n  }\n}\n/* ============================================\n   DESKTOP OPTIMIZATIONS (1024px+)\n   ============================================ */\n@media (min-width: 1024px) {\n  html {\n    font-size: 16px;\n  }\n\n  body {\n    font-size: var(--font-size-base);\n  }\n\n  h1 {\n    font-size: var(--font-size-4xl);\n  }\n\n  h2 {\n    font-size: var(--font-size-3xl);\n  }\n\n  h3 {\n    font-size: var(--font-size-2xl);\n  }\n\n  .container {\n    padding-left: var(--container-padding-desktop);\n    padding-right: var(--container-padding-desktop);\n    max-width: 1280px;\n  }\n}\n/* ============================================\n   TOUCH TARGETS - MOBILE-FIRST\n   ============================================ */\n@media (max-width: 767px) {\n  /* All interactive elements must be at least 44px */\n  button,\n  a[role='button'],\n  input[type='button'],\n  input[type='submit'],\n  input[type='checkbox'],\n  input[type='radio'],\n  select,\n  [role='button'],\n  [role='tab'],\n  [role='menuitem'] {\n    min-height: var(--touch-target-min);\n    min-width: var(--touch-target-min);\n    padding: var(--spacing-sm) var(--spacing-base);\n    font-size: var(--font-size-base); /* Prevents iOS zoom */\n  }\n\n  /* Icon-only buttons */\n  button[aria-label],\n  button:has(svg:only-child) {\n    min-width: var(--touch-target-min);\n    min-height: var(--touch-target-min);\n    padding: var(--spacing-sm);\n  }\n\n  /* Form inputs */\n  input[type='text'],\n  input[type='email'],\n  input[type='password'],\n  input[type='number'],\n  input[type='tel'],\n  input[type='url'],\n  input[type='search'],\n  textarea,\n  select {\n    min-height: var(--touch-target-min);\n    font-size: var(--font-size-base); /* Prevents iOS zoom */\n    padding: var(--spacing-sm) var(--spacing-base);\n  }\n}\n/* ============================================\n   MOBILE-FIRST UTILITIES\n   ============================================ */\n/* Safe area utilities */\n.safe-top {\n  padding-top: calc(var(--safe-area-top) + var(--spacing-base));\n}\n.safe-bottom {\n  padding-bottom: calc(var(--safe-area-bottom) + var(--spacing-base));\n}\n.safe-left {\n  padding-left: calc(var(--safe-area-left) + var(--spacing-base));\n}\n.safe-right {\n  padding-right: calc(var(--safe-area-right) + var(--spacing-base));\n}\n.safe-all {\n  padding-top: calc(var(--safe-area-top) + var(--spacing-base));\n  padding-bottom: calc(var(--safe-area-bottom) + var(--spacing-base));\n  padding-left: calc(var(--safe-area-left) + var(--spacing-base));\n  padding-right: calc(var(--safe-area-right) + var(--spacing-base));\n}\n/* Mobile-first spacing */\n@media (max-width: 767px) {\n  .mobile-p-0 {\n    padding: 0;\n  }\n  .mobile-p-1 {\n    padding: var(--spacing-xs);\n  }\n  .mobile-p-2 {\n    padding: var(--spacing-sm);\n  }\n  .mobile-p-3 {\n    padding: var(--spacing-md);\n  }\n  .mobile-p-4 {\n    padding: var(--spacing-base);\n  }\n  .mobile-p-6 {\n    padding: var(--spacing-lg);\n  }\n\n  .mobile-m-0 {\n    margin: 0;\n  }\n  .mobile-m-1 {\n    margin: var(--spacing-xs);\n  }\n  .mobile-m-2 {\n    margin: var(--spacing-sm);\n  }\n  .mobile-m-3 {\n    margin: var(--spacing-md);\n  }\n  .mobile-m-4 {\n    margin: var(--spacing-base);\n  }\n  .mobile-m-6 {\n    margin: var(--spacing-lg);\n  }\n\n  .mobile-gap-1 {\n    gap: var(--spacing-xs);\n  }\n  .mobile-gap-2 {\n    gap: var(--spacing-sm);\n  }\n  .mobile-gap-3 {\n    gap: var(--spacing-md);\n  }\n  .mobile-gap-4 {\n    gap: var(--spacing-base);\n  }\n}\n/* Prevent text selection on mobile (for better UX) */\n@media (max-width: 767px) {\n  button,\n  [role='button'],\n  a {\n    -webkit-user-select: none;\n    -moz-user-select: none;\n         user-select: none;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  /* Allow selection for text content */\n  p,\n  span,\n  div:not([role='button']):not(button) {\n    -webkit-user-select: text;\n    -moz-user-select: text;\n         user-select: text;\n  }\n}\n/* ============================================\n   SCROLL OPTIMIZATIONS MOBILE\n   ============================================ */\n@media (max-width: 767px) {\n  /* Smooth scrolling on mobile */\n  html {\n    -webkit-overflow-scrolling: touch;\n    scroll-behavior: smooth;\n  }\n\n  /* Prevent overscroll bounce on iOS */\n  body {\n    overscroll-behavior-y: contain;\n    overscroll-behavior-x: none;\n  }\n\n  /* Scroll containers */\n  [data-scroll-container] {\n    -webkit-overflow-scrolling: touch;\n    overscroll-behavior: contain;\n  }\n\n  /* Hide scrollbar but keep functionality */\n  .scrollbar-hide {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n\n  .scrollbar-hide::-webkit-scrollbar {\n    display: none;\n  }\n}\n/* ============================================\n   MOBILE-FIRST GRID SYSTEM\n   ============================================ */\n.mobile-grid {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: var(--spacing-base);\n}\n@media (min-width: 768px) {\n  .mobile-grid {\n    grid-template-columns: repeat(2, 1fr);\n    gap: var(--spacing-lg);\n  }\n}\n@media (min-width: 1024px) {\n  .mobile-grid {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n/* ============================================\n   MOBILE-FIRST FLEX UTILITIES\n   ============================================ */\n@media (max-width: 767px) {\n  .mobile-flex-col {\n    flex-direction: column;\n  }\n\n  .mobile-flex-wrap {\n    flex-wrap: wrap;\n  }\n\n  .mobile-justify-center {\n    justify-content: center;\n  }\n\n  .mobile-items-center {\n    align-items: center;\n  }\n\n  .mobile-w-full {\n    width: 100%;\n  }\n\n  .mobile-text-center {\n    text-align: center;\n  }\n}\n/* ============================================\n   PERFORMANCE OPTIMIZATIONS\n   ============================================ */\n/* GPU acceleration for animations */\n@media (max-width: 767px) {\n  .mobile-gpu-accelerate {\n    transform: translateZ(0);\n    will-change: transform;\n    backface-visibility: hidden;\n  }\n\n  /* Reduce animations on mobile for performance (sauf marquees landing) */\n  *:not(.lp-marquee-track):not(.lp-countries-marquee-track):not(.lp-currencies-marquee-track) {\n    animation-duration: 0.2s !important;\n    transition-duration: 0.2s !important;\n  }\n}\n/* Respect reduced motion */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n/**\n * Styles sidebar — thème clair (fond blanc)\n */\n.app-sidebar {\n  --sidebar-background: 0 0% 100%;\n}\n[data-sidebar='sidebar'] {\n  --sidebar-background: 0 0% 100%;\n  --sidebar-foreground: 220 40% 10%;\n  --sidebar-primary: 217 91% 60%;\n  --sidebar-primary-foreground: 0 0% 100%;\n  --sidebar-accent: 0 0% 96%;\n  --sidebar-accent-foreground: 0 0% 12%;\n  --sidebar-border: 0 0% 90%;\n  --sidebar-ring: 217 91% 60%;\n\n  --sidebar-text-color: hsl(220 40% 10%);\n  --sidebar-text-color-muted: hsl(220 10% 46%);\n  --sidebar-text-color-active: hsl(220 40% 10%);\n  --sidebar-bg: #ffffff;\n  --sidebar-bg-gradient: #ffffff;\n\n  background: #ffffff !important;\n  color: var(--sidebar-text-color) !important;\n  border-color: hsl(var(--sidebar-border)) !important;\n}\n[data-sidebar='sidebar'] [data-sidebar='group-label'],\n[data-sidebar='sidebar'] [data-sidebar='menu-button'],\n[data-sidebar='sidebar'] [data-sidebar='menu-button'] span {\n  color: var(--sidebar-text-color);\n}\n[data-sidebar='sidebar'] svg:not([class*='text-orange']):not([class*='text-red']) {\n  color: var(--sidebar-text-color);\n  stroke: currentColor;\n  flex-shrink: 0;\n  width: 1rem;\n  height: 1rem;\n  display: inline-block;\n}\n/* Mobile drawer — keep menu icons visible (avoid collapsed-rail bleed) */\n[data-sidebar='sidebar'][data-mobile='true'] [data-sidebar='menu-button'] svg {\n  display: inline-block !important;\n  visibility: visible !important;\n  opacity: 1 !important;\n  width: 1rem !important;\n  height: 1rem !important;\n  min-width: 1rem;\n  min-height: 1rem;\n  flex-shrink: 0;\n}\n/* Horizontal context mega-nav (Systeme.io style) */\n[data-testid='horizontal-context-nav'] [data-radix-collection-item] {\n  scroll-margin-top: 3rem;\n}\n[data-testid='horizontal-context-nav'] .scrollbar-hide {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n[data-testid='horizontal-context-nav'] .scrollbar-hide::-webkit-scrollbar {\n  display: none;\n}\n[data-sidebar='sidebar'] [data-sidebar='group-label'] {\n  color: var(--sidebar-text-color-muted) !important;\n}\n[data-sidebar='sidebar'] input {\n  color: hsl(var(--foreground)) !important;\n  background: hsl(var(--background)) !important;\n  border-color: hsl(var(--border)) !important;\n}\n[data-sidebar='sidebar'] input::-moz-placeholder {\n  color: hsl(var(--muted-foreground)) !important;\n}\n[data-sidebar='sidebar'] input::placeholder {\n  color: hsl(var(--muted-foreground)) !important;\n}\n[data-sidebar='sidebar'] [data-active='true'],\n[data-sidebar='sidebar'] [data-active='true'] *,\n[data-sidebar='sidebar'] [aria-current='page'],\n[data-sidebar='sidebar'] [aria-current='page'] * {\n  color: var(--sidebar-text-color-active) !important;\n}\n[data-sidebar='sidebar'] [data-sidebar='menu-button'][data-active='true'] {\n  background: hsl(var(--sidebar-accent)) !important;\n  font-weight: 600;\n  border-left: 2px solid hsl(var(--sidebar-primary));\n}\n[data-sidebar='sidebar'] [data-sidebar='menu-button']:hover {\n  background: hsl(var(--sidebar-accent)) !important;\n  color: hsl(var(--sidebar-accent-foreground)) !important;\n}\n[data-sidebar='sidebar'] a:hover,\n[data-sidebar='sidebar'] button:hover {\n  color: hsl(var(--sidebar-foreground)) !important;\n}\n[data-sidebar='sidebar'] img {\n  color: unset !important;\n  stroke: unset !important;\n  fill: unset !important;\n}\n.landing-premium.app-premium [data-sidebar='sidebar'] {\n  background: #ffffff !important;\n}\n.scrollbar-thin {\n  scrollbar-width: thin;\n  scrollbar-color: rgba(0, 0, 0, 0.15) transparent;\n}\n.scrollbar-thin::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n.scrollbar-thin::-webkit-scrollbar-track {\n  background: transparent;\n}\n.scrollbar-thin::-webkit-scrollbar-thumb {\n  background-color: rgba(0, 0, 0, 0.15);\n  border-radius: 3px;\n  -webkit-transition: background-color 0.2s ease;\n  transition: background-color 0.2s ease;\n}\n.scrollbar-thin::-webkit-scrollbar-thumb:hover {\n  background-color: rgba(0, 0, 0, 0.25);\n}\n[data-sidebar='sidebar'] *:focus-visible {\n  outline: 2px solid hsl(var(--sidebar-ring));\n  outline-offset: 2px;\n}\n[data-sidebar='sidebar'] {\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n}\n[data-sidebar='sidebar'] .app-sidebar-scroll {\n  flex: 1 1 auto;\n  min-height: 0;\n  overflow-x: hidden;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  scrollbar-gutter: stable;\n  -webkit-mask-image: linear-gradient(\n    to bottom,\n    transparent 0,\n    #000 10px,\n    #000 calc(100% - 12px),\n    transparent 100%\n  );\n          mask-image: linear-gradient(\n    to bottom,\n    transparent 0,\n    #000 10px,\n    #000 calc(100% - 12px),\n    transparent 100%\n  );\n}\n[data-sidebar='sidebar'] .app-sidebar-footer {\n  flex-shrink: 0;\n  margin-top: auto;\n  z-index: 2;\n}\n[data-sidebar='sidebar'] .app-sidebar-footer .lp-lang-switcher {\n  width: 100%;\n  justify-content: center;\n  border-radius: 0.5rem;\n}\n[data-sidebar='sidebar'] .app-sidebar-section-header {\n  border-left: 2px solid transparent;\n}\n[data-sidebar='sidebar'] .app-sidebar-section-header:hover,\n[data-sidebar='sidebar'] .app-sidebar-section-header[aria-expanded='true'] {\n  border-left-color: hsl(var(--sidebar-primary));\n  background: hsl(var(--sidebar-accent));\n}\n[data-sidebar='sidebar'] .app-sidebar-section-header[aria-expanded='true'] span {\n  color: hsl(var(--sidebar-foreground));\n}\n[data-sidebar='sidebar'] .app-sidebar-command-trigger:focus-visible {\n  outline: 2px solid hsl(var(--sidebar-ring));\n  outline-offset: 2px;\n}\n[data-sidebar='sidebar'] .app-sidebar-rail-separator {\n  flex-shrink: 0;\n}\n[data-sidebar='sidebar'] .app-sidebar-pinned-rail button:hover {\n  color: hsl(var(--sidebar-foreground));\n}\n:root {\n  --emarzona-brand-emar: #f97316;\n  --emarzona-brand-zona: #2563eb;\n}\n.emarzona-brand-name {\n  font-weight: inherit;\n  letter-spacing: inherit;\n  white-space: nowrap;\n}\n.emarzona-brand-emar {\n  color: var(--emarzona-brand-emar);\n  font-weight: inherit;\n}\n.emarzona-brand-zona {\n  color: var(--emarzona-brand-zona);\n  font-weight: inherit;\n}\n/* Pied de page landing : titres en gras, sous-éléments grisés */\n.landing-premium footer .lp-footer-col-title {\n  font-weight: 700;\n  color: #fff;\n}\n.landing-premium footer .lp-footer-tagline,\n.landing-premium footer .lp-footer-body,\n.landing-premium footer .lp-footer-bar {\n  font-weight: 400;\n  color: var(--lp-text-dim);\n}\n.landing-premium footer .lp-footer-sublink {\n  font-weight: 400;\n  color: var(--lp-text-dim);\n  transition: color 0.2s ease;\n}\n.landing-premium footer .lp-footer-sublink:hover {\n  color: rgba(255, 255, 255, 0.78);\n}\n.landing-premium footer .lp-footer-legal .lp-footer-sublink,\n.landing-premium footer .lp-footer-legal button.lp-footer-sublink {\n  font-weight: 400;\n}\n/**\n * Font optimization: font-display: swap\n * Améliore le FCP (First Contentful Paint)\n * Évite le FOIT (Flash of Invisible Text)\n * \n * Animations personnalisées importées depuis ./styles/animations.css\n */\n*, ::before, ::after {\n  --tw-border-spacing-x: 0;\n  --tw-border-spacing-y: 0;\n  --tw-translate-x: 0;\n  --tw-translate-y: 0;\n  --tw-rotate: 0;\n  --tw-skew-x: 0;\n  --tw-skew-y: 0;\n  --tw-scale-x: 1;\n  --tw-scale-y: 1;\n  --tw-pan-x:  ;\n  --tw-pan-y:  ;\n  --tw-pinch-zoom:  ;\n  --tw-scroll-snap-strictness: proximity;\n  --tw-gradient-from-position:  ;\n  --tw-gradient-via-position:  ;\n  --tw-gradient-to-position:  ;\n  --tw-ordinal:  ;\n  --tw-slashed-zero:  ;\n  --tw-numeric-figure:  ;\n  --tw-numeric-spacing:  ;\n  --tw-numeric-fraction:  ;\n  --tw-ring-inset:  ;\n  --tw-ring-offset-width: 0px;\n  --tw-ring-offset-color: #fff;\n  --tw-ring-color: rgb(59 130 246 / 0.5);\n  --tw-ring-offset-shadow: 0 0 #0000;\n  --tw-ring-shadow: 0 0 #0000;\n  --tw-shadow: 0 0 #0000;\n  --tw-shadow-colored: 0 0 #0000;\n  --tw-blur:  ;\n  --tw-brightness:  ;\n  --tw-contrast:  ;\n  --tw-grayscale:  ;\n  --tw-hue-rotate:  ;\n  --tw-invert:  ;\n  --tw-saturate:  ;\n  --tw-sepia:  ;\n  --tw-drop-shadow:  ;\n  --tw-backdrop-blur:  ;\n  --tw-backdrop-brightness:  ;\n  --tw-backdrop-contrast:  ;\n  --tw-backdrop-grayscale:  ;\n  --tw-backdrop-hue-rotate:  ;\n  --tw-backdrop-invert:  ;\n  --tw-backdrop-opacity:  ;\n  --tw-backdrop-saturate:  ;\n  --tw-backdrop-sepia:  ;\n  --tw-contain-size:  ;\n  --tw-contain-layout:  ;\n  --tw-contain-paint:  ;\n  --tw-contain-style:  ;\n}\n::backdrop {\n  --tw-border-spacing-x: 0;\n  --tw-border-spacing-y: 0;\n  --tw-translate-x: 0;\n  --tw-translate-y: 0;\n  --tw-rotate: 0;\n  --tw-skew-x: 0;\n  --tw-skew-y: 0;\n  --tw-scale-x: 1;\n  --tw-scale-y: 1;\n  --tw-pan-x:  ;\n  --tw-pan-y:  ;\n  --tw-pinch-zoom:  ;\n  --tw-scroll-snap-strictness: proximity;\n  --tw-gradient-from-position:  ;\n  --tw-gradient-via-position:  ;\n  --tw-gradient-to-position:  ;\n  --tw-ordinal:  ;\n  --tw-slashed-zero:  ;\n  --tw-numeric-figure:  ;\n  --tw-numeric-spacing:  ;\n  --tw-numeric-fraction:  ;\n  --tw-ring-inset:  ;\n  --tw-ring-offset-width: 0px;\n  --tw-ring-offset-color: #fff;\n  --tw-ring-color: rgb(59 130 246 / 0.5);\n  --tw-ring-offset-shadow: 0 0 #0000;\n  --tw-ring-shadow: 0 0 #0000;\n  --tw-shadow: 0 0 #0000;\n  --tw-shadow-colored: 0 0 #0000;\n  --tw-blur:  ;\n  --tw-brightness:  ;\n  --tw-contrast:  ;\n  --tw-grayscale:  ;\n  --tw-hue-rotate:  ;\n  --tw-invert:  ;\n  --tw-saturate:  ;\n  --tw-sepia:  ;\n  --tw-drop-shadow:  ;\n  --tw-backdrop-blur:  ;\n  --tw-backdrop-brightness:  ;\n  --tw-backdrop-contrast:  ;\n  --tw-backdrop-grayscale:  ;\n  --tw-backdrop-hue-rotate:  ;\n  --tw-backdrop-invert:  ;\n  --tw-backdrop-opacity:  ;\n  --tw-backdrop-saturate:  ;\n  --tw-backdrop-sepia:  ;\n  --tw-contain-size:  ;\n  --tw-contain-layout:  ;\n  --tw-contain-paint:  ;\n  --tw-contain-style:  ;\n}\n/* ! tailwindcss v3.4.19 | MIT License | https://tailwindcss.com */\n/*\n1. Prevent padding and border from affecting element width. (https://github.com/mozdevs/cssremedy/issues/4)\n2. Allow adding a border to an element by just adding a border-width. (https://github.com/tailwindcss/tailwindcss/pull/116)\n*/\n*,\n::before,\n::after {\n  box-sizing: border-box; /* 1 */\n  border-width: 0; /* 2 */\n  border-style: solid; /* 2 */\n  border-color: #e5e7eb; /* 2 */\n}\n::before,\n::after {\n  --tw-content: '';\n}\n/*\n1. Use a consistent sensible line-height in all browsers.\n2. Prevent adjustments of font size after orientation changes in iOS.\n3. Use a more readable tab size.\n4. Use the user's configured `sans` font-family by default.\n5. Use the user's configured `sans` font-feature-settings by default.\n6. Use the user's configured `sans` font-variation-settings by default.\n7. Disable tap highlights on iOS\n*/\nhtml,\n:host {\n  line-height: 1.5; /* 1 */\n  -webkit-text-size-adjust: 100%; /* 2 */\n  -moz-tab-size: 4; /* 3 */\n  -o-tab-size: 4;\n     tab-size: 4; /* 3 */\n  font-family: Inter, system-ui, -apple-system, sans-serif; /* 4 */\n  font-feature-settings: normal; /* 5 */\n  font-variation-settings: normal; /* 6 */\n  -webkit-tap-highlight-color: transparent; /* 7 */\n}\n/*\n1. Remove the margin in all browsers.\n2. Inherit line-height from `html` so users can set them as a class directly on the `html` element.\n*/\nbody {\n  margin: 0; /* 1 */\n  line-height: inherit; /* 2 */\n}\n/*\n1. Add the correct height in Firefox.\n2. Correct the inheritance of border color in Firefox. (https://bugzilla.mozilla.org/show_bug.cgi?id=190655)\n3. Ensure horizontal rules are visible by default.\n*/\nhr {\n  height: 0; /* 1 */\n  color: inherit; /* 2 */\n  border-top-width: 1px; /* 3 */\n}\n/*\nAdd the correct text decoration in Chrome, Edge, and Safari.\n*/\nabbr:where([title]) {\n  -webkit-text-decoration: underline dotted;\n          text-decoration: underline dotted;\n}\n/*\nRemove the default font size and weight for headings.\n*/\nh1,\nh2,\nh3,\nh4,\nh5,\nh6 {\n  font-size: inherit;\n  font-weight: inherit;\n}\n/*\nReset links to optimize for opt-in styling instead of opt-out.\n*/\na {\n  color: inherit;\n  text-decoration: inherit;\n}\n/*\nAdd the correct font weight in Edge and Safari.\n*/\nb,\nstrong {\n  font-weight: bolder;\n}\n/*\n1. Use the user's configured `mono` font-family by default.\n2. Use the user's configured `mono` font-feature-settings by default.\n3. Use the user's configured `mono` font-variation-settings by default.\n4. Correct the odd `em` font sizing in all browsers.\n*/\ncode,\nkbd,\nsamp,\npre {\n  font-family: JetBrains Mono, Fira Code, Consolas, monospace; /* 1 */\n  font-feature-settings: normal; /* 2 */\n  font-variation-settings: normal; /* 3 */\n  font-size: 1em; /* 4 */\n}\n/*\nAdd the correct font size in all browsers.\n*/\nsmall {\n  font-size: 80%;\n}\n/*\nPrevent `sub` and `sup` elements from affecting the line height in all browsers.\n*/\nsub,\nsup {\n  font-size: 75%;\n  line-height: 0;\n  position: relative;\n  vertical-align: baseline;\n}\nsub {\n  bottom: -0.25em;\n}\nsup {\n  top: -0.5em;\n}\n/*\n1. Remove text indentation from table contents in Chrome and Safari. (https://bugs.chromium.org/p/chromium/issues/detail?id=999088, https://bugs.webkit.org/show_bug.cgi?id=201297)\n2. Correct table border color inheritance in all Chrome and Safari. (https://bugs.chromium.org/p/chromium/issues/detail?id=935729, https://bugs.webkit.org/show_bug.cgi?id=195016)\n3. Remove gaps between table borders by default.\n*/\ntable {\n  text-indent: 0; /* 1 */\n  border-color: inherit; /* 2 */\n  border-collapse: collapse; /* 3 */\n}\n/*\n1. Change the font styles in all browsers.\n2. Remove the margin in Firefox and Safari.\n3. Remove default padding in all browsers.\n*/\nbutton,\ninput,\noptgroup,\nselect,\ntextarea {\n  font-family: inherit; /* 1 */\n  font-feature-settings: inherit; /* 1 */\n  font-variation-settings: inherit; /* 1 */\n  font-size: 100%; /* 1 */\n  font-weight: inherit; /* 1 */\n  line-height: inherit; /* 1 */\n  letter-spacing: inherit; /* 1 */\n  color: inherit; /* 1 */\n  margin: 0; /* 2 */\n  padding: 0; /* 3 */\n}\n/*\nRemove the inheritance of text transform in Edge and Firefox.\n*/\nbutton,\nselect {\n  text-transform: none;\n}\n/*\n1. Correct the inability to style clickable types in iOS and Safari.\n2. Remove default button styles.\n*/\nbutton,\ninput:where([type='button']),\ninput:where([type='reset']),\ninput:where([type='submit']) {\n  -webkit-appearance: button; /* 1 */\n  background-color: transparent; /* 2 */\n  background-image: none; /* 2 */\n}\n/*\nUse the modern Firefox focus style for all focusable elements.\n*/\n:-moz-focusring {\n  outline: auto;\n}\n/*\nRemove the additional `:invalid` styles in Firefox. (https://github.com/mozilla/gecko-dev/blob/2f9eacd9d3d995c937b4251a5557d95d494c9be1/layout/style/res/forms.css#L728-L737)\n*/\n:-moz-ui-invalid {\n  box-shadow: none;\n}\n/*\nAdd the correct vertical alignment in Chrome and Firefox.\n*/\nprogress {\n  vertical-align: baseline;\n}\n/*\nCorrect the cursor style of increment and decrement buttons in Safari.\n*/\n::-webkit-inner-spin-button,\n::-webkit-outer-spin-button {\n  height: auto;\n}\n/*\n1. Correct the odd appearance in Chrome and Safari.\n2. Correct the outline style in Safari.\n*/\n[type='search'] {\n  -webkit-appearance: textfield; /* 1 */\n  outline-offset: -2px; /* 2 */\n}\n/*\nRemove the inner padding in Chrome and Safari on macOS.\n*/\n::-webkit-search-decoration {\n  -webkit-appearance: none;\n}\n/*\n1. Correct the inability to style clickable types in iOS and Safari.\n2. Change font properties to `inherit` in Safari.\n*/\n::-webkit-file-upload-button {\n  -webkit-appearance: button; /* 1 */\n  font: inherit; /* 2 */\n}\n/*\nAdd the correct display in Chrome and Safari.\n*/\nsummary {\n  display: list-item;\n}\n/*\nRemoves the default spacing and border for appropriate elements.\n*/\nblockquote,\ndl,\ndd,\nh1,\nh2,\nh3,\nh4,\nh5,\nh6,\nhr,\nfigure,\np,\npre {\n  margin: 0;\n}\nfieldset {\n  margin: 0;\n  padding: 0;\n}\nlegend {\n  padding: 0;\n}\nol,\nul,\nmenu {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n/*\nReset default styling for dialogs.\n*/\ndialog {\n  padding: 0;\n}\n/*\nPrevent resizing textareas horizontally by default.\n*/\ntextarea {\n  resize: vertical;\n}\n/*\n1. Reset the default placeholder opacity in Firefox. (https://github.com/tailwindlabs/tailwindcss/issues/3300)\n2. Set the default placeholder color to the user's configured gray 400 color.\n*/\ninput::-moz-placeholder, textarea::-moz-placeholder {\n  opacity: 1; /* 1 */\n  color: #9ca3af; /* 2 */\n}\ninput::placeholder,\ntextarea::placeholder {\n  opacity: 1; /* 1 */\n  color: #9ca3af; /* 2 */\n}\n/*\nSet the default cursor for buttons.\n*/\nbutton,\n[role=\"button\"] {\n  cursor: pointer;\n}\n/*\nMake sure disabled buttons don't get the pointer cursor.\n*/\n:disabled {\n  cursor: default;\n}\n/*\n1. Make replaced elements `display: block` by default. (https://github.com/mozdevs/cssremedy/issues/14)\n2. Add `vertical-align: middle` to align replaced elements more sensibly by default. (https://github.com/jensimmons/cssremedy/issues/14#issuecomment-634934210)\n   This can trigger a poorly considered lint error in some tools but is included by design.\n*/\nimg,\nsvg,\nvideo,\ncanvas,\naudio,\niframe,\nembed,\nobject {\n  display: block; /* 1 */\n  vertical-align: middle; /* 2 */\n}\n/*\nConstrain images and videos to the parent width and preserve their intrinsic aspect ratio. (https://github.com/mozdevs/cssremedy/issues/14)\n*/\nimg,\nvideo {\n  max-width: 100%;\n  height: auto;\n}\n/* Make elements with the HTML hidden attribute stay hidden by default */\n[hidden]:where(:not([hidden=\"until-found\"])) {\n  display: none;\n}\n:root {\n    /* Thème clair par défaut (Professionnel) */\n    --background: 0 0% 100%;\n    --foreground: 220 40% 10%; /* Plus foncé pour meilleur contraste sur fond blanc (WCAG AA) */\n\n    --card: 0 0% 100%;\n    --card-foreground: 220 40% 10%; /* Plus foncé pour meilleur contraste */\n\n    --popover: 0 0% 100%;\n    --popover-foreground: 220 40% 10%; /* Plus foncé pour meilleur contraste */\n\n    --primary: 24.6 95% 53.1%; /* Orange Premium #f97316 — conversion optimisée */\n    --primary-foreground: 0 0% 100%;\n\n    --secondary: 0 0% 96%; /* Gris très clair moderne */\n    --secondary-foreground: 0 0% 12%; /* Noir doux */\n\n    --muted: 0 0% 98%; /* Gris ultra clair */\n    --muted-foreground: 0 0% 35%; /* Gris foncé pour meilleur contraste sur fond blanc (WCAG AA) */\n\n    --accent: 38 92% 50%; /* Orange/Jaune moderne pour contraste avec primary */\n    --accent-foreground: 0 0% 100%;\n\n    --destructive: 0 84.2% 60.2%;\n    --destructive-foreground: 0 0% 100%;\n\n    --border: 0 0% 90%; /* Gris clair moderne */\n    --input: 0 0% 90%; /* Gris clair moderne */\n    --ring: 24.6 95% 53.1%; /* Orange moderne */\n\n    --radius: 0.5rem; /* 8px - Border radius moderne et cohérent */\n\n    --gradient-primary: linear-gradient(135deg, hsl(24.6, 95%, 60%) 0%, hsl(24.6, 95%, 50%) 100%);\n    --gradient-accent: linear-gradient(135deg, hsl(38, 92%, 50%) 0%, hsl(38, 92%, 45%) 100%);\n    --gradient-hero: linear-gradient(135deg, hsl(220, 50%, 12%) 0%, hsl(220, 45%, 18%) 100%);\n    --gradient-dark: linear-gradient(180deg, hsl(220, 30%, 12%) 0%, hsl(220, 35%, 18%) 100%);\n\n    --shadow-soft: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);\n    --shadow-medium: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\n    --shadow-large: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\n    --shadow-glow: 0 0 20px rgba(59, 130, 246, 0.3);\n    --shadow-glass: 0 8px 32px 0 rgba(0, 0, 0, 0.08);\n    --shadow-float: 0 12px 36px -4px rgba(0, 0, 0, 0.12), 0 4px 12px -2px rgba(0, 0, 0, 0.08);\n\n    --transition-smooth: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n\n    /* Sidebar claire par défaut */\n    --sidebar-background: 0 0% 100%;\n    --sidebar-foreground: 220 40% 10%; /* Plus foncé pour meilleur contraste sur fond blanc */\n    --sidebar-primary: 217 91% 60%; /* Bleu moderne */\n    --sidebar-primary-foreground: 0 0% 100%;\n    --sidebar-accent: 0 0% 96%; /* Gris très clair */\n    --sidebar-accent-foreground: 0 0% 12%; /* Noir doux */\n    --sidebar-border: 0 0% 90%; /* Gris clair */\n    --sidebar-ring: 217 91% 60%; /* Bleu moderne */\n  }\n.dark {\n    --background: 220 35% 8%;\n    --foreground: 0 0% 98%;\n\n    --card: 220 30% 12%;\n    --card-foreground: 0 0% 98%;\n\n    --popover: 220 30% 12%;\n    --popover-foreground: 0 0% 98%;\n\n    --primary: 24.6 95% 58%; /* Orange moderne plus clair pour dark mode */\n    --primary-foreground: 0 0% 100%;\n\n    --secondary: 0 0% 18%; /* Gris foncé moderne */\n    --secondary-foreground: 0 0% 98%;\n\n    --muted: 0 0% 16%; /* Gris très foncé */\n    --muted-foreground: 0 0% 65%; /* Gris moyen */\n\n    --accent: 38 92% 55%; /* Orange/Jaune moderne pour contraste avec primary */\n    --accent-foreground: 0 0% 100%;\n\n    --destructive: 0 72% 51%;\n    --destructive-foreground: 0 0% 100%;\n\n    --border: 0 0% 20%; /* Gris foncé */\n    --input: 0 0% 20%; /* Gris foncé */\n    --ring: 24.6 95% 58%; /* Orange moderne */\n\n    --gradient-primary: linear-gradient(135deg, hsl(24.6, 95%, 65%) 0%, hsl(24.6, 95%, 55%) 100%);\n    --gradient-accent: linear-gradient(135deg, hsl(38, 92%, 55%) 0%, hsl(38, 92%, 50%) 100%);\n    --gradient-hero: linear-gradient(135deg, hsl(220, 50%, 12%) 0%, hsl(220, 45%, 18%) 100%);\n    --gradient-dark: linear-gradient(180deg, hsl(220, 35%, 8%) 0%, hsl(220, 40%, 14%) 100%);\n\n    --shadow-soft: 0 1px 3px 0 rgba(0, 0, 0, 0.3), 0 1px 2px 0 rgba(0, 0, 0, 0.2);\n    --shadow-medium: 0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -1px rgba(0, 0, 0, 0.3);\n    --shadow-large: 0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -2px rgba(0, 0, 0, 0.4);\n    --shadow-glow: 0 0 30px rgba(59, 130, 246, 0.4);\n    --shadow-glass: 0 8px 32px 0 rgba(0, 0, 0, 0.4);\n    --shadow-float: 0 12px 36px -4px rgba(0, 0, 0, 0.5), 0 4px 12px -2px rgba(0, 0, 0, 0.4);\n\n    /* Sidebar toujours en thème clair même en mode sombre */\n    --sidebar-background: 0 0% 100%;\n    --sidebar-foreground: 0 0% 0%;\n    --sidebar-primary: 25 95% 53%;\n    --sidebar-primary-foreground: 0 0% 100%;\n    --sidebar-accent: 33 100% 96.5%;\n    --sidebar-accent-foreground: 0 0% 0%;\n    --sidebar-border: 20 5.9% 90%;\n    --sidebar-ring: 25 95% 53%;\n  }\n* {\n  border-color: hsl(var(--border));\n}\n/* Times New Roman pour les titres */\nh1,\n  h2,\n  h3,\n  h4,\n  h5,\n  h6 {\n    font-family: 'Times New Roman', Times, serif;\n  }\n/* OPTIMISATION: CSS du sidebar déplacé dans sidebar-optimized.css\n     pour permettre le chargement asynchrone et réduire le CSS critique */\n/* Les styles du sidebar sont maintenant dans ./styles/sidebar-optimized.css */\nhtml {\n    scroll-behavior: smooth;\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n  }\nbody {\n  background-color: hsl(var(--background));\n  font-family: Inter, system-ui, -apple-system, sans-serif;\n  color: hsl(var(--foreground));\n    font-family:\n      'Inter',\n      system-ui,\n      -apple-system,\n      sans-serif;\n    font-size: 1rem; /* 16px - Taille professionnelle */\n    line-height: 1.625; /* Amélioré pour meilleure lisibilité */\n    letter-spacing: 0;\n    overscroll-behavior: none;\n    -webkit-tap-highlight-color: transparent;\n    touch-action: manipulation;\n    overflow-x: hidden;\n    max-width: 100vw;\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n}\n/* Hiérarchie typographique moderne */\nh1 {\n    font-size: 2.5rem; /* 40px */\n    line-height: 1.2;\n    font-weight: 700;\n    letter-spacing: -0.02em;\n  }\nh2 {\n    font-size: 2rem; /* 32px */\n    line-height: 1.25;\n    font-weight: 600;\n    letter-spacing: -0.01em;\n  }\nh3 {\n    font-size: 1.5rem; /* 24px */\n    line-height: 1.3;\n    font-weight: 600;\n    letter-spacing: 0;\n  }\nh4 {\n    font-size: 1.25rem; /* 20px */\n    line-height: 1.4;\n    font-weight: 600;\n    letter-spacing: 0;\n  }\nh5 {\n    font-size: 1.125rem; /* 18px */\n    line-height: 1.4;\n    font-weight: 600;\n    letter-spacing: 0;\n  }\nh6 {\n    font-size: 1rem; /* 16px */\n    line-height: 1.4;\n    font-weight: 600;\n    letter-spacing: 0.01em;\n  }\n/* Responsive typography */\n@media (max-width: 768px) {\n    h1 {\n      font-size: 2rem; /* 32px */\n    }\n    h2 {\n      font-size: 1.75rem; /* 28px */\n    }\n    h3 {\n      font-size: 1.5rem; /* 24px */\n    }\n  }\n/* Optimisations pour très petits écrans (< 360px) */\n@media (max-width: 360px) {\n    h1 {\n      font-size: 1.75rem; /* 28px */\n      line-height: 1.2;\n    }\n    h2 {\n      font-size: 1.5rem; /* 24px */\n      line-height: 1.25;\n    }\n    h3 {\n      font-size: 1.25rem; /* 20px */\n      line-height: 1.3;\n    }\n\n    /* Padding réduit pour très petits écrans */\n    .container {\n      padding-left: 0.5rem;\n      padding-right: 0.5rem;\n    }\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n    body {\n      font-size: 0.875rem; /* 14px - Minimum recommandé WCAG */\n      line-height: 1.5;\n    }\n\n    /* Boutons compacts mais touch-friendly */\n    button {\n      padding: 0.5rem 0.75rem;\n      font-size: 0.875rem;\n      min-height: 40px; /* Légèrement réduit mais toujours touch-friendly */\n      min-width: 40px;\n    }\n\n    /* Cards plus compactes */\n    [class*='card'],\n    [class*='Card'] {\n      padding: 0.75rem;\n    }\n\n    /* Espacement réduit */\n    .space-y-3 > * + * {\n      margin-top: 0.5rem;\n    }\n\n    .space-y-4 > * + * {\n      margin-top: 0.75rem;\n    }\n\n    .gap-3 {\n      gap: 0.5rem;\n    }\n\n    .gap-4 {\n      gap: 0.75rem;\n    }\n\n    /* Grilles adaptées */\n    .grid {\n      gap: 0.5rem;\n    }\n\n    /* Padding réduit pour très petits écrans */\n    .\\!container {\n      padding-left: 0.5rem !important;\n      padding-right: 0.5rem !important;\n    }\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n\n    /* Grilles adaptées */\n  }\n#root {\n    min-height: 100vh;\n    overflow-x: hidden;\n    max-width: 100vw;\n  }\n* {\n    box-sizing: border-box;\n  }\n/*\n   * ⚠️ PERF: éviter les transitions globales sur `*`\n   * Cela augmente le coût des recalculs de style (surtout sur mobile) et peut dégrader le scroll.\n   * On applique des transitions uniquement aux éléments interactifs et composants UI.\n   */\nbutton,\n  a,\n  input,\n  textarea,\n  select,\n  [role='button'] {\n    transition:\n      background-color 0.2s ease,\n      color 0.2s ease,\n      border-color 0.2s ease,\n      box-shadow 0.2s ease,\n      opacity 0.2s ease,\n      transform 0.2s ease;\n  }\nimg,\n  video {\n    max-width: 100%;\n    height: auto;\n    display: block;\n  }\n.animate-fade-in,\n  .animate-fade-in-up,\n  .hover-scale {\n    will-change: transform, opacity;\n    transform: translateZ(0);\n    backface-visibility: hidden;\n  }\n/* Optimisations mobile et interactions tactiles */\n/* Réduction des animations pour l'accessibilité */\n@media (prefers-reduced-motion: reduce) {\n    *,\n    *::before,\n    *::after {\n      animation-duration: 0.01ms !important;\n      animation-iteration-count: 1 !important;\n      transition-duration: 0.01ms !important;\n      scroll-behavior: auto !important;\n    }\n\n    /* Désactiver les animations spécifiques */\n    .animate-fade-in-up,\n    .animate-float,\n    .animate-pulse {\n      animation: none !important;\n    }\n\n    /* Désactiver les transformations au hover */\n    *:hover {\n      transform: none !important;\n    }\n  }\n/* OPTIMISATION PERFORMANCE: Réduire les animations sur mobile pour économiser la batterie */\n@media (max-width: 768px) {\n    /* Réduire la durée des animations (sauf marquees landing) */\n    *:not(.lp-marquee-track):not(.lp-countries-marquee-track):not(.lp-currencies-marquee-track),\n    *:not(.lp-marquee-track):not(.lp-countries-marquee-track):not(\n        .lp-currencies-marquee-track\n      )::before,\n    *:not(.lp-marquee-track):not(.lp-countries-marquee-track):not(\n        .lp-currencies-marquee-track\n      )::after {\n      animation-duration: 0.2s !important;\n      transition-duration: 0.15s !important;\n    }\n\n    /* Désactiver les animations non-essentielles */\n    .animate-float,\n    .animate-pulse:not([aria-busy='true']) {\n      animation: none !important;\n    }\n\n    /* Désactiver les transformations au hover (peu utiles sur mobile) */\n    .hover-smooth-lift:hover,\n    .hover-smooth-scale:hover,\n    .product-card-zoom:hover {\n      transform: none !important;\n    }\n\n    /* Réduire les effets de glow et shadow sur mobile */\n    .shadow-glow {\n      box-shadow: var(--shadow-soft) !important;\n    }\n  }\n/* Optimisations pour très petits écrans */\n@media (max-width: 475px) {\n    .\\!container {\n      padding-left: 0.75rem !important;\n      padding-right: 0.75rem !important;\n    }\n    .container {\n      padding-left: 0.75rem;\n      padding-right: 0.75rem;\n    }\n\n    .text-responsive-xs {\n      font-size: 0.75rem;\n      line-height: 1rem;\n    }\n\n    .p-responsive-xs {\n      padding: 0.5rem;\n    }\n\n    .gap-responsive-xs {\n      gap: 0.5rem;\n    }\n  }\n/* Optimisations supplémentaires pour très petits écrans (< 360px) */\n@media (max-width: 360px) {\n    .container {\n      padding-left: 0.5rem;\n      padding-right: 0.5rem;\n    }\n\n    /* Textes adaptés - Minimum 14px pour accessibilité WCAG */\n    .text-responsive-xs {\n      font-size: 0.875rem; /* 14px minimum pour accessibilité */\n      line-height: 1.25rem;\n    }\n\n    /* Padding minimal */\n    .p-responsive-xs {\n      padding: 0.375rem;\n    }\n\n    /* Gap minimal */\n    .gap-responsive-xs {\n      gap: 0.375rem;\n    }\n\n    /* Cards plus compactes */\n    .card {\n      padding: 0.75rem;\n    }\n\n    /* Boutons compacts mais touch-friendly */\n    button {\n      min-height: 40px; /* Légèrement réduit mais toujours touch-friendly */\n      padding: 0.5rem 0.75rem;\n      font-size: 0.875rem;\n    }\n    .\\!container {\n      padding-left: 0.5rem !important;\n      padding-right: 0.5rem !important;\n    }\n\n    /* Textes adaptés - Minimum 14px pour accessibilité WCAG */\n\n    /* Padding minimal */\n\n    /* Gap minimal */\n\n    /* Cards plus compactes */\n\n    /* Boutons compacts mais touch-friendly */\n  }\n/* ===================================== */\n/* ACCESSIBILITÉ WCAG AA LEVEL */\n/* ===================================== */\n/* 1. Focus visible amélioré - Respecte WCAG 2.4.7 */\n*:focus-visible {\n    outline: 3px solid hsl(var(--ring));\n    outline-offset: 2px;\n    transition: outline-offset 0.2s ease;\n  }\n/* Focus étendu pour les interactions tactiles */\n@media (hover: none) {\n    *:focus-visible {\n      outline-width: 4px;\n      outline-offset: 3px;\n    }\n  }\n/* Skip links - Respecte WCAG 2.4.1 */\n.sr-only {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n    border-width: 0;\n  }\n.sr-only:focus,\n  .focus\\:not-sr-only:focus {\n    position: static;\n    width: auto;\n    height: auto;\n    padding: inherit;\n    margin: inherit;\n    overflow: visible;\n    clip: auto;\n    white-space: normal;\n  }\n/* 2. Contraste amélioré pour les liens - Respecte WCAG 1.4.3 */\na {\n    color: hsl(var(--primary));\n    -webkit-text-decoration-skip: ink;\n            text-decoration-skip-ink: auto;\n  }\na:hover {\n    text-decoration: underline;\n  }\na:focus {\n    outline: 3px solid hsl(var(--ring));\n    outline-offset: 2px;\n  }\n/* 3. Boutons accessibles - Respecte WCAG 2.1.1 */\nbutton:disabled,\n  [aria-disabled='true'] {\n    cursor: not-allowed;\n    opacity: 0.6;\n  }\nbutton:focus-visible,\n  [role='button']:focus-visible,\n  a:focus-visible,\n  input:focus-visible,\n  select:focus-visible,\n  textarea:focus-visible {\n    outline: 3px solid hsl(var(--ring));\n    outline-offset: 3px;\n    outline-style: solid;\n    border-radius: 0.25rem;\n  }\n/* Focus visible amélioré pour navigation clavier - WCAG 2.4.7 */\n*:focus-visible {\n    outline: 3px solid hsl(var(--ring));\n    outline-offset: 3px;\n    outline-style: solid;\n  }\n/* Exception pour les éléments avec focus interne (inputs, etc.) */\ninput:focus-visible,\n  textarea:focus-visible,\n  select:focus-visible {\n    outline: 2px solid hsl(var(--ring));\n    outline-offset: 2px;\n  }\n/* 4. Messages d'erreur et status - Respecte WCAG 3.3.1 & 3.3.2 */\n[role='alert'],\n  [aria-live='assertive'],\n  [aria-live='polite'] {\n    position: relative;\n  }\n/* 5. Cibles tactiles minimum 44x44px - Respecte WCAG 2.5.5 */\nbutton,\n  a,\n  input[type='checkbox'],\n  input[type='radio'],\n  select {\n    min-height: 44px;\n    min-width: 44px;\n    touch-action: manipulation;\n  }\n/* Exception pour les icônes dans les boutons */\nbutton > svg,\n  a > svg {\n    pointer-events: none;\n  }\n/* 6. Texte sélectionnable avec contraste - Respecte WCAG 1.4.3 */\n::-moz-selection {\n    background-color: hsl(var(--primary) / 0.3);\n    color: hsl(var(--foreground));\n  }\n::selection {\n    background-color: hsl(var(--primary) / 0.3);\n    color: hsl(var(--foreground));\n  }\n/* 7. Mode sombre avec contraste respecté */\n.dark {\n    /* Garantir un contraste minimum de 4.5:1 */\n    --text-high-contrast: 0 0% 100%;\n    --text-medium-contrast: 0 0% 85%;\n    --text-low-contrast: 0 0% 70%;\n  }\n/* 8. États hover et active clairs - Respecte WCAG 1.4.1 */\nbutton:hover:not(:disabled),\n  [role='button']:hover:not([aria-disabled='true']) {\n    filter: brightness(1.1);\n  }\nbutton:active:not(:disabled),\n  [role='button']:active:not([aria-disabled='true']) {\n    filter: brightness(0.9);\n  }\n/* 9. Navigation au clavier visible */\n[tabindex]:focus-visible,\n  [role='tab']:focus-visible,\n  [role='menuitem']:focus-visible,\n  [role='option']:focus-visible {\n    outline: 3px solid hsl(var(--ring));\n    outline-offset: 2px;\n    z-index: 10;\n  }\n/* 10. Indicateurs de chargement accessibles */\n@keyframes spin-accessible {\n    from {\n      transform: rotate(0deg);\n    }\n    to {\n      transform: rotate(360deg);\n    }\n  }\n[aria-busy='true']::before {\n    content: '';\n    display: inline-block;\n    width: 1em;\n    height: 1em;\n    margin-right: 0.5em;\n    border: 2px solid hsl(var(--primary));\n    border-top-color: transparent;\n    border-radius: 50%;\n    animation: spin-accessible 0.8s linear infinite;\n  }\n/* 11. Amélioration du contraste pour les placeholders */\n::-moz-placeholder {\n    color: hsl(var(--muted-foreground));\n    opacity: 0.7;\n  }\n::placeholder {\n    color: hsl(var(--muted-foreground));\n    opacity: 0.7;\n  }\ninput:focus::-moz-placeholder, textarea:focus::-moz-placeholder {\n    opacity: 0.5;\n  }\ninput:focus::placeholder,\n  textarea:focus::placeholder {\n    opacity: 0.5;\n  }\n/* 12. Focus pour les éléments de formulaire */\ninput:focus,\n  textarea:focus,\n  select:focus {\n    outline: 3px solid hsl(var(--ring));\n    outline-offset: 2px;\n    border-color: hsl(var(--ring));\n  }\n/* 13. Tooltips accessibles */\n[role='tooltip'] {\n    background-color: hsl(var(--popover));\n    color: hsl(var(--popover-foreground));\n    border: 1px solid hsl(var(--border));\n    padding: 0.5rem 0.75rem;\n    border-radius: 0.375rem;\n    font-size: 0.875rem;\n    box-shadow: var(--shadow-medium);\n  }\n/* 14. Indicateur de page actuelle */\n[aria-current='page'] {\n    font-weight: 600;\n    position: relative;\n  }\n[aria-current='page']::after {\n    content: '';\n    position: absolute;\n    bottom: -2px;\n    left: 0;\n    right: 0;\n    height: 2px;\n    background: hsl(var(--primary));\n  }\n/* 15. Respect des préférences utilisateur */\n@media (prefers-contrast: high) {\n    :root {\n      --border: 220 20% 40%;\n      --ring: 210 100% 70%;\n    }\n\n    button,\n    a {\n      outline-width: 4px;\n    }\n  }\n@media (prefers-color-scheme: dark) {\n    :root:not(.light) {\n      color-scheme: dark;\n    }\n  }\n.\\!container {\n  width: 100% !important;\n  margin-right: auto !important;\n  margin-left: auto !important;\n  padding-right: 1rem !important;\n  padding-left: 1rem !important;\n}\n.container {\n  width: 100%;\n  margin-right: auto;\n  margin-left: auto;\n  padding-right: 1rem;\n  padding-left: 1rem;\n}\n@media (min-width: 475px) {\n  .\\!container {\n    max-width: 475px !important;\n  }\n  .container {\n    max-width: 475px;\n  }\n}\n@media (min-width: 640px) {\n  .\\!container {\n    max-width: 640px !important;\n  }\n  .container {\n    max-width: 640px;\n  }\n}\n@media (min-width: 768px) {\n  .\\!container {\n    max-width: 768px !important;\n  }\n  .container {\n    max-width: 768px;\n  }\n}\n@media (min-width: 1024px) {\n  .\\!container {\n    max-width: 1024px !important;\n  }\n  .container {\n    max-width: 1024px;\n  }\n}\n@media (min-width: 1280px) {\n  .\\!container {\n    max-width: 1280px !important;\n  }\n  .container {\n    max-width: 1280px;\n  }\n}\n@media (min-width: 1400px) {\n  .\\!container {\n    max-width: 1400px !important;\n  }\n  .container {\n    max-width: 1400px;\n  }\n}\n@media (min-width: 1920px) {\n  .\\!container {\n    max-width: 1920px !important;\n  }\n  .container {\n    max-width: 1920px;\n  }\n}\n.sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border-width: 0;\n}\n.pointer-events-none {\n  pointer-events: none;\n}\n.pointer-events-auto {\n  pointer-events: auto;\n}\n.\\!visible {\n  visibility: visible !important;\n}\n.visible {\n  visibility: visible;\n}\n.invisible {\n  visibility: hidden;\n}\n.collapse {\n  visibility: collapse;\n}\n.static {\n  position: static;\n}\n.fixed {\n  position: fixed;\n}\n.absolute {\n  position: absolute;\