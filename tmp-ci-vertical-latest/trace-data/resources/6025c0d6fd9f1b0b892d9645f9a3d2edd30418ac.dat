                        ascending: false
                    }).limit(limit);
                    categoryRecommendations = categoryServices || [];
                }
                // 2. Recommandations basées sur les tags
                let tagRecommendations = [];
                if (tags && tags.length > 0) {
                    // Rechercher services avec tags similaires
                    const { data: tagServices } = await supabase.from('products').select(`
              *,
              stores!inner (
                id,
                name,
                slug
              ),
              service_products (
                *
              )
            `).eq('product_type', 'service').eq('is_active', true).eq('is_draft', false).neq('id', serviceId).limit(100);
