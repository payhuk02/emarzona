import { createHotContext as __vite__createHotContext } from "/@vite/client";import.meta.hot = __vite__createHotContext("/src/styles/reviews-dark-mode.css");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from "/@vite/client"
const __vite__id = "/home/runner/work/emarzona/emarzona/src/styles/reviews-dark-mode.css"
const __vite__css = "/**\n * Dark Mode Refinements pour Reviews\n * Date : 27 octobre 2025\n */\n\n/* Review Cards */\n.dark .review-card {\n    --tw-border-opacity: 1;\n    border-color: rgb(31 41 55 / var(--tw-border-opacity, 1));\n    background-color: rgb(17 24 39 / 0.5)\n}\n\n.dark .review-card:hover {\n    --tw-border-opacity: 1;\n    border-color: rgb(55 65 81 / var(--tw-border-opacity, 1));\n    background-color: rgb(17 24 39 / 0.7)\n}\n\n/* Stars Colors */\n.dark .star-filled {\n    --tw-text-opacity: 1;\n    color: rgb(251 191 36 / var(--tw-text-opacity, 1))\n}\n\n.dark .star-empty {\n    --tw-text-opacity: 1;\n    color: rgb(75 85 99 / var(--tw-text-opacity, 1))\n}\n\n/* Review Content */\n.dark .review-content {\n    --tw-text-opacity: 1;\n    color: rgb(209 213 219 / var(--tw-text-opacity, 1))\n}\n\n.dark .review-title {\n    --tw-text-opacity: 1;\n    color: rgb(243 244 246 / var(--tw-text-opacity, 1))\n}\n\n.dark .reviewer-name {\n    --tw-text-opacity: 1;\n    color: rgb(229 231 235 / var(--tw-text-opacity, 1))\n}\n\n/* Media Thumbnails */\n.dark .review-media-thumbnail {\n    --tw-border-opacity: 1;\n    border-color: rgb(55 65 81 / var(--tw-border-opacity, 1));\n    opacity: 0.9\n}\n\n.dark .review-media-thumbnail:hover {\n    --tw-border-opacity: 1;\n    border-color: rgb(75 85 99 / var(--tw-border-opacity, 1));\n    opacity: 1\n}\n\n/* Vote Buttons */\n.dark .vote-button {\n    --tw-border-opacity: 1;\n    border-color: rgb(55 65 81 / var(--tw-border-opacity, 1));\n    --tw-bg-opacity: 1;\n    background-color: rgb(31 41 55 / var(--tw-bg-opacity, 1));\n    --tw-text-opacity: 1;\n    color: rgb(209 213 219 / var(--tw-text-opacity, 1))\n}\n\n.dark .vote-button:hover {\n    --tw-border-opacity: 1;\n    border-color: rgb(75 85 99 / var(--tw-border-opacity, 1));\n    --tw-bg-opacity: 1;\n    background-color: rgb(55 65 81 / var(--tw-bg-opacity, 1))\n}\n\n.dark .vote-button-active {\n    border-color: hsl(var(--primary) / 0.5);\n    background-color: hsl(var(--primary) / 0.2);\n    color: hsl(var(--primary))\n}\n\n/* Stats */\n.dark .review-stats-card {\n    --tw-border-opacity: 1;\n    border-color: rgb(31 41 55 / var(--tw-border-opacity, 1));\n    background-color: rgb(17 24 39 / 0.5)\n}\n\n.dark .rating-bar {\n    --tw-bg-opacity: 1;\n    background-color: rgb(31 41 55 / var(--tw-bg-opacity, 1))\n}\n\n.dark .rating-bar-fill {\n    --tw-bg-opacity: 1;\n    background-color: rgb(245 158 11 / var(--tw-bg-opacity, 1))\n}\n\n/* Form */\n.dark .review-form-input {\n    --tw-border-opacity: 1;\n    border-color: rgb(55 65 81 / var(--tw-border-opacity, 1));\n    --tw-bg-opacity: 1;\n    background-color: rgb(17 24 39 / var(--tw-bg-opacity, 1));\n    --tw-text-opacity: 1;\n    color: rgb(243 244 246 / var(--tw-text-opacity, 1))\n}\n\n.dark .review-form-input:focus {\n    border-color: hsl(var(--primary));\n    --tw-ring-color: hsl(var(--primary) / 0.2)\n}\n\n/* Badges */\n.dark .verified-badge {\n    border-color: rgb(21 128 61 / 0.5);\n    background-color: rgb(20 83 45 / 0.3);\n    --tw-text-opacity: 1;\n    color: rgb(74 222 128 / var(--tw-text-opacity, 1))\n}\n\n.dark .featured-badge {\n    border-color: rgb(180 83 9 / 0.5);\n    background-color: rgb(120 53 15 / 0.3);\n    --tw-text-opacity: 1;\n    color: rgb(251 191 36 / var(--tw-text-opacity, 1))\n}\n\n/* Skeletons */\n.dark .skeleton {\n    --tw-bg-opacity: 1;\n    background-color: rgb(31 41 55 / var(--tw-bg-opacity, 1))\n}\n\n/* Replies */\n.dark .review-reply {\n    --tw-border-opacity: 1;\n    border-color: rgb(55 65 81 / var(--tw-border-opacity, 1));\n    --tw-bg-opacity: 1;\n    background-color: rgb(31 41 55 / var(--tw-bg-opacity, 1))\n}\n\n.dark .official-reply {\n    border-color: rgb(30 64 175 / 0.5);\n    background-color: rgb(30 58 138 / 0.2)\n}\n\n/* Dropdown & Dialogs */\n.dark .review-dialog-content {\n    --tw-border-opacity: 1;\n    border-color: rgb(31 41 55 / var(--tw-border-opacity, 1));\n    --tw-bg-opacity: 1;\n    background-color: rgb(17 24 39 / var(--tw-bg-opacity, 1))\n}\n\n.dark .review-dropdown {\n    --tw-border-opacity: 1;\n    border-color: rgb(31 41 55 / var(--tw-border-opacity, 1));\n    --tw-bg-opacity: 1;\n    background-color: rgb(17 24 39 / var(--tw-bg-opacity, 1))\n}\n"
__vite__updateStyle(__vite__id, __vite__css)
import.meta.hot.accept()
import.meta.hot.prune(() => __vite__removeStyle(__vite__id))