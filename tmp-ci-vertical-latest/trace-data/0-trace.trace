kit-font-smoothing: antialiased;\n}\n\n@media (min-width: 768px) {\n  .landing-premium.app-premium #main-content,\n  .landing-premium.app-premium main.flex-1,\n  .landing-premium.app-premium main.flex-1.overflow-auto {\n    font-size: var(--app-font-body-lg);\n  }\n}\n\n/* Titres */\n.landing-premium.app-premium #main-content h1,\n.landing-premium.app-premium #main-content .app-premium-page-title,\n.landing-premium.app-premium main.flex-1 h1,\n.landing-premium.app-premium main.flex-1.overflow-auto h1 {\n  font-size: var(--app-font-display) !important;\n  line-height: var(--app-line-tight);\n  font-weight: 700 !important;\n}\n\n.landing-premium.app-premium #main-content h2,\n.landing-premium.app-premium main.flex-1 h2,\n.landing-premium.app-premium main.flex-1.overflow-auto h2 {\n  font-size: var(--app-font-h1) !important;\n  line-height: var(--app-line-tight);\n  font-weight: 600 !important;\n}\n\n.landing-premium.app-premium #main-content h3,\n.landing-premium.app-premium main.flex-1 h3,\n.landing-premium.app-premium main.flex-1.overflow-auto h3 {\n  font-size: var(--app-font-h2) !important;\n  line-height: var(--app-line-tight);\n  font-weight: 600 !important;\n}\n\n.landing-premium.app-premium #main-content h4,\n.landing-premium.app-premium main.flex-1 h4,\n.landing-premium.app-premium main.flex-1.overflow-auto h4 {\n  font-size: var(--app-font-h3) !important;\n  font-weight: 600 !important;\n}\n\n/* Corps & labels — poids normal */\n.landing-premium.app-premium #main-content p,\n.landing-premium.app-premium #main-content span:not([class*='font-']),\n.landing-premium.app-premium #main-content label,\n.landing-premium.app-premium #main-content li,\n.landing-premium.app-premium #main-content td,\n.landing-premium.app-premium #main-content th,\n.landing-premium.app-premium main.flex-1 p,\n.landing-premium.app-premium main.flex-1 span:not([class*='font-']),\n.landing-premium.app-premium main.flex-1 label,\n.landing-premium.app-premium main.flex-1.overflow-auto p,\n.l