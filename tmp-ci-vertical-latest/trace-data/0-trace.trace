-premium #main-content [class*='from-purple-600'][class*='to-pink-600'] svg,\n.landing-premium.app-premium #main-content .bg-primary svg,\n.landing-premium.app-premium #main-content [class*='text-primary-foreground'] svg,\n.landing-premium.app-premium main.flex-1 [class*='from-purple-600'][class*='to-pink-600'] svg,\n.landing-premium.app-premium main.flex-1 .bg-primary svg,\n.landing-premium.app-premium main.flex-1 [class*='text-white'] svg {\n  color: #fff !important;\n  stroke: #fff !important;\n}\n\n/* Classes texte colorées sur icônes → noir */\n.landing-premium.app-premium #main-content [class*='text-blue-500'],\n.landing-premium.app-premium #main-content [class*='text-blue-600'],\n.landing-premium.app-premium #main-content [class*='text-orange-500'],\n.landing-premium.app-premium #main-content [class*='text-orange-600'],\n.landing-premium.app-premium #main-content [class*='text-green-500'],\n.landing-premium.app-premium #main-content [class*='text-green-600'],\n.landing-premium.app-premium #main-content [class*='text-purple-500'],\n.landing-premium.app-premium #main-content [class*='text-purple-600'],\n.landing-premium.app-premium #main-content [class*='text-pink-500'],\n.landing-premium.app-premium #main-content [class*='text-pink-600'],\n.landing-premium.app-premium #main-content [class*='text-red-500'],\n.landing-premium.app-premium #main-content [class*='text-red-600'],\n.landing-premium.app-premium #main-content [class*='text-cyan-'],\n.landing-premium.app-premium #main-content [class*='text-emerald-'],\n.landing-premium.app-premium main.flex-1 [class*='text-blue-500'],\n.landing-premium.app-premium main.flex-1 [class*='text-blue-600'],\n.landing-premium.app-premium main.flex-1 [class*='text-orange-500'],\n.landing-premium.app-premium main.flex-1 [class*='text-orange-600'],\n.landing-premium.app-premium main.flex-1 [class*='text-green-500'],\n.landing-premium.app-premium main.flex-1 [class*='text-green-600'],\n.landing-premium.app-premium main.flex-1 [cla