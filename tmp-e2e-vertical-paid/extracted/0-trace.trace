x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y));\n}\n.\\[\\&_\\*\\]\\:\\!text-primary * {\n  color: hsl(var(--primary)) !important;\n}\n.\\[\\&_\\*\\]\\:text-foreground * {\n  color: hsl(var(--foreground));\n}\n.\\[\\&_\\.recharts-cartesian-axis-tick_text\\]\\:fill-muted-foreground .recharts-cartesian-axis-tick text {\n  fill: hsl(var(--muted-foreground));\n}\n.\\[\\&_\\.recharts-cartesian-grid_line\\[stroke\\=\\'\\#ccc\\'\\]\\]\\:stroke-border\\/50 .recharts-cartesian-grid line[stroke='#ccc'] {\n  stroke: hsl(var(--border) / 0.5);\n}\n.\\[\\&_\\.recharts-curve\\.recharts-tooltip-cursor\\]\\:stroke-border .recharts-curve.recharts-tooltip-cursor {\n  stroke: hsl(var(--border));\n}\n.\\[\\&_\\.recharts-dot\\[stroke\\=\\'\\#fff\\'\\]\\]\\:stroke-transparent .recharts-dot[stroke='#fff'] {\n  stroke: transparent;\n}\n.\\[\\&_\\.recharts-layer\\]\\:outline-none .recharts-layer {\n  outline: 2px solid transparent;\n  outline-offset: 2px;\n}\n.\\[\\&_\\.recharts-polar-grid_\\[stroke\\=\\'\\#ccc\\'\\]\\]\\:stroke-border .recharts-polar-grid [stroke='#ccc'] {\n  stroke: hsl(var(--border));\n}\n.\\[\\&_\\.recharts-radial-bar-background-sector\\]\\:fill-muted .recharts-radial-bar-background-sector {\n  fill: hsl(var(--muted));\n}\n.\\[\\&_\\.recharts-rectangle\\.recharts-tooltip-cursor\\]\\:fill-muted .recharts-rectangle.recharts-tooltip-cursor {\n  fill: hsl(var(--muted));\n}\n.\\[\\&_\\.recharts-reference-line_\\[stroke\\=\\'\\#ccc\\'\\]\\]\\:stroke-border .recharts-reference-line [stroke='#ccc'] {\n  stroke: hsl(var(--border));\n}\n.\\[\\&_\\.recharts-sector\\[stroke\\=\\'\\#fff\\'\\]\\]\\:stroke-transparent .recharts-sector[stroke='#fff'] {\n  stroke: transparent;\n}\n.\\[\\&_\\.recharts-sector\\]\\:outline-none .recharts-sector {\n  outline: 2px solid transparent;\n  outline-offset: 2px;\n}\n.\\[\\&_\\.recharts-surface\\]\\:outline-none .recharts-surface {\n  outline: 2px solid transparent;\n  outline-offset: 2px;\n}\n.\\[\\&_\\.text-2xl\\]\\:text-blue-600 .text-2xl {\n  --tw-text-opacity: 1;\n  color: rgb(37 99 235 / var(--tw-text-opacity, 1));\n}\n.\\[\\&_\\.text-2xl\\]\\:text-emerald-600 .text-2xl {\n  --tw-text-opacity: 1;\n  color: rgb(5 150 105 / var(--tw-text-opacity, 1));\n}\n.\\[\\&_\\.text-2xl\\]\\:text-green-600 .text-2xl {\n  --tw-text-opacity: 1;\n  color: rgb(22 163 74 / var(--tw-text-opacity, 1));\n}\n.\\[\\&_\\.text-2xl\\]\\:text-orange-600 .text-2xl {\n  --tw-text-opacity: 1;\n  color: rgb(234 88 12 / var(--tw-text-opacity, 1));\n}\n.\\[\\&_\\.text-2xl\\]\\:text-purple-600 .text-2xl {\n  --tw-text-opacity: 1;\n  color: rgb(147 51 234 / var(--tw-text-opacity, 1));\n}\n.\\[\\&_\\.text-2xl\\]\\:text-red-600 .text-2xl {\n  --tw-text-opacity: 1;\n  color: rgb(220 38 38 / var(--tw-text-opacity, 1));\n}\n.\\[\\&_\\.text-2xl\\]\\:text-yellow-600 .text-2xl {\n  --tw-text-opacity: 1;\n  color: rgb(202 138 4 / var(--tw-text-opacity, 1));\n}\n.dark\\:\\[\\&_\\.text-2xl\\]\\:text-blue-500 .text-2xl:is(.dark *) {\n  --tw-text-opacity: 1;\n  color: rgb(59 130 246 / var(--tw-text-opacity, 1));\n}\n.dark\\:\\[\\&_\\.text-2xl\\]\\:text-emerald-500 .text-2xl:is(.dark *) {\n  --tw-text-opacity: 1;\n  color: rgb(16 185 129 / var(--tw-text-opacity, 1));\n}\n.dark\\:\\[\\&_\\.text-2xl\\]\\:text-green-500 .text-2xl:is(.dark *) {\n  --tw-text-opacity: 1;\n  color: rgb(34 197 94 / var(--tw-text-opacity, 1));\n}\n.dark\\:\\[\\&_\\.text-2xl\\]\\:text-orange-500 .text-2xl:is(.dark *) {\n  --tw-text-opacity: 1;\n  color: rgb(249 115 22 / var(--tw-text-opacity, 1));\n}\n.dark\\:\\[\\&_\\.text-2xl\\]\\:text-purple-500 .text-2xl:is(.dark *) {\n  --tw-text-opacity: 1;\n  color: rgb(168 85 247 / var(--tw-text-opacity, 1));\n}\n.dark\\:\\[\\&_\\.text-2xl\\]\\:text-red-500 .text-2xl:is(.dark *) {\n  --tw-text-opacity: 1;\n  color: rgb(239 68 68 / var(--tw-text-opacity, 1));\n}\n.dark\\:\\[\\&_\\.text-2xl\\]\\:text-yellow-500 .text-2xl:is(.dark *) {\n  --tw-text-opacity: 1;\n  color: rgb(234 179 8 / var(--tw-text-opacity, 1));\n}\n.\\[\\&_\\.text-primary\\]\\:text-blue-600 .text-primary {\n  --tw-text-opacity: 1;\n  color: rgb(37 99 235 / var(--tw-text-opacity, 1));\n}\n.\\[\\&_\\.text-primary\\]\\:text-emerald-600 .text-primary {\n  --tw-text-opacity: 1;\n  color: rgb(5 150 105 / var(--tw-text-opacity, 1));\n}\n.\\[\\&_\\.text-primary\\]\\:text-green-600 .text-primary {\n  --tw-text-opacity: 1;\n  color: rgb(22 163 74 / var(--tw-text-opacity, 1));\n}\n.\\[\\&_\\.text-primary\\]\\:text-orange-600 .text-primary {\n  --tw-text-opacity: 1;\n  color: rgb(234 88 12 / var(--tw-text-opacity, 1));\n}\n.\\[\\&_\\.text-primary\\]\\:text-purple-600 .text-primary {\n  --tw-text-opacity: 1;\n  color: rgb(147 51 234 / var(--tw-text-opacity, 1));\n}\n.\\[\\&_\\.text-primary\\]\\:text-red-600 .text-primary {\n  --tw-text-opacity: 1;\n  color: rgb(220 38 38 / var(--tw-text-opacity, 1));\n}\n.\\[\\&_\\.text-primary\\]\\:text-yellow-600 .text-primary {\n  --tw-text-opacity: 1;\n  color: rgb(202 138 4 / var(--tw-text-opacity, 1));\n}\n.dark\\:\\[\\&_\\.text-primary\\]\\:text-blue-500 .text-primary:is(.dark *) {\n  --tw-text-opacity: 1;\n  color: rgb(59 130 246 / var(--tw-text-opacity, 1));\n}\n.dark\\:\\[\\&_\\.text-primary\\]\\:text-emerald-500 .text-primary:is(.dark *) {\n  --tw-text-opacity: 1;\n  color: rgb(16 185 129 / var(--tw-text-opacity, 1));\n}\n.dark\\:\\[\\&_\\.text-primary\\]\\:text-green-500 .text-primary:is(.dark *) {\n  --tw-text-opacity: 1;\n  color: rgb(34 197 94 / var(--tw-text-opacity, 1));\n}\n.dark\\:\\[\\&_\\.text-primary\\]\\:text-orange-500 .text-primary:is(.dark *) {\n  --tw-text-opacity: 1;\n  color: rgb(249 115 22 / var(--tw-text-opacity, 1));\n}\n.dark\\:\\[\\&_\\.text-primary\\]\\:text-purple-500 .text-primary:is(.dark *) {\n  --tw-text-opacity: 1;\n  color: rgb(168 85 247 / var(--tw-text-opacity, 1));\n}\n.dark\\:\\[\\&_\\.text-primary\\]\\:text-red-500 .text-primary:is(.dark *) {\n  --tw-text-opacity: 1;\n  color: rgb(239 68 68 / var(--tw-text-opacity, 1));\n}\n.dark\\:\\[\\&_\\.text-primary\\]\\:text-yellow-500 .text-primary:is(.dark *) {\n  --tw-text-opacity: 1;\n  color: rgb(234 179 8 / var(--tw-text-opacity, 1));\n}\n.\\[\\&_\\[cmdk-group-heading\\]\\]\\:px-2 [cmdk-group-heading] {\n  padding-left: 0.5rem;\n  padding-right: 0.5rem;\n}\n.\\[\\&_\\[cmdk-group-heading\\]\\]\\:py-1\\.5 [cmdk-group-heading] {\n  padding-top: 0.375rem;\n  padding-bottom: 0.375rem;\n}\n.\\[\\&_\\[cmdk-group-heading\\]\\]\\:text-xs [cmdk-group-heading] {\n  font-size: 0.75rem;\n  line-height: 1.25rem;\n  letter-spacing: 0;\n}\n.\\[\\&_\\[cmdk-group-heading\\]\\]\\:font-medium [cmdk-group-heading] {\n  font-weight: 500;\n}\n.\\[\\&_\\[cmdk-group-heading\\]\\]\\:text-muted-foreground [cmdk-group-heading] {\n  color: hsl(var(--muted-foreground));\n}\n.\\[\\&_\\[cmdk-group\\]\\:not\\(\\[hidden\\]\\)_\\~\\[cmdk-group\\]\\]\\:pt-0 [cmdk-group]:not([hidden]) ~[cmdk-group] {\n  padding-top: 0px;\n}\n.\\[\\&_\\[cmdk-group\\]\\]\\:px-2 [cmdk-group] {\n  padding-left: 0.5rem;\n  padding-right: 0.5rem;\n}\n.\\[\\&_\\[cmdk-input-wrapper\\]_svg\\]\\:h-5 [cmdk-input-wrapper] svg {\n  height: 1.25rem;\n}\n.\\[\\&_\\[cmdk-input-wrapper\\]_svg\\]\\:w-5 [cmdk-input-wrapper] svg {\n  width: 1.25rem;\n}\n.\\[\\&_\\[cmdk-input\\]\\]\\:h-12 [cmdk-input] {\n  height: 3rem;\n}\n.\\[\\&_\\[cmdk-item\\]\\]\\:px-2 [cmdk-item] {\n  padding-left: 0.5rem;\n  padding-right: 0.5rem;\n}\n.\\[\\&_\\[cmdk-item\\]\\]\\:py-3 [cmdk-item] {\n  padding-top: 0.75rem;\n  padding-bottom: 0.75rem;\n}\n.\\[\\&_\\[cmdk-item\\]_svg\\]\\:h-5 [cmdk-item] svg {\n  height: 1.25rem;\n}\n.\\[\\&_\\[cmdk-item\\]_svg\\]\\:w-5 [cmdk-item] svg {\n  width: 1.25rem;\n}\n.\\[\\&_p\\]\\:leading-relaxed p {\n  line-height: 1.625;\n}\n.\\[\\&_span\\]\\:\\!text-muted-foreground span {\n  color: hsl(var(--muted-foreground)) !important;\n}\n.\\[\\&_span\\]\\:\\!text-primary span {\n  color: hsl(var(--primary)) !important;\n}\n.hover\\:\\[\\&_span\\]\\:\\!text-foreground span:hover {\n  color: hsl(var(--foreground)) !important;\n}\n.\\[\\&_svg\\.opacity-50\\]\\:hidden svg.opacity-50 {\n  display: none;\n}\n.\\[\\&_svg\\]\\:pointer-events-none svg {\n  pointer-events: none;\n}\n.\\[\\&_svg\\]\\:size-4 svg {\n  width: 1rem;\n  height: 1rem;\n}\n.\\[\\&_svg\\]\\:shrink-0 svg {\n  flex-shrink: 0;\n}\n.\\[\\&_svg\\]\\:\\!text-muted-foreground svg {\n  color: hsl(var(--muted-foreground)) !important;\n}\n.\\[\\&_svg\\]\\:\\!text-primary svg {\n  color: hsl(var(--primary)) !important;\n}\n.hover\\:\\[\\&_svg\\]\\:\\!text-foreground svg:hover {\n  color: hsl(var(--foreground)) !important;\n}\n.\\[\\&_tr\\:last-child\\]\\:border-0 tr:last-child {\n  border-width: 0px;\n}\n.\\[\\&_tr\\]\\:border-b tr {\n  border-bottom-width: 1px;\n}\n[data-side=left][data-collapsible=offcanvas] .\\[\\[data-side\\=left\\]\\[data-collapsible\\=offcanvas\\]_\\&\\]\\:-right-2 {\n  right: -0.5rem;\n}\n[data-side=left][data-state=collapsed] .\\[\\[data-side\\=left\\]\\[data-state\\=collapsed\\]_\\&\\]\\:cursor-e-resize {\n  cursor: e-resize;\n}\n[data-side=left] .\\[\\[data-side\\=left\\]_\\&\\]\\:cursor-w-resize {\n  cursor: w-resize;\n}\n[data-side=right][data-collapsible=offcanvas] .\\[\\[data-side\\=right\\]\\[data-collapsible\\=offcanvas\\]_\\&\\]\\:-left-2 {\n  left: -0.5rem;\n}\n[data-side=right][data-state=collapsed] .\\[\\[data-side\\=right\\]\\[data-state\\=collapsed\\]_\\&\\]\\:cursor-w-resize {\n  cursor: w-resize;\n}\n[data-side=right] .\\[\\[data-side\\=right\\]_\\&\\]\\:cursor-e-resize {\n  cursor: e-resize;\n}\n"],["STYLE",{},"/* ============================================================\n   OPTIMISATION DES BANNIÈRES PRODUITS - EMARZONA\n   Version Professionnelle - Inspirée des grandes plateformes\n   ============================================================ */\n\n/* Variables CSS pour la cohérence et la performance - Style ComeUp/Fiverr */\n:root {\n  /* Ratio par défaut des bannières aligné sur le format produit 1536×1024 (3:2) */\n  --product-banner-aspect-ratio: 3/2;\n  --mobile-margin: 0.125rem;\n  --tablet-margin: 1rem;\n  --desktop-margin: 1.5rem;\n  --border-radius-mobile: 0.75rem;\n  --border-radius-tablet: 1rem;\n  --border-radius-desktop: 1.25rem;\n  --transition-duration: 300ms;\n  /* Ombres supprimées pour affichage statique et professionnel */\n}\n\n/* Container principal pour les cartes produits - Optimisé pour toutes les plateformes */\n.product-card-container {\n  width: 100%;\n  /* Prévention du CLS et optimisation GPU */\n  contain: layout style;\n  transform: translateZ(0);\n  will-change: transform;\n}\n\n/* Container de bannière avec optimisations avancées */\n.product-banner-container {\n  position: relative;\n  width: 100%;\n  /* Optimisation GPU */\n  transform: translateZ(0);\n  will-change: transform;\n}\n\n/* Bannière produit avec ratio 3:2 professionnel */\n.product-banner {\n  position: relative;\n  width: 100%;\n  overflow: hidden;\n  aspect-ratio: var(--product-banner-aspect-ratio);\n  /* Qualité d'affichage optimisée */\n  image-rendering: high-quality;\n  -webkit-image-rendering: high-quality;\n  /* Optimisation GPU */\n  transform: translateZ(0);\n  will-change: transform;\n}\n\n/* Image optimisée avec rendu professionnel statique - Pas d'ombres, pas d'animations - Stable et optimisée */\n.product-banner img {\n  height: 100%;\n  width: 100%;\n  -o-object-fit: cover;\n     object-fit: cover;\n  /* Qualité d'affichage optimisée - Images nettes */\n  image-rendering: high-quality;\n  -webkit-image-rendering: high-quality;\n  /* Centrage parfait de l'image */\n  -o-object-position: center;\n     object-position: center;\n  /* Prévention du CLS */\n  contain: layout;\n  /* Coins arrondis pour l'image */\n  border-radius: inherit;\n  /* Pas d'ombres, affichage statique */\n  box-shadow: none !important;\n  filter: none;\n  /* S'assurer que l'image reste visible lors du scroll sur mobile */\n  position: relative !important;\n  z-index: 1 !important;\n  visibility: visible !important;\n  opacity: 1 !important;\n  display: block !important;\n  /* Stabilité garantie - pas de transformations */\n  transform: none !important;\n  /* Optimisation performance */\n  will-change: auto;\n  backface-visibility: visible;\n  -webkit-backface-visibility: visible;\n}\n\n/* Overlay gradient pour les effets visuels */\n.product-banner-overlay {\n  position: absolute;\n  inset: 0px;\n  background-image: linear-gradient(to top, var(--tw-gradient-stops));\n  --tw-gradient-from: rgb(0 0 0 / 0.6) var(--tw-gradient-from-position);\n  --tw-gradient-to: rgb(0 0 0 / 0) var(--tw-gradient-to-position);\n  --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to);\n  --tw-gradient-to: rgb(0 0 0 / 0)  var(--tw-gradient-to-position);\n  --tw-gradient-stops: var(--tw-gradient-from), transparent var(--tw-gradient-via-position), var(--tw-gradient-to);\n  --tw-gradient-to: transparent var(--tw-gradient-to-position);\n  opacity: 0;\n  transition-property: opacity;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 300ms;\n  animation-duration: 300ms;\n}\n\n.product-card:hover .product-banner-overlay {\n  opacity: 1;\n}\n\n/* Badges de promotion */\n.product-badge {\n  position: absolute;\n  top: 0.75rem;\n  right: 0.75rem;\n  z-index: 10;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  /* Optimisation GPU */\n  transform: translateZ(0);\n  will-change: transform;\n}\n\n/* Actions hover */\n.product-actions {\n  position: absolute;\n  top: 0.75rem;\n  right: 0.75rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  --tw-translate-x: 0.5rem;\n  transform: translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y));\n  opacity: 0;\n  transition-property: all;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 300ms;\n  animation-duration: 300ms;\n  /* Optimisation GPU */\n  transform: translateZ(0) translateX(8px);\n  will-change: transform, opacity;\n}\n\n.product-card:hover .product-actions {\n  opacity: 1;\n  transform: translateZ(0) translateX(0);\n}\n\n/* ============================================================\n   RESPONSIVE DESIGN - MOBILE FIRST\n   ============================================================ */\n\n/* Mobile (< 640px) - 1 produit par ligne - Affichage exact */\n@media (max-width: 639px) {\n  .product-card-container {\n    width: 96%;\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n  .product-banner {\n    border-radius: var(--border-radius-mobile);\n    /* Largeur 96% pour une meilleure utilisation de l'espace mobile */\n    width: 96%;\n    margin: 0 auto;\n  }\n\n  /* Grille mobile - EXACTEMENT 1 produit par ligne */\n  .products-grid-mobile {\n    display: grid;\n    grid-template-columns: repeat(1, minmax(0, 1fr));\n    gap: 1.5rem;\n    padding-left: 2%;\n    padding-right: 2%;\n    /* Optimisation GPU */\n    transform: translateZ(0);\n    will-change: transform;\n  }\n\n  /* Cartes produits mobile - Design professionnel */\n  .product-card-mobile {\n    margin-left: 0px;\n    margin-right: 0px;\n    width: 96%;\n    margin-left: auto;\n    margin-right: auto;\n    box-shadow: none;\n    border-radius: var(--border-radius-mobile);\n    background: transparent;\n    /* Effet de profondeur */\n    transform: translateZ(0);\n    will-change: transform;\n    /* Hauteur uniforme exacte */\n    height: 480px;\n    min-height: 480px;\n    max-height: 480px;\n  }\n\n  /* Contenu des cartes mobile */\n  .product-card-content-mobile {\n    padding: 1rem;\n  }\n\n  /* Boutons mobile - Style moderne */\n  .product-button-mobile {\n    width: 100%;\n    padding-top: 0.75rem;\n    padding-bottom: 0.75rem;\n    padding-left: 1rem;\n    padding-right: 1rem;\n    font-size: 0.875rem;\n    line-height: 1.375rem;\n    letter-spacing: 0;\n    border-radius: var(--border-radius-mobile);\n    font-weight: 600;\n    /* Optimisation GPU */\n    transform: translateZ(0);\n    will-change: transform;\n  }\n}\n\n/* Tablet (640px - 1024px) - EXACTEMENT 2 produits par ligne */\n@media (min-width: 640px) and (max-width: 1023px) {\n  .product-card-container {\n    margin-left: var(--tablet-margin);\n    margin-right: var(--tablet-margin);\n  }\n\n  .product-banner {\n    border-radius: var(--border-radius-tablet);\n  }\n\n  /* Grille tablette - EXACTEMENT 2 produits par ligne */\n  .products-grid-tablet {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 2rem;\n    padding-left: var(--tablet-margin);\n    padding-right: var(--tablet-margin);\n    /* Optimisation GPU */\n    transform: translateZ(0);\n    will-change: transform;\n  }\n\n  /* Cartes produits tablette */\n  .product-card-tablet {\n    box-shadow: none;\n    border-radius: var(--border-radius-tablet);\n    background: transparent;\n    /* Hauteur uniforme exacte */\n    height: 520px;\n    min-height: 520px;\n    max-height: 520px;\n    transition: all var(--transition-duration) cubic-bezier(0.4, 0, 0.2, 1);\n    /* Optimisation GPU */\n    transform: translateZ(0);\n    will-change: transform;\n  }\n\n  /* Pas d'effet hover - Affichage statique */\n  .product-card-tablet:hover {\n    transform: none;\n    box-shadow: none;\n  }\n}\n\n/* Desktop (> 1024px) - EXACTEMENT 3 produits par ligne */\n@media (min-width: 1024px) {\n  .product-card-container {\n    margin-left: var(--desktop-margin);\n    margin-right: var(--desktop-margin);\n  }\n\n  .product-banner {\n    border-radius: var(--border-radius-desktop);\n    /* Optimisation pour le ratio 1920x1080 */\n    max-width: 100%;\n    height: auto;\n  }\n\n  /* Grille desktop - EXACTEMENT 3 produits par ligne */\n  .products-grid-desktop {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 2rem;\n    padding-left: var(--desktop-margin);\n    padding-right: var(--desktop-margin);\n    /* Optimisation GPU */\n    transform: translateZ(0);\n    will-change: transform;\n  }\n\n  /* Affichage statique et professionnel pour desktop - Pas d'ombres */\n  .product-card-desktop {\n    box-shadow: none;\n    border-radius: var(--border-radius-desktop);\n    background: transparent;\n    /* Hauteur uniforme exacte */\n    height: 560px;\n    min-height: 560px;\n    max-height: 560px;\n  }\n\n  /* Pas d'effet hover - Affichage statique */\n  .product-card-desktop:hover {\n    transform: none;\n    box-shadow: none;\n  }\n\n  /* Optimisation pour les écrans ultra-larges - Maintenir EXACTEMENT 3 colonnes */\n  @media (min-width: 1920px) {\n    .products-grid-desktop {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n      gap: 2rem;\n      max-width: 1400px;\n      margin: 0 auto;\n    }\n  }\n}\n\n/* ============================================================\n   STYLES UNIFORMES POUR LES CARTES PRODUITS\n   ============================================================ */\n\n/* Hauteur uniforme pour toutes les cartes - Garantie exacte */\n.product-card {\n  display: flex;\n  flex-direction: column;\n  background: transparent;\n  /* Hauteur minimale pour éviter les décalages */\n  min-height: 480px;\n  /* Optimisation GPU */\n  transform: translateZ(0);\n  will-change: transform;\n  /* Transition fluide pour tous les effets */\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n/* Contenu des cartes - Espacement uniforme */\n.product-card-content {\n  display: flex;\n  flex: 1 1 0%;\n  flex-direction: column;\n  justify-content: space-between;\n  padding: 1rem;\n}\n\n/* Titres de produits - Style professionnel */\n.product-title {\n  font-size: 1rem;\n  line-height: 1.625rem;\n  letter-spacing: 0;\n  font-weight: 600;\n  line-height: 1.25;\n  min-height: 2.5rem;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n/* Prix - Style moderne */\n.product-price {\n  font-size: 1.125rem;\n  line-height: 1.75rem;\n  letter-spacing: 0;\n  font-weight: 700;\n  color: hsl(var(--primary));\n}\n\n/* Boutons d'action - Centrés et uniformes */\n.product-actions {\n  margin-top: 1rem;\n  display: flex;\n  gap: 0.5rem;\n}\n\n.product-button {\n  flex: 1 1 0%;\n  border-radius: var(--radius);\n  padding-top: 0.5rem;\n  padding-bottom: 0.5rem;\n  padding-left: 1rem;\n  padding-right: 1rem;\n  text-align: center;\n  font-weight: 500;\n  transition-property: all;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 200ms;\n  animation-duration: 200ms;\n  /* Optimisation GPU */\n  transform: translateZ(0);\n  will-change: transform;\n}\n\n.product-button-primary {\n  background-color: hsl(var(--primary));\n  color: hsl(var(--primary-foreground));\n}\n\n.product-button-primary:hover {\n  background-color: hsl(var(--primary) / 0.9);\n}\n\n.product-button-secondary {\n  background-color: hsl(var(--secondary));\n  color: hsl(var(--secondary-foreground));\n}\n\n.product-button-secondary:hover {\n  background-color: hsl(var(--secondary) / 0.9);\n}\n\n/* Étoiles de notation */\n.product-rating {\n  display: flex;\n  align-items: center;\n  gap: 0.25rem;\n  font-size: 0.875rem;\n  line-height: 1.375rem;\n  letter-spacing: 0;\n  color: hsl(var(--muted-foreground));\n}\n\n/* Badges de promotion */\n.product-badge {\n  position: absolute;\n  top: 0.75rem;\n  right: 0.75rem;\n  z-index: 10;\n}\n\n/* Pas d'effet hover - Affichage statique et professionnel */\n.product-card:hover {\n  transform: none;\n  box-shadow: none;\n}\n\n.product-card:hover .product-title {\n  color: hsl(var(--primary));\n}\n\n/* Prévention du CLS (Cumulative Layout Shift) */\n.product-banner {\n  contain: layout style;\n}\n\n/* Lazy loading optimisé */\n.product-banner img[loading='lazy'] {\n  opacity: 0;\n  transition: opacity 0.3s ease-in-out;\n}\n\n.product-banner img[loading='lazy'].loaded {\n  opacity: 1;\n}\n\n/* Placeholder de chargement */\n.product-banner-loading {\n  position: absolute;\n  inset: 0px;\n  background-image: linear-gradient(to bottom right, var(--tw-gradient-stops));\n  --tw-gradient-from: #334155 var(--tw-gradient-from-position);\n  --tw-gradient-to: rgb(51 65 85 / 0) var(--tw-gradient-to-position);\n  --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to);\n  --tw-gradient-to: #1e293b var(--tw-gradient-to-position);\n  display: flex;\n}\n@keyframes pulse {\n  50% {\n    opacity: .5;\n  }\n}\n.product-banner-loading {\n  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n  align-items: center;\n  justify-content: center;\n}\n\n/* ============================================================\n   COMPATIBILITÉ NAVIGATEURS\n   ============================================================ */\n\n/* Fallback pour les navigateurs sans support aspect-ratio */\n@supports not (aspect-ratio: 16/9) {\n  .product-banner {\n    position: relative;\n    padding-bottom: 56.25%; /* 16:9 ratio */\n  }\n\n  .product-banner img {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n  }\n}\n\n/* ============================================================\n   ACCESSIBILITÉ\n   ============================================================ */\n\n/* Focus visible pour l'accessibilité */\n.product-card:focus-visible {\n  outline-width: 2px;\n  outline-offset: 2px;\n  outline-color: #3b82f6;\n}\n\n/* Contraste amélioré pour les badges */\n.product-badge .badge {\n  font-weight: 600;\n  --tw-text-opacity: 1;\n  color: rgb(255 255 255 / var(--tw-text-opacity, 1));\n  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);\n}\n\n/* ============================================================\n   ANIMATIONS FLUIDES\n   ============================================================ */\n\n/* Animation d'entrée pour les cartes */\n@keyframes fadeInUp {\n  from {\n    opacity: 0;\n    transform: translateY(20px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.product-card {\n  animation: fadeInUp 0.5s ease-out;\n}\n\n/* Animation de chargement */\n@keyframes shimmer {\n  0% {\n    background-position: -200px 0;\n  }\n  100% {\n    background-position: calc(200px + 100%) 0;\n  }\n}\n\n.product-banner-loading::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);\n  background-size: 200px 100%;\n  animation: shimmer 1.5s infinite;\n}\n\n/* ============================================================\n   MODE SOMBRE OPTIMISÉ\n   ============================================================ */\n\n@media (prefers-color-scheme: dark) {\n  .product-card {\n    --tw-border-opacity: 1;\n    border-color: rgb(71 85 105 / var(--tw-border-opacity, 1));\n    background-color: transparent;\n  }\n\n  .product-card:hover {\n    --tw-border-opacity: 1;\n    border-color: rgb(100 116 139 / var(--tw-border-opacity, 1));\n  }\n\n  .product-banner-loading {\n    background-image: linear-gradient(to bottom right, var(--tw-gradient-stops));\n    --tw-gradient-from: #334155 var(--tw-gradient-from-position);\n    --tw-gradient-to: rgb(51 65 85 / 0) var(--tw-gradient-to-position);\n    --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to);\n    --tw-gradient-to: #1e293b var(--tw-gradient-to-position);\n  }\n}\n\n/* ============================================================\n   PRINT STYLES\n   ============================================================ */\n\n@media print {\n  .product-card {\n    -moz-column-break-inside: avoid;\n         break-inside: avoid;\n  }\n\n  .product-banner {\n    aspect-ratio: 1 / 1; /* Ratio carré pour l'impression */\n  }\n\n  .product-actions {\n    display: none; /* Masquer les actions pour l'impression */\n  }\n}\n\n/* ============================================================\n   OPTIMISATIONS PERFORMANCE AVANCÉES\n   ============================================================ */\n\n/* Utilisation de contain pour l'isolation des layouts */\n.product-card {\n  contain: layout style;\n}\n\n/* Optimisation des animations avec will-change */\n.product-card:hover {\n  will-change: transform;\n}\n\n.product-card:not(:hover) {\n  will-change: auto;\n}\n\n/* Préchargement des images critiques */\n.product-banner img[data-priority='true'] {\n  opacity: 1;\n}\n\n/* Optimisation des transitions */\n.product-card * {\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n/* Réduction des animations sur les appareils lents */\n@media (prefers-reduced-motion: reduce) {\n  .product-card {\n    animation: none;\n  }\n\n  .product-card:hover {\n    transform: none;\n  }\n\n  .product-banner img {\n    transition: none;\n  }\n}\n"],["STYLE",{},"/**\n * Dark Mode Refinements pour Reviews\n * Date : 27 octobre 2025\n */\n\n/* Review Cards */\n.dark .review-card {\n    --tw-border-opacity: 1;\n    border-color: rgb(31 41 55 / var(--tw-border-opacity, 1));\n    background-color: rgb(17 24 39 / 0.5)\n}\n\n.dark .review-card:hover {\n    --tw-border-opacity: 1;\n    border-color: rgb(55 65 81 / var(--tw-border-opacity, 1));\n    background-color: rgb(17 24 39 / 0.7)\n}\n\n/* Stars Colors */\n.dark .star-filled {\n    --tw-text-opacity: 1;\n    color: rgb(251 191 36 / var(--tw-text-opacity, 1))\n}\n\n.dark .star-empty {\n    --tw-text-opacity: 1;\n    color: rgb(75 85 99 / var(--tw-text-opacity, 1))\n}\n\n/* Review Content */\n.dark .review-content {\n    --tw-text-opacity: 1;\n    color: rgb(209 213 219 / var(--tw-text-opacity, 1))\n}\n\n.dark .review-title {\n    --tw-text-opacity: 1;\n    color: rgb(243 244 246 / var(--tw-text-opacity, 1))\n}\n\n.dark .reviewer-name {\n    --tw-text-opacity: 1;\n    color: rgb(229 231 235 / var(--tw-text-opacity, 1))\n}\n\n/* Media Thumbnails */\n.dark .review-media-thumbnail {\n    --tw-border-opacity: 1;\n    border-color: rgb(55 65 81 / var(--tw-border-opacity, 1));\n    opacity: 0.9\n}\n\n.dark .review-media-thumbnail:hover {\n    --tw-border-opacity: 1;\n    border-color: rgb(75 85 99 / var(--tw-border-opacity, 1));\n    opacity: 1\n}\n\n/* Vote Buttons */\n.dark .vote-button {\n    --tw-border-opacity: 1;\n    border-color: rgb(55 65 81 / var(--tw-border-opacity, 1));\n    --tw-bg-opacity: 1;\n    background-color: rgb(31 41 55 / var(--tw-bg-opacity, 1));\n    --tw-text-opacity: 1;\n    color: rgb(209 213 219 / var(--tw-text-opacity, 1))\n}\n\n.dark .vote-button:hover {\n    --tw-border-opacity: 1;\n    border-color: rgb(75 85 99 / var(--tw-border-opacity, 1));\n    --tw-bg-opacity: 1;\n    background-color: rgb(55 65 81 / var(--tw-bg-opacity, 1))\n}\n\n.dark .vote-button-active {\n    border-color: hsl(var(--primary) / 0.5);\n    background-color: hsl(var(--primary) / 0.2);\n    color: hsl(var(--primary))\n}\n\n/* Stats */\n.dark .review-stats-card {\n    --tw-border-opacity: 1;\n    border-color: rgb(31 41 55 / var(--tw-border-opacity, 1));\n    background-color: rgb(17 24 39 / 0.5)\n}\n\n.dark .rating-bar {\n    --tw-bg-opacity: 1;\n    background-color: rgb(31 41 55 / var(--tw-bg-opacity, 1))\n}\n\n.dark .rating-bar-fill {\n    --tw-bg-opacity: 1;\n    background-color: rgb(245 158 11 / var(--tw-bg-opacity, 1))\n}\n\n/* Form */\n.dark .review-form-input {\n    --tw-border-opacity: 1;\n    border-color: rgb(55 65 81 / var(--tw-border-opacity, 1));\n    --tw-bg-opacity: 1;\n    background-color: rgb(17 24 39 / var(--tw-bg-opacity, 1));\n    --tw-text-opacity: 1;\n    color: rgb(243 244 246 / var(--tw-text-opacity, 1))\n}\n\n.dark .review-form-input:focus {\n    border-color: hsl(var(--primary));\n    --tw-ring-color: hsl(var(--primary) / 0.2)\n}\n\n/* Badges */\n.dark .verified-badge {\n    border-color: rgb(21 128 61 / 0.5);\n    background-color: rgb(20 83 45 / 0.3);\n    --tw-text-opacity: 1;\n    color: rgb(74 222 128 / var(--tw-text-opacity, 1))\n}\n\n.dark .featured-badge {\n    border-color: rgb(180 83 9 / 0.5);\n    background-color: rgb(120 53 15 / 0.3);\n    --tw-text-opacity: 1;\n    color: rgb(251 191 36 / var(--tw-text-opacity, 1))\n}\n\n/* Skeletons */\n.dark .skeleton {\n    --tw-bg-opacity: 1;\n    background-color: rgb(31 41 55 / var(--tw-bg-opacity, 1))\n}\n\n/* Replies */\n.dark .review-reply {\n    --tw-border-opacity: 1;\n    border-color: rgb(55 65 81 / var(--tw-border-opacity, 1));\n    --tw-bg-opacity: 1;\n    background-color: rgb(31 41 55 / var(--tw-bg-opacity, 1))\n}\n\n.dark .official-reply {\n    border-color: rgb(30 64 175 / 0.5);\n    background-color: rgb(30 58 138 / 0.2)\n}\n\n/* Dropdown & Dialogs */\n.dark .review-dialog-content {\n    --tw-border-opacity: 1;\n    border-color: rgb(31 41 55 / var(--tw-border-opacity, 1));\n    --tw-bg-opacity: 1;\n    background-color: rgb(17 24 39 / var(--tw-bg-opacity, 1))\n}\n\n.dark .review-dropdown {\n    --tw-border-opacity: 1;\n    border-color: rgb(31 41 55 / var(--tw-border-opacity, 1));\n    --tw-bg-opacity: 1;\n    background-color: rgb(17 24 39 / var(--tw-bg-opacity, 1))\n}\n"],["STYLE",{},"/**\n * Mobile Optimizations pour Reviews\n * Date : 27 octobre 2025\n */\n\n/* Touch Targets - Minimum 44px */\n@media (max-width: 768px) {\n  .vote-button,\n  .review-action-button {\n    min-width: 44px;\n    min-height: 44px;\n    padding: 12px;\n  }\n\n  /* Larger tap targets for stars */\n  .review-stars button {\n    min-width: 40px;\n    min-height: 40px;\n    padding: 8px;\n  }\n\n  /* Review Cards */\n  .review-card {\n    padding: 1rem;\n  }\n\n  /* Stats on mobile */\n  .review-stats-card {\n    padding: 1rem;\n  }\n\n  /* Form inputs */\n  .review-form-input,\n  .review-form-textarea {\n    font-size: 1rem;\n    line-height: 1.625rem;\n    letter-spacing: 0; /* Prevent zoom on iOS */\n    font-size: 16px !important;\n  }\n\n  /* Media Gallery - Swipeable */\n  .review-media-gallery {\n    scroll-snap-type: x var(--tw-scroll-snap-strictness);\n    --tw-scroll-snap-strictness: mandatory;\n    overflow-x: auto;\n    scrollbar-width: none; /* Firefox */\n    -ms-overflow-style: none; /* IE/Edge */\n  }\n\n  .review-media-gallery::-webkit-scrollbar {\n    display: none; /* Chrome/Safari */\n  }\n\n  .review-media-item {\n    flex-shrink: 0;\n    scroll-snap-align: center;\n  }\n\n  /* Bottom Sheet for Form (mobile) */\n  .review-form-mobile-sheet {\n    position: fixed;\n    bottom: 0px;\n    left: 0px;\n    right: 0px;\n    z-index: 50;\n    border-top-left-radius: 0.75rem;\n    border-top-right-radius: 0.75rem;\n    border-top-width: 1px;\n    background-color: hsl(var(--background));\n    max-height: 90vh;\n    overflow-y: auto;\n    padding: 1.5rem;\n  }\n\n  /* Compact stats on mobile */\n  .review-stats-compact {\n    display: flex;\n    align-items: center;\n    gap: 0.75rem;\n  }\n\n  .review-stats-compact .average-rating {\n    font-size: 1.875rem;\n    line-height: 2.25rem;\n    letter-spacing: -0.01em;\n    font-weight: 700;\n  }\n\n  .review-stats-compact .stars {\n    --tw-scale-x: .9;\n    --tw-scale-y: .9;\n    transform: translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y));\n  }\n\n  /* Grid adjustments */\n  .reviews-layout-grid {\n    grid-template-columns: repeat(1, minmax(0, 1fr));\n    gap: 1rem;\n  }\n\n  /* Floating action button for review */\n  .review-fab {\n    position: fixed;\n    bottom: 1.5rem;\n    right: 1.5rem;\n    z-index: 40;\n    height: 3.5rem;\n    width: 3.5rem;\n    border-radius: 9999px;\n    background-color: hsl(var(--primary));\n    color: hsl(var(--primary-foreground));\n    --tw-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);\n    --tw-shadow-colored: 0 10px 15px -3px var(--tw-shadow-color), 0 4px 6px -4px var(--tw-shadow-color);\n    box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  /* Sticky filter bar on mobile */\n  .review-filter-mobile {\n    position: sticky;\n    top: 0px;\n    z-index: 30;\n    background-color: hsl(var(--background) / 0.95);\n    --tw-backdrop-blur: blur(8px);\n    backdrop-filter: var(--tw-backdrop-blur) var(--tw-backdrop-brightness) var(--tw-backdrop-contrast) var(--tw-backdrop-grayscale) var(--tw-backdrop-hue-rotate) var(--tw-backdrop-invert) var(--tw-backdrop-opacity) var(--tw-backdrop-saturate) var(--tw-backdrop-sepia);\n    border-bottom-width: 1px;\n    padding: 1rem;\n  }\n\n  /* Reduce spacing on mobile */\n  .review-list-mobile .review-card + .review-card {\n    margin-top: 1rem;\n  }\n\n  /* Image lightbox mobile */\n  .review-image-lightbox-mobile {\n    position: fixed;\n    inset: 0px;\n    z-index: 50;\n    background-color: rgb(0 0 0 / 0.95);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .review-image-lightbox-mobile img {\n    max-height: 100%;\n    max-width: 100%;\n    -o-object-fit: contain;\n       object-fit: contain;\n  }\n\n  /* Swipe indicator for media */\n  .swipe-indicator {\n    margin-top: 0.5rem;\n    display: flex;\n    justify-content: center;\n    gap: 0.25rem;\n  }\n\n  .swipe-indicator-dot {\n    height: 0.5rem;\n    width: 0.5rem;\n    border-radius: 9999px;\n    --tw-bg-opacity: 1;\n    background-color: rgb(156 163 175 / var(--tw-bg-opacity, 1));\n  }\n\n  .swipe-indicator-dot.active {\n    width: 1rem;\n    background-color: hsl(var(--primary));\n  }\n}\n\n/* Small Mobile (<375px) */\n@media (max-width: 374px) {\n  .review-card {\n    padding: 0.75rem;\n  }\n\n  .review-stats-card {\n    padding: 0.75rem;\n  }\n\n  .vote-button,\n  .review-action-button {\n    padding-left: 0.75rem;\n    padding-right: 0.75rem;\n    font-size: 0.875rem;\n    line-height: 1.375rem;\n    letter-spacing: 0;\n  }\n}\n\n/* Tablet (768px - 1024px) */\n@media (min-width: 768px) and (max-width: 1024px) {\n  .reviews-layout-grid {\n    grid-template-columns: repeat(1, minmax(0, 1fr));\n  }\n  @media (min-width: 1024px) {\n    .reviews-layout-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n  }\n\n  /* Stats can stay in sidebar on tablet */\n  .review-stats-tablet {\n    position: sticky;\n    top: 5rem;\n  }\n}\n\n/* Landscape mobile */\n@media (max-width: 768px) and (orientation: landscape) {\n  .review-form-mobile-sheet {\n    max-height: 80vh;\n  }\n\n  .review-stats-compact {\n    flex-direction: row;\n  }\n}\n"],["META",{"name":"title","content":"Emarzona - Plateforme de ecommerce et marketing"}],["META",{"name":"keywords","content":"e-commerce, boutique en ligne, vente en ligne, plateforme e-commerce, multi-boutiques"}],["META",{"name":"robots","content":"index, follow"}]],"\n\n  ",["BODY",{},"\n    ","\n    \n    ",["DIV",{"id":"root"},["DIV",{"role":"region","aria-label":"Notifications (F8)","tabindex":"-1","style":"pointer-events: none;"},["OL",{"tabindex":"-1","class":"fixed top-0 z-[100] flex max-h-screen w-full flex-col-reverse p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px]"}]],["A",{"href":"#main-content","class":"sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-foreground focus:rounded-md focus:shadow-lg focus:font-semibold focus:text-sm focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 transition-all duration-200","aria-label":"Aller au contenu principal"},"Aller au contenu principal"],["BUTTON",{"class":"inline-flex items-center justify-center gap-2 text-sm font-medium ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 active:scale-95 select-none bg-[image:var(--gradient-primary)] text-primary-foreground hover:opacity-90 shadow-md hover:shadow-lg min-h