/**
 * Optimise une image avec compression et tailles multiples
 */ export async function optimizeImage(inputBuffer, options = {}) {
    const { quality = 85, format = 'webp', progressive = true, sizes = [
        400,
        800,
        1200,
        1600
    ], maxWidth = 2000, maxHeight = 2000 } = options;
