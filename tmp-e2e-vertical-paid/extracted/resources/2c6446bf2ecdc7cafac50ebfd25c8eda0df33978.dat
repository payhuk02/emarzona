const __vite__css = "/**\n * Overrides UI plateforme (zone app premium)\n * - Icônes sans arrière-plan, en noir\n * - Boutons dégradé violet/rose → bleu landing\n * - Titres dégradé violet/rose → noir\n *\n * Scope : #main-content ET tout <main class=\"flex-1\"> (ex. portail client)\n */\n\n.landing-premium.app-premium {\n  --app-btn-blue: linear-gradient(\n    135deg,\n    var(--lp-blue-bright) 0%,\n    var(--lp-blue) 55%,\n    var(--lp-blue-deep) 100%\n  );\n}\n\n/* Zone de contenu principale (hors sidebar) */\n.landing-premium.app-premium #main-content,\n.landing-premium.app-premium main.flex-1 {\n  /* anchor pour has() si besoin */\n}\n\n/* ——— Titres dégradé (ex. « Mon Espace Client » violet→rose) → noir ——— */\n.landing-premium.app-premium #main-content [class*='bg-clip-text'],\n.landing-premium.app-premium\n  #main-content\n  [class*='from-purple-600'][class*='to-pink-600']:not(button):not([role='tab']),\n.landing-premium.app-premium #main-content h1 span[class*='bg-gradient'],\n.landing-premium.app-premium #main-content h2 span[class*='bg-gradient'],\n.landing-premium.app-premium main.flex-1 [class*='bg-clip-text'],\n.landing-premium.app-premium\n  main.flex-1\n  [class*='from-purple-600'][class*='to-pink-600']:not(button):not([role='tab']),\n.landing-premium.app-premium main.flex-1 h1 span[class*='bg-gradient'],\n.landing-premium.app-premium main.flex-1 h2 span[class*='bg-gradient'] {\n  background: none !important;\n  background-image: none !important;\n  -webkit-background-clip: unset !important;\n  background-clip: unset !important;\n  -webkit-text-fill-color: #000 !important;\n  color: #000 !important;\n}\n\n/* ——— Bouton primaire bleu (remplace violet→rose) ——— */\n.landing-premium.app-premium #main-content .app-btn-premium-gradient,\n.landing-premium.app-premium #main-content .bg-gradient-to-r.from-purple-600.to-pink-600,\n.landing-premium.app-premium #main-content [class*='from-purple-600'][class*='to-pink-600'],\n.landing-premium.app-premium #main-content [class*='from-purple-500'][class*='to-pink-500'],\n.landing-premium.app-premium #main-content [class*='from-\\[#7851A9\\]'][class*='to-\\[#FF69B4\\]'],\n.landing-premium.app-premium #main-content [class*='from-\\[#7851A9\\]'],\n.landing-premium.app-premium main.flex-1 .app-btn-premium-gradient,\n.landing-premium.app-premium main.flex-1 [class*='from-purple-600'][class*='to-pink-600'] {\n  background-image: var(--app-btn-blue) !important;\n  background-color: transparent !important;\n  color: #fff !important;\n  border: none !important;\n  -webkit-text-fill-color: #fff !important;\n}\n\n.landing-premium.app-premium #main-content .app-btn-premium-gradient:hover,\n.landing-premium.app-premium #main-content [class*='from-purple-600'][class*='to-pink-600']:hover,\n.landing-premium.app-premium main.flex-1 [class*='from-purple-600'][class*='to-pink-600']:hover {\n  filter: brightness(1.06);\n}\n\n.landing-premium.app-premium #main-content .app-btn-premium-gradient svg,\n.landing-premium.app-premium #main-content .app-btn-premium-gradient span,\n.landing-premium.app-premium #main-content [class*='from-purple-600'][class*='to-pink-600'] svg,\n.landing-premium.app-premium #main-content [class*='from-purple-600'][class*='to-pink-600'] span,\n.landing-premium.app-premium main.flex-1 [class*='from-purple-600'][class*='to-pink-600'] svg {\n  color: #fff !important;\n  stroke: #fff !important;\n}\n\n/* ——— Conteneurs d'icônes : fond transparent, pas de bordure colorée ——— */\n.landing-premium.app-premium #main-content .app-icon-plain,\n.landing-premium.app-premium main.flex-1 .app-icon-plain,\n.landing-premium.app-premium\n  #main-content\n  [class*='500/10']:not(button):not(a):not([class*='bg-card']):not([class*='bg-white']):not(\n    [class*='bg-background']\n  ):not([class*='bg-muted']):not([class*='bg-popover']):not([class*='TabsList']),\n.landing-premium.app-premium\n  main.flex-1\n  [class*='500/10']:not(button):not(a):not([class*='bg-card']):not([class*='bg-white']):