// ============================================================
// USER REVIEWS
// ============================================================
/**
 * Hook pour récupérer les reviews d'un utilisateur
 */ export const useUserReviews = (userId, limit = 50)=>{
    return useQuery({
        queryKey: [
            'user-reviews',
            userId,
            limit
        ],
        queryFn: async ()=>{
            if (!userId) return [];
            const { data, error } = await supabase.from('reviews').select(`
          ${REVIEW_FIELDS},
          media:review_media(${REVIEW_MEDIA_FIELDS})
        `).eq('user_id', userId).order('created_at', {
                ascending: false
            }).limit(limit);
            if (error) {
                logger.error('Error fetching user reviews', {
                    error,
                    userId
                });
                throw error;
            }
            return data;
        },
        enabled: !!userId,
        staleTime: 1000 * 60 * 5
    });
};

