        maxRequests: parseInt(import.meta.env.VITE_GENIUSPAY_RATE_LIMIT_STORE_MAX || '200', 10),
        windowMs: parseInt(import.meta.env.VITE_GENIUSPAY_RATE_LIMIT_WINDOW_MS || '60000', 10),
