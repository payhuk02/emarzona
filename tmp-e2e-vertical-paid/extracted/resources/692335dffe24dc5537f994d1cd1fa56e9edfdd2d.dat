        maxRequests: parseInt(import.meta.env.VITE_GENIUSPAY_RATE_LIMIT_USER_MAX || '50', 10),
        windowMs: parseInt(import.meta.env.VITE_GENIUSPAY_RATE_LIMIT_WINDOW_MS || '60000', 10),
        identifier: 'user'
    });
}
/**
 * Rate Limiter par store
 * Limite: 200 requêtes par minute par store
