// Instance globale du store
const metricsStore = new MetricsStore();
/**
 * Enregistrer une métrique
 */ export function recordMetric(metric) {
    const fullMetric = {
        ...metric,
        id: `metric-${Date.now()}-${Math.random()}`,
        timestamp: Date.now()
    };
    metricsStore.addMetric(fullMetric);
    // Envoyer à Sentry si c'est une métrique importante
    if (metric.type === 'error_rate' || metric.type === 'page_load') {
        Sentry.setMeasurement(metric.name, metric.value, metric.unit);
    }
}
/**
 * Mesurer une opération et enregistrer la métrique
 */ export async function measureOperation(name, type, operation, unit = 'ms') {
    const startTime = performance.now();
    try {
        const result = await operation();
        const duration = performance.now() - startTime;
        recordMetric({
            name,
            type,
            value: duration,
            unit
        });
        return result;
    } catch (error) {
        const duration = performance.now() - startTime;
        recordMetric({
            name: `${name} (error)`,
            type,
            value: duration,
            unit,
            metadata: {
                error: error instanceof Error ? error.message : String(error)
            }
        });
        throw error;
    }
}
