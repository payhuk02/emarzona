            const paymentType = paymentOptions.payment_type || 'full';
            const percentageRate = paymentOptions.percentage_rate || 30;
            // 2. Récupérer les détails du service
            const { data: serviceProduct, error: serviceError } = await supabase.from('service_products').select(SERVICE_PRODUCT_FIELDS).eq('id', serviceProductId).single();
