                    // Vérifier les conflits avec les réservations existantes du staff
                    const { data: conflictingBookings, error: fallbackConflictError } = await supabase.from('service_bookings').select(SERVICE_BOOKING_FIELDS).eq('product_id', productId).eq('staff_member_id', staffId).eq('scheduled_date', bookingDate).in('status', [
                        'pending',
