/**
 * Types TypeScript pour le système de Reviews & Ratings
 * Date : 27 octobre 2025
 * Universel : Digital, Physical, Service, Course
 */ // ============================================================
// HELPERS
// ============================================================
export const RATING_LABELS = {
    5: 'Excellent',
    4: 'Très bon',
    3: 'Moyen',
    2: 'Médiocre',
    1: 'Très mauvais'
};
export const getDetailedRatingFields = (productType)=>{
    switch(productType){
        case 'digital':
            return [
                'quality_rating',
                'value_rating'
            ];
        case 'physical':
            return [
                'quality_rating',
                'value_rating',
                'delivery_rating'
            ];
        case 'service':
            return [
                'quality_rating',
                'value_rating',
                'service_rating'
            ];
        case 'course':
            return [
                'course_content_rating',
                'instructor_rating',
                'value_rating'
            ];
        default:
            return [];
    }
};
export const getDetailedRatingLabel = (field)=>{
    const labels = {
        quality_rating: 'Qualité',
        value_rating: 'Rapport qualité/prix',
        service_rating: 'Service',
        delivery_rating: 'Livraison',
        course_content_rating: 'Contenu du cours',
        instructor_rating: 'Instructeur'
    };
    return labels[field] || field;
};

