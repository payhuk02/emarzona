export function useLoyaltyProfile(userId) {
    const { data: profile, isLoading, error, refetch } = useQuery({
        queryKey: [
            'loyalty-profile',
            userId
        ],
        queryFn: ()=>userId ? loyaltyEngine.getUserProfile(userId) : null,
        enabled: !!userId,
        staleTime: 5 * 60 * 1000,
        retry: 2
    });
    return {
        profile,
        isLoading,
        error,
        refetch
    };
}
export function useAwardPoints() {
    const queryClient = useQueryClient();
    const { toast } = useToast();
    return useMutation({
        mutationFn: async ({ userId, points, reason, referenceId, referenceType, metadata, storeId })=>{
            return await loyaltyEngine.awardPoints(userId, points, reason, referenceId, referenceType, metadata, storeId);
