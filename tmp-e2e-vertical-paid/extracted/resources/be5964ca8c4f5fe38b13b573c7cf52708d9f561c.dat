import { createHotContext as __vite__createHotContext } from "/@vite/client";import.meta.hot = __vite__createHotContext("/src/styles/dashboard-premium.css");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from "/@vite/client"
const __vite__id = "/home/runner/work/emarzona/emarzona/src/styles/dashboard-premium.css"
const __vite__css = "/**\n * Tableau de bord premium — cartes colorées (inspiré maquette)\n */\n\n.dashboard-premium {\n  --dash-purple: 139 92 246;\n  --dash-blue: 59 130 246;\n  --dash-green: 16 185 129;\n  --dash-orange: 249 115 22;\n}\n\n.landing-premium.app-premium #main-content:has(.dashboard-premium) {\n  background: #f3f4f6 !important;\n}\n\n.dashboard-premium .dashboard-metric-icon-wrap svg {\n  color: inherit !important;\n  stroke: currentColor !important;\n}\n\n/* Carte KPI colorée */\n.dashboard-metric-card {\n  position: relative;\n  overflow: hidden;\n  border-radius: 1rem;\n  border-width: 1px;\n  --tw-bg-opacity: 1;\n  background-color: rgb(255 255 255 / var(--tw-bg-opacity, 1));\n  padding: 1.25rem;\n  --tw-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);\n  --tw-shadow-colored: 0 1px 2px 0 var(--tw-shadow-color);\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\n  transition-property: box-shadow;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 300ms;\n  animation-duration: 300ms;\n}\n@media (min-width: 640px) {\n\n  .dashboard-metric-card {\n    padding: 1.5rem;\n  }\n}\n.dashboard-metric-card:hover {\n  --tw-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);\n  --tw-shadow-colored: 0 4px 6px -1px var(--tw-shadow-color), 0 2px 4px -2px var(--tw-shadow-color);\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\n}\n\n.dashboard-metric-card--purple {\n  border-color: rgb(var(--dash-purple) / 0.15);\n}\n.dashboard-metric-card--blue {\n  border-color: rgb(var(--dash-blue) / 0.15);\n}\n.dashboard-metric-card--green {\n  border-color: rgb(var(--dash-green) / 0.15);\n}\n.dashboard-metric-card--orange {\n  border-color: rgb(var(--dash-orange) / 0.15);\n}\n\n.dashboard-metric-icon-wrap {\n  display: flex;\n  height: 2.75rem;\n  width: 2.75rem;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  border-radius: 9999px;\n}\n\n@media (min-width: 640px) {\n\n  .dashboard-metric-icon-wrap {\n    height: 3rem;\n    width: 3rem;\n  }\n}\n\n.dashboard-metric-card--purple .dashboard-metric-icon-wrap {\n  background: rgb(var(--dash-purple) / 0.12);\n  color: rgb(var(--dash-purple));\n}\n.dashboard-metric-card--blue .dashboard-metric-icon-wrap {\n  background: rgb(var(--dash-blue) / 0.12);\n  color: rgb(var(--dash-blue));\n}\n.dashboard-metric-card--green .dashboard-metric-icon-wrap {\n  background: rgb(var(--dash-green) / 0.12);\n  color: rgb(var(--dash-green));\n}\n.dashboard-metric-card--orange .dashboard-metric-icon-wrap {\n  background: rgb(var(--dash-orange) / 0.12);\n  color: rgb(var(--dash-orange));\n}\n\n.dashboard-metric-icon-wrap svg {\n  height: 1.25rem;\n  width: 1.25rem;\n}\n\n@media (min-width: 640px) {\n\n  .dashboard-metric-icon-wrap svg {\n    height: 1.5rem;\n    width: 1.5rem;\n  }\n}\n\n.dashboard-metric-icon-wrap svg {\n  color: inherit !important;\n  stroke: currentColor !important;\n}\n\n.dashboard-metric-trend {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.25rem;\n  border-radius: 9999px;\n  padding-left: 0.625rem;\n  padding-right: 0.625rem;\n  padding-top: 0.25rem;\n  padding-bottom: 0.25rem;\n  font-size: 0.75rem;\n  line-height: 1.25rem;\n  letter-spacing: 0;\n  font-weight: 600;\n  --tw-numeric-spacing: tabular-nums;\n  font-variant-numeric: var(--tw-ordinal) var(--tw-slashed-zero) var(--tw-numeric-figure) var(--tw-numeric-spacing) var(--tw-numeric-fraction);\n}\n\n@media (min-width: 640px) {\n\n  .dashboard-metric-trend {\n    font-size: 0.875rem;\n    line-height: 1.375rem;\n    letter-spacing: 0;\n  }\n}\n\n.dashboard-metric-trend--up {\n  --tw-bg-opacity: 1;\n  background-color: rgb(236 253 245 / var(--tw-bg-opacity, 1));\n  --tw-text-opacity: 1;\n  color: rgb(4 120 87 / var(--tw-text-opacity, 1));\n}\n\n.dashboard-metric-trend--down {\n  --tw-bg-opacity: 1;\n  background-color: rgb(254 242 242 / var(--tw-bg-opacity, 1));\n  --tw-text-opacity: 1;\n  color: rgb(220 38 38 / var(--tw-text-opacity, 1));\n}\n\n.dashboard-metric-label {\n  margin-top: 1rem;\n  font-size: 0.875rem;\n  line-height: 1.375rem;\n  letter-spacing: 0;\n  font-weight: 500;\n  color: hsl(var(--muted-foreground));\n}\n\n@media (min-width: 640px) {\n\n  .dashboard-metric-label {\n    font-size: 1rem;\n    line-height: 1.625rem;\n    letter-spacing: 0;\n  }\n}\n\n.dashboard-metric-value {\n  font-family: var(--lp-serif, Georgia, serif);\n  margin-top: 0.25rem;\n  font-size: 1.5rem;\n  line-height: 2rem;\n  font-weight: 700;\n  --tw-numeric-spacing: tabular-nums;\n  font-variant-numeric: var(--tw-ordinal) var(--tw-slashed-zero) var(--tw-numeric-figure) var(--tw-numeric-spacing) var(--tw-numeric-fraction);\n  letter-spacing: -0.025em;\n  color: hsl(var(--foreground));\n}\n\n@media (min-width: 640px) {\n\n  .dashboard-metric-value {\n    font-size: 1.875rem;\n    line-height: 2.25rem;\n    letter-spacing: -0.01em;\n  }\n}\n\n@media (min-width: 1024px) {\n\n  .dashboard-metric-value {\n    font-size: 2.25rem;\n    line-height: 2.5rem;\n    letter-spacing: -0.02em;\n  }\n}\n\n.dashboard-metric-sub {\n  margin-top: 0.25rem;\n  font-size: 0.75rem;\n  line-height: 1.25rem;\n  letter-spacing: 0;\n  color: hsl(var(--muted-foreground));\n}\n\n@media (min-width: 640px) {\n\n  .dashboard-metric-sub {\n    font-size: 0.875rem;\n    line-height: 1.375rem;\n    letter-spacing: 0;\n  }\n}\n\n.dashboard-metric-wave {\n  pointer-events: none;\n  position: absolute;\n  right: -10%;\n  bottom: -2px;\n  left: -10%;\n  height: 72px;\n  opacity: 0.55;\n}\n\n.dashboard-metric-card--purple .dashboard-metric-wave {\n  background: radial-gradient(\n    ellipse 80% 100% at 50% 100%,\n    rgb(var(--dash-purple) / 0.18),\n    transparent 70%\n  );\n}\n.dashboard-metric-card--blue .dashboard-metric-wave {\n  background: radial-gradient(\n    ellipse 80% 100% at 50% 100%,\n    rgb(var(--dash-blue) / 0.18),\n    transparent 70%\n  );\n}\n.dashboard-metric-card--green .dashboard-metric-wave {\n  background: radial-gradient(\n    ellipse 80% 100% at 50% 100%,\n    rgb(var(--dash-green) / 0.18),\n    transparent 70%\n  );\n}\n.dashboard-metric-card--orange .dashboard-metric-wave {\n  background: radial-gradient(\n    ellipse 80% 100% at 50% 100%,\n    rgb(var(--dash-orange) / 0.18),\n    transparent 70%\n  );\n}\n\n/* Panneau blanc (graphiques, listes) */\n.dashboard-premium-panel {\n  border-radius: 1rem;\n  border-width: 1px;\n  border-color: hsl(var(--border) / 0.5);\n  --tw-bg-opacity: 1;\n  background-color: rgb(255 255 255 / var(--tw-bg-opacity, 1));\n  padding: 1.25rem;\n  --tw-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);\n  --tw-shadow-colored: 0 1px 2px 0 var(--tw-shadow-color);\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\n}\n@media (min-width: 640px) {\n\n  .dashboard-premium-panel {\n    padding: 1.5rem;\n  }\n}\n@media (min-width: 1024px) {\n\n  .dashboard-premium-panel {\n    padding: 1.75rem;\n  }\n}\n\n.dashboard-premium-panel-title {\n  font-family: var(--lp-serif, Georgia, serif);\n  font-size: 1.125rem;\n  line-height: 1.75rem;\n  letter-spacing: 0;\n  font-weight: 700;\n  letter-spacing: -0.025em;\n  color: hsl(var(--foreground));\n}\n\n@media (min-width: 640px) {\n\n  .dashboard-premium-panel-title {\n    font-size: 1.25rem;\n    line-height: 1.75rem;\n    letter-spacing: 0;\n  }\n}\n\n.dashboard-premium-panel-subtitle {\n  margin-top: 0.125rem;\n  font-size: 0.875rem;\n  line-height: 1.375rem;\n  letter-spacing: 0;\n  color: hsl(var(--muted-foreground));\n}\n\n@media (min-width: 640px) {\n\n  .dashboard-premium-panel-subtitle {\n    font-size: 1rem;\n    line-height: 1.625rem;\n    letter-spacing: 0;\n  }\n}\n\n/* Barre de progression catégories */\n.dashboard-category-bar {\n  height: 0.5rem;\n  overflow: hidden;\n  border-radius: 9999px;\n  background-color: hsl(var(--muted) / 0.6);\n}\n\n.dashboard-category-bar-fill {\n  height: 100%;\n  border-radius: 9999px;\n  transition-property: all;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 500ms;\n  animation-duration: 500ms;\n}\n\n/* Mini métriques footer */\n.dashboard-mini-metric {\n  border-radius: 0.75rem;\n  border-width: 1px;\n  border-color: hsl(var(--border) / 0.4);\n  --tw-bg-opacity: 1;\n  background-color: rgb(255 255 255 / var(--tw-bg-opacity, 1));\n  padding: 1rem;\n  --tw-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);\n  --tw-shadow-colored: 0 1px 2px 0 var(--tw-shadow-color);\n  box-shadow: var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow);\n}\n@media (min-width: 640px) {\n\n  .dashboard-mini-metric {\n    padding: 1.25rem;\n  }\n}\n\n.dashboard-mini-metric-value {\n  margin-top: 0.25rem;\n  font-size: 1.25rem;\n  line-height: 1.75rem;\n  letter-spacing: 0;\n  font-weight: 700;\n  --tw-numeric-spacing: tabular-nums;\n  font-variant-numeric: var(--tw-ordinal) var(--tw-slashed-zero) var(--tw-numeric-figure) var(--tw-numeric-spacing) var(--tw-numeric-fraction);\n  color: hsl(var(--foreground));\n}\n\n@media (min-width: 640px) {\n\n  .dashboard-mini-metric-value {\n    font-size: 1.5rem;\n    line-height: 2rem;\n    letter-spacing: -0.01em;\n  }\n}\n\n.dashboard-mini-metric-label {\n  font-size: 0.875rem;\n  line-height: 1.375rem;\n  letter-spacing: 0;\n  font-weight: 500;\n  color: hsl(var(--muted-foreground));\n}\n\n/* Liste commandes premium */\n@media (max-width: 360px) {\n\n    /* Padding réduit pour très petits écrans */\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n\n    .dashboard-order-row {\n      gap: 0.5rem;\n    }\n\n    /* Grilles adaptées */\n  }\n.dashboard-order-row {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  border-bottom-width: 1px;\n  border-color: hsl(var(--border) / 0.4);\n  padding-top: 0.75rem;\n  padding-bottom: 0.75rem;\n}\n@media (min-width: 640px) {\n  @media (max-width: 360px) {\n\n    /* Padding réduit pour très petits écrans */\n\n    /* Textes plus petits mais lisibles - Minimum 14px pour accessibilité */\n\n    /* Boutons compacts mais touch-friendly */\n\n    /* Cards plus compactes */\n\n    /* Espacement réduit */\n\n    .dashboard-order-row {\n      gap: 0.75rem;\n    }\n\n    /* Grilles adaptées */\n  }\n}\n.dashboard-order-row:last-child {\n  border-width: 0px;\n}\n@media (min-width: 640px) {\n\n  .dashboard-order-row {\n    gap: 1rem;\n    padding-top: 0.875rem;\n    padding-bottom: 0.875rem;\n  }\n}\n\n.dashboard-order-avatar {\n  display: flex;\n  height: 2.5rem;\n  width: 2.5rem;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  border-radius: 9999px;\n  background-color: hsl(var(--muted));\n  font-size: 0.875rem;\n  line-height: 1.375rem;\n  letter-spacing: 0;\n  font-weight: 600;\n  color: hsl(var(--foreground));\n}\n\n.dashboard-status-badge {\n  display: inline-flex;\n  border-radius: 9999px;\n  padding-left: 0.625rem;\n  padding-right: 0.625rem;\n  padding-top: 0.125rem;\n  padding-bottom: 0.125rem;\n  font-size: 0.75rem;\n  line-height: 1.25rem;\n  letter-spacing: 0;\n  font-weight: 600;\n}\n\n.dashboard-status-badge--completed,\n.dashboard-status-badge--delivered {\n  --tw-bg-opacity: 1;\n  background-color: rgb(236 253 245 / var(--tw-bg-opacity, 1));\n  --tw-text-opacity: 1;\n  color: rgb(4 120 87 / var(--tw-text-opacity, 1));\n}\n.dashboard-status-badge--pending,\n.dashboard-status-badge--processing,\n.dashboard-status-badge--confirmed {\n  --tw-bg-opacity: 1;\n  background-color: rgb(239 246 255 / var(--tw-bg-opacity, 1));\n  --tw-text-opacity: 1;\n  color: rgb(29 78 216 / var(--tw-text-opacity, 1));\n}\n.dashboard-status-badge--shipped {\n  --tw-bg-opacity: 1;\n  background-color: rgb(255 251 235 / var(--tw-bg-opacity, 1));\n  --tw-text-opacity: 1;\n  color: rgb(146 64 14 / var(--tw-text-opacity, 1));\n}\n.dashboard-status-badge--cancelled {\n  --tw-bg-opacity: 1;\n  background-color: rgb(254 242 242 / var(--tw-bg-opacity, 1));\n  --tw-text-opacity: 1;\n  color: rgb(220 38 38 / var(--tw-text-opacity, 1));\n}\n"
__vite__updateStyle(__vite__id, __vite__css)
